root = true

[*]
charset = utf-8-bom
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# **Déclaré parce que le silence coûtait cher.** Le dépôt mélangeait les deux
# fins de ligne, trois cent soixante-trois fichiers en LF contre vingt-six en
# CRLF, sans qu'aucune règle ne tranche. « dotnet format » retombait alors sur
# le défaut de la plateforme, CRLF sous Windows, et la porte du format passait
# ou échouait selon ce qu'un changement de branche avait réécrit au passage.
#
# LF, parce que c'est déjà ce que git stocke sous « * text=auto ».
end_of_line = lf

# Sauf les scripts Windows, qu'un cmd.exe ancien lit de travers en LF.
# Même règle que .gitattributes, qui les marque « eol=crlf ».
[*.{cmd,ps1}]
end_of_line = crlf

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# Les noms de tests décrivent un comportement en français : les underscores
# sont volontaires et lisibles, on désactive donc CA1707 sur ce projet.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# CA1873 ne suit pas les gardes IsEnabled lorsque l'appel de journalisation est
# généré à la source par [LoggerMessage]. Les appels concernés sont gardés
# explicitement dans le code ; la règle produirait donc uniquement du bruit.
dotnet_diagnostic.CA1873.severity = none

# Les vues-modèles exposent des propriétés liées par XAML. Les rendre statiques
# casserait la liaison de données, et les services injectés doivent rester des
# instances pour l'injection de dépendances. CA1822 n'a donc pas de sens ici.
[src/DtHub.App/**/*.cs]
dotnet_diagnostic.CA1822.severity = none

# CA1416 signale un appel réservé à une plateforme. Il est éteint là où appeler
# Windows est le métier du projet, et laissé actif ailleurs : c'est lui qui
# préviendrait qu'un appel Windows s'est glissé dans DtHub.Core, ce que la règle
# d'architecture interdit. Éteint partout, il ne protégeait plus rien.
[src/DtHub.App/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[src/DtHub.Infrastructure/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[build/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1416.severity = none
