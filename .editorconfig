root = true

[*]
charset = utf-8-bom
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# **Declared because the silence was costing us.** The repository mixed the
# two line endings, three hundred and sixty-three files in LF against
# twenty-six in CRLF, with no rule to settle it. "dotnet format" then fell
# back on the platform default, CRLF on Windows, and the format gate passed
# or failed depending on what a branch switch had rewritten on the way.
#
# LF, because that is already what git stores under "* text=auto".
end_of_line = lf

# Except the Windows scripts, which an older cmd.exe reads wrong in LF.
# Same rule as .gitattributes, which marks them "eol=crlf".
[*.{cmd,ps1}]
end_of_line = crlf

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# Test names describe a behaviour in French: the underscores are deliberate
# and readable, so CA1707 is turned off on this project.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# CA1873 does not follow the IsEnabled guards when the logging call is source
# generated by [LoggerMessage]. The calls concerned are guarded explicitly in
# the code, so the rule would produce nothing but noise.
dotnet_diagnostic.CA1873.severity = none

# The view models expose properties bound by XAML. Making them static would
# break the data binding, and injected services must stay instances for
# dependency injection. CA1822 therefore makes no sense here.
[src/DtHub.App/**/*.cs]
dotnet_diagnostic.CA1822.severity = none

# CA1416 reports a call reserved to one platform. It is turned off where
# calling Windows is the project's job, and left on elsewhere: it is what
# would warn that a Windows call has slipped into DtHub.Core, which the
# architecture rule forbids. Turned off everywhere, it protected nothing.
[src/DtHub.App/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[src/DtHub.Infrastructure/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[build/**/*.cs]
dotnet_diagnostic.CA1416.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1416.severity = none
