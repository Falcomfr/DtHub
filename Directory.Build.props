<Project>

  <!--
    Product identity, kept in one place.
    To rename the application, change this file and
    src/DtHub.Core/ProductInfo.cs (see AGENTS.md, "Renaming the product").
  -->
  <PropertyGroup Label="Product">
    <!-- What Windows shows in the file properties, and what SmartScreen
         quotes when it warns. It must say exactly what the application says
         of itself: "DT Touch" had been left here by a rename, while the
         window announces "DT Hub". An executable that does not carry its own
         name defends itself poorly. -->
    <Product>DT Hub</Product>
    <ProductSlug>DtHub</ProductSlug>

    <!-- The description is what Windows shows first, in the SmartScreen
         warning as in Task Manager. Without it there is only the file
         name. -->
    <AssemblyTitle>DT Hub, several DOFUS Touch accounts side by side</AssemblyTitle>
    <Description>Opens several DOFUS Touch accounts side by side from real Android devices, with guide tracking.</Description>
    <Company>Falcomfr</Company>
    <Authors>Falcomfr</Authors>
    <Copyright>Copyright (c) 2026 Falcomfr</Copyright>
    <RepositoryUrl>https://github.com/Falcomfr/DtHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <VersionPrefix>0.4.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

</Project>
