<Project>

  <!--
    Identité produit centralisée.
    Pour renommer l'application, il suffit de modifier ce fichier
    et src/DtHub.Core/ProductInfo.cs (voir AGENTS.md, section "Renommer le produit").
  -->
  <PropertyGroup Label="Product">
    <!-- Ce que Windows montre dans les propriétés du fichier, et ce que
         SmartScreen cite quand il met en garde. Il doit dire exactement ce que
         l'application dit d'elle-même : « DT Touch » traînait ici depuis un
         renommage, quand la fenêtre annonce « DT Hub ». Un exécutable qui ne
         porte pas son propre nom se défend mal. -->
    <Product>DT Hub</Product>
    <ProductSlug>DtHub</ProductSlug>

    <!-- La description est ce que Windows affiche en premier, dans la mise en
         garde de SmartScreen comme dans le gestionnaire des tâches. Sans elle,
         il n'y a que le nom du fichier. -->
    <AssemblyTitle>DT Hub, several DOFUS Touch accounts side by side</AssemblyTitle>
    <Description>Opens several DOFUS Touch accounts side by side from real Android devices, with guide tracking.</Description>
    <Company>Falcomfr</Company>
    <Authors>Falcomfr</Authors>
    <Copyright>Copyright (c) 2026 Falcomfr</Copyright>
    <RepositoryUrl>https://github.com/Falcomfr/DtHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

</Project>
