<Project>

  <!--
    Identité produit centralisée.
    Pour renommer l'application, il suffit de modifier ce fichier
    et src/DtHub.Core/ProductInfo.cs (voir AGENTS.md, section "Renommer le produit").
  -->
  <PropertyGroup Label="Product">
    <Product>DT Touch</Product>
    <ProductSlug>DtHub</ProductSlug>
    <Company>Falcomfr</Company>
    <Authors>Falcomfr</Authors>
    <Copyright>Copyright (c) 2026 Falcomfr</Copyright>
    <RepositoryUrl>https://github.com/Falcomfr/DtHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

</Project>
