<!-- The PC's help window (src/DtHub.App/Windows/HelpWindow.xaml), on the
     same view model: the steps to follow on the phone, adapted to its
     brand, one version per way of being attached. -->
<Window x:Class="DtHub.Mac.Views.HelpWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DtHub.Mac.Localization"
        xmlns:vm="using:DtHub.App.ViewModels"
        xmlns:g="using:DtHub.Core.Guidance"
        xmlns:views="using:DtHub.Mac.Views"
        x:DataType="vm:HelpViewModel"
        Title="{loc:T Help}"
        Width="560" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        FontSize="{DynamicResource FontMedium}"
        Foreground="{DynamicResource TextBrush}">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Classes="title" Text="{loc:T PrepareDevice}" />

      <!-- One version per way of being attached: a cable owner must not
           read the Wi-Fi's troubles as if they were theirs. -->
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <RadioButton Theme="{StaticResource Tab}" Content="{loc:T ByWifi}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable, Converter={StaticResource InverseBool}}" />
        <RadioButton Theme="{StaticResource Tab}" Content="{loc:T ByCable}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable}" />
      </StackPanel>

      <!-- Above the scrolling, so that the fixes reached by "Nothing shows
           up?" are still read for a brand that can be seen and changed. -->
      <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,12,22,0"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="g:PhoneBrand">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Margin="2,4,0,0"
                 Text="{loc:T FrenchLabelsShort}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel Name="Steps" Margin="0,0,12,0">

        <Border Classes="card">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T UnlockDeveloperOptions}" />
            <views:MenuPathControl Path="{Binding Brand.BuildNumberPath}" Margin="0,2,0,4" />
            <TextBlock Classes="muted">
              <Run Text="{loc:T TapSevenTimesPrefix}" /><Run Text="{Binding Brand.BuildNumberLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{loc:T TapSevenTimesSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T OpenDeveloperOptions}" />
            <views:MenuPathControl Path="{Binding Brand.DeveloperOptionsPath}" Margin="0,2,0,4" />
            <TextBlock Classes="muted" Text="{loc:T EnableUsbDebugging}" IsVisible="{Binding OnCable}" />
            <TextBlock Classes="muted" Text="{loc:T EnableDebugging}" IsVisible="{Binding !OnCable}" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource Radius}"
                    Padding="10" Margin="0,10,0,0" IsVisible="{Binding HasWarning}">
              <TextBlock Classes="muted" Text="{Binding Brand.Warning}"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <StackPanel IsVisible="{Binding OnCable}">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T CableIsSimplest}" />
              <TextBlock Classes="muted" Text="{loc:T CableSteps}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding !OnCable}">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T WirelessFirstTime}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T WirelessMenuPath}" />
              <TextBlock Classes="muted" Text="{loc:T WirelessCodeShown}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Where "Nothing shows up?" and an offline phone's help link
             land: the window scrolls straight to it. -->
        <Border Name="Fixes" Classes="card">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T HelpFixes}" />
            <StackPanel IsVisible="{Binding OnCable}">
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixCableUnlock}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixCableWire}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixCableMode}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixCableRevoke}" />
              <TextBlock Classes="muted" Text="{loc:T HelpFixCableWindows}" />
              <TextBlock Classes="muted" Margin="0,3,0,0" Text="{Binding Brand.FixCable}"
                         IsVisible="{Binding Brand.FixCable, Converter={StaticResource EmptyToVisibility}, ConverterParameter=inverse}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding !OnCable}">
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixWifiScreen}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixWifiRestart}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T HelpFixWifiOneNetwork}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T StaysOfflineSameBand}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T StaysOfflinePrivate}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T StaysOfflineFirewall}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{loc:T StaysOfflineVpn}" />
              <TextBlock Classes="muted" Margin="0,0,0,3" Text="{Binding Brand.FixWifi}"
                         IsVisible="{Binding Brand.FixWifi, Converter={StaticResource EmptyToVisibility}, ConverterParameter=inverse}" />
              <TextBlock Classes="muted" Text="{loc:T StaysOfflineByHand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The battery help's other door: the alert can be hidden, and
             what it pointed to must stay findable. -->
        <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,4,0,6"
                FontSize="{DynamicResource FontSmall}"
                Content="{loc:T OpenSleepHelp}" Click="OnSleepHelp" />

        <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Margin="2,0,0,4"
                   Text="{loc:T AndroidOnly}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
