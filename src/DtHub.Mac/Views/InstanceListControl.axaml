<!-- The PC's list of phones and their accounts
     (src/DtHub.App/Windows/InstanceListControl.xaml), on the same view
     model. A single list across all devices; a phone's name only appears
     where it changes. -->
<UserControl x:Class="DtHub.Mac.Views.InstanceListControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DtHub.Mac.Localization"
             xmlns:vm="using:DtHub.App.ViewModels"
             xmlns:views="using:DtHub.Mac.Views"
             xmlns:s="using:DtHub.Core.Settings"
             x:DataType="vm:InstanceListViewModel">

  <UserControl.Styles>
    <!-- A row fades in when a phone is found, once per genuine discovery:
         the sweep keeps the rows it already has. -->
    <Style Selector="StackPanel.row">
      <Style.Animations>
        <Animation Duration="0:0:0.12" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The triangle and its text turn from yellow to red when the
         finding will cut the session short. -->
    <Style Selector="Path.problem">
      <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Path.problem.serious">
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.problem.serious">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel>

    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:InstanceRowViewModel">
          <StackPanel Classes="row">

            <!-- Device header. Outside the drop surface: including it would
                 push down the midpoint that decides between above and
                 below, for the first row of a device only. -->
            <Grid Margin="0,6,0,3" ColumnDefinitions="Auto,*,Auto"
                  IsVisible="{Binding ShowDeviceHeader}">

              <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="1"
                      Background="{Binding Device.StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Device.Name}" Classes="deviceHeader" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Device.StatusText}" />

                <!-- Spelled out only where you choose what to launch, and
                     not while one of its accounts is open. -->
                <TextBlock Text="{Binding Device.StatusText}" Classes="muted"
                           FontSize="{DynamicResource FontTiny}" Margin="8,1,0,0" VerticalAlignment="Center">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowDeviceStatus" />
                      <Binding Path="Device.IsIdle" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>

                <!-- The battery, drawn: a gauge reads without being read. -->
                <StackPanel Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center"
                            Background="Transparent"
                            ToolTip.Tip="{Binding Device.BatterySummary}"
                            IsVisible="{Binding Device.HasBattery}">

                  <Border Width="18" Height="9" CornerRadius="2" Padding="1"
                          VerticalAlignment="Center"
                          BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1">
                    <Rectangle HorizontalAlignment="Left" RadiusX="1" RadiusY="1"
                               Width="{Binding Device.BatteryFill}"
                               Fill="{Binding Device.BatteryBrushKey, Converter={StaticResource KeyToBrush}}" />
                  </Border>

                  <!-- The little nub at the tip, which makes it a battery. -->
                  <Border Width="2" Height="4" CornerRadius="0,1,1,0" Margin="1,0,0,0"
                          VerticalAlignment="Center"
                          Background="{DynamicResource TextMutedBrush}" />

                  <!-- Plugged in: why twelve percent warns about nothing. -->
                  <Path Width="5" Height="8" Margin="5,0,0,0" Stretch="Uniform"
                        VerticalAlignment="Center"
                        Data="M 3.2,0 L 0,4.6 L 2.2,4.6 L 1.8,8 L 5,3.4 L 2.8,3.4 Z"
                        Fill="{DynamicResource TextMutedBrush}"
                        IsVisible="{Binding Device.IsCharging}" />

                  <TextBlock Text="{Binding Device.BatteryText}" Classes="muted"
                             FontSize="{DynamicResource FontTiny}" Margin="5,1,0,0"
                             VerticalAlignment="Center"
                             Foreground="{Binding Device.BatteryBrushKey, Converter={StaticResource KeyToBrush}}" />
                </StackPanel>

                <!-- A thermometer only once Android says it is throttling. -->
                <Path Classes="rowGlyph listGlyph" StrokeThickness="1.3"
                      Margin="10,1,0,0" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding Device.HeatText}"
                      Stroke="{Binding Device.HeatBrushKey, Converter={StaticResource KeyToBrush}}"
                      Data="M 7.5,2.8 V 8.8 M 7.5,10.8 m -2.3,0 a 2.3,2.3 0 1 0 4.6,0 a 2.3,2.3 0 1 0 -4.6,0 M 9.4,4.4 H 10.8 M 9.4,6.4 H 10.8"
                      IsVisible="{Binding Device.HasHeat}" />

                <TextBlock Text="{Binding Device.StorageText}" Classes="muted"
                           FontSize="{DynamicResource FontTiny}" Margin="10,1,0,0"
                           TextWrapping="NoWrap" VerticalAlignment="Center"
                           Foreground="{Binding Device.StorageBrushKey, Converter={StaticResource KeyToBrush}}"
                           IsVisible="{Binding Device.HasStorage}" />

                <!-- A memory chip, drawn like the thermometer. -->
                <Path Classes="rowGlyph listGlyph" StrokeThickness="1.3"
                      Margin="10,1,0,0" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding Device.MemoryTip}"
                      Stroke="{Binding Device.MemoryBrushKey, Converter={StaticResource KeyToBrush}}"
                      Data="M 4.5,4 H 10.5 V 11 H 4.5 Z M 6.5,4 V 2.5 M 8.5,4 V 2.5 M 6.5,11 V 12.5 M 8.5,11 V 12.5 M 4.5,6 H 3 M 4.5,9 H 3 M 10.5,6 H 12 M 10.5,9 H 12"
                      IsVisible="{Binding Device.HasMemory}" />

                <TextBlock Text="{Binding Device.LinkText}" Classes="muted"
                           FontSize="{DynamicResource FontTiny}" Margin="10,1,0,0"
                           TextWrapping="NoWrap" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Device.LinkSummary}"
                           Foreground="{Binding Device.LinkBrushKey, Converter={StaticResource KeyToBrush}}"
                           IsVisible="{Binding Device.HasLink}" />

                <!-- The phone's screen, whenever one of its accounts is open. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowActions" />
                      <Binding Path="Device.IsPlaying" />
                    </MultiBinding>
                  </StackPanel.IsVisible>

                  <Button Theme="{StaticResource LinkButton}" Content="{Binding Device.ScreenAction}"
                          FontSize="{DynamicResource FontTiny}" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Device.ScreenActionTip}"
                          IsVisible="{Binding !Device.IsScreenSwitching}"
                          Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).TogglePanelCommand}"
                          CommandParameter="{Binding Device}" />

                  <!-- In its place while the screen changes. -->
                  <ContentControl Theme="{StaticResource Spinner}" VerticalAlignment="Center"
                                  IsVisible="{Binding Device.IsScreenSwitching}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Add a line: an application already on the phone, or a
                     new account for the game. -->
                <Button Theme="{StaticResource IconButton}"
                        IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="{loc:T AddAccountTip}"
                        Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).ManageAppsCommand}"
                        CommandParameter="{Binding Device}">
                  <Path Data="M 7.5,3 L 7.5,12 M 3,7.5 L 12,7.5"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.6" StrokeLineCap="Round" />
                  <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowActions" />
                      <Binding Path="IsFirstOfDevice" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>

                <!-- Close every account of this phone, while one is open. -->
                <Button Theme="{StaticResource IconButton}"
                        ToolTip.Tip="{loc:T StopDeviceTip}"
                        Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).StopDeviceCommand}"
                        CommandParameter="{Binding Device}">
                  <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                             Fill="{Binding $parent[Button].Foreground}" />
                  <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowActions" />
                      <Binding Path="IsFirstOfDevice" />
                      <Binding Path="Device.IsPlaying" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>

                <!-- Forgetting the phone applies at the device level: on
                     its first row only. -->
                <Button Theme="{StaticResource DangerIconButton}"
                        ToolTip.Tip="{loc:T ForgetDeviceTip}"
                        Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).ForgetDeviceCommand}"
                        CommandParameter="{Binding Device}">
                  <Path Classes="rowGlyph binGlyph" />
                  <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowActions" />
                      <Binding Path="IsFirstOfDevice" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
              </StackPanel>
            </Grid>

            <!-- What is wrong with this device, under its name: the most
                 serious finding, then "(+2)" for the others. -->
            <Grid Margin="16,0,0,4" ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent"
                  ToolTip.Tip="{Binding Device.Problems}">
              <Grid.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrue}">
                  <Binding Path="ShowDeviceHeader" />
                  <Binding Path="Device.HasProblems" />
                </MultiBinding>
              </Grid.IsVisible>

              <Path Grid.Column="0" Width="13" Height="13" Stretch="None" Margin="0,1,5,0"
                    VerticalAlignment="Top" StrokeJoin="Round" StrokeThickness="1.3"
                    Stroke="{Binding Device.ProblemsBrushKey, Converter={StaticResource KeyToBrush}}"
                    Data="M 6.5,2 L 12.5,11.5 H 0.5 Z M 6.5,5.5 V 8 M 6.5,9.6 V 10.1" />

              <TextBlock Grid.Column="1" Text="{Binding Device.Headline}"
                         FontSize="{DynamicResource FontSmall}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Foreground="{Binding Device.ProblemsBrushKey, Converter={StaticResource KeyToBrush}}" />

              <TextBlock Grid.Column="2" Text="{Binding Device.More}" Margin="4,0,0,0"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{Binding Device.ProblemsBrushKey, Converter={StaticResource KeyToBrush}}" />

              <!-- The help comes with the problem it answers. -->
              <Button Grid.Column="3" Theme="{StaticResource LinkButton}" Content="{loc:T Help}"
                      Margin="8,0,0,0" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Top"
                      IsVisible="{Binding Device.HasHelp}"
                      Click="OnProblemHelp" />
            </Grid>

            <!-- Drop surface: the row and its two markers, nothing else. -->
            <StackPanel Classes="dropSurface"
                        Opacity="{Binding IsDragging, Converter={StaticResource DraggedOpacity}}">

              <!-- Shown for every row at once while a drag runs, so no row
                   changes height under the pointer. -->
              <Border Classes="dropLine"
                      Opacity="{Binding DropAbove, Converter={StaticResource BoolToOpacity}}"
                      IsVisible="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).IsReordering}" />

              <Grid Margin="0,1" Background="Transparent"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                <!-- Which account this is, and what it is doing. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}">
                  <!-- Opacity and not visibility: the slot keeps its width
                       whether or not the account is marked. -->
                  <Border Width="3" CornerRadius="1.5" Margin="0,2,6,2"
                          VerticalAlignment="Stretch"
                          Background="{Binding ColourBrushKey, Converter={StaticResource KeyToBrush}}"
                          Opacity="{Binding HasColour, Converter={StaticResource BoolToOpacity}}" />

                  <!-- At rest an unlit socket, the groove ring alone. -->
                  <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="1"
                          ToolTip.Tip="{Binding StatusLine}"
                          Background="{Binding ActivityBrushKey, Converter={StaticResource KeyToBrush}}" />
                </StackPanel>

                <ContentControl Grid.Column="1" Theme="{StaticResource DragHandle}" Margin="0,0,2,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:T DragToReorderTip}"
                                PointerPressed="OnDragSourcePressed"
                                PointerMoved="OnDragSourceMoved"
                                PointerReleased="OnDragSourceReleased"
                                PointerCaptureLost="OnDragSourceLost">
                  <ContentControl.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="$parent[views:InstanceListControl].ShowOrdering" />
                      <Binding Path="$parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).CanReorder" />
                    </MultiBinding>
                  </ContentControl.IsVisible>
                </ContentControl>

                <!-- Locked, the window is left where it is. -->
                <ToggleButton Grid.Column="2" Theme="{StaticResource LockToggle}"
                              IsChecked="{Binding IsLocked}"
                              Margin="0,0,4,0" VerticalAlignment="Center"
                              ToolTip.Tip="{loc:T LockWindowTip}"
                              IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}" />

                <!-- Puts the account in the tabbed frame, or takes it out. -->
                <ToggleButton Grid.Column="3" Theme="{StaticResource TabbedToggle}"
                              Margin="0,0,5,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsTabbed}"
                              ToolTip.Tip="{loc:T TabbedTip}"
                              IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- The key that brings this account forward, F1 for the
                       first open line. Opacity: a window opening must not
                       push the name. -->
                  <TextBlock MinWidth="14" Margin="0,0,4,0" VerticalAlignment="Center"
                             Text="{Binding AccountKey}" Classes="muted"
                             FontSize="{DynamicResource FontTiny}"
                             ToolTip.Tip="{loc:T ActionAccountDetail}"
                             Opacity="{Binding HasAccountKey, Converter={StaticResource BoolToOpacity}}"
                             IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}" />

                  <!-- The game's own icon; the space is held even without
                       one, so a late icon does not shift the names. -->
                  <Image Width="20" Height="20" Margin="0,0,7,0"
                         VerticalAlignment="Center" Stretch="Uniform"
                         RenderOptions.BitmapInterpolationMode="HighQuality"
                         ToolTip.Tip="{Binding PlaytimeLabel}"
                         Source="{Binding IconPath, Converter={StaticResource IconPath}}" />
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                           Theme="{StaticResource InlineEdit}"
                           KeyDown="OnRenameKey"
                           ToolTip.Tip="{loc:T RenameTip}" />

                  <!-- What this account is doing. One line, never
                       collapsed, so a launch does not push the rows below. -->
                  <TextBlock Text="{Binding StatusLine}" Classes="muted"
                             Foreground="{Binding StatusLineBrushKey, Converter={StaticResource KeyToBrush}}"
                             FontSize="{DynamicResource FontTiny}" Margin="5,1,0,0"
                             MinHeight="13" />
                </StackPanel>

                <!-- The buttons alone tell the instance's state. -->
                <Panel Grid.Column="6" Margin="8,0,0,0"
                       IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}">

                  <ContentControl Theme="{StaticResource BusyIndicator}"
                                  Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  IsVisible="{Binding IsBusy}" />

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                              IsVisible="{Binding !IsBusy}">

                    <!-- The phone draws this game smaller than its display,
                         by Android's game mode. -->
                    <Panel Margin="0,0,4,0" VerticalAlignment="Center"
                           IsVisible="{Binding HasReducedRender}">
                      <ToggleButton Name="ReducedRender" Theme="{StaticResource RowChipToggle}"
                                    Foreground="{DynamicResource WarningBrush}"
                                    IsChecked="{Binding IsReducedRenderOpen, Mode=TwoWay}"
                                    ToolTip.Tip="{loc:T ReducedRenderTip}">
                        <Path Width="13" Height="13" Stretch="None"
                              VerticalAlignment="Center" StrokeJoin="Round" StrokeThickness="1.3"
                              Stroke="{DynamicResource WarningBrush}"
                              Data="M 6.5,2 L 12.5,11.5 H 0.5 Z M 6.5,5.5 V 8 M 6.5,9.6 V 10.1" />
                      </ToggleButton>

                      <Popup IsOpen="{Binding IsReducedRenderOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
                             Placement="BottomEdgeAlignedRight" PlacementTarget="{Binding #ReducedRender}">
                        <Border Classes="bubble" Margin="0,4,0,0" Padding="12,10">
                          <StackPanel Width="300">
                            <TextBlock Text="{Binding ReducedRenderHeading}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:T ReducedRenderExplain}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSmall}" />
                            <!-- Already standard and still reduced: the
                                 button would only go round in circles. -->
                            <StackPanel IsVisible="{Binding !StandardDidNotHelp}">
                              <Button Content="{loc:T RestoreStandardMode}" Theme="{StaticResource PrimaryButton}"
                                      HorizontalAlignment="Left" Margin="0,10,0,4"
                                      Command="{Binding RestoreStandardModeCommand}" />
                              <TextBlock Text="{loc:T RestoreStandardModeNote}" TextWrapping="Wrap"
                                         FontSize="{DynamicResource FontSmall}"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{loc:T StandardDidNotHelp}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{DynamicResource FontSmall}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       IsVisible="{Binding StandardDidNotHelp}" />
                            <TextBlock Text="{loc:T ReducedRenderManual}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{DynamicResource FontSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Button Theme="{StaticResource LinkButton}" Content="{loc:T StopReducedRenderWarning}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    FontSize="{DynamicResource FontSmall}"
                                    Command="{Binding StopReducedRenderWarningCommand}" />
                          </StackPanel>
                        </Border>
                      </Popup>
                    </Panel>

                    <!-- This account's own settings behind a single chip:
                         colour, quality, zoom distance. -->
                    <Panel Margin="0,0,4,0" VerticalAlignment="Center">
                      <Button Theme="{StaticResource RowChip}"
                              ToolTip.Tip="{loc:T InstanceSettingsTip}">
                        <StackPanel Orientation="Horizontal">
                          <!-- A label only where this account departs from
                               the shared setting, before the glyph so the
                               glyph stays in line. -->
                          <TextBlock Text="{Binding QualityLabel}" Margin="0,0,4,0"
                                     VerticalAlignment="Center" TextWrapping="NoWrap"
                                     IsVisible="{Binding QualityLabel, Converter={StaticResource EmptyToVisibility}, ConverterParameter=inverse}" />

                          <TextBlock Text="{Binding ZoomLabel}" Margin="0,0,4,0"
                                     VerticalAlignment="Center" TextWrapping="NoWrap"
                                     IsVisible="{Binding ZoomLabel, Converter={StaticResource EmptyToVisibility}, ConverterParameter=inverse}" />

                          <!-- Two sliders: the settings of one thing. -->
                          <Path Width="13" Height="13" Stretch="None" VerticalAlignment="Center"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeThickness="1.3" StrokeLineCap="Round"
                                Data="M 1.5,4.5 H 11.5 M 1.5,9.5 H 11.5 M 4.3,4.5 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0 M 8.7,9.5 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0" />
                        </StackPanel>

                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="bare">
                            <Border Classes="bubble" Margin="0,4,0,0" Padding="4">
                              <StackPanel MinWidth="170">
                                <TextBlock Text="{loc:T ColourHeading}" Classes="section" Margin="8,2,0,4" />

                                <!-- Two rows of six: the vivid tones above,
                                     each light tone under its own. -->
                                <WrapPanel Margin="6,0,0,4" MaxWidth="156">
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintA}"
                                          ToolTip.Tip="{loc:T ColourTeal}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Teal}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Teal}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintB}"
                                          ToolTip.Tip="{loc:T ColourMoss}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Moss}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Moss}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintC}"
                                          ToolTip.Tip="{loc:T ColourBrass}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Brass}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Brass}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintD}"
                                          ToolTip.Tip="{loc:T ColourIndigo}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Indigo}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Indigo}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintE}"
                                          ToolTip.Tip="{loc:T ColourOrchid}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Orchid}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Orchid}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintF}"
                                          ToolTip.Tip="{loc:T ColourRose}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Rose}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Rose}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintG}"
                                          ToolTip.Tip="{loc:T ColourAqua}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Aqua}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Aqua}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintH}"
                                          ToolTip.Tip="{loc:T ColourLime}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Lime}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Lime}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintI}"
                                          ToolTip.Tip="{loc:T ColourHoney}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Honey}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Honey}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintJ}"
                                          ToolTip.Tip="{loc:T ColourPeriwinkle}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Periwinkle}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Periwinkle}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintK}"
                                          ToolTip.Tip="{loc:T ColourLilac}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Lilac}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Lilac}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                  <Button Theme="{StaticResource ColourSwatch}" Background="{DynamicResource AccountTintL}"
                                          ToolTip.Tip="{loc:T ColourBlush}"
                                          Command="{Binding PickColourCommand}" CommandParameter="{x:Static s:AccountColour.Blush}">
                                    <Panel Opacity="{Binding Colour, Converter={StaticResource EqualToOpacity}, ConverterParameter={x:Static s:AccountColour.Blush}}">
                                      <Border Margin="3" CornerRadius="1" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
                                      <Border Margin="4.5" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1" />
                                    </Panel>
                                  </Button>
                                </WrapPanel>

                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ColourNone}"
                                        Command="{Binding ClearColourCommand}" />

                                <ContentControl Theme="{StaticResource Groove}" Margin="0,6" />

                                <TextBlock Text="{loc:T QualityHeading}" Classes="section" Margin="8,0,0,4" />

                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityFollowShared}"
                                        Command="{Binding FollowSharedQualityCommand}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityLowShort}"
                                        Command="{Binding PickQualityCommand}"
                                        CommandParameter="{x:Static s:StreamQuality.Low}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityMediumShort}"
                                        Command="{Binding PickQualityCommand}"
                                        CommandParameter="{x:Static s:StreamQuality.Medium}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityElevatedShort}"
                                        Command="{Binding PickQualityCommand}"
                                        CommandParameter="{x:Static s:StreamQuality.Elevated}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityMaximumShort}"
                                        Command="{Binding PickQualityCommand}"
                                        CommandParameter="{x:Static s:StreamQuality.Maximum}" />

                                <ContentControl Theme="{StaticResource Groove}" Margin="0,6" />

                                <TextBlock Text="{loc:T GameDistanceHeading}" Classes="section" Margin="8,0,0,4" />

                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T QualityFollowShared}"
                                        Command="{Binding FollowSharedZoomCommand}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ZoomVeryFar}"
                                        Command="{Binding PickZoomCommand}"
                                        CommandParameter="{x:Static s:GameZoom.Widest}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ZoomFar}"
                                        Command="{Binding PickZoomCommand}"
                                        CommandParameter="{x:Static s:GameZoom.Wide}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ZoomSlightlyFar}"
                                        Command="{Binding PickZoomCommand}"
                                        CommandParameter="{x:Static s:GameZoom.SlightlyWide}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ZoomNormal}"
                                        Command="{Binding PickZoomCommand}"
                                        CommandParameter="{x:Static s:GameZoom.Normal}" />
                                <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="{loc:T ZoomClose}"
                                        Command="{Binding PickZoomCommand}"
                                        CommandParameter="{x:Static s:GameZoom.Close}" />

                                <ContentControl Theme="{StaticResource Groove}" Margin="0,6" />

                                <!-- The PC screen's ratio by default; the
                                     phone's for devices drawn wrong at it. -->
                                <CheckBox Margin="8,2,8,4"
                                          IsChecked="{Binding PhoneFormat}"
                                          ToolTip.Tip="{loc:T PhoneFormatTip}">
                                  <TextBlock Text="{loc:T PhoneFormat}" TextWrapping="Wrap" MaxWidth="220" />
                                </CheckBox>

                                <!-- Android's game mode, known once the
                                     window opened in this run. -->
                                <StackPanel IsVisible="{Binding HasGameModeChoice}">
                                  <ContentControl Theme="{StaticResource Groove}" Margin="0,6" />

                                  <TextBlock Text="{loc:T GameModeHeading}" Classes="section" Margin="8,0,0,4" />

                                  <ItemsControl Name="GameModes" ItemsSource="{Binding GameModeChoices}"
                                                ToolTip.Tip="{loc:T GameModeNote}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:GameModeChoice">
                                        <Button Theme="{StaticResource QuietButton}" Padding="8,5"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Content="{Binding Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:InstanceRowViewModel)DataContext).PickGameModeCommand}"
                                                CommandParameter="{Binding Mode}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>

                                <!-- Only to undo "Don't warn me again". -->
                                <CheckBox Margin="8,2,8,4" IsChecked="{Binding QuietReducedRender}"
                                          IsVisible="{Binding QuietReducedRender}">
                                  <TextBlock Text="{loc:T QuietReducedRender}" TextWrapping="Wrap" MaxWidth="220" />
                                </CheckBox>
                              </StackPanel>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                      </Button>

                      <!-- The open window still runs with the old zoom. -->
                      <Ellipse Width="6" Height="6" Margin="0,-2,-2,0"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Fill="{DynamicResource WarningBrush}"
                               ToolTip.Tip="{loc:T InstanceZoomWaitsForReopen}"
                               IsVisible="{Binding ZoomWaitsForReopen}" />
                    </Panel>

                    <!-- Restart and the bin share one slot: restart only
                         while the window is open, the bin only while it is
                         closed. Restart keeps its slot when hidden. -->
                    <Panel>
                      <Button Theme="{StaticResource IconButton}"
                              ToolTip.Tip="{loc:T RestartTip}"
                              Opacity="{Binding IsRunning, Converter={StaticResource BoolToOpacity}}"
                              IsHitTestVisible="{Binding IsRunning}"
                              Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).RestartCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="rowGlyph"
                              Data="M 13,7.5 A 5.5,5.5 0 1 1 11.1,3.3 M 13,1.5 V 4.2 H 10.3" />
                      </Button>

                      <!-- Only on a row added from the plus button, while
                           its window is closed. -->
                      <Button Theme="{StaticResource DangerIconButton}"
                              ToolTip.Tip="{loc:T RemoveAppTip}"
                              Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).RemoveAppCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="rowGlyph binGlyph" />
                        <Button.IsVisible>
                          <MultiBinding Converter="{StaticResource AllTrue}">
                            <Binding Path="IsShownApp" />
                            <Binding Path="!IsRunning" />
                          </MultiBinding>
                        </Button.IsVisible>
                      </Button>
                    </Panel>

                    <!-- The row's action, always in the same place: a solid
                         triangle and a solid square, the same button
                         answering to the state. -->
                    <Panel>
                      <Button Theme="{StaticResource RowActionButton}"
                              ToolTip.Tip="{loc:T OpenInstanceTip}"
                              IsVisible="{Binding !IsRunning}"
                              Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).LaunchInstanceCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="M 4,2.5 L 12.5,7.5 L 4,12.5 Z"
                              Fill="{Binding $parent[Button].Foreground}"
                              Width="15" Height="15" Stretch="None" />
                      </Button>

                      <Button Theme="{StaticResource RowActionButton}"
                              ToolTip.Tip="{loc:T CloseWindowTip}"
                              IsVisible="{Binding IsRunning}"
                              Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).StopCommand}"
                              CommandParameter="{Binding}">
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{Binding $parent[Button].Foreground}" />
                      </Button>
                    </Panel>
                  </StackPanel>
                </Panel>
              </Grid>

              <Border Classes="dropLine"
                      Opacity="{Binding DropBelow, Converter={StaticResource BoolToOpacity}}"
                      IsVisible="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).IsReordering}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Devices with no instance at all: offline, or reachable but
         without the game. -->
    <ItemsControl Margin="0,6,0,4" ItemsSource="{Binding InactiveDevices}"
                  IsVisible="{Binding HasInactiveDevices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceGroupViewModel">
          <Grid Margin="0,2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

            <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="1"
                    Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Classes="deviceHeader" />

              <!-- A missing game cannot be guessed; offline, the grey dot
                   is enough in the ordinary list. -->
              <TextBlock Text="{Binding StatusText}" Classes="muted"
                         FontSize="{DynamicResource FontTiny}" Margin="8,1,0,0"
                         Foreground="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}"
                         ToolTip.Tip="{Binding StatusTip}">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{StaticResource AnyTrue}">
                    <Binding Path="HasNoGame" />
                    <Binding Path="$parent[views:InstanceListControl].ShowDeviceStatus" />
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- The same plus as on a row: a phone without the game can
                   still show its other apps. -->
              <Button Theme="{StaticResource IconButton}"
                      ToolTip.Tip="{loc:T AddAppTip}"
                      Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).ManageAppsCommand}"
                      CommandParameter="{Binding}">
                <Path Data="M 7.5,3 L 7.5,12 M 3,7.5 L 12,7.5"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" />
                <Button.IsVisible>
                  <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="$parent[views:InstanceListControl].ShowActions" />
                    <Binding Path="HasNoGame" />
                  </MultiBinding>
                </Button.IsVisible>
              </Button>

              <Button Theme="{StaticResource DangerIconButton}"
                      ToolTip.Tip="{loc:T ForgetDeviceShortTip}"
                      IsVisible="{Binding $parent[views:InstanceListControl].ShowActions}"
                      Command="{Binding $parent[views:InstanceListControl].((vm:InstanceListViewModel)DataContext).ForgetDeviceCommand}"
                      CommandParameter="{Binding}">
                <Path Classes="rowGlyph binGlyph" />
              </Button>
            </StackPanel>

            <!-- Where to fix it, on the only device where the refusal was
                 observed. -->
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted"
                       FontSize="{DynamicResource FontTiny}" Margin="0,1,0,2"
                       Text="{loc:T ToPairAgainHow}"
                       Foreground="{DynamicResource WarningBrush}"
                       IsVisible="{Binding NeedsPairing}" />

            <!-- Where to look, on a phone that has stopped answering. -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                        Margin="0,1,0,2"
                        IsVisible="{Binding ShowsOfflineHelp}">
              <TextBlock Text="{Binding OfflineHow}" Classes="muted"
                         FontSize="{DynamicResource FontTiny}" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding StatusTip}" />

              <Button Theme="{StaticResource LinkButton}" Content="{loc:T Help}"
                      Margin="6,0,0,0" VerticalAlignment="Center"
                      FontSize="{DynamicResource FontTiny}"
                      ToolTip.Tip="{loc:T HelpTip}" Click="OnDeviceHelp" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The first scan looks for remembered phones, and a phone that is
         off makes it wait. A word is better than emptiness. -->
    <Border Classes="card" Padding="10,8" Margin="0,12,0,0"
            IsVisible="{Binding ShowsSearching}">
      <StackPanel Orientation="Horizontal">
        <ContentControl Theme="{StaticResource Spinner}" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Text="{loc:T SearchingDevices}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- No device at all: the list says why it is empty. -->
    <Border Classes="card" Padding="10,8"
            IsVisible="{Binding ShowsNoDeviceCard}">
      <StackPanel>
        <TextBlock Text="{loc:T NoDeviceFound}" Classes="section" />
        <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}"
                   Text="{Binding NoDeviceHelp}" />
      </StackPanel>
    </Border>

    <!-- One finding per row, truncated, with the full text on hover. -->
    <Grid Margin="2,0,0,4" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Background="Transparent"
          ToolTip.Tip="{Binding Problem}"
          IsVisible="{Binding Problem, Converter={StaticResource EmptyToVisibility}, ConverterParameter=inverse}">

      <Path Grid.Column="0" Width="13" Height="13" Stretch="None" Margin="0,1,5,0"
            VerticalAlignment="Top" StrokeJoin="Round" StrokeThickness="1.3"
            Classes="problem" Classes.serious="{Binding ProblemIsSerious}"
            Data="M 6.5,2 L 12.5,11.5 H 0.5 Z M 6.5,5.5 V 8 M 6.5,9.6 V 10.1" />

      <TextBlock Grid.Column="1" Text="{Binding Problem}"
                 FontSize="{DynamicResource FontSmall}"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"
                 Classes="problem" Classes.serious="{Binding ProblemIsSerious}" />

      <!-- On its own row so the failure's text keeps the full width. -->
      <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,2,0,0"
              Theme="{StaticResource LinkButton}" Content="{loc:T OpenLogFolder}"
              Command="{Binding OpenLogsCommand}"
              IsVisible="{Binding ActionFailed}" />
    </Grid>

  </StackPanel>
</UserControl>
