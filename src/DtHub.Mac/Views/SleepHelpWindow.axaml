<!-- The PC's battery help (src/DtHub.App/Windows/SleepHelpWindow.xaml), on
     the same view model: how to keep Android from putting the game, or a
     tool, to sleep. -->
<Window x:Class="DtHub.Mac.Views.SleepHelpWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DtHub.Mac.Localization"
        xmlns:vm="using:DtHub.App.ViewModels"
        xmlns:g="using:DtHub.Core.Guidance"
        xmlns:views="using:DtHub.Mac.Views"
        x:DataType="vm:SleepHelpViewModel"
        Title="{loc:T PreventSleep}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        FontSize="{DynamicResource FontMedium}"
        Foreground="{DynamicResource TextBrush}">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Classes="title" Text="{Binding Heading}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" Margin="0,6,0,0" Text="{Binding Explanation}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="g:PhoneBrand">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Classes="muted" Margin="0,0,0,14" Text="{loc:T FrenchLabelsNotice}" />

        <Border Classes="card">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{Binding OpenStep}" TextWrapping="Wrap" />
            <views:MenuPathControl Path="{Binding BatteryPath}" Margin="0,2,0,4" />
            <TextBlock Classes="muted">
              <Run Text="{loc:T SettingCalledPrefix}" /><Run Text="{Binding Brand.BatteryFeature, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{loc:T SettingCalledSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RemoveRestrictions}" />
            <TextBlock Classes="muted" Text="{Binding RemoveHelp}" />
          </StackPanel>
        </Border>

        <!-- What this brand needs on top, when it needs something. -->
        <Border Classes="card" IsVisible="{Binding HasNote}">
          <TextBlock Classes="muted" Text="{Binding Brand.BatteryNote}" />
        </Border>

        <Border Classes="card" IsVisible="{Binding !IsTool}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RepeatForEachCopy}" />
            <TextBlock Classes="muted" Text="{loc:T RepeatForEachCopyHelp}" />
          </StackPanel>
        </Border>

        <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Margin="2,0,0,4"
                   Text="{Binding FrozenHelp}" />

        <!-- Under the steps, never on the alert line: hiding the alert
             means having seen where the setting would be. -->
        <Border Classes="card" Margin="0,10,0,0" IsVisible="{Binding CanMute}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T MuteBatteryAlertHeader}" />
            <TextBlock Classes="muted" Margin="0,0,0,8" Text="{Binding MuteNote}" />
            <Button Theme="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="12,6"
                    Content="{loc:T MuteBatteryAlert}" Click="OnMute" />
          </StackPanel>
        </Border>

        <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,10,0,0"
                Content="{loc:T UnmuteBatteryAlerts}" Click="OnUnmute"
                IsVisible="{Binding HasMuted}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
