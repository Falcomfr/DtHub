<!-- The PC's tab strip (src/DtHub.App/Windows/TabbedGameWindow.xaml) as a
     window of its own: on the Mac the game windows cannot be housed inside
     it, so it sits right above them instead. Below the strip, the waiting
     view, shown only while the selected tab has lost its phone. -->
<Window x:Class="DtHub.App.Windows.TabbedGameWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DtHub.Mac.Localization"
        xmlns:vm="using:DtHub.App.ViewModels"
        xmlns:win="using:DtHub.App.Windows"
        x:DataType="vm:GameTabViewModel"
        WindowDecorations="None"
        CanResize="False"
        MinWidth="480"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
  <DockPanel>
    <Border Name="Strip" DockPanel.Dock="Top" Height="34" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnStripPressed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Margin="0,0,6,0"
                VerticalAlignment="Center" ToolTip.Tip="{loc:T Close}" Click="OnCloseAll">
          <Path Classes="rowGlyph" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
        </Button>
        <!-- What the PC's title bar carries and this borderless strip has
             nowhere else to show: the phone's state and the shortcuts. -->
        <TextBlock Name="Hint" DockPanel.Dock="Right" Classes="muted" FontSize="{DynamicResource FontSmall}"
                   VerticalAlignment="Center" Margin="8,0,8,0" MaxWidth="360"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <ItemsControl Name="Tabs" Margin="4,4,4,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTabViewModel">
              <!-- The two gutters frame the tab at all times, even empty:
                   showing them on hover would shift the strip as one aims.
                   The whole cell is where a dragged tab is dropped. -->
              <Grid Classes="dropSurface" Background="Transparent" ColumnDefinitions="4,Auto,4">
                <Border Grid.Column="0" Width="2" Margin="1,4,1,4" CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" IsVisible="{Binding DropBefore}" />
                <!-- Not focusable, as on the PC: clicking a tab must not take
                     the keyboard from the game. -->
                <RadioButton Grid.Column="1" Theme="{StaticResource Tab}" GroupName="GameTabs"
                             Focusable="False" IsChecked="{Binding IsSelected}"
                             ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="4" CornerRadius="2" Margin="0,2,7,2" IsVisible="{Binding HasColour}"
                            Background="{Binding ColourBrushKey, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Classes="muted"
                               FontSize="{DynamicResource FontTiny}"
                               Text="{Binding AccountKey}"
                               IsVisible="{Binding AccountKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Image Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                           Source="{Binding IconPath, Converter={StaticResource IconPath}}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.85" />
                    <Button Theme="{StaticResource IconButton}" Margin="4,0,0,0" Focusable="False"
                            ToolTip.Tip="{loc:T Close}" Click="OnTabClose">
                      <Path Classes="rowGlyph" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
                    </Button>
                  </StackPanel>
                </RadioButton>
                <!-- The selected tab's underline in its account's colour, over
                     the accent one; an account without a colour keeps the
                     accent. -->
                <Border Grid.Column="1" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                        Background="{Binding ColourBrushKey, Converter={StaticResource KeyToBrush}}">
                  <Border.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="IsSelected" />
                      <Binding Path="HasColour" />
                    </MultiBinding>
                  </Border.IsVisible>
                </Border>
                <Border Grid.Column="2" Width="2" Margin="1,4,1,4" CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" IsVisible="{Binding DropAfter}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
    <win:WaitingPhoneView Name="Waiting" IsVisible="False" />
  </DockPanel>
</Window>
