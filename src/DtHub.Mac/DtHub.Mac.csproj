<Project Sdk="Microsoft.NET.Sdk">
  <!-- The macOS front-end. It builds on Windows too, so the CI keeps it
       from rotting, but only src/DtHub.App is ever shipped from there.
       See docs/macos.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DtHub.Mac</RootNamespace>
    <AssemblyName>DtHub.Mac</AssemblyName>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en;fr;es</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
    <ProjectReference Include="..\DtHub.Infrastructure\DtHub.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
