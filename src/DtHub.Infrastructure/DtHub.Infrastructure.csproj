<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DtHub.Infrastructure</RootNamespace>
    <AssemblyName>DtHub.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dependencies manifest is embedded: the CI and the runtime
         share exactly the same file. -->
    <EmbeddedResource Include="..\..\build\dependencies.json" LogicalName="DtHub.Infrastructure.dependencies.json" />

    <!-- Quest -> achievement map recorded from papycha by
         build/extract-successes.py. Embedded rather than read on each
         indexing pass: the achievement is only readable in the intro
         block of each quest, which costs thirteen megabytes, for
         information that only changes when the game is updated. -->
    <EmbeddedResource Include="..\..\assets\quest-successes.json" LogicalName="DtHub.Infrastructure.quest-successes.json" />
  </ItemGroup>

</Project>
