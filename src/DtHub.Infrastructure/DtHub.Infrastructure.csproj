<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DtHub.Infrastructure</RootNamespace>
    <AssemblyName>DtHub.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dependencies manifest is embedded: the CI and the runtime
         share exactly the same file. -->
    <EmbeddedResource Include="..\..\build\dependencies.json" LogicalName="DtHub.Infrastructure.dependencies.json" />

    <!-- The quest catalog as DT Hub indexed it on 2026-10-11, the last read
         through wp/v2. The base a new player starts from before the public
         API is merged over it. Embedded with Papycha's authorization, see
         THIRD-PARTY-NOTICES.md. -->
    <EmbeddedResource Include="..\..\assets\papycha-catalog.json" LogicalName="DtHub.Infrastructure.papycha-catalog.json" />

    <!-- Which game ids answer which Papycha page: numbers only, no game
         text. Regenerated by build/touch-ids/touch_ids.py. -->
    <EmbeddedResource Include="..\..\assets\dofus-touch-ids.json" LogicalName="DtHub.Infrastructure.dofus-touch-ids.json" />

    <!-- SDL patched so that a window docked in a tab receives text input.
         See third_party/sdl/MODIFICATIONS.md. -->
    <EmbeddedResource Include="..\..\third_party\sdl\SDL3.dll" LogicalName="DtHub.Infrastructure.SDL3.dll" />
  </ItemGroup>

</Project>
