<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!--
    DPI awareness, monitor by monitor.

    Without this manifest, Windows treats the application as aware of
    only the main monitor's scale factor: on a machine with two monitors
    set to different scale factors, it automatically resizes windows
    moved to the second one, which turn blurry. The placement of the
    game windows already queries GetDpiForMonitor and stayed correct; it
    was the rendering of our own windows that suffered.

    PerMonitorV2 rather than PerMonitor: it is the one that extends
    scaling to dialog boxes and to non-client frames.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>

  <!--
    Windows versions declared compatible. The real baseline is Windows 10
    1809, required by WebView2 and by .NET 10; declaring them stops
    Windows from applying compatibility shims for older versions.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
