<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <RootNamespace>DtHub.App</RootNamespace>
    <AssemblyName>DtHub</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ce filtre est là pour que les paquets tiers ne sèment pas leurs
         traductions à côté de l'exécutable. Il vaut aussi pour les nôtres :
         omettre « fr » et « es » les supprimerait sans rien dire. -->
    <SatelliteResourceLanguages>en;fr;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- La publication ne doit rendre qu'un fichier : c'est ce qu'on donne à
       l'utilisateur, et six fichiers traînaient à côté, trois de symboles et
       trois de documentation d'un paquet tiers.

       Les symboles sont embarqués plutôt que supprimés : un fichier de moins,
       et les journaux gardent leurs numéros de ligne, ce qu'ils perdraient
       avec « none ». -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- L'image de marque est embarquée comme ressource pour être adressable
         par URI depuis le XAML. -->
    <Resource Include="..\..\assets\app.png" Link="assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le pont est embarqué : il doit suivre l'exécutable, pas traîner à côté. -->
    <EmbeddedResource Include="Assets\quest-bridge.js" LogicalName="DtHub.App.quest-bridge.js" />
    <EmbeddedResource Include="Assets\papycha-report.js" LogicalName="DtHub.App.papycha-report.js" />
  </ItemGroup>

  <!-- Ces trois-là ne se voient nulle part si elles disparaissent : le pont et
       la sonde ne sont lus qu'à l'ouverture d'un guide, et l'icône qu'au
       premier lancement de scrcpy. Une ligne retirée par mégarde ne se serait
       vue que chez la personne qui a téléchargé l'application. -->
  <!-- Après la compilation XAML et non avant : WPF rejoue le projet dans une
       copie temporaire qui ne porte pas les mêmes items, et le contrôle y
       tombait à faux. -->
  <Target Name="ControlerLesRessourcesEmbarquees" BeforeTargets="Build"
          Condition="'$(_TargetAssemblyProjectName)' == ''">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'DtHub.App.quest-bridge.js'))' == ''"
           Text="Le pont des guides n'est plus embarqué : quest-bridge.js manque aux EmbeddedResource." />
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'DtHub.App.papycha-report.js'))' == ''"
           Text="La sonde de signalement n'est plus embarquée : papycha-report.js manque aux EmbeddedResource." />
    <Error Condition="'@(Resource->WithMetadataValue('Link', 'assets\app.png'))' == ''"
           Text="L'icône donnée à scrcpy n'est plus embarquée : app.png manque aux Resource." />

    <!-- Le filtre plus haut supprime les traductions « sans rien dire », et
         rien dans le binaire publié ne permet de s'en apercevoir : le
         deps.json embarqué cite les satellites même quand ils ont été
         écartés. Le contrôle se fait donc ici, sur la propriété elle-même. -->
    <Error Condition="!$(SatelliteResourceLanguages.Contains('fr')) or !$(SatelliteResourceLanguages.Contains('es'))"
           Text="SatelliteResourceLanguages vaut « $(SatelliteResourceLanguages) » : les traductions fr et es ne seraient pas publiées." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
    <ProjectReference Include="..\DtHub.Infrastructure\DtHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
