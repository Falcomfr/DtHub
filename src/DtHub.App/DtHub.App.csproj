<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <RootNamespace>DtHub.App</RootNamespace>
    <AssemblyName>DtHub</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <!-- This filter is here so third-party packages do not scatter their
         translations next to the executable. It also applies to our own:
         omitting "fr" and "es" would drop them without a word. -->
    <SatelliteResourceLanguages>en;fr;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The publish must produce only one file: that is what we hand to the
       user, and six files used to trail alongside it, three of symbols and
       three of documentation from a third-party package.

       Symbols are embedded rather than dropped: one file fewer, and the
       logs keep their line numbers, which they would lose with
       "none". -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- The brand image is embedded as a resource so it can be addressed
         by URI from the XAML. -->
    <Resource Include="..\..\assets\app.png" Link="assets\app.png" />

    <!-- The papycha.fr logo, used with their agreement. See
         THIRD-PARTY-NOTICES.md: it is not covered by the MIT licence. -->
    <Resource Include="..\..\assets\papycha.png" Link="assets\papycha.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bridge is embedded: it must travel with the executable, not
         trail alongside it. -->
    <EmbeddedResource Include="Assets\quest-bridge.js" LogicalName="DtHub.App.quest-bridge.js" />
    <EmbeddedResource Include="Assets\papycha-report.js" LogicalName="DtHub.App.papycha-report.js" />
    <EmbeddedResource Include="Assets\almanax-bridge.js" LogicalName="DtHub.App.almanax-bridge.js" />
  </ItemGroup>

  <!-- These three show up nowhere if they disappear: the bridge and the
       probe are only read when a guide opens, and the icon only on
       scrcpy's first launch. A line dropped by mistake would only have
       shown up for the person who downloaded the application. -->
  <!-- After the XAML compilation and not before: WPF replays the project
       in a temporary copy that does not carry the same items, and the
       check used to misfire there. -->
  <Target Name="ControlerLesRessourcesEmbarquees" BeforeTargets="Build"
          Condition="'$(_TargetAssemblyProjectName)' == ''">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'DtHub.App.quest-bridge.js'))' == ''"
           Text="The guide bridge is no longer embedded: quest-bridge.js is missing from EmbeddedResource." />
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'DtHub.App.papycha-report.js'))' == ''"
           Text="The report probe is no longer embedded: papycha-report.js is missing from EmbeddedResource." />
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'DtHub.App.almanax-bridge.js'))' == ''"
           Text="The Almanax bridge is no longer embedded: almanax-bridge.js is missing from EmbeddedResource." />
    <Error Condition="'@(Resource->WithMetadataValue('Link', 'assets\app.png'))' == ''"
           Text="The icon handed to scrcpy is no longer embedded: app.png is missing from Resource." />
    <Error Condition="'@(Resource->WithMetadataValue('Link', 'assets\papycha.png'))' == ''"
           Text="The guide logo is no longer embedded: papycha.png is missing from Resource." />

    <!-- The filter above drops the translations "without a word", and
         nothing in the published binary lets you notice it: the embedded
         deps.json cites the satellites even when they have been left
         out. The check is therefore done here, on the property itself. -->
    <Error Condition="!$(SatelliteResourceLanguages.Contains('fr')) or !$(SatelliteResourceLanguages.Contains('es'))"
           Text="SatelliteResourceLanguages is &quot;$(SatelliteResourceLanguages)&quot;: the fr and es translations would not be published." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
    <ProjectReference Include="..\DtHub.Infrastructure\DtHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
