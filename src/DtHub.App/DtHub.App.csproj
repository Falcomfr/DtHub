<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <RootNamespace>DtHub.App</RootNamespace>
    <AssemblyName>DtHub</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- L'image de marque est embarquée comme ressource pour être adressable
         par URI depuis le XAML. -->
    <Resource Include="..\..\assets\app.png" Link="assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le pont est embarqué : il doit suivre l'exécutable, pas traîner à côté. -->
    <EmbeddedResource Include="Assets\quest-bridge.js" LogicalName="DtHub.App.quest-bridge.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DtHub.Core\DtHub.Core.csproj" />
    <ProjectReference Include="..\DtHub.Infrastructure\DtHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
