<Window x:Class="DtHub.App.Windows.ProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Width="640" SizeToContent="Height"
        MinWidth="560" MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <StackPanel Margin="20">

    <!-- What failed, in plain language. The previous dialog only showed a
         folder path: the exception message, which says what happened,
         never reached the screen. -->
    <TextBlock x:Name="Headline" FontSize="{StaticResource FontLarge}" FontWeight="SemiBold"
               TextWrapping="Wrap" Margin="0,0,0,10"
               Foreground="{DynamicResource TextBrush}" />

    <TextBlock x:Name="Detail" Style="{StaticResource Muted}"
               TextWrapping="Wrap" Margin="0,0,0,14" />

    <TextBlock Text="{loc:T ReportContents}" Style="{StaticResource Muted}"
               FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" Margin="0,0,0,12" />

    <!-- The report itself, collapsed. We don't ask anyone to send text
         they cannot read. -->
    <Expander Header="{loc:T ShowTheReport}" Margin="0,0,0,14">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource Radius}"
              Padding="10,8" Margin="0,8,0,0">
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
          <TextBox x:Name="Report" IsReadOnly="True" BorderThickness="0"
                   Background="Transparent" FontSize="{StaticResource FontSmall}"
                   FontFamily="{StaticResource MonoFont}"
                   TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                   Foreground="{DynamicResource TextMutedBrush}" />
        </ScrollViewer>
      </Border>
    </Expander>

    <TextBlock x:Name="Copied" Text="{loc:T ReportCopied}" Style="{StaticResource Muted}"
               FontSize="{StaticResource FontSmall}" Margin="0,0,0,8" Visibility="Collapsed"
               Foreground="{DynamicResource SuccessBrush}" />

    <!-- Four buttons, two of them with long names: they wrap onto a new
         line rather than getting cut off. -->
    <WrapPanel HorizontalAlignment="Right">
      <Button Content="{loc:T OpenLogFolder}" Style="{StaticResource QuietButton}"
              Padding="12,6" Margin="0,0,8,4" Click="OnOpenLogs" />

      <Button Content="{loc:T ReportProblem}" Style="{StaticResource QuietButton}"
              Padding="12,6" Margin="0,0,8,4" Click="OnReport"
              ToolTip="{loc:T ReportProblemTip}" />

      <Button Content="{loc:T CopyReport}" Padding="14,6" Margin="0,0,8,4"
              IsDefault="True" Click="OnCopy" />

      <Button Content="{loc:T Close}" Style="{StaticResource QuietButton}"
              Padding="12,6" Margin="0,0,0,4" IsCancel="True" />
    </WrapPanel>
  </StackPanel>
</Window>
