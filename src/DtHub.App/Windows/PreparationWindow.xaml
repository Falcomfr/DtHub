<Window x:Class="DtHub.App.Windows.PreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="{loc:T PreparationTitle}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <StackPanel Margin="20">

    <TextBlock Text="{loc:T PreparationTitle}" Style="{StaticResource Title}" />
    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14"
               Text="{loc:T PreparationLead}" />

    <!-- One block per missing component, and nothing for those already
         in place: on subsequent launches this window does not appear
         at all. -->
    <ItemsControl x:Name="Rows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontMedium}"
                           FontFamily="{StaticResource UiFont}"
                           Foreground="{DynamicResource TextBrush}" />
                <!-- The source is named: it states what is being downloaded and from where. -->
                <TextBlock Text="{Binding Host}" HorizontalAlignment="Right"
                           Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />
              </Grid>

              <ProgressBar Height="3" Margin="0,9,0,0"
                           Minimum="0" Maximum="1"
                           Value="{Binding Fraction, Mode=OneWay}"
                           IsIndeterminate="{Binding IsBusy}"
                           Background="{DynamicResource SurfaceAltBrush}"
                           BorderThickness="0"
                           Foreground="{DynamicResource AccentBrush}" />

              <TextBlock Margin="0,7,0,0" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                         Text="{Binding Status}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="Footer" Style="{StaticResource Muted}" Margin="0,6,0,0"
               Text="{loc:T PreparationChecksum}" />

    <!-- Shown only when something has failed. The application knows how
         to live without these tools: "Continue without" is not an
         admission, it is an exit. -->
    <WrapPanel x:Name="Choices" HorizontalAlignment="Right" Margin="0,14,0,0"
               Visibility="Collapsed">
      <Button Content="{loc:T PreparationRetry}" Click="OnRetry"
              MinWidth="110" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
      <Button Content="{loc:T PreparationSkip}" Click="OnSkip" MinWidth="110"
              IsCancel="True" />
    </WrapPanel>
  </StackPanel>
</Window>
