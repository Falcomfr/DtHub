<Window x:Class="DtHub.App.Windows.InputHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="{loc:T DeadInputTitle}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T DeadInputTitle}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{loc:T DeadInputExplanation}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="{loc:T FrenchLabelsNotice}" />

        <!-- Le test passe avant les remèdes : il dit lequel est le bon, et
             évite d'en essayer trois au hasard. -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T DeadInputTest}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T DeadInputTestHelp}" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="{loc:T DeadInputTest}" MinWidth="150"
                      Command="{Binding TestCommand}"
                      IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
              <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                         Text="{loc:T DeadInputTestRunning}"
                         Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Le verdict qui désigne la cause se distingue des deux autres :
                 c'est le seul sur lequel il y a quelque chose à faire. -->
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding Verdict}"
                       Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding VerdictIsRefusal}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- La cause principale, et de loin. Le sous-titre du réglage est
             recopié tel quel : c'est lui qui permet de le reconnaître à
             l'écran, son intitulé variant d'une surcouche à l'autre. -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T DeadInputSecuritySetting}" />
            <w:MenuPathControl Path="{Binding Brand.DeveloperOptionsPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T DeadInputSecurityHelp}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding Brand.Warning}"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T DeadInputCable}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T DeadInputCableHelp}" />
          </StackPanel>
        </Border>

        <!-- Le remède que le terrain donne le plus souvent après le réglage
             lui-même, et qui manquait ici : deux personnes du salon d'entraide
             concurrent le donnent l'une après l'autre, et c'est lui qui a
             débloqué le cas rapporté. Il vient donc avant la bascule du mode
             développeur, qui produit le même effet par un chemin plus long. -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T DeadInputRevoke}" />
            <w:MenuPathControl Path="{Binding Brand.DeveloperOptionsPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T DeadInputRevokeHelp}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T DeadInputToggleDeveloper}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T DeadInputToggleDeveloperHelp}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
