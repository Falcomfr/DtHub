<Window x:Class="DtHub.App.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <StackPanel Margin="20">
    <TextBlock x:Name="Question" Style="{StaticResource Muted}" TextWrapping="Wrap"
               Margin="0,0,0,10" />

    <!-- What the action will remember, when the caller has something to
         tell about it. A question alone does not say so: "under what
         name" does not warn that positions and settings are saved too.
         Collapsed as long as nothing fills this text in. -->
    <Border x:Name="DetailsBox" Visibility="Collapsed"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource Radius}"
            Padding="12,10" Margin="0,0,0,12">
      <TextBlock x:Name="Details" Style="{StaticResource Muted}"
                 TextWrapping="Wrap" LineHeight="18" />
    </Border>

    <!-- The field takes focus on opening: this is where you come to type,
         and clicking into the box first would be one gesture too many. -->
    <TextBox x:Name="Entry" FontSize="{StaticResource FontLarge}" MaxLength="40"
             KeyDown="OnEntryKeyDown" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:T Cancel}" Style="{StaticResource QuietButton}" Padding="14,6"
              Margin="0,0,8,0" IsCancel="True" />
      <Button x:Name="Accept" Content="{loc:T Save}" Padding="14,6"
              IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
