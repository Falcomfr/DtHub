<Window x:Class="DtHub.App.Windows.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="{Binding Title}"
        Width="540" Height="680" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- Two things behind one plus sign, kept apart on purpose. Showing an
       application installs nothing; cloning the game creates an Android
       profile. Each has its own card, its own sentence saying what it
       does to the phone, and its own button: nothing in one can be read
       as the other. -->
  <DockPanel Margin="20">

    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Title}"
               Margin="0,0,0,14" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="{loc:T Cancel}" Style="{StaticResource QuietButton}" Padding="14,6"
              Margin="0,0,8,0" IsCancel="True" />
      <Button Content="{loc:T Save}" Padding="14,6" IsDefault="True" Click="OnSave"
              IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
    </StackPanel>

    <!-- The clone, below the list and apart from it: it is the rarer
         gesture, and the one that changes the phone. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,6"
                Style="{StaticResource OutlineButton}"
                Content="{loc:T AppPickerCloneButton}" Click="OnClone" />
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T AppPickerCloneHeader}" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="{loc:T AppPickerCloneHelp}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T AppPickerShowHeader}" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="{loc:T AppPickerShowHelp}" />

          <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                     Margin="0,0,0,3" Text="{loc:T AppPickerSearch}" />
          <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,0,8" />

          <CheckBox Content="{loc:T AppPickerSystemApps}" IsChecked="{Binding ShowSystemApps}"
                    Margin="0,0,0,8" />
        </StackPanel>

        <!-- The three states that are not a list: asking the phone, the
             phone gone, and a filter that leaves nothing. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
          <Control Style="{StaticResource Spinner}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Style="{StaticResource Muted}" Text="{loc:T AppPickerLoading}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="0,4,0,4" Text="{Binding Problem}"
                   Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,4,0,4"
                   Text="{loc:T AppPickerEmpty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding View}">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,8,0,4"
                               Text="{Binding Name}"
                               Visibility="{Binding Name, Converter={StaticResource EmptyToVisibility},
                                                    ConverterParameter=inverse}" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChosen}" Margin="0,3,0,3"
                          ToolTip="{Binding PackageName}">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Label, Mode=OneWay}" />
                    <Run Text="{Binding PackageName, Mode=OneWay}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="{StaticResource FontSmall}" />
                  </TextBlock>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </DockPanel>
</Window>
