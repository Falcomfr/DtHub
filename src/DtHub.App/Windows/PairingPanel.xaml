<UserControl x:Class="DtHub.App.Windows.PairingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Association Wi-Fi. Le panneau surveille le réseau et remplit ce qu'il
       peut : seul le code à six chiffres reste à saisir. -->
  <Border Style="{StaticResource Card}">
    <StackPanel>

      <TextBlock Text="AUCUN TÉLÉPHONE CONNECTÉ" Style="{StaticResource SectionLabel}" />

      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                 Text="Branchez un câble USB avec le débogage activé : le téléphone apparaîtra tout seul. Sinon, associez-le en Wi-Fi." />

      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                 Text="1.  Paramètres &gt; À propos, appuyez sept fois sur « Numéro de build »." />
      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                 Text="2.  Options pour les développeurs, activez « Débogage sans fil »." />
      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                 Text="3.  Appuyez sur « Associer l'appareil avec un code d'association »." />

      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10"
              Visibility="{Binding HasCandidate, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource AccentBrush}"
                   Text="Téléphone repéré sur le réseau, adresse et port remplis. Saisissez seulement le code." />
      </Border>

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Adresse IP" Style="{StaticResource Muted}" Margin="2,0,0,3" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Style="{StaticResource Muted}" Margin="2,0,0,3" />
        <TextBlock Grid.Row="0" Grid.Column="4" Text="Code" Style="{StaticResource Muted}" Margin="2,0,0,3" />

        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>

      <StackPanel Orientation="Horizontal">
        <Button Content="Associer" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                Command="{Binding PairCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <Button Content="Déjà associé, connecter" Command="{Binding ConnectCommand}"
                ToolTip="Utilisez le port affiché sous « Débogage sans fil », différent du port d'association."
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                 Visibility="{Binding Status, Converter={StaticResource EmptyToVisibility},
                                      ConverterParameter=inverse}" />

    </StackPanel>
  </Border>
</UserControl>
