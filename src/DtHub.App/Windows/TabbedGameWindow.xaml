<Window x:Class="DtHub.App.Windows.TabbedGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1400" Height="900" MinWidth="480" MinHeight="320"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- La barre d'onglets, au-dessus de la zone de jeu et jamais dessus :
         une fenêtre native se dessine par-dessus tout élément WPF du même
         châssis, et un onglet posé sur l'image serait invisible.

         La barre entière reçoit les dépôts : lâcher après le dernier onglet
         range en fin de liste, là où il fallait viser un onglet. -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            AllowDrop="True" DragOver="OnStripDragOver" Drop="OnStripDrop"
            DragLeave="OnStripDragLeave">
      <ItemsControl x:Name="Tabs" Margin="4,4,4,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Les deux gouttières encadrent l'onglet en permanence, même
                 vides : les faire paraître au survol décalerait toute la barre
                 de trois pixels au moment précis où l'on vise. -->
            <Grid Background="Transparent" AllowDrop="True"
                  DragOver="OnTabDragOver" Drop="OnTabDrop" DragLeave="OnTabDragLeave">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Width="2" Margin="1,4,1,4" CornerRadius="1"
                      Background="{DynamicResource AccentBrush}"
                      Visibility="{Binding DropBefore,
                                           Converter={StaticResource BoolToVisibility}}" />

              <!-- Focusable="False" : cliquer un onglet ne doit pas prendre le focus
                   clavier au jeu logé. Rien dans ce cadre ne se saisit au
                   clavier, et Ctrl+Tab suffit à changer d'onglet sans souris. -->
              <RadioButton Grid.Column="1" Style="{StaticResource Tab}" GroupName="Onglets"
                           Focusable="False"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           ToolTip="{Binding Title}"
                           PreviewMouseLeftButtonDown="OnTabPressed"
                           PreviewMouseMove="OnTabMoved">
                <StackPanel Orientation="Horizontal">
                  <!-- The account's own mark, the same bar the row wears
                       in the panel, so the two surfaces teach one shape.

                       The bar marks every tab, selected or not, which is
                       what a multi-account player needs; the active tab's
                       underline takes the colour too, further down.

                       Opacity and not visibility, so an unmarked account
                       indents like a marked one. -->
                  <Border Width="4" CornerRadius="2" Margin="0,2,7,2"
                          VerticalAlignment="Stretch"
                          Background="{Binding ColourBrushKey, Converter={StaticResource KeyToBrush}}"
                          Opacity="{Binding HasColour, Converter={StaticResource BoolToOpacity}}" />

                  <Image Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Source="{Binding IconPath, Converter={StaticResource IconPath}}" />
                  <!-- A touch quieter than the panel's text: with no wash
                       behind it any more, full white read "un poil trop
                       visible". -->
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.85" />
                </StackPanel>
              </RadioButton>

              <!-- The active tab's underline in its account's colour, laid
                   over the accent one; an account without a colour keeps the
                   accent. The tab used to be washed with the colour as well:
                   at 0.45 the title read poorly, and even lighter it was too
                   much colour, so the bar and this underline mark it alone. -->
              <Border Grid.Column="1" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                      Background="{Binding ColourBrushKey, Converter={StaticResource KeyToBrush}}">
                <Border.Visibility>
                  <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="IsSelected" />
                    <Binding Path="HasColour" />
                  </MultiBinding>
                </Border.Visibility>
              </Border>

              <Border Grid.Column="2" Width="2" Margin="1,4,1,4" CornerRadius="1"
                      Background="{DynamicResource AccentBrush}"
                      Visibility="{Binding DropAfter,
                                           Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Zone d'accueil : volontairement vide. Les fenêtres de jeu y sont
         logées, et tout élément WPF posé ici serait caché sous elles. -->
    <Grid x:Name="Accueil" Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}"
          SizeChanged="OnHostResized" />
  </Grid>
</Window>
