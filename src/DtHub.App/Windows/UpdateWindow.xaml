<Window x:Class="DtHub.App.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="{loc:T WhatsNew}"
        Width="560" Height="620" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{Binding Lead}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <!-- La note vient du dépôt et n'est pas de nous : elle s'affiche telle
           qu'elle est écrite, sans mise en forme inventée. -->
      <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" LineHeight="19"
                 Foreground="{DynamicResource TextBrush}" />
    </ScrollViewer>
  </DockPanel>
</Window>
