<Window x:Class="DtHub.App.Windows.WebToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1280" Height="800" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}">

  <!-- A DOFUS Touch tool that is a web site, as the site shows itself: the
       map on two thirds of the screen, Calcofus narrow beside the game, the
       first time; then where each was left. -->
  <DockPanel>
    <!-- The same page in the browser, and for the map its donation page:
         a thin strip, as at the foot of the Almanax. -->
    <Border DockPanel.Dock="Bottom" Padding="10,5"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="Donate" Content="{loc:T ToolMapDonate}" Style="{StaticResource OutlineButton}"
                Padding="10,3" Margin="0,0,6,0" Visibility="Collapsed" Click="OnDonate" />
        <!-- Only on a site in another language than ours, where it takes the
             place of the untranslated page: see PageTranslation. -->
        <Button x:Name="Translate" ToolTip="{loc:T TranslateTip}"
                Style="{StaticResource OutlineButton}" Padding="10,3"
                Visibility="Collapsed" Click="OnTranslate">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:T Translate}" VerticalAlignment="Center" />
            <Path Style="{StaticResource RowGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                  Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenPage" Content="{loc:T OpenInBrowser}" Style="{StaticResource OutlineButton}"
                Padding="10,3" Click="OnOpenInBrowser" />
      </StackPanel>
    </Border>

    <wv:WebView2 x:Name="View" />
  </DockPanel>
</Window>
