<Window x:Class="DtHub.App.Windows.CloneHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jouer à plusieurs comptes"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Plusieurs comptes sur un même appareil" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="Un compte par installation du jeu. Pour en ouvrir plusieurs, il faut donc installer le jeu une seconde fois, dans un profil séparé. La fonction existe sur la plupart des appareils, mais chaque marque l'a nommée autrement." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,14">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="1. Ouvrir la fonction" />
            <TextBlock Text="{Binding Brand.ClonePath}" Style="{StaticResource Muted}" Margin="0,0,0,3" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="Sur cet appareil, elle s'appelle «" />
              <Run Text="{Binding Brand.CloneFeature, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="»." />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="2. Y ajouter le jeu" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Choisissez DOFUS Touch dans la liste. L'appareil crée une seconde installation, avec sa propre icône et ses propres données de connexion." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="3. L'ouvrir une fois sur l'appareil" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Lancez la nouvelle icône et connectez-vous avec le second compte. Ce premier démarrage installe les données du jeu ; sans lui, le profil resterait vide." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="4. Revenir ici" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="La nouvelle instance apparaît toute seule dans la liste des appareils, sous son profil. Il n'y a rien à déclarer." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Brand.CloneNote}" Style="{StaticResource Muted}"
                     Foreground="{DynamicResource WarningBrush}" />
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,4"
                   Text="Chaque compte reste piloté séparément : un geste de votre part agit sur une fenêtre, et sur une seule." />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
