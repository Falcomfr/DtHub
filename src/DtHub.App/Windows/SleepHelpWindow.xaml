<Window x:Class="DtHub.App.Windows.SleepHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empêcher la mise en veille"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Une fenêtre se fige au bout d'un moment" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="DT Hub maintient l'écran de l'appareil allumé, mais Android endort de lui-même les applications qu'il juge inactives, et une fenêtre de jeu qui n'est pas au premier plan en fait partie. Les fenêtres se figent alors une à une, la plus ancienne d'abord. Un réglage suffit à l'empêcher, et il tient." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Les libellés ci-dessous sont ceux d'un appareil réglé en français. Sur un appareil dans une autre langue, les mots diffèrent mais les menus se suivent dans le même ordre." />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="1. Ouvrir le réglage de batterie du jeu" />
            <TextBlock Text="{Binding Brand.BatteryPath}" Style="{StaticResource Muted}" Margin="0,0,0,3"
                       TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="Sur cet appareil, le réglage à trouver s'appelle «" />
              <Run Text="{Binding Brand.BatteryFeature, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="»." />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="2. Le retirer des restrictions" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Le jeu doit pouvoir tourner en arrière-plan sans limite. C'est la seule manipulation nécessaire dans la plupart des cas, et elle survit aux redémarrages." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="3. Recommencer pour chaque copie du jeu" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Une application clonée, ou installée dans un second profil, est une application distincte aux yeux d'Android : elle a ses propres restrictions, et le réglage fait sur l'une ne vaut pas pour l'autre." />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,4" TextWrapping="Wrap"
                   Text="Une fenêtre déjà figée se répare en la relançant : le bouton « Relancer » de sa ligne redémarre le jeu sans refermer la fenêtre." />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
