<Window x:Class="DtHub.App.Windows.SleepHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="{loc:T PreventSleep}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T WindowFreezes}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{loc:T SleepExplanation}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="{loc:T FrenchLabelsNotice}" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T OpenBatterySetting}" />
            <w:MenuPathControl Path="{Binding Brand.BatteryPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="{loc:T SettingCalledPrefix}" />
              <Run Text="{Binding Brand.BatteryFeature, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="{loc:T SettingCalledSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RemoveRestrictions}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="{loc:T RemoveRestrictionsHelp}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RepeatForEachCopy}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="{loc:T RepeatForEachCopyHelp}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,4" TextWrapping="Wrap"
                   Text="{loc:T AlreadyFrozenHelp}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
