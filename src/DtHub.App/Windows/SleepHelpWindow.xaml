<Window x:Class="DtHub.App.Windows.SleepHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="{loc:T PreventSleep}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{Binding Explanation}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="{loc:T FrenchLabelsNotice}" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{Binding OpenStep}" />
            <w:MenuPathControl Path="{Binding BatteryPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="{loc:T SettingCalledPrefix}" />
              <Run Text="{Binding Brand.BatteryFeature, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="{loc:T SettingCalledSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RemoveRestrictions}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="{Binding RemoveHelp}" />
          </StackPanel>
        </Border>

        <!-- What this brand needs on top, when it needs something: Xiaomi
             closes a game left out of its recent apps, Samsung puts it back
             to sleep through its own maintenance. -->
        <Border Style="{StaticResource Card}"
                Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="{Binding Brand.BatteryNote}" />
        </Border>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsTool, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T RepeatForEachCopy}" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="{loc:T RepeatForEachCopyHelp}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" Margin="2,0,0,4" TextWrapping="Wrap"
                   Text="{Binding FrozenHelp}" />

        <!-- Under the steps, never on the alert line: hiding the alert
             means having seen where the setting would be. -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                Visibility="{Binding CanMute, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T MuteBatteryAlertHeader}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{Binding MuteNote}" />
            <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="12,6"
                    Content="{loc:T MuteBatteryAlert}" Click="OnMute" />
          </StackPanel>
        </Border>

        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,10,0,0"
                Content="{loc:T UnmuteBatteryAlerts}" Click="OnUnmute"
                Visibility="{Binding HasMuted, Converter={StaticResource BoolToVisibility}}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
