<Window x:Class="DtHub.App.Windows.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Associer un nouveau téléphone"
        Width="600" Height="680" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Associer un nouveau téléphone" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="À faire une seule fois par téléphone. Ensuite il se connectera tout seul, même si son adresse change." />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                 Text="Seuls les téléphones Android conviennent : iOS ne permet ni d'ouvrir un écran supplémentaire, ni d'installer deux fois la même application." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- Marque : elle change les chemins de menu -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="MARQUE DU TÉLÉPHONE" Style="{StaticResource SectionLabel}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Text="Les menus ne portent pas le même nom d'une marque à l'autre. Choisissez la vôtre pour avoir le bon chemin." />
            <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}"
                      DisplayMemberPath="Name" />
          </StackPanel>
        </Border>

        <!-- Marche à suivre, adaptée -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="SUR LE TÉLÉPHONE" Style="{StaticResource SectionLabel}" />

            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="1. Débloquer les options pour les développeurs" />
            <TextBlock Text="{Binding Brand.BuildNumberPath}" Style="{StaticResource Muted}" Margin="0,0,0,3" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap">
              <Run Text="Appuyez sept fois de suite sur «" />
              <Run Text="{Binding Brand.BuildNumberLabel, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="». Un message confirme que vous êtes développeur." />
            </TextBlock>

            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="2. Ouvrir les options pour les développeurs" />
            <TextBlock Text="{Binding Brand.DeveloperOptionsPath}" Style="{StaticResource Muted}" Margin="0,0,0,3" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Activez « Débogage USB » et « Débogage sans fil »." />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding Brand.Warning}" Style="{StaticResource Muted}"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>

            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="3. Par câble, le plus simple" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Branchez le câble et acceptez la demande affichée sur le téléphone. Il apparaît dans la fenêtre précédente tout seul, il n'y a rien à faire ici." />

            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="4. Sans fil, la première fois" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                       Text="Débogage sans fil  ›  Associer l'appareil avec un code d'association" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Le téléphone affiche un code à six chiffres et apparaît ci-dessous. Le téléphone et le PC doivent être sur le même réseau Wi-Fi, et Android 11 au minimum." />
          </StackPanel>
        </Border>

        <!-- Association -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="TÉLÉPHONE À ASSOCIER" Style="{StaticResource SectionLabel}" />

            <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,0,0,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="Candidate" Margin="0,3" Foreground="{DynamicResource TextBrush}"
                               Checked="OnCandidateChecked">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Text="En attente. Ouvrez « Associer l'appareil avec un code d'association » sur le téléphone : il apparaîtra ici tout seul, sans rien saisir."
                       Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility}}" />

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility},
                                             ConverterParameter=inverse}">
              <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                       Width="150" Margin="0,0,8,0" FontSize="15"
                       ToolTip="Le code à six chiffres affiché sur le téléphone" />
              <Button Content="Associer" Style="{StaticResource PrimaryButton}"
                      Command="{Binding PairCommand}" IsEnabled="{Binding CanPair}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       Visibility="{Binding Status, Converter={StaticResource EmptyToVisibility},
                                            ConverterParameter=inverse}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
