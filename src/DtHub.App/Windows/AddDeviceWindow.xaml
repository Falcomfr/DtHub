<Window x:Class="DtHub.App.Windows.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Associer un nouvel appareil"
        Width="520" Height="420" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Associer un nouvel appareil" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="Sur l'appareil, ouvrez « Associer l'appareil avec un code d'association ». Il apparaîtra ci-dessous." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="Aide" MinWidth="90" Click="OnHelp"
                ToolTip="Où trouver ces réglages sur votre téléphone" />
        <Button Grid.Column="2" Content="Fermer" MinWidth="110" Click="OnClose" />
      </Grid>
    </Border>

    <StackPanel>

      <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,0,0,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="Candidate" Margin="0,4" Foreground="{DynamicResource TextBrush}"
                         Checked="OnCandidateChecked">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}"
              Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility}}">
        <TextBlock Style="{StaticResource Muted}"
                   Text="En attente d'un appareil. La liste se remplit toute seule dès que l'écran d'association est ouvert sur l'appareil." />
      </Border>

      <StackPanel Orientation="Horizontal"
                  Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
        <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                 Width="150" Margin="0,0,8,0" FontSize="15"
                 ToolTip="Le code à six chiffres affiché sur l'appareil" />
        <Button Content="Associer" Style="{StaticResource PrimaryButton}"
                Command="{Binding PairCommand}" IsEnabled="{Binding CanPair}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="2,12,0,0"
                 Visibility="{Binding Status, Converter={StaticResource EmptyToVisibility},
                                      ConverterParameter=inverse}" />

    </StackPanel>

  </DockPanel>
</Window>
