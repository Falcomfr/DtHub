<Window x:Class="DtHub.App.Windows.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="{loc:T PairDevice}"
        Width="520" Height="420" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T PairDevice}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{loc:T PairCodeIntro}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="{loc:T Help}" MinWidth="90" Click="OnHelp"
                ToolTip="{loc:T HelpTip}" />
        <Button Grid.Column="2" Content="{loc:T Close}" MinWidth="110" Click="OnClose" />
      </Grid>
    </Border>

    <StackPanel>

      <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,0,0,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="Candidate" Margin="0,4" Foreground="{DynamicResource TextBrush}"
                         Checked="OnCandidateChecked">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}"
              Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility}}">
        <TextBlock Style="{StaticResource Muted}"
                   Text="{loc:T WaitingForDevice}" />
      </Border>

      <StackPanel Orientation="Horizontal"
                  Visibility="{Binding Candidates.Count, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
        <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                 Width="150" Margin="0,0,8,0" FontSize="15"
                 ToolTip="{loc:T PairingCodeTip}" />
        <Button Content="{loc:T Pair}" Style="{StaticResource PrimaryButton}"
                Command="{Binding PairCommand}" IsEnabled="{Binding CanPair}" />
      </StackPanel>

      <!-- Le port ne se demande que lorsqu'il manque, c'est-à-dire quand le
           réseau n'a rien annoncé. L'appairage est alors déjà acquis : il n'y a
           rien à refaire, rien qu'à lire un nombre sur le téléphone. -->
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                  Visibility="{Binding NeedsPort, Converter={StaticResource BoolToVisibility}}">
        <TextBox Text="{Binding ConnectPort, UpdateSourceTrigger=PropertyChanged}"
                 Width="150" Margin="0,0,8,0" FontSize="15"
                 ToolTip="{loc:T PortTip}" />
        <Button Content="{loc:T Connect}" Style="{StaticResource PrimaryButton}"
                Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="2,12,0,0"
                 Visibility="{Binding Status, Converter={StaticResource EmptyToVisibility},
                                      ConverterParameter=inverse}" />

    </StackPanel>

  </DockPanel>
</Window>
