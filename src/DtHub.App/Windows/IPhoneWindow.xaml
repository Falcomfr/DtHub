<Window x:Class="DtHub.App.Windows.IPhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="{loc:T IPhoneTitle}"
        Width="520" Height="460" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T IPhoneTitle}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                 Text="{loc:T IPhoneIntro}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="RefreshButton" Grid.Column="0" Content="{loc:T IPhoneRefresh}" MinWidth="110"
                Click="OnRefresh" />
        <Button Grid.Column="2" Content="{loc:T Close}" MinWidth="110" Click="OnClose" IsCancel="True" />
      </Grid>
    </Border>

    <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Rows" />
    </ScrollViewer>
  </DockPanel>
</Window>
