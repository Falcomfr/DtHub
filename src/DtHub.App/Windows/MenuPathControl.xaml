<UserControl x:Class="DtHub.App.Windows.MenuPathControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- Le chemin de menu, montré comme la suite d'écrans qu'il décrit. Chaque
       écran porte son nom en titre et, sur l'une de ses lignes, le vrai libellé
       de ce qu'on y touche. Les autres lignes restent muettes : inventer le
       reste du menu montrerait ce que la fiche de marque ne dit pas. -->
  <ItemsControl x:Name="Ecrans" Focusable="False">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,9">

          <!-- L'écran du téléphone : fond sombre, coins arrondis, barre d'état
               en haut. Ce sont ces trois marques qui le font reconnaître d'un
               coup d'oeil pour ce qu'il est. -->
          <Border Width="164" CornerRadius="11" BorderThickness="1"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>

              <!-- La barre d'état. Rien n'y est écrit : l'heure et le niveau
                   de batterie seraient inventés, et la silhouette suffit. -->
              <Grid Margin="10,7,10,0" Height="7">
                <Border Width="17" Height="5" CornerRadius="2"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Border Width="6" Height="5" CornerRadius="1" Margin="0,0,3,0"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                  <Border Width="6" Height="5" CornerRadius="1" Margin="0,0,3,0"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                  <Border Width="10" Height="5" CornerRadius="1"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                </StackPanel>
              </Grid>

              <!-- La flèche de retour et le grand titre, comme les réglages
                   d'Android les posent depuis leur douzième version. Le titre
                   est, avec la ligne à toucher, le seul texte de l'écran :
                   c'est ce qu'on cherche des yeux. -->
              <TextBlock Text="&#x2190;" FontSize="13" Margin="11,7,0,0"
                         Foreground="{DynamicResource TextMutedBrush}" />

              <TextBlock Text="{Binding Titre}" FontSize="13" FontWeight="SemiBold"
                         Margin="11,3,11,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextBrush}" />

              <!-- La liste, dans sa carte : Android groupe ses réglages dans
                   un pavé arrondi plus clair que la page. -->
              <Border CornerRadius="9" Margin="7,9,7,8" Padding="0,4"
                      Background="{DynamicResource SurfaceAltBrush}">
                <ItemsControl ItemsSource="{Binding Lignes}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- La hauteur suit le texte : un libellé tronqué ne
                           montrerait pas ce qu'on cherche, et c'est tout
                           l'objet du dessin. -->
                      <Grid MinHeight="25">

                        <!-- Le fond de la ligne à toucher. Il court sur toute
                             la ligne, icône comprise : c'est ainsi qu'un
                             réglage se montre désigné. -->
                        <Border CornerRadius="7" Margin="4,1"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Visibility="{Binding EstCelleQuOnTouche,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <Grid Margin="9,4,8,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- L'icône. Chaque réglage en porte une, et c'est
                               ce qui distingue une liste de réglages de
                               n'importe quelle autre liste. La sienne reste
                               muette : la fiche de marque ne dit pas laquelle. -->
                          <Border Grid.Column="0" Width="15" Height="15" CornerRadius="5"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Background="{DynamicResource BevelBrush}" Opacity="0.45"
                                  Visibility="{Binding EstCelleQuOnTouche,
                                                       Converter={StaticResource InverseBoolToVisibility}}" />

                          <Border Grid.Column="0" Width="15" Height="15" CornerRadius="5"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Background="{DynamicResource AccentBrush}"
                                  Visibility="{Binding EstCelleQuOnTouche,
                                                       Converter={StaticResource BoolToVisibility}}" />

                          <!-- Une ligne muette : une barre, rien de plus.
                               Inventer le reste du menu montrerait ce que la
                               fiche de marque ne dit pas. -->
                          <Border Grid.Column="1" Height="6" CornerRadius="2"
                                  Margin="0,0,10,0" Width="{Binding Largeur}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{DynamicResource BevelBrush}" Opacity="0.4"
                                  Visibility="{Binding EstCelleQuOnTouche,
                                                       Converter={StaticResource InverseBoolToVisibility}}" />

                          <TextBlock Grid.Column="1" Text="{Binding Libelle}" FontSize="10"
                                     TextWrapping="Wrap" VerticalAlignment="Center"
                                     Margin="0,0,6,0"
                                     Foreground="{DynamicResource TextBrush}"
                                     Visibility="{Binding EstCelleQuOnTouche,
                                                          Converter={StaticResource BoolToVisibility}}" />

                          <!-- Le chevron court sur toutes les lignes : c'est
                               ce que fait la vraie liste, et le réserver à une
                               seule trahirait le dessin. -->
                          <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="11"
                                     Margin="0,-1,0,0" VerticalAlignment="Center"
                                     Opacity="0.5"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     Visibility="{Binding EstCelleQuOnTouche,
                                                          Converter={StaticResource InverseBoolToVisibility}}" />

                          <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="11"
                                     Margin="0,-1,0,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Visibility="{Binding EstCelleQuOnTouche,
                                                          Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <!-- Le chevron ne suit pas le dernier écran : il n'y a plus rien
               après, et le tracer laisserait croire à une étape manquante. -->
          <TextBlock Text="&#x203A;" FontSize="16" Margin="6,52,6,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding SuitQuelqueChose,
                                          Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
