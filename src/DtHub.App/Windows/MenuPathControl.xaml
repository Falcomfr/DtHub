<UserControl x:Class="DtHub.App.Windows.MenuPathControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- Le chemin de menu, montré comme la suite d'écrans qu'il décrit. Chaque
       écran porte la ligne à toucher, surlignée à une hauteur tirée du libellé
       lui-même : le dessin est ainsi le même à chaque ouverture. -->
  <ItemsControl x:Name="Ecrans" Focusable="False">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

          <StackPanel Width="86" Margin="0,2,0,6">

            <!-- L'écran : un cadre, cinq lignes de liste, dont une surlignée. -->
            <Border Width="56" Height="76" CornerRadius="6" BorderThickness="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
              <ItemsControl ItemsSource="{Binding Lignes}" Margin="6,7,6,7" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Height="6" CornerRadius="2" Margin="0,0,0,4">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource BevelBrush}" />
                          <Setter Property="Opacity" Value="0.45" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EstSurlignee}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock Text="{Binding Libelle}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="10" Margin="0,5,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>

          <!-- Le chevron ne suit pas le dernier écran : il n'y a plus rien
               après, et le tracer laisserait croire à une étape manquante. -->
          <TextBlock Text="›" FontSize="15" Margin="0,26,0,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding SuitQuelqueChose,
                                          Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
