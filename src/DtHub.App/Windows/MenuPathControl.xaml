<UserControl x:Class="DtHub.App.Windows.MenuPathControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <!-- The menu path, shown as the sequence of screens it describes. Each
       screen carries its name as a title and, on one of its rows, the
       real label of what you tap there. The other rows stay blank:
       making up the rest of the menu would show what the brand sheet
       does not say. -->
  <ItemsControl x:Name="Ecrans" Focusable="False">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,9">

          <!-- The phone screen: dark background, rounded corners, status
               bar on top. These three marks are what make it
               recognisable at a glance for what it is. -->
          <Border Width="164" CornerRadius="11" BorderThickness="1"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>

              <!-- The status bar. Nothing is written on it: the time and
                   battery level would be made up, and the silhouette
                   is enough. -->
              <Grid Margin="10,7,10,0" Height="7">
                <Border Width="17" Height="5" CornerRadius="2"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Border Width="6" Height="5" CornerRadius="1" Margin="0,0,3,0"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                  <Border Width="6" Height="5" CornerRadius="1" Margin="0,0,3,0"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                  <Border Width="10" Height="5" CornerRadius="1"
                          Background="{DynamicResource BevelBrush}" Opacity="0.55" />
                </StackPanel>
              </Grid>

              <!-- The back arrow and the large title, the way Android's
                   settings have laid them out since its twelfth
                   version. The title is, along with the row to tap,
                   the only text on the screen: it's what the eye
                   looks for. -->
              <TextBlock Text="&#x2190;" FontSize="13" Margin="11,7,0,0"
                         Foreground="{DynamicResource TextMutedBrush}" />

              <TextBlock Text="{Binding Titre}" FontSize="13" FontWeight="SemiBold"
                         Margin="11,3,11,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextBrush}" />

              <!-- The list, in its card: Android groups its settings in a
                   rounded block lighter than the page. -->
              <Border CornerRadius="9" Margin="7,9,7,8" Padding="0,4"
                      Background="{DynamicResource SurfaceAltBrush}">
                <ItemsControl ItemsSource="{Binding Lignes}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- The height follows the text: a truncated label
                           would not show what you're looking for, and
                           that's the whole point of the drawing. -->
                      <Grid MinHeight="25">

                        <!-- The background of the row to tap. It runs across
                             the whole row, icon included: that's how a
                             setting is shown as designated. -->
                        <Border CornerRadius="7" Margin="4,1"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Visibility="{Binding EstCelleQuOnTouche,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <Grid Margin="9,4,8,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- The dot. Android files its settings behind
                               coloured icons, and that's what
                               distinguishes a settings list from any
                               other list. The artwork it carries stays
                               blank: the brand sheet doesn't say which
                               one. -->
                          <Border Grid.Column="0" Width="16" Height="16" CornerRadius="5"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Background="{Binding Teinte,
                                                       Converter={StaticResource KeyToBrush}}"
                                  Visibility="{Binding EstCelleQuOnTouche,
                                                       Converter={StaticResource InverseBoolToVisibility}}" />

                          <Border Grid.Column="0" Width="16" Height="16" CornerRadius="5"
                                  Margin="0,0,7,0" VerticalAlignment="Center"
                                  Background="{DynamicResource AccentBrush}"
                                  Visibility="{Binding EstCelleQuOnTouche,
                                                       Converter={StaticResource BoolToVisibility}}" />

                          <!-- A blank row: one bar, and sometimes a shorter
                               second one, like settings that state
                               their status under their name. Making up
                               the text would show what the sheet
                               doesn't say. -->
                          <StackPanel Grid.Column="1" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding EstCelleQuOnTouche,
                                                           Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Height="6" CornerRadius="2" Width="{Binding Largeur}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource BevelBrush}" Opacity="0.45" />

                            <Border Height="4" CornerRadius="2" Margin="0,4,0,0"
                                    Width="{Binding LargeurSousTitre}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource BevelBrush}" Opacity="0.28"
                                    Visibility="{Binding AvecSousTitre,
                                                         Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>

                          <TextBlock Grid.Column="1" Text="{Binding Libelle}" FontSize="10"
                                     TextWrapping="Wrap" VerticalAlignment="Center"
                                     Margin="0,0,6,0"
                                     Foreground="{DynamicResource TextBrush}"
                                     Visibility="{Binding EstCelleQuOnTouche,
                                                          Converter={StaticResource BoolToVisibility}}" />

                          <!-- On the right, what the row carries: a chevron
                               when it leads elsewhere, a switch when
                               it toggles something. A list with
                               nothing but chevrons would not look like
                               any settings screen. -->
                          <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="&#x203A;" FontSize="11" Margin="0,-1,0,0"
                                       Opacity="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding AvecChevron,
                                                            Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="&#x203A;" FontSize="11" Margin="0,-1,0,0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding EstCelleQuOnTouche,
                                                            Converter={StaticResource BoolToVisibility}}" />
                          </Grid>

                          <!-- The switch, at rest: that's the state in which
                               you find a setting you haven't touched
                               yet. -->
                          <Border Grid.Column="2" Width="18" Height="10" CornerRadius="5"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource BevelBrush}" Opacity="0.5"
                                  Visibility="{Binding AvecInterrupteur,
                                                       Converter={StaticResource BoolToVisibility}}">
                            <Border Width="6" Height="6" CornerRadius="3" Margin="2,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource TextMutedBrush}" />
                          </Border>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <!-- The chevron doesn't follow the last screen: there's nothing
               after it, and drawing it would suggest a missing step. -->
          <TextBlock Text="&#x203A;" FontSize="16" Margin="6,52,6,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding SuitQuelqueChose,
                                          Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
