<Window x:Class="DtHub.App.Windows.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:T Guides}"
        PreviewMouseDown="OnWindowPressed"
        Width="520" Height="760" MinWidth="380" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- No WindowStyle="None" or AllowsTransparency here, unlike the
       configurator: a WebView2 is a native surface and does not render
       inside a transparent window. Windows' chrome is the price to pay
       for seeing the page. -->

  <DockPanel>

    <!-- Search bar -->
    <Border DockPanel.Dock="Top" Padding="10,8"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <!-- The field takes up the full width: the quest count that used
             to cut into it didn't say anything worth reading twice. -->
        <Grid>
          <!-- The right padding is wider than the others: it reserves
               room for the cross, which sits above the field. It's set
               to half the width wanted, since the field applies its
               padding twice - once to the text holder, once to the
               text itself. -->
          <TextBox x:Name="SearchBox" Padding="7,4,16,4"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   GotKeyboardFocus="OnSearchFocused"
                   PreviewMouseLeftButtonDown="OnSearchClicked"
                   PreviewKeyDown="OnSearchKey"
                   ToolTip="{loc:T SearchTip}"
                   Tag="{loc:T QuestSearchPlaceholder}" />

          <!-- Inside the field, not next to it: a cross placed outside
               read like one of the bar's buttons, without saying what
               it was clearing. -->
          <Button Style="{StaticResource IconButton}"
                  HorizontalAlignment="Right" Margin="0,0,3,0"
                  Click="OnClearQuery"
                  ToolTip="{loc:T ClearSearchTip}"
                  Visibility="{Binding Query, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
            <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
          </Button>
        </Grid>

        <!-- Only when there's something to say: an indexing in progress,
             or an error. Nothing the rest of the time. -->
        <ProgressBar Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />
      </StackPanel>
    </Border>

    <!-- Banner for the open quest: its name, its place within the
         achievement, and the step arrows. It disappears when the list
         opens, so the list can take up the full height: you don't
         consult a step and a list at the same time. -->
    <Border DockPanel.Dock="Top" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding ShowsQuestChrome, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Going back where you came from. A curved arrow rather than
               a chevron: the chevrons on the row below point to the
               previous and next step, and two left-pointing arrows in
               the same banner wouldn't say the same thing. -->
          <Button Grid.Column="0" Style="{StaticResource IconButton}"
                  Margin="0,0,4,0" VerticalAlignment="Center"
                  Click="OnGoBackPage"
                  ToolTip="{loc:T BackToPreviousPageTip}"
                  Visibility="{Binding CanGoBackPage,
                                       Converter={StaticResource BoolToVisibility}}">
            <Path Style="{StaticResource RowGlyph}"
                  Data="M 3.5,6 L 7,2.5 M 3.5,6 L 7,9.5
                        M 3.5,6 H 9.5 C 12,6 12.5,7.6 12.5,9.6 V 12.5" />
          </Button>

          <!-- The achievement line wasn't declared as spacing, but it
               acted as one: fifteen pixels of light grey above the
               title. More than half of quests don't have one, and the
               title then ended up touching the divider, especially
               since the page below allows itself twelve pixels of
               margin. The block therefore gives back a bit of room
               when the line collapses, without pretending to replace
               missing text.

               The trigger reads the line's visibility rather than the
               string itself: it's the same notion of emptiness as the
               converter, including for a null or blank text, and the
               two cannot diverge. -->
          <StackPanel Grid.Column="1">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Visibility, ElementName=HeaderSeries}" Value="Collapsed">
                    <Setter Property="Margin" Value="0,4" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>

            <TextBlock x:Name="HeaderSeries"
                       Text="{Binding ChainText}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       Visibility="{Binding ChainText, Converter={StaticResource EmptyToVisibility},
                                            ConverterParameter=inverse}" />

            <TextBlock Text="{Binding QuestTitle}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- The steps: two arrows, the rank, and what there is to do. -->
        <Grid Margin="0,6,0,0"
              Visibility="{Binding ShowsSteps, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoPreviousStep}" Click="OnPreviousStep"
                  ToolTip="{loc:T PreviousStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12" />
          </Button>

          <Button Grid.Column="1" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoNextStep}" Click="OnNextStep"
                  ToolTip="{loc:T NextStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12" />
          </Button>

          <!-- The rank unfolds the list of steps. The two arrows only
               move one at a time: going back to the third step of a
               guide with twelve of them took nine clicks, and nothing
               said what you'd find along the way. The rank used to be
               just text, and nothing hinted there was something else
               to do here. -->
          <Grid Grid.Column="2" Margin="4,0,10,0">
            <!-- The rank in plain text when there's only one step: the
                 chip would unfold a list with a single item, which led
                 nowhere. -->
            <TextBlock VerticalAlignment="Center" Text="{Binding StepText}"
                       Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                       Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding CanPickStep,
                                            Converter={StaticResource InverseBoolToVisibility}}" />

            <ToggleButton x:Name="StepsToggle" Style="{StaticResource OutlineToggle}"
                          Padding="7,2" VerticalAlignment="Center"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ToolTip="{loc:T PickStepTip}"
                          Visibility="{Binding CanPickStep,
                                               Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StepText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                           Foreground="{DynamicResource AccentBrush}" />
                <Path Width="8" Height="5" Stretch="None" Margin="6,1,0,0"
                      VerticalAlignment="Center" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                      Data="M 0.7,0.7 L 4,4 L 7.3,0.7" />
              </StackPanel>
            </ToggleButton>

            <Popup IsOpen="{Binding IsChecked, ElementName=StepsToggle, Mode=TwoWay}" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=StepsToggle}"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}" Width="400"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="6">
                <!-- A twenty-step guide doesn't fit all at once: the list
                     scrolls rather than running off the screen. -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Padding="8,5" Margin="0,1" Click="OnPickStep">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderBrush" Value="Transparent" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Background"
                                          Value="{DynamicResource AccentSoftBrush}" />
                                  <Setter Property="BorderBrush"
                                          Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Rank}" VerticalAlignment="Top"
                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource AccentBrush}" />

                            <!-- Most often empty: only a section title is
                                 written here. The row keeps its height
                                 and its clickable area through the
                                 button's fill. -->
                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                       TextWrapping="Wrap" Style="{StaticResource Muted}"
                                       Visibility="{Binding Label,
                                           Converter={StaticResource EmptyToVisibility},
                                           ConverterParameter=inverse}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <!-- The row stays during loading so the banner doesn't jump in
               height; it used to show nothing but two greyed-out
               arrows there, which read like a broken page. It now says
               what it's waiting for. -->
          <TextBlock Grid.Column="3" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding StepDetail}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Text" Value="{Binding StepDetail}" />

                <Style.Triggers>
                  <!-- Nothing to say, nothing to show: the rank is enough
                       on its own. The visibility is set here and not on
                       the element, since a local value overrides any
                       style trigger. -->
                  <DataTrigger Binding="{Binding StepDetail}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- Last, so it wins: the waiting state is shown even
                       when the step has nothing to display. -->
                  <DataTrigger Binding="{Binding IsLoadingPage}" Value="True">
                    <Setter Property="Text" Value="{loc:T LoadingPage}" />
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </StackPanel>
    </Border>

    <!-- The source, always credited, and access to the real browser -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The credit carries the accent colour: it's the name of those
             whose work is displayed, it doesn't read as a grey
             mention. It's allowed to be truncated: the two buttons
             take priority over it in a narrow window. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/assets/papycha.png" Width="14" Height="14" Margin="0,0,5,0"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource AccentBrush}"
                     Text="{loc:T PapychaGuides}" />
        </StackPanel>

        <!-- The report button carries the accent colours, at rest and
             not only on hover: it's the action people look for in this
             bar, and a grey icon blended into the rest.

             Browser access therefore becomes an icon. Three written
             labels didn't fit together in a narrow window, and the
             credit would shrink to "Guide…": it's the name of those
             whose work is displayed, it doesn't get to be trimmed. -->
        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                Padding="9,5" FontSize="{StaticResource FontBody}"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"
                ToolTip="{loc:T ReportErrorTip}"
                Click="OnReportError">
          <StackPanel Orientation="Horizontal">
            <Path Width="15" Height="15" Stretch="None" Margin="0,0,7,0"
                  VerticalAlignment="Center" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                  Data="M 3.6,2.2 V 13.8 M 3.6,3.3 H 12.6 L 10.3,6.2 L 12.6,9.1 H 3.6" />
            <TextBlock Text="{loc:T ReportError}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                ToolTip="{loc:T OpenCurrentPageTip}"
                Click="OnOpenInBrowser">
          <Path Style="{StaticResource RowGlyph}"
                Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
        </Button>
      </Grid>
    </Border>

    <!-- The search's fallback exit, offered when you press Enter. Our
         catalogue only knows titles; the site searches within the body
         of its articles, so items, monsters and characters as well.

         On its own line, not in the credit bar: the latter already
         carries three elements, and its own comment explains what
         happens to a fourth one in a narrow window. Declared after it,
         so placed above it: a child anchored to the bottom sits above
         the previous one. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{DynamicResource AccentSoftBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowsSiteSearch, Converter={StaticResource BoolToVisibility}}">
      <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
              Padding="0" Background="Transparent" BorderThickness="0"
              ToolTip="{loc:T SearchOnSiteTip}"
              Click="OnSearchOnSite">
        <StackPanel Orientation="Horizontal">
          <Image Source="/assets/papycha.png" Width="14" Height="14" Margin="0,0,6,0"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource AccentBrush}"
                     Text="{Binding SiteSearchLabel}" />

          <!-- The same icon as the browser access in the bar below: it's
               the same action, leaving the application. -->
          <Path Style="{StaticResource RowGlyph}" Margin="7,0,0,0" VerticalAlignment="Center"
                Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
        </StackPanel>
      </Button>
    </Border>

    <!-- The achievement's sequence: where you came from, where you are,
         where you're going. These are the list's neighbours, not those
         of the prerequisite chain the site publishes at the foot of
         the article: that one jumps from one achievement to another
         and branches off. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowsChain, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                   Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   Text="{Binding ChainStep}"
                   ToolTip="{loc:T QuestInSuccessTip}"
                   Visibility="{Binding ChainStep, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <Button Grid.Column="0" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                Tag="{Binding PreviousQuest}" Click="OnFollowChain"
                ToolTip="{loc:T PreviousQuestTip}"
                Visibility="{Binding PreviousQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <!-- The series only appears when it changes: following a
               prerequisite sometimes leads into another achievement,
               or even another zone, and the title alone would suggest
               you're continuing the same sequence. -->
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                  Margin="0,0,4,0" VerticalAlignment="Center" />
            <!-- Same mechanism as at the top of the window: without a
                 series, the title used to ride up against the button's
                 edge. -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=PreviousSeries}" Value="Collapsed">
                      <Setter Property="Margin" Value="0,3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock x:Name="PreviousSeries"
                         Text="{Binding PreviousQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding PreviousQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding PreviousQuest.Title}" MaxWidth="180"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                Tag="{Binding NextQuest}" Click="OnFollowChain"
                ToolTip="{loc:T NextQuestTip}"
                Visibility="{Binding NextQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <StackPanel Orientation="Horizontal">
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=NextSeries}" Value="Collapsed">
                      <Setter Property="Margin" Value="0,3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock x:Name="NextSeries"
                         Text="{Binding NextQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis"
                         Visibility="{Binding NextQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding NextQuest.Title}" MaxWidth="180"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12"
                  Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- The page, and the drop-down list on top of it -->
    <Grid>
      <!-- The pinned prerequisites. A single panel for the whole list,
           rather than one per row: sixty rows would carry sixty of
           them, of which only one would ever be used. It closes on the
           first click elsewhere, and on the second click on the lock.

           To the left of the lock, not below it: placed below, it
           covered the following rows, and the two hundred and sixty
           pixel offset that pulled it back inside the window was a
           measurement taken once, which the panel's width contradicts
           as soon as a prerequisite is long. On the left, it lines
           itself up on the lock alone, whatever its size.

           It stays open and it's the window that closes it, on the
           first click outside the lock that opened it. Left to
           itself, it used to close on a click on that same lock, and
           the click would immediately reopen it: there was no way to
           close it from where it had been opened. Its closing,
           moreover, told no one, since the event never fired, which
           removed any way of knowing about it. -->
      <Popup x:Name="PanneauPrerequis" StaysOpen="True"
             Placement="Left" HorizontalOffset="-6" VerticalOffset="-6"
             AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" Padding="11,8">
          <StackPanel MaxWidth="330">
            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlyphNeedBrush}" />

            <ItemsControl ItemsSource="{Binding Needs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="11" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="3" Height="3"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="0,7,0,0"
                             Fill="{DynamicResource TextMutedBrush}" />

                    <!-- Only prerequisites that are quests are clickable:
                         an item to bring back or a time slot leads
                         nowhere. -->
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                            Content="{Binding Text}" Tag="{Binding Quest}"
                            Click="OnFollowNeed"
                            Visibility="{Binding IsQuest,
                                                 Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                               Foreground="{DynamicResource TextBrush}"
                               Visibility="{Binding IsQuest,
                                                    Converter={StaticResource InverseBoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- A WebView2 is a native window: it draws itself above every WPF
           element in the same frame, regardless of declaration order.
           Without this collapsing, the list opened behind the page as
           soon as a quest was loaded, which is the most common case.
           Collapsing it makes it visible; the page, meanwhile, lives
           in its own process and finds its position again on return. -->
      <wv:WebView2 x:Name="View"
                   Visibility="{Binding ShowsPage,
                                        Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Style="{StaticResource Muted}" Margin="20"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center"
                 Text="{Binding Placeholder}"
                 Visibility="{Binding HasQuest, Converter={StaticResource InverseBoolToVisibility}}" />

      <!-- The waiting indicator takes the view's place rather than
           covering it, for the reason stated above.

           At the top rather than centred: the window is thirteen
           hundred pixels tall, and a twenty-two pixel circle placed in
           its middle lands five hundred pixels below the banner, far
           from the eye, in an empty expanse that reads as a failure.
           It is therefore placed where the text is about to appear.

           Without the title underneath: the banner already carries it,
           two lines above, and it's shown there during loading. -->
      <Control Style="{StaticResource BusyIndicator}" Width="22" Height="22"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,54,0,0"
               Visibility="{Binding ShowsLoader, Converter={StaticResource BoolToVisibility}}" />

      <!-- It covers the page: the list is a choice in progress, not a
           permanent panel that would steal space from the guide. -->
      <Border VerticalAlignment="Stretch"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <!-- The breadcrumb and the close button share a line that's
               always present: the breadcrumb is empty at the root, and
               a cross lodged inside its block would have disappeared
               along with it. -->
          <Grid DockPanel.Dock="Top" Margin="10,4,4,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Breadcrumb}" />

            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                    Click="OnCloseList" ToolTip="{loc:T CloseListTip}"
                    Visibility="{Binding CanCloseList, Converter={StaticResource BoolToVisibility}}">
              <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
            </Button>
          </Grid>

          <!-- The back button is fixed and not a row of the list: it
               used to scroll with it and disappear as soon as you went
               down into a section of sixty quests. -->
          <Button DockPanel.Dock="Top" Style="{StaticResource QuietButton}"
                  HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                  Margin="1,0,0,2" Click="OnGoBack"
                  ToolTip="{loc:T GoUpOneTip}"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                    Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Back}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <ListBox x:Name="NodeList" ItemsSource="{Binding Nodes}"
                   SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="OnNodeChosen"
                   KeyDown="OnNodeKey">
            <ListBox.ItemContainerStyle>
              <!-- A subheading is not a choice: the keyboard must skip
                   over it, otherwise the arrow key stops on it and
                   Enter does nothing. -->
              <Style TargetType="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="Focusable" Value="{Binding IsEnabled}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- The gutter is fixed rather than a collapsed
                     neighbour: in a horizontal stack, a hidden element
                     doesn't reserve its space, and the labels would
                     stop lining up from one row to the next. -->
                <Grid x:Name="Ligne" Margin="0,3" Background="Transparent"
                      IsEnabled="{Binding IsEnabled}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- The divider under group titles. A solid line
                       rather than a plain gap: in a search, these
                       titles sit above achievements that are
                       themselves subheadings, and the gap alone wasn't
                       enough to tell them apart. -->
                  <Rectangle x:Name="Filet" Grid.ColumnSpan="3" Height="1"
                             VerticalAlignment="Top" Margin="0,-9,0,0"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <!-- The line that connects the quests of an
                       achievement.

                       It's this line, together with the indent, that
                       shows membership: the subheading and its quests
                       used to sit at the same indent, and a single
                       icon carried the whole distinction.

                       So that it doesn't break up from one row to the
                       next, an achievement row carries its gap on the
                       inside, on its label, rather than on the outside
                       like the others: a stroke overflowing a row's
                       margin wasn't drawn, measured at forty-five
                       pixels of line for six of gap. -->
                  <Rectangle x:Name="Trait" Grid.Column="0" Width="1"
                             HorizontalAlignment="Right" VerticalAlignment="Stretch"
                             Margin="0,-4,7,-4"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <Path x:Name="Nature" Grid.Column="0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Path.Style>
                      <Style TargetType="Path" BasedOn="{StaticResource ListGlyph}" />
                    </Path.Style>
                  </Path>

                  <TextBlock x:Name="Libelle" Grid.Column="1" Text="{Binding Label}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <!-- The key required at a dungeon's entrance. Nine
                         out of eighty-two don't require one, and
                         therefore have no icon: the absence is
                         information in itself. Its name is too long
                         for the column and comes on hover. -->
                    <Border Background="Transparent"
                            VerticalAlignment="Center" Margin="0,0,5,0"
                            ToolTip="{Binding Dungeon.Key}"
                            ToolTipService.InitialShowDelay="200"
                            Visibility="{Binding Dungeon.NeedsKey,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">
                      <Path Style="{StaticResource ListGlyph}"
                            Stroke="{DynamicResource GlyphDungeonBrush}"
                            Data="M 5.2,7.5 m -2.6,0 a 2.6,2.6 0 1 0 5.2,0
                                  a 2.6,2.6 0 1 0 -5.2,0
                                  M 7.8,7.5 H 12.8 M 10.3,7.5 V 9.8 M 12.4,7.5 V 9.3" />
                    </Border>

                    <TextBlock Text="{Binding Detail}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />

                    <!-- A lock: what keeps the quest closed. A key had
                         been tried first; its ring and its diagonal
                         shank read like a magnifying glass, a few
                         centimetres from the search field. The site
                         attributes these prerequisites to six hundred
                         and thirteen quests, against one hundred and
                         seventeen to which it attributes a level.

                         This isn't a list of quests to complete
                         beforehand: across five hundred and
                         sixty-seven distinct prerequisites, you find
                         items to bring, an alignment, a number of
                         players, a level, and even time slots. The
                         word that covers them all is "prerequisites".

                         The tooltip is carried by a container with a
                         transparent background, rather than by the
                         stroke: an open stroke has no surface, so a
                         fill gives it no purchase, and you'd have to
                         aim for a line a pixel and a half wide.
                         Measured: on the stroke alone, hovering
                         triggered nothing.

                         It stays displayed for a long time, because a
                         list of prerequisites reads more slowly than a
                         button's single word. -->
                    <Button x:Name="Cadenas" Style="{StaticResource IconButton}"
                            VerticalAlignment="Center" Margin="6,0,2,0"
                            Click="OnShowNeeds"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000"
                            Visibility="{Binding HasNeeds,
                                                 Converter={StaticResource BoolToVisibility}}">
                      <Button.ToolTip>
                        <ToolTip Style="{StaticResource RichToolTip}">
                          <StackPanel MaxWidth="330">
                            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlyphNeedBrush}" />

                            <ItemsControl ItemsSource="{Binding Needs}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="11" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="3" Height="3"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="0,7,0,0"
                                             Fill="{DynamicResource TextMutedBrush}" />

                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                                               Foreground="{DynamicResource TextBrush}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{loc:T ClickQuestsHint}" />
                          </StackPanel>
                        </ToolTip>
                      </Button.ToolTip>

                      <Path Style="{StaticResource ListGlyph}"
                            Stroke="{DynamicResource GlyphNeedBrush}"
                            Data="M 5.1,7 L 5.1,5.2 A 2.4,2.4 0 0 1 9.9,5.2 L 9.9,7
                                  M 3.7,7 L 11.3,7 L 11.3,12.9 L 3.7,12.9 Z
                                  M 7.5,9.3 L 7.5,10.8" />
                    </Button>
                  </StackPanel>
                </Grid>

                <DataTemplate.Triggers>
                  <!-- First, what the row is: a subheading is set apart
                       from what it heads, otherwise a section would
                       read as just another quest. The offset applies
                       to the whole row, otherwise the icon would sit
                       eight pixels too high.

                       The icon comes next, and is set by the row's
                       nature rather than its kind: two branches unfold
                       the same way without denoting the same thing. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontSmall}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,11,0,3" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontSmall}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,11,0,3" />
                  </DataTrigger>

                  <!-- A results group's title dominates everything else:
                       bigger, in full text colour, preceded by a
                       divider. It heads achievements that already carry
                       the blue and the semi-bold weight of subheadings. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Section">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontMedium}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,18,0,5" />
                    <Setter TargetName="Filet" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- An achievement's quest is indented and gets its
                       line. -->
                  <DataTrigger Binding="{Binding InSuccess}" Value="True">
                    <Setter TargetName="Trait" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0" />
                    <Setter TargetName="Libelle" Property="Margin" Value="9,3,0,3" />
                  </DataTrigger>

                  <!-- The break's blank space, placed on the row before
                       it. -->
                  <DataTrigger Binding="{Binding Spaced}" Value="True">
                    <Setter TargetName="Ligne" Property="Margin" Value="0,3,0,14" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Success">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphSuccessBrush}" />
                    <!-- A star: what you obtain. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,2 L 9.2,5.9 L 13.3,6.4 L 10.3,9.2 L 11.1,13.2
                                   L 7.5,11.2 L 3.9,13.2 L 4.7,9.2 L 1.7,6.4 L 5.8,5.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Place">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- A pin: a place you're going to. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,13.6 C 7.5,13.6 12.3,8.6 12.3,6.1
                                   A 4.8,4.8 0 1 0 2.7,6.1 C 2.7,8.6 7.5,13.6 7.5,13.6 Z
                                   M 7.5,6.1 m -1.7,0 a 1.7,1.7 0 1 0 3.4,0
                                   a 1.7,1.7 0 1 0 -3.4,0" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Route">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- Flat caps, unlike the rounded ones on the rest of
                         the list: a round cap overflows by three
                         quarters of a unit on each side, and it was
                         closing up the gaps in the middle line, which
                         are only two units wide. -->
                    <Setter TargetName="Nature" Property="StrokeStartLineCap" Value="Flat" />
                    <Setter TargetName="Nature" Property="StrokeEndLineCap" Value="Flat" />
                    <!-- A road in perspective: two shoulders converging,
                         a dashed centre line. The place pin used to
                         hold this spot, and a route isn't a place: it
                         joins two of them.

                         Three other drawings were built and looked at
                         before this one, and none of them held up at
                         fifteen units: a curve with one bend gave a
                         bone, a curve with two bends a chevron, a
                         dashed arrow a solid arrow, its gaps eaten by
                         the rounded caps. A signpost read fine, but it
                         pointed to a direction, not a route. What
                         remains is the road itself, made of nothing
                         but straight lines. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.2,13.6 L 5.5,2.4
                                   M 11.8,13.6 L 9.5,2.4
                                   M 7.5,12.4 V 10.2
                                   M 7.5,8.4 V 6.4
                                   M 7.5,4.6 V 3.2" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Family">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphFamilyBrush}" />
                    <!-- A bookmark: a family of quests, which sorts
                         without placing. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4,2.4 L 11,2.4 L 11,12.9 L 7.5,10.1 L 4,12.9 Z" />
                  </DataTrigger>

                  <!-- The root's four entries are drawn solid rather
                       than outlined, unlike the rest of the list: they
                       are game objects, not sorting markers, and a
                       stroke a pixel and a half wide made them look
                       faded.

                       Three of them carry the same tint: a dungeon, a
                       raid and a lair are the same kind of place, and
                       the colour states the kind while the shape
                       states which of the three. Distinguishing them
                       by tint too would have pushed the list to eight
                       colours, where six is already barely enough.

                       The holes come from the even-odd fill rule, the
                       default rule of the drawing language: an inner
                       outline punches through the one that surrounds
                       it, without having to say so. -->
                  <DataTrigger Binding="{Binding Glyph}" Value="Quests">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <!-- The neutral tint of the home screen's three other
                         rows. The scroll used to be the only one in
                         colour there, and nothing justified singling
                         out one of the four kinds where they are all
                         equal. -->
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A scroll: two pill-shaped rolls, a body, and two
                         hollowed-out lines of writing. The drawing is
                         ours; the site's own will only be reused if
                         they grant it. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.7,2.7 H 11.3 A 1.05,1.05 0 0 1 11.3,4.8
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,2.7 Z
                                   M 4.1,4.8 H 10.9 V 10.2 H 4.1 Z
                                   M 3.7,10.2 H 11.3 A 1.05,1.05 0 0 1 11.3,12.3
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,10.2 Z
                                   M 5.6,6.2 H 9.4 V 7.0 H 5.6 Z
                                   M 5.6,8.0 H 9.4 V 8.8 H 5.6 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Dungeons">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A dungeon in the literal sense: a crenellated
                         tower, its arched door and murder hole
                         hollowed out.

                         A key lying on its side had held this spot; it
                         was already saying something else. The
                         right-hand column marks with a key the
                         seventy-three dungeons that require one, and a
                         search would therefore show the same key twice
                         on a single row, on the left to say "dungeon"
                         and on the right to say "you need one".
                         Measured on "bworker". The key now means only
                         one thing. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,2.3 H 5.7 V 4.6 H 6.4 V 2.3 H 8.6 V 4.6
                                   H 9.3 V 2.3 H 11.5 V 13.1 H 3.5 Z
                                   M 6.3,13.1 V 9.9 A 1.2,1.2 0 0 1 8.7,9.9
                                   V 13.1 Z
                                   M 6.9,5.9 H 8.1 V 7.9 H 6.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Raids">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A skull: the raid is the fight that kills.

                         Two crossed swords had been drawn first, and
                         built into the application to be seen. At
                         their actual size, twenty-two pixels, the
                         guard and the pommel no longer read: all that's
                         left is a cross, a few centimetres from the one
                         that clears the search field. The skull holds
                         up because it's made of nothing but masses: a
                         skullcap, two eye sockets, a jaw. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,8 A 4,4.4 0 0 1 11.5,8 L 11.5,9.8 L 3.5,9.8 Z
                                   M 5.4,9.8 H 9.6 L 8.9,12.6 H 6.1 Z
                                   M 6,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 9,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 6.75,9.8 H 7.2 V 12.35 H 6.75 Z
                                   M 7.8,9.8 H 8.25 V 12.3 H 7.8 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Lairs">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A paw print: a lair is a beast's den, and that's
                         what sets it apart from a dungeon, built by
                         human hands. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4.35,9.9 a 3.15,2.6 0 1 0 6.3,0
                                   a 3.15,2.6 0 1 0 -6.3,0 Z
                                   M 4.25,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 8.15,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 1.6,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z
                                   M 11.1,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
