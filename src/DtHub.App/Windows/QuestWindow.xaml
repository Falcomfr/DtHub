<Window x:Class="DtHub.App.Windows.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Quêtes"
        Width="520" Height="760" MinWidth="380" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- Pas de WindowStyle="None" ni d'AllowsTransparency ici, contrairement au
       configurateur : un WebView2 est une surface native et ne se dessine pas
       dans une fenêtre transparente. Le chrome de Windows est le prix à payer
       pour voir la page. -->

  <DockPanel>

    <!-- Bandeau de recherche -->
    <Border DockPanel.Dock="Top" Padding="10,8"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" x:Name="SearchBox"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 GotKeyboardFocus="OnSearchFocused"
                 PreviewMouseLeftButtonDown="OnSearchClicked"
                 PreviewKeyDown="OnSearchKey"
                 ToolTip="Cliquez pour dérouler la liste, ou tapez un nom. Les accents ne comptent pas." />

        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Muted}" FontSize="11"
                   Text="{Binding StatusText}" />
      </Grid>
    </Border>

    <!-- Bandeau de la quête ouverte : son nom, sa place dans le succès, et
         les flèches d'étape. -->
    <Border DockPanel.Dock="Top" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding HasQuest, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding ChainText}" Style="{StaticResource Muted}" FontSize="11"
                   Visibility="{Binding ChainText, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <TextBlock Text="{Binding QuestTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <!-- Les étapes : deux flèches, le rang, et ce qu'il y a à faire. -->
        <Grid Margin="0,6,0,0"
              Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoPreviousStep}" Click="OnPreviousStep"
                  ToolTip="Étape précédente. La page se replace dessus.">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12" />
          </Button>

          <Button Grid.Column="1" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoNextStep}" Click="OnNextStep"
                  ToolTip="Étape suivante. La page se replace dessus.">
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12" />
          </Button>

          <TextBlock Grid.Column="2" Text="{Binding StepText}" VerticalAlignment="Center"
                     Margin="4,0,10,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     Foreground="{DynamicResource AccentBrush}" />

          <TextBlock Grid.Column="3" Text="{Binding StepDetail}" VerticalAlignment="Center"
                     Style="{StaticResource Muted}" FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding StepDetail}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- La source, toujours citée, et un accès au vrai navigateur -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Style="{StaticResource Muted}" FontSize="11"
                   Text="Guides de papycha.fr" />

        <Button Grid.Column="1" Content="Ouvrir dans le navigateur"
                Style="{StaticResource QuietButton}"
                ToolTip="Ouvrir la page courante dans votre navigateur habituel, sur le site d'origine"
                Click="OnOpenInBrowser" />
      </Grid>
    </Border>

    <!-- La chaîne du succès : d'où l'on vient, où l'on va. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding HasQuest, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                Tag="{Binding PreviousQuest}" Click="OnFollowChain"
                ToolTip="Revenir à la quête précédente du succès"
                Visibility="{Binding PreviousQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12" Margin="0,0,4,0" />
            <TextBlock Text="{Binding PreviousQuest.Title}" MaxWidth="180"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                Tag="{Binding NextQuest}" Click="OnFollowChain"
                ToolTip="Passer à la quête suivante du succès"
                Visibility="{Binding NextQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding NextQuest.Title}" MaxWidth="180"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12" Margin="4,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- La page, et la liste déroulante par-dessus -->
    <Grid>
      <!-- Un WebView2 est une fenêtre native : il se dessine au-dessus de tout
           élément WPF du même châssis, quel que soit l'ordre de déclaration.
           Sans ce retrait, la liste s'ouvrait derrière la page dès qu'une quête
           était chargée, c'est-à-dire dans le cas le plus courant. La replier
           la rend visible ; la page, elle, vit dans son propre processus et
           retrouve sa position au retour. -->
      <wv:WebView2 x:Name="View"
                   Visibility="{Binding IsListOpen,
                                        Converter={StaticResource InverseBoolToVisibility}}" />

      <TextBlock Style="{StaticResource Muted}" Margin="20"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center"
                 Text="{Binding Placeholder}"
                 Visibility="{Binding HasQuest, Converter={StaticResource InverseBoolToVisibility}}" />

      <!-- Elle recouvre la page : la liste est un choix en cours, pas un
           panneau permanent qui volerait de la place au guide. -->
      <Border VerticalAlignment="Stretch"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4"
                     Style="{StaticResource Muted}" FontSize="11"
                     Text="{Binding Breadcrumb}"
                     Visibility="{Binding Breadcrumb,
                                          Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />

          <ListBox x:Name="NodeList" ItemsSource="{Binding Nodes}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="OnNodeChosen"
                   KeyDown="OnNodeKey">
            <ListBox.ItemContainerStyle>
              <!-- Un intertitre n'est pas un choix : le clavier doit l'enjamber,
                   sans quoi la flèche s'arrête dessus et Entrée ne fait rien. -->
              <Style TargetType="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="Focusable" Value="{Binding IsEnabled}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" Background="Transparent" IsEnabled="{Binding IsEnabled}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- La visibilité par défaut passe par un style : posée en
                         attribut, elle serait une valeur locale, et aucun
                         déclencheur de gabarit ne peut passer devant. -->
                    <Path x:Name="Fleche" Data="M 9,3 L 5,7.5 L 9,12" Margin="0,0,6,0">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource RowGlyph}">
                          <Setter Property="Visibility" Value="Collapsed" />

                          <!-- RowGlyph prend sa couleur d'un bouton ancêtre. Il
                               n'y en a pas dans une liste : sans cette ligne, le
                               trait est peint avec une couleur nulle et la
                               flèche reste invisible. -->
                          <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
                        </Style>
                      </Path.Style>
                    </Path>

                    <TextBlock x:Name="Libelle" Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding Detail}" Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource Muted}" FontSize="11" />
                </Grid>

                <DataTemplate.Triggers>
                  <!-- Remonter d'un niveau se dit par une flèche vers la
                       gauche, comme partout ailleurs, et non par un mot. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Back">
                    <Setter TargetName="Fleche" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- L'intertitre se distingue de ce qu'il coiffe : sans cela,
                       une rubrique se lirait comme une quête de plus. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="11" />
                    <Setter TargetName="Libelle" Property="Margin" Value="0,8,0,0" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
