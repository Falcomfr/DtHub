<Window x:Class="DtHub.App.Windows.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:T Guides}"
        PreviewMouseDown="OnWindowPressed"
        Width="520" Height="760" MinWidth="380" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- Pas de WindowStyle="None" ni d'AllowsTransparency ici, contrairement au
       configurateur : un WebView2 est une surface native et ne se dessine pas
       dans une fenêtre transparente. Le chrome de Windows est le prix à payer
       pour voir la page. -->

  <DockPanel>

    <!-- Bandeau de recherche -->
    <Border DockPanel.Dock="Top" Padding="10,8"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <!-- Le champ prend toute la largeur : le compte de quêtes qui l'amputait
             ne dit rien qu'on ait envie de lire deux fois. -->
        <Grid>
          <!-- Le retrait de droite est plus large que les autres : il réserve
               la place de la croix, qui se pose par-dessus le champ. Il vaut la
               moitié de la largeur voulue, le champ appliquant son retrait deux
               fois - une fois au porte-texte, une fois au texte lui-même. -->
          <TextBox x:Name="SearchBox" Padding="7,4,16,4"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   GotKeyboardFocus="OnSearchFocused"
                   PreviewMouseLeftButtonDown="OnSearchClicked"
                   PreviewKeyDown="OnSearchKey"
                   ToolTip="{loc:T SearchTip}"
                   Tag="Cherchez une quête, une zone, un succès, un donjon ou un chemin" />

          <!-- Dans le champ et non à côté : une croix posée en dehors se lisait
               comme un bouton de la barre, sans dire ce qu'elle vidait. -->
          <Button Style="{StaticResource IconButton}"
                  HorizontalAlignment="Right" Margin="0,0,3,0"
                  Click="OnClearQuery"
                  ToolTip="{loc:T ClearSearchTip}"
                  Visibility="{Binding Query, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
            <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
          </Button>
        </Grid>

        <!-- Seulement quand il y a quelque chose à dire : une indexation en
             cours, ou un incident. Rien le reste du temps. -->
        <ProgressBar Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />
      </StackPanel>
    </Border>

    <!-- Bandeau de la quête ouverte : son nom, sa place dans le succès, et
         les flèches d'étape. Il s'efface quand la liste s'ouvre, pour qu'elle
         prenne toute la hauteur : on ne consulte pas une étape et une liste en
         même temps. -->
    <Border DockPanel.Dock="Top" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding ShowsQuestChrome, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Revenir d'où l'on vient. Une flèche courbe et non un chevron :
               les chevrons de la ligne du dessous désignent l'étape précédente
               et la suivante, et deux flèches gauche dans le même bandeau ne
               diraient pas la même chose. -->
          <Button Grid.Column="0" Style="{StaticResource IconButton}"
                  Margin="0,0,4,0" VerticalAlignment="Center"
                  Click="OnGoBackPage"
                  ToolTip="{loc:T BackToPreviousPageTip}"
                  Visibility="{Binding CanGoBackPage,
                                       Converter={StaticResource BoolToVisibility}}">
            <Path Style="{StaticResource RowGlyph}"
                  Data="M 3.5,6 L 7,2.5 M 3.5,6 L 7,9.5
                        M 3.5,6 H 9.5 C 12,6 12.5,7.6 12.5,9.6 V 12.5" />
          </Button>

          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding ChainText}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       Visibility="{Binding ChainText, Converter={StaticResource EmptyToVisibility},
                                            ConverterParameter=inverse}" />

            <TextBlock Text="{Binding QuestTitle}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- Les étapes : deux flèches, le rang, et ce qu'il y a à faire. -->
        <Grid Margin="0,6,0,0"
              Visibility="{Binding ShowsSteps, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoPreviousStep}" Click="OnPreviousStep"
                  ToolTip="{loc:T PreviousStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12" />
          </Button>

          <Button Grid.Column="1" Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoNextStep}" Click="OnNextStep"
                  ToolTip="{loc:T NextStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12" />
          </Button>

          <!-- Le rang déplie la liste des étapes. Les deux flèches n'avancent
               que d'une à la fois : revenir à la troisième d'un guide qui en
               compte douze demandait neuf clics, et rien ne disait ce qu'on
               trouverait en chemin. Le rang n'était qu'un texte, et rien ne
               laissait deviner qu'il y avait autre chose à faire ici. -->
          <Grid Grid.Column="2" Margin="4,0,10,0">
            <!-- Le rang en texte simple quand il n'y a qu'une étape : la pastille
                 y dépliait une liste d'un seul élément, qui ne menait nulle
                 part. -->
            <TextBlock VerticalAlignment="Center" Text="{Binding StepText}"
                       Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                       Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding CanPickStep,
                                            Converter={StaticResource InverseBoolToVisibility}}" />

            <ToggleButton x:Name="StepsToggle" Style="{StaticResource OutlineToggle}"
                          Padding="7,2" VerticalAlignment="Center"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ToolTip="{loc:T PickStepTip}"
                          Visibility="{Binding CanPickStep,
                                               Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StepText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                           Foreground="{DynamicResource AccentBrush}" />
                <Path Width="8" Height="5" Stretch="None" Margin="6,1,0,0"
                      VerticalAlignment="Center" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                      Data="M 0.7,0.7 L 4,4 L 7.3,0.7" />
              </StackPanel>
            </ToggleButton>

            <Popup IsOpen="{Binding IsChecked, ElementName=StepsToggle, Mode=TwoWay}" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=StepsToggle}"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}" Width="400"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="6">
                <!-- Un guide de vingt étapes ne tient pas d'un coup : la liste
                     défile plutôt que de sortir de l'écran. -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Padding="8,5" Margin="0,1" Click="OnPickStep">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderBrush" Value="Transparent" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                  <Setter Property="Background"
                                          Value="{DynamicResource AccentSoftBrush}" />
                                  <Setter Property="BorderBrush"
                                          Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Rank}" VerticalAlignment="Top"
                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource AccentBrush}" />

                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                       TextWrapping="Wrap" Style="{StaticResource Muted}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <!-- La ligne reste pendant le chargement pour que le bandeau ne
               saute pas d'une hauteur ; elle n'y montrait que deux flèches
               éteintes, ce qui se lisait comme une page cassée. Elle dit
               maintenant ce qu'elle attend. -->
          <TextBlock Grid.Column="3" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding StepDetail}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Text" Value="{Binding StepDetail}" />

                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLoadingPage}" Value="True">
                    <Setter Property="Text" Value="Chargement de la page…" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </StackPanel>
    </Border>

    <!-- La source, toujours citée, et un accès au vrai navigateur -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Le crédit porte la couleur d'accent : c'est le nom de ceux dont
             on affiche le travail, il ne se lit pas comme une mention grise.
             Il se laisse couper : les deux boutons passent avant lui dans une
             fenêtre étroite. -->
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{StaticResource FontSmall}"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource AccentBrush}"
                   Text="{loc:T PapychaGuides}" />

        <!-- Le signalement porte les couleurs de l'accent, au repos et non au
             seul survol : c'est le geste qu'on cherche dans cette barre, et un
             dessin gris s'y confondait avec le reste.

             L'accès au navigateur passe donc en icône. Trois libellés écrits ne
             tenaient pas ensemble dans une fenêtre étroite, et le crédit tombait
             à « Guide… » : c'est le nom de ceux dont on affiche le travail, il
             ne se laisse pas rogner. -->
        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                Padding="9,5" FontSize="{StaticResource FontBody}"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"
                ToolTip="{loc:T ReportErrorTip}"
                Click="OnReportError">
          <StackPanel Orientation="Horizontal">
            <Path Width="15" Height="15" Stretch="None" Margin="0,0,7,0"
                  VerticalAlignment="Center" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                  Data="M 3.6,2.2 V 13.8 M 3.6,3.3 H 12.6 L 10.3,6.2 L 12.6,9.1 H 3.6" />
            <TextBlock Text="{loc:T ReportError}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                ToolTip="{loc:T OpenCurrentPageTip}"
                Click="OnOpenInBrowser">
          <Path Style="{StaticResource RowGlyph}"
                Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
        </Button>
      </Grid>
    </Border>

    <!-- La suite du succès : d'où l'on vient, où l'on en est, où l'on va.
         Ce sont les voisines de la liste, pas celles de la chaîne de prérequis
         que le site publie en pied d'article : celle-là saute d'un succès à
         l'autre et se ramifie. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowsChain, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                   Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   Text="{Binding ChainStep}"
                   ToolTip="{loc:T QuestInSuccessTip}"
                   Visibility="{Binding ChainStep, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <Button Grid.Column="0" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                Tag="{Binding PreviousQuest}" Click="OnFollowChain"
                ToolTip="{loc:T PreviousQuestTip}"
                Visibility="{Binding PreviousQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <!-- La série n'apparaît que lorsqu'on en change : suivre un prérequis
               fait parfois entrer dans un autre succès, voire dans une autre
               zone, et le titre seul laisserait croire qu'on poursuit la même
               suite. -->
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                  Margin="0,0,4,0" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="{Binding PreviousQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding PreviousQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding PreviousQuest.Title}" MaxWidth="180"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                Tag="{Binding NextQuest}" Click="OnFollowChain"
                ToolTip="{loc:T NextQuestTip}"
                Visibility="{Binding NextQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <StackPanel Orientation="Horizontal">
            <StackPanel>
              <TextBlock Text="{Binding NextQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis"
                         Visibility="{Binding NextQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding NextQuest.Title}" MaxWidth="180"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12"
                  Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- La page, et la liste déroulante par-dessus -->
    <Grid>
      <!-- Les prérequis épinglés. Un seul panneau pour toute la liste, et non
           un par ligne : soixante lignes en porteraient soixante, dont un seul
           servirait. Il se ferme au premier clic ailleurs, et au second clic sur
           le cadenas.

           À gauche du cadenas et non dessous : posé dessous, il recouvrait les
           lignes suivantes, et le décalage de deux cent soixante pixels qui le
           ramenait dans la fenêtre était une mesure prise une fois, que la
           largeur du panneau dément dès qu'un prérequis est long. À gauche, il
           se cale tout seul sur le cadenas, quelle que soit sa taille.

           Il tient ouvert et c'est la fenêtre qui le referme, au premier clic
           hors du cadenas qui l'a ouvert. Laissé à lui-même, il se fermait au
           clic sur ce cadenas, puis le clic rouvrait aussitôt : on ne pouvait
           pas le refermer par où on l'avait ouvert. Sa fermeture ne prévenait
           d'ailleurs personne, l'événement ne se déclenchant pas, ce qui ôtait
           tout moyen de le savoir. -->
      <Popup x:Name="PanneauPrerequis" StaysOpen="True"
             Placement="Left" HorizontalOffset="-6" VerticalOffset="-6"
             AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" Padding="11,8">
          <StackPanel MaxWidth="330">
            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlyphNeedBrush}" />

            <ItemsControl ItemsSource="{Binding Needs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="11" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="3" Height="3"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="0,7,0,0"
                             Fill="{DynamicResource TextMutedBrush}" />

                    <!-- Seuls les prérequis qui sont des quêtes se cliquent :
                         un objet à rapporter ou un créneau horaire ne mène
                         nulle part. -->
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                            Content="{Binding Text}" Tag="{Binding Quest}"
                            Click="OnFollowNeed"
                            Visibility="{Binding IsQuest,
                                                 Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                               Foreground="{DynamicResource TextBrush}"
                               Visibility="{Binding IsQuest,
                                                    Converter={StaticResource InverseBoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- Un WebView2 est une fenêtre native : il se dessine au-dessus de tout
           élément WPF du même châssis, quel que soit l'ordre de déclaration.
           Sans ce retrait, la liste s'ouvrait derrière la page dès qu'une quête
           était chargée, c'est-à-dire dans le cas le plus courant. La replier
           la rend visible ; la page, elle, vit dans son propre processus et
           retrouve sa position au retour. -->
      <wv:WebView2 x:Name="View"
                   Visibility="{Binding ShowsPage,
                                        Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Style="{StaticResource Muted}" Margin="20"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center"
                 Text="{Binding Placeholder}"
                 Visibility="{Binding HasQuest, Converter={StaticResource InverseBoolToVisibility}}" />

      <!-- L'attente prend la place de la vue plutôt que de la recouvrir, pour
           la raison dite plus haut.

           En haut et non au centre : la fenêtre fait mille trois cents pixels
           de haut, et un rond de vingt-deux pixels posé en son milieu tombe à
           cinq cents pixels sous le bandeau, loin de l'œil, dans une étendue
           vide qui se lit comme une panne. Il se pose donc là où le texte va
           paraître.

           Sans le titre dessous : le bandeau le porte déjà, deux lignes plus
           haut, et il s'y affiche pendant le chargement. -->
      <Control Style="{StaticResource BusyIndicator}" Width="22" Height="22"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,54,0,0"
               Visibility="{Binding ShowsLoader, Converter={StaticResource BoolToVisibility}}" />

      <!-- Elle recouvre la page : la liste est un choix en cours, pas un
           panneau permanent qui volerait de la place au guide. -->
      <Border VerticalAlignment="Stretch"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <!-- Le fil d'Ariane et la fermeture partagent une ligne toujours
               présente : le fil est vide à la racine, et une croix logée dans
               son bloc y aurait disparu avec lui. -->
          <Grid DockPanel.Dock="Top" Margin="10,4,4,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Breadcrumb}" />

            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                    Click="OnCloseList" ToolTip="{loc:T CloseListTip}">
              <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
            </Button>
          </Grid>

          <!-- Le retour est fixe et non une ligne de la liste : il défilait avec
               elle et disparaissait dès qu'on descendait dans une rubrique de
               soixante quêtes. -->
          <Button DockPanel.Dock="Top" Style="{StaticResource QuietButton}"
                  HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                  Margin="1,0,0,2" Click="OnGoBack"
                  ToolTip="{loc:T GoUpOneTip}"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                    Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Back}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <ListBox x:Name="NodeList" ItemsSource="{Binding Nodes}"
                   SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="OnNodeChosen"
                   KeyDown="OnNodeKey">
            <ListBox.ItemContainerStyle>
              <!-- Un intertitre n'est pas un choix : le clavier doit l'enjamber,
                   sans quoi la flèche s'arrête dessus et Entrée ne fait rien. -->
              <Style TargetType="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="Focusable" Value="{Binding IsEnabled}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- La gouttière est fixe et non un voisin replié : dans une
                     pile horizontale, un élément masqué ne réserve pas sa
                     place, et les libellés cesseraient de s'aligner d'une
                     ligne à l'autre. -->
                <Grid x:Name="Ligne" Margin="0,3" Background="Transparent"
                      IsEnabled="{Binding IsEnabled}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Le filet des titres de groupe. Une ligne pleine plutôt
                       qu'un simple écart : dans une recherche, ces titres
                       coiffent des succès qui sont eux-mêmes des intertitres,
                       et l'écart seul ne suffisait pas à les distinguer. -->
                  <Rectangle x:Name="Filet" Grid.ColumnSpan="3" Height="1"
                             VerticalAlignment="Top" Margin="0,-9,0,0"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <!-- Le filet qui relie les quêtes d'un succès.

                       C'est lui, avec le décalage, qui dit l'appartenance :
                       l'intertitre et ses quêtes étaient au même retrait, et une
                       icône portait seule toute la distinction.

                       Pour qu'il ne se hache pas d'un rang à l'autre, une ligne
                       de succès porte son écart au-dedans, sur son libellé, et
                       non au-dehors comme les autres : un tracé débordant de la
                       marge d'une ligne n'était pas dessiné, mesuré à
                       quarante-cinq pixels de filet pour six de vide. -->
                  <Rectangle x:Name="Trait" Grid.Column="0" Width="1"
                             HorizontalAlignment="Right" VerticalAlignment="Stretch"
                             Margin="0,-4,7,-4"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <Path x:Name="Nature" Grid.Column="0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Path.Style>
                      <Style TargetType="Path" BasedOn="{StaticResource ListGlyph}" />
                    </Path.Style>
                  </Path>

                  <TextBlock x:Name="Libelle" Grid.Column="1" Text="{Binding Label}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <!-- La clef exigée à l'entrée d'un donjon. Neuf sur
                         quatre-vingt-deux n'en demandent pas, et n'ont donc pas
                         d'icône : l'absence est une information. Son nom est
                         trop long pour la colonne et vient au survol. -->
                    <Border Background="Transparent"
                            VerticalAlignment="Center" Margin="0,0,5,0"
                            ToolTip="{Binding Dungeon.Key}"
                            ToolTipService.InitialShowDelay="200"
                            Visibility="{Binding Dungeon.NeedsKey,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">
                      <Path Style="{StaticResource ListGlyph}"
                            Stroke="{DynamicResource GlyphDungeonBrush}"
                            Data="M 5.2,7.5 m -2.6,0 a 2.6,2.6 0 1 0 5.2,0
                                  a 2.6,2.6 0 1 0 -5.2,0
                                  M 7.8,7.5 H 12.8 M 10.3,7.5 V 9.8 M 12.4,7.5 V 9.3" />
                    </Border>

                    <TextBlock Text="{Binding Detail}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />

                    <!-- Un cadenas : ce qui tient la quête fermée. Une clé
                         avait été essayée d'abord ; son anneau et sa tige en
                         diagonale se lisaient comme une loupe, à quelques
                         centimètres du champ de recherche. Le site donne ces
                         prérequis pour
                         six cent treize quêtes, contre cent dix-sept auxquelles
                         il donne un niveau.

                         Ce n'est pas une liste de quêtes à faire avant : sur
                         cinq cent soixante-sept prérequis distincts, on trouve
                         des objets à apporter, un alignement, un nombre de
                         joueurs, un niveau, et jusqu'à des créneaux horaires.
                         Le mot qui les couvre tous est « prérequis ».

                         L'infobulle est portée par un conteneur au fond
                         transparent, et non par le tracé : un tracé ouvert n'a
                         pas de surface, si bien qu'un remplissage ne lui donne
                         aucune prise et qu'il faudrait viser une ligne d'un
                         pixel et demi. Mesuré : sur le tracé seul, le survol ne
                         déclenchait rien.

                         Elle tient longtemps affichée, parce qu'une liste de
                         prérequis se lit moins vite que le mot d'un bouton. -->
                    <Button x:Name="Cadenas" Style="{StaticResource IconButton}"
                            VerticalAlignment="Center" Margin="6,0,2,0"
                            Click="OnShowNeeds"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000"
                            Visibility="{Binding HasNeeds,
                                                 Converter={StaticResource BoolToVisibility}}">
                      <Button.ToolTip>
                        <ToolTip Style="{StaticResource RichToolTip}">
                          <StackPanel MaxWidth="330">
                            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlyphNeedBrush}" />

                            <ItemsControl ItemsSource="{Binding Needs}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="11" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="3" Height="3"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="0,7,0,0"
                                             Fill="{DynamicResource TextMutedBrush}" />

                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                                               Foreground="{DynamicResource TextBrush}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{loc:T ClickQuestsHint}" />
                          </StackPanel>
                        </ToolTip>
                      </Button.ToolTip>

                      <Path Style="{StaticResource ListGlyph}"
                            Stroke="{DynamicResource GlyphNeedBrush}"
                            Data="M 5.1,7 L 5.1,5.2 A 2.4,2.4 0 0 1 9.9,5.2 L 9.9,7
                                  M 3.7,7 L 11.3,7 L 11.3,12.9 L 3.7,12.9 Z
                                  M 7.5,9.3 L 7.5,10.8" />
                    </Button>
                  </StackPanel>
                </Grid>

                <DataTemplate.Triggers>
                  <!-- D'abord ce que la ligne est : un intertitre se distingue
                       de ce qu'il coiffe, sans quoi une rubrique se lirait
                       comme une quête de plus. Le décalage porte sur la ligne
                       entière, sinon l'icône resterait huit pixels trop haut.

                       L'icône vient après, et se règle sur la nature de la
                       ligne et non sur son genre : deux branches se déplient de
                       la même façon sans désigner la même chose. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontSmall}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,11,0,3" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontSmall}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,11,0,3" />
                  </DataTrigger>

                  <!-- Le titre d'un groupe de résultats domine tout le reste :
                       plus grand, en pleine couleur de texte, précédé d'un
                       filet. Il coiffe des succès qui portent déjà le bleu et
                       la demi-graisse des intertitres. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Section">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontMedium}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,18,0,5" />
                    <Setter TargetName="Filet" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- Une quête de succès se décale et prend son filet. -->
                  <DataTrigger Binding="{Binding InSuccess}" Value="True">
                    <Setter TargetName="Trait" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0" />
                    <Setter TargetName="Libelle" Property="Margin" Value="9,3,0,3" />
                  </DataTrigger>

                  <!-- Le blanc de rupture, posé sur la ligne qui précède. -->
                  <DataTrigger Binding="{Binding Spaced}" Value="True">
                    <Setter TargetName="Ligne" Property="Margin" Value="0,3,0,14" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Success">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphSuccessBrush}" />
                    <!-- Une étoile : ce qu'on obtient. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,2 L 9.2,5.9 L 13.3,6.4 L 10.3,9.2 L 11.1,13.2
                                   L 7.5,11.2 L 3.9,13.2 L 4.7,9.2 L 1.7,6.4 L 5.8,5.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Place">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- Une épingle : un endroit où l'on va. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,13.6 C 7.5,13.6 12.3,8.6 12.3,6.1
                                   A 4.8,4.8 0 1 0 2.7,6.1 C 2.7,8.6 7.5,13.6 7.5,13.6 Z
                                   M 7.5,6.1 m -1.7,0 a 1.7,1.7 0 1 0 3.4,0
                                   a 1.7,1.7 0 1 0 -3.4,0" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Route">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- Bouts francs, contre les bouts ronds du reste de la
                         liste : un bout rond déborde de trois quarts d'unité de
                         chaque côté, et refermait les blancs de la ligne
                         médiane, qui n'en font que deux. -->
                    <Setter TargetName="Nature" Property="StrokeStartLineCap" Value="Flat" />
                    <Setter TargetName="Nature" Property="StrokeEndLineCap" Value="Flat" />
                    <!-- Une route en perspective : deux bas-côtés qui se
                         rapprochent, une ligne médiane en pointillés. L'épingle
                         du lieu tenait la place, et un chemin n'est pas un
                         lieu : il en joint deux.

                         Trois autres dessins ont été montés et regardés avant
                         celui-ci, et aucun ne tenait à quinze unités : une
                         courbe à un virage donnait un os, une courbe à deux
                         virages un chevron, une flèche en pointillés une flèche
                         pleine, ses blancs mangés par les bouts ronds. Un
                         panneau indicateur se lisait, mais désignait la
                         direction et non le chemin. Reste la route elle-même,
                         qui n'est faite que de droites. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.2,13.6 L 5.5,2.4
                                   M 11.8,13.6 L 9.5,2.4
                                   M 7.5,12.4 V 10.2
                                   M 7.5,8.4 V 6.4
                                   M 7.5,4.6 V 3.2" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Family">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphFamilyBrush}" />
                    <!-- Un marque-page : une famille de quêtes, qui range sans
                         situer. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4,2.4 L 11,2.4 L 11,12.9 L 7.5,10.1 L 4,12.9 Z" />
                  </DataTrigger>

                  <!-- Les quatre entrées de la racine sont dessinées pleines
                       et non au filet, contrairement au reste de la liste : ce
                       sont des objets du jeu et non des repères de classement,
                       et un trait d'un pixel et demi les rendait fades.

                       Trois d'entre elles portent la même teinte : un donjon, un
                       raid et une tanière sont le même genre de lieu, et la
                       couleur dit le genre quand la forme dit lequel des trois.
                       Les distinguer aussi par la teinte aurait porté la liste à
                       huit couleurs, où six suffisent déjà à peine.

                       Les creux viennent de la règle de remplissage pair-impair,
                       celle du langage de tracé par défaut : un contour intérieur
                       perce celui qui l'entoure, sans qu'on ait à le dire. -->
                  <DataTrigger Binding="{Binding Glyph}" Value="Quests">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <!-- La teinte neutre des trois autres lignes de l'accueil.
                         Le parchemin y était le seul en couleur, et rien ne
                         justifiait qu'une des quatre natures se distingue là où
                         elles se valent. -->
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- Un parchemin : deux rouleaux en pilule, un corps, et
                         deux lignes d'écriture évidées. Le dessin est à nous ;
                         celui du site ne sera repris que s'ils l'accordent. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.7,2.7 H 11.3 A 1.05,1.05 0 0 1 11.3,4.8
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,2.7 Z
                                   M 4.1,4.8 H 10.9 V 10.2 H 4.1 Z
                                   M 3.7,10.2 H 11.3 A 1.05,1.05 0 0 1 11.3,12.3
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,10.2 Z
                                   M 5.6,6.2 H 9.4 V 7.0 H 5.6 Z
                                   M 5.6,8.0 H 9.4 V 8.8 H 5.6 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Dungeons">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- Un donjon au sens propre : une tour crénelée, sa
                         porte en arc et sa meurtrière évidées.

                         Une clef couchée avait tenu la place ; elle disait déjà
                         autre chose. La colonne de droite marque d'une clef les
                         soixante-treize donjons qui en exigent une, et une
                         recherche montrait donc la même clef deux fois sur une
                         seule ligne, à gauche pour dire « donjon » et à droite
                         pour dire « il vous en faut une ». Mesuré sur
                         « bworker ». La clef ne veut plus dire qu'une chose. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,2.3 H 5.7 V 4.6 H 6.4 V 2.3 H 8.6 V 4.6
                                   H 9.3 V 2.3 H 11.5 V 13.1 H 3.5 Z
                                   M 6.3,13.1 V 9.9 A 1.2,1.2 0 0 1 8.7,9.9
                                   V 13.1 Z
                                   M 6.9,5.9 H 8.1 V 7.9 H 6.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Raids">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- Un crâne : le raid est le combat qui tue.

                         Deux épées croisées avaient été dessinées d'abord, et
                         montées dans l'application pour être vues. À la taille
                         réelle, vingt-deux pixels, la garde et le pommeau ne
                         portent plus : il ne reste qu'une croix, à quelques
                         centimètres de celle qui vide le champ de recherche.
                         Le crâne tient parce qu'il n'est fait que de masses :
                         une calotte, deux orbites, une mâchoire. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,8 A 4,4.4 0 0 1 11.5,8 L 11.5,9.8 L 3.5,9.8 Z
                                   M 5.4,9.8 H 9.6 L 8.9,12.6 H 6.1 Z
                                   M 6,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 9,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 6.75,9.8 H 7.2 V 12.35 H 6.75 Z
                                   M 7.8,9.8 H 8.25 V 12.3 H 7.8 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Lairs">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- Une empreinte : la tanière est l'antre d'une bête, et
                         c'est ce qui la sépare du donjon, bâti de main
                         d'homme. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4.35,9.9 a 3.15,2.6 0 1 0 6.3,0
                                   a 3.15,2.6 0 1 0 -6.3,0 Z
                                   M 4.25,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 8.15,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 1.6,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z
                                   M 11.1,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
