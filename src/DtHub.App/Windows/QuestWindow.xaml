<Window x:Class="DtHub.App.Windows.QuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:papycha="clr-namespace:DtHub.Core.Papycha;assembly=DtHub.Core"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:T Guides}"
        PreviewMouseDown="OnWindowPressed"
        Width="520" Height="760" MinWidth="440" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <!-- No WindowStyle="None" or AllowsTransparency here, unlike the
       configurator: a WebView2 is a native surface and does not render
       inside a transparent window. Windows' chrome is the price to pay
       for seeing the page. -->

  <DockPanel>

    <!-- Search bar -->
    <Border DockPanel.Dock="Top" Padding="10,8"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <!-- The field takes up the full width: the quest count that used
             to cut into it didn't say anything worth reading twice. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- The right padding is wider than the others: it reserves
               room for the cross, which sits above the field. It's set
               to half the width wanted, since the field applies its
               padding twice - once to the text holder, once to the
               text itself. -->
          <TextBox x:Name="SearchBox" Padding="7,4,16,4"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   GotKeyboardFocus="OnSearchFocused"
                   PreviewMouseLeftButtonDown="OnSearchClicked"
                   PreviewKeyDown="OnSearchKey"
                   ToolTip="{loc:T SearchTip}"
                   Tag="{loc:T QuestSearchPlaceholder}" />

          <!-- Inside the field, not next to it: a cross placed outside
               read like one of the bar's buttons, without saying what
               it was clearing. -->
          <Button Style="{StaticResource IconButton}"
                  HorizontalAlignment="Right" Margin="0,0,3,0"
                  Click="OnClearQuery"
                  ToolTip="{loc:T ClearSearchTip}"
                  Visibility="{Binding Query, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
            <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
            <!-- Only where they act: a list of quests, once linked, and no
                 search under way, since a search is never filtered. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                        Visibility="{Binding ShowsFilters,
                                             Converter={StaticResource BoolToVisibility}}">
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,3"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Content="{loc:T FilterDoable}"
                            ToolTip="{loc:T FilterDoableTip}"
                            IsChecked="{Binding FilterDoable, Mode=TwoWay}" />
            </StackPanel>

            <!-- The one way into the recommended quests, from anywhere:
                 pressed again it puts back what the reader left. OneWay, the
                 click asks the view model, which knows where to go back. -->
            <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,3"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Content="{loc:T Recommended}"
                          ToolTip="{loc:T RecommendedTip}"
                          IsChecked="{Binding ShowsRecommended, Mode=OneWay}"
                          Click="OnRecommendedClick" />

            <!-- "Sélection": a glyph and not a word, the toolbar has no
                 room left at the 440 px minimum; the word comes on hover. -->
            <ToggleButton Style="{StaticResource OutlineToggle}" Padding="6,3" Margin="4,0,0,0"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ToolTip="{loc:T BatchSelection}"
                          IsChecked="{Binding Selecting, Mode=TwoWay}"
                          IsEnabled="{Binding BatchRunning, Converter={StaticResource InverseBool}}"
                          Visibility="{Binding ShowsSelection, Converter={StaticResource BoolToVisibility}}">
              <Path Width="14" Height="14" Stretch="None"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 4,7 L 6.2,9.2 L 10.5,4.5" />
            </ToggleButton>
          </StackPanel>
        </Grid>

        <!-- Only when there's something to say: an indexing in progress,
             or an error. Nothing the rest of the time. -->
        <ProgressBar Height="2" Margin="0,6,0,0" IsIndeterminate="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <!-- Selection mode: the batch button, then while it runs the count
             and Cancel, then the summary, refusals in the site's words. -->
        <StackPanel Margin="0,6,0,0"
                    Visibility="{Binding ShowsSelectionPanel, Converter={StaticResource BoolToVisibility}}">
          <WrapPanel>
            <Button Style="{StaticResource OutlineButton}" Padding="8,3"
                    Content="{Binding MarkPickedLabel}" Click="OnMarkPickedClick"
                    IsEnabled="{Binding CanMarkPicked}"
                    Visibility="{Binding BatchRunning, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"
                       FontSize="{StaticResource FontSmall}" Text="{loc:T BatchRangeHint}"
                       Visibility="{Binding BatchRunning, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding BatchProgress}"
                       Visibility="{Binding BatchRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource QuietButton}" Padding="8,3" Margin="8,0,0,0"
                    Content="{loc:T Cancel}" Click="OnCancelBatchClick"
                    Visibility="{Binding BatchRunning, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
          <ScrollViewer MaxHeight="120" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding BatchSummary, Converter={StaticResource EmptyToVisibility},
                                             ConverterParameter=inverse}">
            <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       TextWrapping="Wrap" Text="{Binding BatchSummary}" />
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The player's Papycha tracker: the link when there is none, the
         character and the menu once linked. Always there: it holds the
         level and Bonus Pack boxes, which every view of the window uses. -->
    <Border DockPanel.Dock="Top" Padding="10,6" DataContext="{Binding Tracker}"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1">
      <!-- The right-hand group goes under the character when the two no
           longer fit side by side: code-behind, OnTrackerBarSizeChanged. -->
      <Grid x:Name="TrackerBar" SizeChanged="OnTrackerBarSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The boxes stay on the character's line while it has room and
             wrap under it otherwise: beside a guide's status buttons the
             column keeps about 200 px at the default width. The pitch and
             the notice come below, wrapping in the column's width. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <WrapPanel>
            <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                      MinWidth="150" Margin="0,0,10,0"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                      Visibility="{Binding HasSeveralCharacters, Converter={StaticResource BoolToVisibility}}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <!-- One line of text, two runs: as two blocks, the level's
                       own font sat off the name's baseline. -->
                  <TextBlock>
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding Level, Mode=OneWay, StringFormat=' ({0})'}"
                         Foreground="{DynamicResource TextMutedBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <!-- Screen readers read the name, not the record's ToString. -->
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>

            <!-- One character only: a dropdown with a single entry would
                 promise a choice that does not exist. Empty when not linked. -->
            <TextBlock Text="{Binding SelectedCharacter.Name}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding HasSeveralCharacters,
                                            Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- Level and XP bonus feed the reward line, the gains and
                 the marks of every list: shown in every view, linked or not,
                 right after the character so its level is changed where it is
                 read; linked, the level is saved on Papycha.
                 The bonus is a switch: the Bonus Pack is the one bonus a player
                 knows, a free percentage box left them guessing what to type. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="{loc:T RewardLevelLabel}" Style="{StaticResource Muted}"
                         FontSize="{StaticResource FontSmall}" VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <TextBox Width="44" Padding="4,2" MaxLength="3" VerticalAlignment="Center"
                       Text="{Binding RewardLevel, Mode=OneWay}"
                       KeyDown="OnRewardLevelKey" LostKeyboardFocus="OnRewardLevelApply">
                <TextBox.Style>
                  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="ToolTip" Value="{loc:T RewardLevelTipLocal}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLinked}" Value="True">
                        <Setter Property="ToolTip" Value="{loc:T RewardLevelTipLinked}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <!-- OneWay survives the click: a toggle sets its current value, not
                   a local one, so a later refresh still moves it. -->
              <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                        FontSize="{StaticResource FontSmall}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Content="{loc:T RewardXpBonusLabel}" ToolTip="{loc:T RewardXpBonusTip}"
                        IsChecked="{Binding HasBonusPack, Mode=OneWay}"
                        Click="OnBonusPackClick" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Text="{loc:T TrackerPitch}" Style="{StaticResource Muted}"
                     FontSize="{StaticResource FontSmall}" Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     Visibility="{Binding ShowsPitch, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}"
                     FontSize="{StaticResource FontSmall}" Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     Visibility="{Binding Notice, Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />
        </StackPanel>

        <Grid x:Name="TrackerRight" Grid.Column="1" VerticalAlignment="Center"
              SizeChanged="OnTrackerBarSizeChanged">
          <Button Style="{StaticResource OutlineButton}" Padding="8,3"
                  VerticalAlignment="Center" Click="OnLinkTracker"
                  Content="{loc:T TrackerLink}"
                  Visibility="{Binding ShowsLinkButton, Converter={StaticResource BoolToVisibility}}" />

          <Grid VerticalAlignment="Center"
                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The shown quest's status on the player's tracker, next to the
                 other tracker controls. Only while a quest is shown. -->
            <!-- Only while a guide is on screen: in the list or a search, the
                 buttons would speak of a quest no longer shown. -->
            <Border VerticalAlignment="Center"
                    Visibility="{Binding DataContext.ShowsQuestChrome,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                          Visibility="{Binding ShowsQuestStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CurrentStatusLabel}" Style="{StaticResource Muted}"
                           FontSize="{StaticResource FontSmall}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
  
                <Button Padding="8,2" VerticalAlignment="Center" Click="OnMarkDone"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                      <Setter Property="Content" Value="{loc:T QuestStatusCompleted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HighlightsDone}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                          <Setter Property="Content" Value="{loc:T TrackerDone}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
  
                <Grid Margin="4,0,0,0" VerticalAlignment="Center">
                  <ToggleButton x:Name="StatusMenuToggle" Style="{StaticResource OutlineToggle}"
                                Padding="7,2" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                ToolTip="{loc:T QuestStatusMenuTip}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <Path Width="8" Height="5" Stretch="None" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                          Data="M 0.7,0.7 L 4,4 L 7.3,0.7" />
                  </ToggleButton>
                  <Popup IsOpen="{Binding IsChecked, ElementName=StatusMenuToggle, Mode=TwoWay}"
                         StaysOpen="False" Placement="Bottom"
                         PlacementTarget="{Binding ElementName=StatusMenuToggle}"
                         AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="6">
                      <StackPanel>
                        <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                                HorizontalContentAlignment="Left" Background="Transparent"
                                BorderBrush="Transparent" Click="OnPickStatus"
                                Tag="{x:Static papycha:QuestStatus.NotStarted}"
                                Content="{loc:T QuestStatusNotStarted}" />
                        <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                                HorizontalContentAlignment="Left" Background="Transparent"
                                BorderBrush="Transparent" Click="OnPickStatus"
                                Tag="{x:Static papycha:QuestStatus.InProgress}"
                                Content="{loc:T QuestStatusInProgress}" />
                        <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                                HorizontalContentAlignment="Left" Background="Transparent"
                                BorderBrush="Transparent" Click="OnPickStatus"
                                Tag="{x:Static papycha:QuestStatus.Completed}"
                                Content="{loc:T QuestStatusCompleted}" />
                        <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                                HorizontalContentAlignment="Left" Background="Transparent"
                                BorderBrush="Transparent" Click="OnPickStatus"
                                Tag="{x:Static papycha:QuestStatus.Blocked}"
                                Content="{loc:T QuestStatusBlocked}" />
                        <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                                HorizontalContentAlignment="Left" Background="Transparent"
                                BorderBrush="Transparent" Click="OnPickStatus"
                                Tag="{x:Static papycha:QuestStatus.Ignored}"
                                Content="{loc:T QuestStatusIgnored}" />
                      </StackPanel>
                    </Border>
                  </Popup>
                </Grid>
              </StackPanel>
            </Border>

            <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,8,0"
                    VerticalAlignment="Center" Click="OnOpenTracker"
                    Content="{loc:T TrackerMyQuests}" />

            <ToggleButton x:Name="TrackerMenuToggle" Grid.Column="2" Style="{StaticResource OutlineToggle}"
                          Padding="8,2" Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}"
                          ToolTip="{loc:T TrackerMenuTip}">
              <Path Width="12" Height="4" Stretch="None" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" Stroke="{DynamicResource TextMutedBrush}"
                    StrokeThickness="2" Data="M 1,2 H 1.1 M 6,2 H 6.1 M 11,2 H 11.1" />
            </ToggleButton>
            <Popup IsOpen="{Binding IsChecked, ElementName=TrackerMenuToggle, Mode=TwoWay}"
                   StaysOpen="False" Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TrackerMenuToggle}"
                   AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="6">
                <StackPanel>
                  <Button Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,1"
                          HorizontalContentAlignment="Left" Background="Transparent"
                          BorderBrush="Transparent" Click="OnUnlinkTracker"
                          Content="{loc:T TrackerUnlink}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Banner for the open quest: its name, its place within the
         achievement, and the step arrows. It disappears when the list
         opens, so the list can take up the full height: you don't
         consult a step and a list at the same time. -->
    <Border DockPanel.Dock="Top" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding ShowsQuestChrome, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Going back where you came from. A curved arrow rather than
             a chevron: the chevrons on the row below point to the
             previous and next step, and two left-pointing arrows in
             the same banner wouldn't say the same thing. -->
        <Button Grid.Column="0" Style="{StaticResource IconButton}"
                Margin="0,0,4,0" VerticalAlignment="Center"
                Click="OnGoBackPage"
                ToolTip="{loc:T BackToPreviousPageTip}"
                Visibility="{Binding CanGoBackPage,
                                     Converter={StaticResource BoolToVisibility}}">
          <Path Style="{StaticResource RowGlyph}"
                Data="M 3.5,6 L 7,2.5 M 3.5,6 L 7,9.5
                      M 3.5,6 H 9.5 C 12,6 12.5,7.6 12.5,9.6 V 12.5" />
        </Button>

        <!-- The achievement line wasn't declared as spacing, but it
             acted as one: fifteen pixels of light grey above the
             title. More than half of quests don't have one, and the
             title then ended up touching the divider, especially
             since the page below allows itself twelve pixels of
             margin. The block therefore gives back a bit of room
             when the line collapses, without pretending to replace
             missing text.

             The trigger reads the line's visibility rather than the
             string itself: it's the same notion of emptiness as the
             converter, including for a null or blank text, and the
             two cannot diverge. -->
        <StackPanel Grid.Column="1">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=HeaderSeries}" Value="Collapsed">
                  <Setter Property="Margin" Value="0,4" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <TextBlock x:Name="HeaderSeries"
                     Text="{Binding ChainText}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                     Visibility="{Binding ChainText, Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />

          <TextBlock Text="{Binding QuestTitle}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />

          <TextBlock Text="{Binding RewardText}" ToolTip="{Binding RewardText}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding RewardText, Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />

          <!-- Where the items the quest asks for come from, on one line under
               the reward; one source per line on hover. -->
          <TextBlock Text="{Binding SourcesLine}" ToolTip="{Binding SourcesText}" Style="{StaticResource Muted}"
                     FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding SourcesText, Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />

        </StackPanel>

        <!-- The step arrows, on the title's row: the site's intro block,
             shown again at the top of the guide, now says where the
             quest starts, and a second row only cost height. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowsSteps, Converter={StaticResource BoolToVisibility}}">
          <Button Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoPreviousStep}" Click="OnPreviousStep"
                  ToolTip="{loc:T PreviousStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12" />
          </Button>

          <Button Style="{StaticResource IconButton}"
                  IsEnabled="{Binding CanGoNextStep}" Click="OnNextStep"
                  ToolTip="{loc:T NextStepTip}">
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The source, always credited, and access to the real browser -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The credit carries the accent colour: it's the name of those
             whose work is displayed, it doesn't read as a grey
             mention. It's allowed to be truncated: the two buttons
             take priority over it in a narrow window. -->
        <DockPanel Grid.Column="0" LastChildFill="True">
          <!-- The tracker's offers, left of the report button: the bar at
               the top had no room left for them. The credit gives way. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="8,0,8,0" DataContext="{Binding Tracker}">
              <!-- Offered after "next quest": leaving a quest is not always
                   finishing it, so it is asked, never written on its own. -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                          Visibility="{Binding ShowsFinishOffer, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FinishOffer}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,0,8,0" />
                <Button Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,0,4,0"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Click="OnAcceptFinish" Content="{loc:T TrackerYes}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource OutlineButton}" Padding="8,2"
                        Click="OnDismissFinish" Content="{loc:T TrackerNo}" />
              </StackPanel>

              <!-- After "Terminée": the account's other characters still to
                   finish it, one click each or all at once. Ignored, it writes
                   nothing and goes with the next quest shown. -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                          Visibility="{Binding ShowsOthers, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:T TrackerAlsoFor}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ItemsControl ItemsSource="{Binding OthersToFinish}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource OutlineButton}" Padding="8,2" Margin="0,0,4,0"
                              Content="{Binding Name}" Tag="{Binding}" Click="OnFinishForOther" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource OutlineButton}" Padding="8,2"
                        Click="OnFinishForAll" Content="{loc:T TrackerAllCharacters}"
                        Visibility="{Binding ShowsAllOthers, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/assets/papycha.png" Width="14" Height="14" Margin="0,0,5,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSmall}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{loc:T PapychaGuides}" />
          </StackPanel>
        </DockPanel>

        <!-- The report button carries the accent colours, at rest and
             not only on hover: it's the action people look for in this
             bar, and a grey icon blended into the rest.

             Browser access therefore becomes an icon. Three written
             labels didn't fit together in a narrow window, and the
             credit would shrink to "Guide…": it's the name of those
             whose work is displayed, it doesn't get to be trimmed. -->
        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
                Padding="9,5" FontSize="{StaticResource FontBody}"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"
                ToolTip="{loc:T ReportErrorTip}"
                Click="OnReportError">
          <StackPanel Orientation="Horizontal">
            <Path Width="15" Height="15" Stretch="None" Margin="0,0,7,0"
                  VerticalAlignment="Center" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                  Data="M 3.6,2.2 V 13.8 M 3.6,3.3 H 12.6 L 10.3,6.2 L 12.6,9.1 H 3.6" />
            <TextBlock Text="{loc:T ReportError}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Only on a site in another language than ours, where it takes the
             place of the untranslated page: see PageTranslation. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0"
                  FontSize="{StaticResource FontBody}"
                  ToolTip="{loc:T OfficialStepsTip}"
                  Visibility="{Binding OffersOfficialSteps, Converter={StaticResource BoolToVisibility}}"
                  Command="{Binding ToggleOfficialStepsCommand}">
            <TextBlock Text="{loc:T OfficialSteps}" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="Translate" Style="{StaticResource OutlineButton}"
                  Padding="9,5" FontSize="{StaticResource FontBody}"
                  ToolTip="{loc:T TranslateTip}"
                  Visibility="Collapsed" Click="OnTranslate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{loc:T Translate}" VerticalAlignment="Center" />
              <Path Style="{StaticResource RowGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                    Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Button x:Name="OpenPage" Grid.Column="3" Style="{StaticResource IconButton}"
                ToolTip="{loc:T OpenCurrentPageTip}"
                Click="OnOpenInBrowser">
          <Path Style="{StaticResource RowGlyph}"
                Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
        </Button>
      </Grid>
    </Border>

    <!-- The search's fallback exit, offered when you press Enter. Our
         catalogue only knows titles; the site searches within the body
         of its articles, so items, monsters and characters as well.

         On its own line, not in the credit bar: the latter already
         carries three elements, and its own comment explains what
         happens to a fourth one in a narrow window. Declared after it,
         so placed above it: a child anchored to the bottom sits above
         the previous one. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{DynamicResource AccentSoftBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowsSiteSearch, Converter={StaticResource BoolToVisibility}}">
      <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
              Padding="0" Background="Transparent" BorderThickness="0"
              ToolTip="{loc:T SearchOnSiteTip}"
              Click="OnSearchOnSite">
        <StackPanel Orientation="Horizontal">
          <Image Source="/assets/papycha.png" Width="14" Height="14" Margin="0,0,6,0"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSmall}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource AccentBrush}"
                     Text="{Binding SiteSearchLabel}" />

          <!-- The same icon as the browser access in the bar below: it's
               the same action, leaving the application. -->
          <Path Style="{StaticResource RowGlyph}" Margin="7,0,0,0" VerticalAlignment="Center"
                Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
        </StackPanel>
      </Button>
    </Border>

    <!-- The achievement's sequence: where you came from, where you are,
         where you're going. These are the list's neighbours, not those
         of the prerequisite chain the site publishes at the foot of
         the article: that one jumps from one achievement to another
         and branches off. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowsChain, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                   Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   Text="{Binding ChainStep}"
                   ToolTip="{loc:T QuestInSuccessTip}"
                   Visibility="{Binding ChainStep, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

        <Button Grid.Column="0" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                Tag="{Binding PreviousQuest}" Click="OnFollowChain"
                ToolTip="{loc:T PreviousQuestTip}"
                Visibility="{Binding PreviousQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <!-- The series only appears when it changes: following a
               prerequisite sometimes leads into another achievement,
               or even another zone, and the title alone would suggest
               you're continuing the same sequence. -->
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                  Margin="0,0,4,0" VerticalAlignment="Center" />
            <!-- Same mechanism as at the top of the window: without a
                 series, the title used to ride up against the button's
                 edge. -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=PreviousSeries}" Value="Collapsed">
                      <Setter Property="Margin" Value="0,3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock x:Name="PreviousSeries"
                         Text="{Binding PreviousQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding PreviousQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding PreviousQuest.Title}" MaxWidth="180"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                Tag="{Binding NextQuest}" Click="OnFollowChain"
                ToolTip="{loc:T NextQuestTip}"
                Visibility="{Binding NextQuest, Converter={StaticResource EmptyToVisibility},
                                     ConverterParameter=inverse}">
          <StackPanel Orientation="Horizontal">
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=NextSeries}" Value="Collapsed">
                      <Setter Property="Margin" Value="0,3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock x:Name="NextSeries"
                         Text="{Binding NextQuest.Series}" MaxWidth="180"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontTiny}"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis"
                         Visibility="{Binding NextQuest.Series,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
              <TextBlock Text="{Binding NextQuest.Title}" MaxWidth="180"
                         TextAlignment="Right" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Path Style="{StaticResource RowGlyph}" Data="M 6,3 L 10,7.5 L 6,12"
                  Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- The page, and the drop-down list on top of it -->
    <Grid>
      <!-- The pinned prerequisites. A single panel for the whole list,
           rather than one per row: sixty rows would carry sixty of
           them, of which only one would ever be used. It closes on the
           first click elsewhere, and on the second click on the lock.

           To the left of the lock, not below it: placed below, it
           covered the following rows, and the two hundred and sixty
           pixel offset that pulled it back inside the window was a
           measurement taken once, which the panel's width contradicts
           as soon as a prerequisite is long. On the left, it lines
           itself up on the lock alone, whatever its size.

           It stays open and it's the window that closes it, on the
           first click outside the lock that opened it. Left to
           itself, it used to close on a click on that same lock, and
           the click would immediately reopen it: there was no way to
           close it from where it had been opened. Its closing,
           moreover, told no one, since the event never fired, which
           removed any way of knowing about it. -->
      <Popup x:Name="PanneauPrerequis" StaysOpen="True"
             Placement="Left" HorizontalOffset="-6" VerticalOffset="-6"
             AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" Padding="11,8">
          <StackPanel MaxWidth="330">
            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlyphNeedBrush}" />

            <ItemsControl ItemsSource="{Binding Needs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="11" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Puce" Grid.Column="0" Width="3" Height="3"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="0,7,0,0"
                             Fill="{DynamicResource TextMutedBrush}" />

                    <!-- A check on a prerequisite done, a cross on one missing
                         (unmet lock only); items and free text keep the dot. -->
                    <Path x:Name="Coche" Grid.Column="0" Width="9" Height="9" Visibility="Collapsed"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stroke="{DynamicResource SuccessBrush}" Data="M 0.7,4.6 L 3.2,7 L 8,1.8" />

                    <!-- Only prerequisites that are quests are clickable:
                         an item to bring back or a time slot leads
                         nowhere. -->
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                            Content="{Binding Text}" Tag="{Binding Quest}"
                            Click="OnFollowNeed"
                            Visibility="{Binding IsQuest,
                                                 Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                               Foreground="{DynamicResource TextBrush}"
                               Visibility="{Binding IsQuest,
                                                    Converter={StaticResource InverseBoolToVisibility}}" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Met}" Value="True">
                      <Setter TargetName="Puce" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Met}" Value="False">
                      <Setter TargetName="Puce" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                      <Setter TargetName="Coche" Property="Stroke" Value="{DynamicResource WarningBrush}" />
                      <Setter TargetName="Coche" Property="Data" Value="M 1.5,1.5 L 7.5,7.5 M 7.5,1.5 L 1.5,7.5" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>

      <!-- A WebView2 is a native window: it draws itself above every WPF
           element in the same frame, regardless of declaration order.
           Without this collapsing, the list opened behind the page as
           soon as a quest was loaded, which is the most common case.
           Collapsing it makes it visible; the page, meanwhile, lives
           in its own process and finds its position again on return. -->
      <wv:WebView2 x:Name="View"
                   Visibility="{Binding ShowsPage,
                                        Converter={StaticResource BoolToVisibility}}" />

      <!-- The game's own steps, in the web view's place while it is hidden. -->
      <DockPanel Background="{DynamicResource SurfaceBrush}"
                 Visibility="{Binding ShowsOfficialSteps, Converter={StaticResource BoolToVisibility}}">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="12,8,0,0"
                Style="{StaticResource OutlineButton}" Padding="9,5"
                FontSize="{StaticResource FontBody}"
                Content="{loc:T BackToGuide}"
                Command="{Binding BackToGuideCommand}" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="12,6,12,8"
                   Text="{loc:T OfficialNamesCredit}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="12,12,12,0"
                   Text="{loc:T OfficialStepsLoading}"
                   Visibility="{Binding IsLoadingOfficialSteps, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="12,12,12,0"
                   Text="{loc:T OfficialStepsUnavailable}"
                   Visibility="{Binding ShowsOfficialStepsUnavailable, Converter={StaticResource BoolToVisibility}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl Margin="12,8,12,8" ItemsSource="{Binding OfficialSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,4"
                             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                             Foreground="{DynamicResource TextBrush}" />
                  <ItemsControl ItemsSource="{Binding Objectives}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,1,0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                     FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                                     Foreground="{DynamicResource TextBrush}" />
                          <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="10,0,0,0"
                                     Text="{Binding Position}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <TextBlock Style="{StaticResource Muted}" Margin="20"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center"
                 Text="{Binding Placeholder}"
                 Visibility="{Binding HasQuest, Converter={StaticResource InverseBoolToVisibility}}" />

      <!-- The waiting indicator takes the view's place rather than
           covering it, for the reason stated above.

           At the top rather than centred: the window is thirteen
           hundred pixels tall, and a twenty-two pixel circle placed in
           its middle lands five hundred pixels below the banner, far
           from the eye, in an empty expanse that reads as a failure.
           It is therefore placed where the text is about to appear.

           Without the title underneath: the banner already carries it,
           two lines above, and it's shown there during loading. -->
      <Control Style="{StaticResource BusyIndicator}" Width="22" Height="22"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,54,0,0"
               Visibility="{Binding ShowsLoader, Converter={StaticResource BoolToVisibility}}" />

      <!-- It covers the page: the list is a choice in progress, not a
           permanent panel that would steal space from the guide. -->
      <Border VerticalAlignment="Stretch"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <!-- The breadcrumb and the close button share a line that's
               always present: the breadcrumb is empty at the root, and
               a cross lodged inside its block would have disappeared
               along with it. -->
          <Grid DockPanel.Dock="Top" Margin="10,4,4,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The info glyph of "Recommandées" right after its title, on its
                 line (the user's call, 24/10/2026): at the right of the line
                 below, it sat under "Moi / Équipe" and the close cross. Both
                 docked left, so the title still trims when the line is short. -->
            <DockPanel Grid.Column="0" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                         Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Breadcrumb}" />
              <Border DockPanel.Dock="Left" Background="Transparent" Margin="5,0,0,0"
                      VerticalAlignment="Center"
                      ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
                <Border.Visibility>
                  <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="ShowsRecommended" />
                    <Binding Path="Tracker.IsLinked" />
                  </MultiBinding>
                </Border.Visibility>
                <Border.ToolTip>
                  <ToolTip Style="{StaticResource RichToolTip}">
                    <TextBlock MaxWidth="360" TextWrapping="Wrap" Text="{Binding ProfitHowTip}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}" />
                  </ToolTip>
                </Border.ToolTip>
                <Path Width="12" Height="12" Stretch="None"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.1"
                      Data="M 0.6,6 A 5.4,5.4 0 1 0 11.4,6 A 5.4,5.4 0 1 0 0.6,6 Z
                            M 6,5.2 L 6,9 M 6,3 L 6,3.9" />
              </Border>
            </DockPanel>

            <!-- "Moi / Équipe" in "Recommandées", once there are characters to
                 add up. OneWay, the click asks the view model, which tells the
                 value again so a toggle clicked while on comes back on. Six more
                 on the right, so "Équipe" ends with the rows and the bar above
                 (the line's own margin, 4, is the close cross's). -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,6,0"
                        Visibility="{Binding ShowsRecommended, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal"
                          Visibility="{Binding Tracker.HasSeveralCharacters,
                                               Converter={StaticResource BoolToVisibility}}">
                <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Content="{loc:T ProfitMe}" ToolTip="{loc:T ProfitMeTip}"
                              IsChecked="{Binding ProfitTeam, Mode=OneWay, Converter={StaticResource InverseBool}}"
                              Click="OnProfitMe" />
                <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1" Margin="4,0,0,0"
                              Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Content="{loc:T ProfitTeam}" ToolTip="{loc:T ProfitTeamTip}"
                              IsChecked="{Binding ProfitTeam, Mode=OneWay}"
                              Click="OnProfitTeam" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                    Click="OnCloseList" ToolTip="{loc:T CloseListTip}"
                    Visibility="{Binding CanCloseList, Converter={StaticResource BoolToVisibility}}">
              <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
            </Button>
          </Grid>

          <!-- The team view's boxes, one per character: only the ticked
               ones count in its lists. -->
          <StackPanel DockPanel.Dock="Top" Margin="10,0,4,4"
                      Visibility="{Binding ShowsRecommended, Converter={StaticResource BoolToVisibility}}">
            <!-- How the list is ranked, one line, the detail on the info
                 glyph after the title. -->
            <TextBlock Margin="0,0,0,4" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                       TextWrapping="Wrap" Text="{Binding ProfitHow}"
                       Visibility="{Binding Tracker.IsLinked, Converter={StaticResource BoolToVisibility}}" />

            <!-- The mode, quests or series, then the tab, XP or kamas, with
                 the gain columns' glyphs, then the two toggles. OneWay pairs:
                 the click asks the view model, which tells the value again so
                 a button clicked while on stays on. A wrap panel, since the
                 window goes down to 440 px. -->
            <WrapPanel Margin="0,0,0,4"
                       Visibility="{Binding Tracker.IsLinked, Converter={StaticResource BoolToVisibility}}">
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Content="{loc:T ProfitModeQuests}" ToolTip="{loc:T ProfitModeQuestsTip}"
                            IsChecked="{Binding ProfitSeries, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Click="OnProfitQuests" />
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1" Margin="4,0,12,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Content="{loc:T ProfitModeSeries}" ToolTip="{loc:T ProfitModeSeriesTip}"
                            IsChecked="{Binding ProfitSeries, Mode=OneWay}"
                            Click="OnProfitSeries" />
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ToolTip="{loc:T ProfitTabXpTip}"
                            IsChecked="{Binding ProfitKamas, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Click="OnProfitXp">
                <StackPanel Orientation="Horizontal">
                  <Path Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                        Stretch="None" Fill="{DynamicResource GainXpBrush}"
                        Data="M 5,0.5 C 5.4,3.6 6.4,4.6 9.5,5 C 6.4,5.4 5.4,6.4 5,9.5
                              C 4.6,6.4 3.6,5.4 0.5,5 C 3.6,4.6 4.6,3.6 5,0.5 Z" />
                  <TextBlock Text="{loc:T ProfitTabXp}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1" Margin="4,0,0,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ToolTip="{loc:T ProfitTabKamasTip}"
                            IsChecked="{Binding ProfitKamas, Mode=OneWay}"
                            Click="OnProfitKamas">
                <StackPanel Orientation="Horizontal">
                  <Path Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                        Stretch="None" Stroke="{DynamicResource GainKamasBrush}"
                        StrokeThickness="1.2"
                        Data="M 0.9,5 A 4.1,4.1 0 1 0 9.1,5 A 4.1,4.1 0 1 0 0.9,5 Z
                              M 3.2,5 A 1.8,1.8 0 1 0 6.8,5 A 1.8,1.8 0 1 0 3.2,5 Z" />
                  <TextBlock Text="{loc:T ProfitTabKamas}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Style="{StaticResource OutlineToggle}" Padding="8,1" Margin="12,0,0,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Content="{loc:T ProfitDungeons}" ToolTip="{loc:T ProfitDungeonsTip}"
                            IsChecked="{Binding ProfitDungeons, Mode=TwoWay}" />
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding Tracker.TeamMembers}">
              <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ProfitTeam}" Value="True" />
                        <Condition Binding="{Binding Tracker.HasSeveralCharacters}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </ItemsControl.Style>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Character.Name}" IsChecked="{Binding Included}"
                            FontSize="{StaticResource FontSmall}" Margin="0,2,10,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The back button is fixed and not a row of the list: it
               used to scroll with it and disappear as soon as you went
               down into a section of sixty quests. -->
          <Button DockPanel.Dock="Top" Style="{StaticResource QuietButton}"
                  HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                  Margin="1,0,0,2" Click="OnGoBack"
                  ToolTip="{loc:T GoUpOneTip}"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource RowGlyph}" Data="M 9,3 L 5,7.5 L 9,12"
                    Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Back}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="12,6,12,8"
                     Text="{loc:T OfficialNamesCredit}"
                     Visibility="{Binding ShowsOfficialNamesCredit, Converter={StaticResource BoolToVisibility}}" />

          <ListBox x:Name="NodeList" ItemsSource="{Binding Nodes}"
                   SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseLeftButtonUp="OnNodeChosen"
                   KeyDown="OnNodeKey">
            <ListBox.ItemContainerStyle>
              <!-- A subheading is not a choice: the keyboard must skip
                   over it, otherwise the arrow key stops on it and
                   Enter does nothing.

                   **The template is written here and not in the theme.**
                   The convention test that checks a named style is worn
                   by the type it targets matches the "Style=" tail of
                   "ItemContainerStyle=" as well: moving this to
                   Themes/Controls.xaml and referencing it by key would
                   report a ListBox wearing a style that targets
                   ListBoxItem, and turn red. This is also the only
                   ListBox in the application, so the theme would gain a
                   single-use style either way.

                   Until now there was no template at all, so hover and
                   selection were Aero2's own pale blue washes, which are
                   nowhere in the palette. -->
              <Style TargetType="ListBoxItem">
                <!-- Screen readers read the row's title, not the record's
                     ToString ("QuestNode { Kind = Quest, ... }"). -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                <!-- Reachable, not only enabled: in selection mode an
                     achievement heading carries "Tout marquer terminé", and
                     a disabled row would disable its button too. -->
                <Setter Property="IsEnabled" Value="{Binding IsReachable}" />
                <Setter Property="Focusable" Value="{Binding IsEnabled}" />
                <Setter Property="Margin" Value="0" />

                <!-- The band runs edge to edge while the text sits ten
                     pixels in, which is also where the breadcrumb above
                     it starts. -->
                <Setter Property="Padding" Value="10,0" />

                <!-- The dotted rectangle is off-palette. The bar below
                     says the same thing in the right vocabulary. -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Fond" Background="Transparent"
                              Padding="{TemplateBinding Padding}"
                              CornerRadius="{StaticResource Radius}"
                              SnapsToDevicePixels="True">
                        <Grid>
                          <!-- A bar that fades in rather than a border
                               that appears: a border would add two
                               pixels of height and nudge every row the
                               moment the selection moved. The same
                               idiom as the tabs' underline. -->
                          <Border x:Name="Mark" Width="2" HorizontalAlignment="Left"
                                  Margin="-8,1,0,1" CornerRadius="1" Opacity="0"
                                  Background="{DynamicResource AccentBrush}" />

                          <ContentPresenter />
                        </Grid>
                      </Border>

                      <ControlTemplate.Triggers>
                        <!-- Both conditions, spelled out: a disabled
                             element still reports the pointer over it,
                             so a plain IsMouseOver trigger would light
                             up the band headers, which are not
                             choices. -->
                        <MultiTrigger>
                          <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsEnabled" Value="True" />
                          </MultiTrigger.Conditions>
                          <Setter TargetName="Fond" Property="Background"
                                  Value="{DynamicResource SurfaceAltBrush}" />
                        </MultiTrigger>

                        <!-- In selection mode an achievement heading is
                             enabled for its "Tout marquer terminé"
                             button, and still not a choice: no band.
                             Before the selection trigger, which wins. -->
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                          <Setter TargetName="Fond" Property="Background" Value="Transparent" />
                        </DataTrigger>

                        <!-- Selected and unfocused deliberately looks the
                             same as selected. This window sends focus
                             back to the search field constantly, and the
                             selection is the "you are here" mark that
                             scrolling relies on: greying it out, as the
                             stock template does, would lose it. -->
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Fond" Property="Background"
                                  Value="{DynamicResource AccentSoftBrush}" />
                          <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Mark" Property="Background"
                                  Value="{DynamicResource AccentHoverBrush}" />
                          <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- No disabled trigger, and that is deliberate:
                             the stock one greys the foreground, which is
                             invisible today only because the row
                             template sets the label's colour itself.
                             Any opacity or background added here would
                             dim the band headers. -->
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- The gutter is fixed rather than a collapsed
                     neighbour: in a horizontal stack, a hidden element
                     doesn't reserve its space, and the labels would
                     stop lining up from one row to the next. -->
                <Grid x:Name="Ligne" Margin="0,3" Background="Transparent"
                      IsEnabled="{Binding IsReachable}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- The divider under group titles. A solid line
                       rather than a plain gap: in a search, these
                       titles sit above achievements that are
                       themselves subheadings, and the gap alone wasn't
                       enough to tell them apart. -->
                  <Rectangle x:Name="Filet" Grid.ColumnSpan="3" Height="1"
                             VerticalAlignment="Top" Margin="0,-9,0,0"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <!-- The line that connects the quests of an
                       achievement.

                       It's this line, together with the indent, that
                       shows membership: the subheading and its quests
                       used to sit at the same indent, and a single
                       icon carried the whole distinction.

                       So that it doesn't break up from one row to the
                       next, an achievement row carries its gap on the
                       inside, on its label, rather than on the outside
                       like the others: a stroke overflowing a row's
                       margin wasn't drawn, measured at forty-five
                       pixels of line for six of gap. -->
                  <Rectangle x:Name="Trait" Grid.Column="0" Width="1"
                             HorizontalAlignment="Right" VerticalAlignment="Stretch"
                             Margin="0,-4,7,-4"
                             Fill="{DynamicResource BorderBrush}"
                             Visibility="Collapsed" />

                  <!-- The bracket that ties a dungeon's path to the dungeon
                       below it, at the very start of the rows, two pixels
                       thick in the dividers' colour: visible without
                       competing with the road. The road's own colour was
                       tried and drew too much attention. The path's row draws its upper arm, the
                       dungeon's row its lower arm; each stops at its own
                       row's edge, three pixels past the row's margin, so
                       nothing has to overflow into the neighbour. -->
                  <Grid Grid.Column="0" Width="8" HorizontalAlignment="Right" Margin="0,0,2,0">
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border x:Name="CrochetHaut" Grid.Row="1" Margin="0,0,0,-3"
                            BorderThickness="2,2,0,0" BorderBrush="{DynamicResource BorderBrush}"
                            SnapsToDevicePixels="True" Visibility="Collapsed" />
                    <Border x:Name="CrochetBas" Grid.Row="0" Margin="0,-3,0,0"
                            BorderThickness="2,0,0,2" BorderBrush="{DynamicResource BorderBrush}"
                            SnapsToDevicePixels="True" Visibility="Collapsed" />
                  </Grid>

                  <Path x:Name="Nature" Grid.Column="0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Path.Style>
                      <Style TargetType="Path" BasedOn="{StaticResource ListGlyph}" />
                    </Path.Style>
                  </Path>

                  <!-- A level heads its row, before the name,
                       in a column of fixed width: the names then start
                       at the same place whatever the level, and the
                       numbers read as a ladder down the band. Placed
                       last on the right, it read as one more fact among
                       the size and the position, far from the dungeon it
                       is about.

                       Empty for the three dungeons the site gives no
                       level for: they sit under a header that says so. -->
                  <DockPanel Grid.Column="1">
                    <!-- Selection mode: a box on each quest row, first so the
                         boxes line up; Shift+click ticks a range. -->
                    <CheckBox DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                              IsChecked="{Binding Checked, Mode=OneWay}" Click="OnPickClick"
                              Visibility="{Binding Checked, Converter={StaticResource EmptyToVisibility},
                                                   ConverterParameter=inverse}" />
                    <TextBlock x:Name="Niveau" DockPanel.Dock="Left" Width="22" Margin="0,0,4,0"
                               Text="{Binding Level}"
                               TextAlignment="Right" TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}"
                               FontSize="{StaticResource FontSmall}"
                               Visibility="{Binding HasLevelColumn,
                                                    Converter={StaticResource BoolToVisibility}}" />

                    <!-- The label, then muted words that only situate it: the
                         zone and series place of a recommended row. -->
                    <TextBlock x:Name="Libelle"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <Run Text="{Binding Label, Mode=OneWay}" /><Run
                           Text="{Binding Suffix, Mode=OneWay}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{StaticResource FontSmall}" />
                    </TextBlock>
                  </DockPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0"
                              VerticalAlignment="Center">
                    <!-- Selection mode, on an achievement or zone heading. -->
                    <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,6,0"
                            FontSize="{StaticResource FontSmall}"
                            Content="{loc:T BatchMarkAll}" ToolTip="{loc:T BatchMarkAllTip}"
                            Click="OnMarkAllClick"
                            Visibility="{Binding MarksAll, Converter={StaticResource BoolToVisibility}}" />
                    <!-- A dungeon's soul stone, position and key, each in
                         its own fixed column so that eighty-three rows line
                         up, each column only as wide as its content and
                         four pixels apart: the user prefers tight rows.

                         **Fixed widths and not a shared size scope.**
                         Under virtualization, containers join and leave
                         the scope as you scroll, so a shared width is
                         computed from whatever happens to be realized
                         and shifts while you move. Fixed widths also
                         align the Raids and Lairs branches and the
                         search results, none of which have bands to
                         anchor the eye.

                         The widths come from the catalogue rather than
                         from a guess: the longest position it holds is
                         nine characters, about sixty pixels in the mono
                         face; the stone is fourteen, the key fifteen.

                         Collapsed whole for every row that is not a
                         dungeon, which is six kinds out of seven. A
                         collapsed grid short-circuits measure, so the
                         fixed columns cost a quest row nothing. -->
                    <Grid Visibility="{Binding Facts,
                                               Converter={StaticResource EmptyToVisibility},
                                               ConverterParameter=inverse}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="19" />
                      </Grid.ColumnDefinitions>

                      <!-- The stone alone, coloured by its size as in the
                           game: it says the size, so the word only comes on
                           hover. Drawn rather than taken from the game's
                           artwork, which the project does not embed.
                           Collapsed for a size the site has not used,
                           rather than drawn in a wrong colour.
                           The words are the API's, capital included.
                           shortcut: a new size word would show nothing,
                           give it a stone colour when the site adds one. -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal"
                                  HorizontalAlignment="Left" Margin="0,0,4,0">
                        <Viewbox Width="14" Height="14"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding Facts.Size}"
                                 ToolTipService.InitialShowDelay="200">
                          <Viewbox.Style>
                            <Style TargetType="Viewbox">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Facts.Size}" Value="Petite">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Setter Property="Tag" Value="{DynamicResource SoulStoneSmallBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Facts.Size}" Value="Moyenne">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Setter Property="Tag" Value="{DynamicResource SoulStoneMediumBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Facts.Size}" Value="Grande">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Setter Property="Tag" Value="{DynamicResource SoulStoneLargeBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Facts.Size}" Value="Gigantesque">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Setter Property="Tag" Value="{DynamicResource SoulStoneHugeBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Viewbox.Style>

                          <!-- The game's icon, traced on a 16 unit square:
                               a plum cluster of two shards behind, its
                               left shard lit and a glint on the right;
                               in front, a dark left shard, a tall pale
                               central one whose right half catches the
                               light, and a right shard in half shadow,
                               every piece parted by a dark edge. -->
                          <Canvas Width="16" Height="16">
                            <Path Fill="{DynamicResource SoulStoneTipBrush}"
                                  Stroke="{DynamicResource SoulStoneEdgeBrush}"
                                  StrokeThickness="0.28" StrokeLineJoin="Round"
                                  Data="M 5.1,6 L 7,1.4 L 7.6,1.4 L 8,1 L 9,1.8 L 10.3,6 L 9.2,8.6 L 6,7 Z" />
                            <Path Fill="{DynamicResource SoulStoneShadeBrush}"
                                  Data="M 6.6,6 L 7.6,2.2 L 8.4,1.8 L 9.8,5.8 L 9.2,8.4 Z" />
                            <Path Fill="{DynamicResource SoulStoneLightBrush}"
                                  Data="M 5.1,6 L 7,1.4 L 7.6,1.4 L 6.6,6 Z" />
                            <Path Fill="{DynamicResource SoulStoneGlintBrush}"
                                  Data="M 8.6,5.2 A 0.6,0.6 0 1 0 9.8,5.2 A 0.6,0.6 0 1 0 8.6,5.2 Z" />
                            <Path Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Viewbox}}"
                                  Stroke="{DynamicResource SoulStoneEdgeBrush}"
                                  StrokeThickness="0.28" StrokeLineJoin="Round"
                                  Data="M 5,5.8 L 6.6,6.6 L 7.4,5.2 L 8.6,7 L 9.9,5.9 L 10.7,6.6 L 11.3,9.2 L 10.6,11.7 L 8.6,13.9 L 8,14.9 L 5.8,14 L 4.2,11.5 L 4.3,9 Z" />
                            <Path Fill="{DynamicResource SoulStoneDeepBrush}"
                                  Data="M 5,5.8 L 6.6,6.6 L 5.4,11.1 L 6.5,13.4 L 5.8,14 L 4.2,11.5 L 4.3,9 Z" />
                            <Path Fill="{DynamicResource SoulStoneSheenBrush}"
                                  Data="M 7.4,5.2 L 9.2,8.6 L 8.6,13.9 L 8,14.9 L 6.9,14.1 L 5.4,11.1 Z" />
                            <Path Fill="{DynamicResource SoulStoneGlintBrush}"
                                  Data="M 7.4,5.2 L 9.2,8.6 L 8.6,13.9 L 8,14.9 Z" />
                            <Path Fill="{DynamicResource SoulStoneShadeBrush}"
                                  Data="M 9.9,5.9 L 10.7,6.6 L 11.3,9.2 L 10.6,11.7 L 9.2,8.6 Z" />
                            <Path Fill="{DynamicResource SoulStoneSheenBrush}"
                                  Data="M 9.2,8.6 L 10.6,11.7 L 8.6,13.9 Z" />
                            <Path Stroke="{DynamicResource SoulStoneEdgeBrush}"
                                  StrokeThickness="0.28" StrokeLineJoin="Round"
                                  Data="M 7.4,5.2 L 9.2,8.6 L 8.6,13.9 M 9.2,8.6 L 10.6,11.7 M 6.6,6.6 L 5.4,11.1 L 6.5,13.4" />
                          </Canvas>
                        </Viewbox>
                      </StackPanel>

                      <!-- The one place a fixed pitch earns its keep: in
                           the proportional face, [7,-25] and [-63,-75]
                           do not begin at the same offset, so the
                           brackets never form a column. -->
                      <TextBlock Grid.Column="1" Text="{Binding Facts.Position}"
                                 TextAlignment="Right"
                                 TextWrapping="NoWrap" VerticalAlignment="Center"
                                 Style="{StaticResource Muted}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="{StaticResource FontSmall}" />

                      <!-- The key required at a dungeon's entrance, last
                           on the right. Nine out of eighty-three don't
                           require one, and therefore have no icon: the
                           absence is information in itself, and the
                           column stays so the positions do not shift. Its
                           name is too long for the column and comes on
                           hover. -->
                      <Border Grid.Column="2" Background="Transparent"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip="{Binding Dungeon.Key}"
                              ToolTipService.InitialShowDelay="200"
                              Visibility="{Binding Dungeon.NeedsKey,
                                                   Converter={StaticResource BoolToVisibility},
                                                   FallbackValue=Collapsed}">
                        <Path Style="{StaticResource ListGlyph}"
                              Stroke="{DynamicResource GlyphDungeonBrush}"
                              Data="M 5.2,7.5 m -2.6,0 a 2.6,2.6 0 1 0 5.2,0
                                    a 2.6,2.6 0 1 0 -5.2,0
                                    M 7.8,7.5 H 12.8 M 10.3,7.5 V 9.8 M 12.4,7.5 V 9.3" />
                      </Border>
                    </Grid>

                    <!-- Still the right-hand text of every other kind of
                         row: the root's counts, a zone's level range, an
                         achievement's tally. Hidden when empty, since an
                         empty block still claims its margin. On a zone
                         with a tally it becomes a fixed, right-aligned
                         column (trigger below), so the ranges stand in a
                         column and never touch the tally. -->
                    <TextBlock x:Name="Detail" Text="{Binding Detail}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                               Visibility="{Binding Detail,
                                                    Converter={StaticResource EmptyToVisibility},
                                                    ConverterParameter=inverse}" />

                    <!-- A zone's progress, in two columns of fixed width
                         (fixed and not shared, for the virtualization
                         reason given above): an hourglass and the quests
                         in progress, then the quests done once over all of
                         them, or a check once they are all done; under the
                         filters, the quests they keep. Each part
                         is hidden, not collapsed, when it has nothing to
                         say, so the other stays in its column. Under
                         "Faisables" the hourglass column goes: the doable
                         count already holds the quests in progress. -->
                    <Grid VerticalAlignment="Center" Margin="12,0,0,0"
                          Visibility="{Binding Tally,
                                               Converter={StaticResource EmptyToVisibility},
                                               ConverterParameter=inverse}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                      </Grid.ColumnDefinitions>

                      <Border x:Name="ZoneEnCoursCase" Grid.Column="0" Width="34">
                        <StackPanel x:Name="ZoneEnCours" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="{Binding Tally.StartedTip}"
                                    ToolTipService.InitialShowDelay="200">
                          <Path Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"
                                Stretch="None" Stroke="{DynamicResource AccentBrush}"
                                StrokeThickness="1.5" StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Data="M 2.5,1.5 H 9.5 M 2.5,10.5 H 9.5
                                      M 3.5,1.5 L 6,6 L 3.5,10.5 M 8.5,1.5 L 6,6 L 8.5,10.5" />
                          <TextBlock Text="{Binding Tally.Started}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentBrush}"
                                     FontSize="{StaticResource FontSmall}" />
                        </StackPanel>
                      </Border>

                      <TextBlock x:Name="ZoneFait" Grid.Column="1" Text="{Binding Tally.Count}"
                                 ToolTip="{Binding Tally.PassingTip}" ToolTipService.InitialShowDelay="200"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />

                      <Border x:Name="ZoneFinie" Grid.Column="1" Width="12" Height="12"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Background="Transparent" Visibility="Collapsed"
                              ToolTip="{Binding Tally.Count}"
                              ToolTipService.InitialShowDelay="200">
                        <Path Stretch="None" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 2,6.5 L 5,9.5 L 10.5,3" />
                      </Border>
                    </Grid>

                    <!-- The right-hand icons of a quest row: gift, priority,
                         rhythm, status, lock, then the time and the two gains.
                         Each icon is collapsed when it has nothing to say, so
                         the ones present, each in a 15 px square (the rhythm's
                         and the lock's drawing size), pack against the time
                         three pixels apart:
                         the user prefers no gaps to straight icon columns.
                         The lock comes last as it is on most quests, so the
                         status mark beside it lines up in practice. Only the
                         time and the gains keep fixed columns, they have to
                         line up.
                         Everything is collapsed on rows that are not quests.
                         A transparent border carries each tooltip, an open
                         stroke catches no hover. -->
                    <!-- A gift: the quest gives more than XP and kamas, what
                         comes on hover. Collapsed otherwise, like the others. -->
                    <Border x:Name="Cadeau" Width="15" Height="15"
                            Margin="3,0,0,0" VerticalAlignment="Center"
                            Background="Transparent"
                            ToolTip="{Binding OtherRewards}"
                            ToolTipService.InitialShowDelay="200"
                            Visibility="{Binding OtherRewards,
                                                 Converter={StaticResource EmptyToVisibility},
                                                 ConverterParameter=inverse}">
                      <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stretch="None" Stroke="{DynamicResource GlyphSuccessBrush}"
                            StrokeThickness="1.2" StrokeLineJoin="Round"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Data="M 1.5,4.5 H 10.5 V 6.5 H 1.5 Z M 2.5,6.5 V 11 H 9.5 V 6.5 M 6,4.5 V 11
                                  M 6,4.5 C 5,1.8 2.6,2.2 3.8,4.5 M 6,4.5 C 7,1.8 9.4,2.2 8.2,4.5" />
                    </Border>

                    <!-- The priority mark of a quest doable now, among the
                         character's doable quests: a flame, a hollow flame,
                         a dot. Hidden by default and collapsed on rows
                         without a dungeon: a dungeon row without a mark keeps
                         its square, so its facts stay in their column. -->
                    <Border x:Name="Priorite" Width="15" Height="15"
                            Margin="3,0,0,0" VerticalAlignment="Center"
                            Background="Transparent" Visibility="Hidden"
                            ToolTip="{Binding ProfitTip}"
                            ToolTipService.InitialShowDelay="200">
                      <Path x:Name="PrioriteTrait" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stretch="None"
                            Fill="{DynamicResource GlyphPriorityBrush}"
                            Stroke="{DynamicResource GlyphPriorityBrush}" StrokeThickness="0"
                            StrokeLineJoin="Round" />
                    </Border>

                    <!-- A quest's rhythm; a quest done once has none. The
                         word comes on hover. -->
                    <Border x:Name="Rythme" Width="15" Height="15" Margin="3,0,0,0"
                            Background="Transparent" VerticalAlignment="Center"
                            ToolTip="{Binding RecurrenceLabel}"
                            ToolTipService.InitialShowDelay="200"
                            Visibility="Collapsed">
                      <Path x:Name="RythmeTrait" Style="{StaticResource ListGlyph}"
                            HorizontalAlignment="Center" />
                    </Border>

                    <!-- The tracker's mark, the row's only status sign: a
                         check, an hourglass, a barred circle, a dash; the
                         word comes on hover. At the left of the name it
                         kept a gap between the level and the name on every
                         unmarked row. -->
                    <Border x:Name="Marque" Width="15" Height="15"
                            Margin="3,0,0,0" VerticalAlignment="Center"
                            Background="Transparent" Visibility="Collapsed"
                            ToolTipService.InitialShowDelay="200">
                      <Path x:Name="MarqueTrait" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stretch="None"
                            Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round" />
                    </Border>

                    <!-- A lock: what keeps the quest closed. A key had
                         been tried first; its ring and its diagonal
                         shank read like a magnifying glass, a few
                         centimetres from the search field. The site
                         attributes these prerequisites to six hundred
                         and thirteen quests, against one hundred and
                         seventeen to which it attributes a level.

                         This isn't a list of quests to complete
                         beforehand: across five hundred and
                         sixty-seven distinct prerequisites, you find
                         items to bring, an alignment, a number of
                         players, a level, and even time slots. The
                         word that covers them all is "prerequisites".

                         The tooltip is carried by a container with a
                         transparent background, rather than by the
                         stroke: an open stroke has no surface, so a
                         fill gives it no purchase, and you'd have to
                         aim for a line a pixel and a half wide.
                         Measured: on the stroke alone, hovering
                         triggered nothing.

                         It stays displayed for a long time, because a
                         list of prerequisites reads more slowly than a
                         button's single word.

                         15 px square like the other signs, not the icon
                         button's 24 high: a row with the lock grew taller
                         than its neighbours. -->
                    <Button x:Name="Cadenas" Style="{StaticResource IconButton}"
                            Width="15" Height="15" VerticalAlignment="Center" Margin="3,0,0,0"
                            Click="OnShowNeeds"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000"
                            Visibility="Collapsed">
                      <Button.ToolTip>
                        <ToolTip Style="{StaticResource RichToolTip}">
                          <StackPanel MaxWidth="330">
                            <TextBlock Text="{loc:T Prerequisites}" Margin="0,0,0,6"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlyphNeedBrush}" />

                            <ItemsControl ItemsSource="{Binding Needs}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="11" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="Puce" Grid.Column="0" Width="3" Height="3"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="0,7,0,0"
                                             Fill="{DynamicResource TextMutedBrush}" />

                                    <!-- A check on a prerequisite done, a cross on one missing
                                         (unmet lock only); items and free text keep the dot. -->
                                    <Path x:Name="Coche" Grid.Column="0" Width="9" Height="9" Visibility="Collapsed"
                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stroke="{DynamicResource SuccessBrush}" Data="M 0.7,4.6 L 3.2,7 L 8,1.8" />

                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                                               Foreground="{DynamicResource TextBrush}" />
                                  </Grid>
                                  <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Met}" Value="True">
                                      <Setter TargetName="Puce" Property="Visibility" Value="Collapsed" />
                                      <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Met}" Value="False">
                                      <Setter TargetName="Puce" Property="Visibility" Value="Collapsed" />
                                      <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                                      <Setter TargetName="Coche" Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                      <Setter TargetName="Coche" Property="Data" Value="M 1.5,1.5 L 7.5,7.5 M 7.5,1.5 L 1.5,7.5" />
                                    </DataTrigger>
                                  </DataTemplate.Triggers>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontTiny}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{loc:T ClickQuestsHint}" />
                          </StackPanel>
                        </ToolTip>
                      </Button.ToolTip>

                      <!-- With the tracker linked, the lock shows only when the
                           prerequisites are not met for the chosen character,
                           in the warning colour (met: no lock at all, see the
                           row triggers). Unlinked, the neutral lock only says
                           the quest has some. -->
                      <Path>
                        <Path.Style>
                          <Style TargetType="Path" BasedOn="{StaticResource ListGlyph}">
                            <Setter Property="Stroke" Value="{DynamicResource GlyphNeedBrush}" />
                            <Setter Property="Data"
                                    Value="M 5.1,7 L 5.1,5.2 A 2.4,2.4 0 0 1 9.9,5.2 L 9.9,7 M 3.7,7 L 11.3,7 L 11.3,12.9 L 3.7,12.9 Z M 7.5,9.3 L 7.5,10.8" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsMet}" Value="False">
                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Path.Style>
                      </Path>
                    </Button>

                    <!-- The estimated time, in a slot of fixed width just left of the gains, the
                         words right-aligned: it stands at the same place on every row whatever
                         icons come before it (with a gift it used to sit 18 px further left).
                         46 px holds "≈ 12 h 34", 44.8 measured in this face; a longer time
                         widens its row rather than being cut. Collapsed when the game's
                         objectives are not read yet. -->
                    <TextBlock x:Name="Duree" MinWidth="46" Margin="4,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Duration}" TextWrapping="NoWrap" TextAlignment="Right"
                               Style="{StaticResource Muted}"
                               FontSize="{StaticResource FontSmall}"
                               ToolTip="{Binding ProfitTip}"
                               ToolTipService.InitialShowDelay="200"
                               Visibility="{Binding Duration,
                                                    Converter={StaticResource EmptyToVisibility},
                                                    ConverterParameter=inverse}" />

                    <!-- What the quest gives the chosen character: XP then
                         kamas, last on the right in two fixed columns. The
                         glyph sits at the column's left edge and the number at
                         its right, so both line up down the list; tabular
                         figures, so "314" and "780" are as wide. Widths
                         measured in this face at 11 px, glyph and gap 12: XP
                         58 for "≤ 99,9 M" (43.6, a quest in progress) or a
                         team's "1234,5 M" (43.2); kamas 50 for "≤ 9,9 M"
                         (37.7) or "≤ 999 k" (36.8). A glyph says
                         which is which, the words come on hover: a blue
                         four-point sparkle for XP, a gold coin for kamas.
                         The kamas column stays empty when there are none.
                         Hidden on a quest row without data, collapsed on
                         other rows and in a list with no gain at all. -->
                    <!-- The gains' hover adds, for a quest asking items, where
                         they come from: read when the hover opens, dropped
                         when it closes, filled in place once read. Rich: the
                         plain tooltip shows its content as text, and a panel
                         as text is empty. -->
                    <Border x:Name="GainXp" Width="58" Margin="3,0,0,0"
                            Background="Transparent" VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000"
                            ToolTipOpening="OnGainTipOpening" ToolTipClosing="OnGainTipClosing">
                      <Border.ToolTip>
                        <ToolTip Style="{StaticResource RichToolTip}">
                          <StackPanel MaxWidth="330" TextElement.Foreground="{DynamicResource TextBrush}"
                                      TextElement.FontFamily="{StaticResource UiFont}"
                                      TextElement.FontSize="{StaticResource FontBody}">
                            <TextBlock Text="{Binding ProfitTip}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                      <DockPanel x:Name="GainXpValeur">
                        <Path DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"
                              Stretch="None" Fill="{DynamicResource GainXpBrush}"
                              Data="M 5,0.5 C 5.4,3.6 6.4,4.6 9.5,5 C 6.4,5.4 5.4,6.4 5,9.5
                                    C 4.6,6.4 3.6,5.4 0.5,5 C 3.6,4.6 4.6,3.6 5,0.5 Z" />
                        <TextBlock Text="{Binding GainXp}" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   Foreground="{DynamicResource GainXpBrush}"
                                   FontSize="{StaticResource FontSmall}" />
                      </DockPanel>
                    </Border>
                    <Border x:Name="GainKamas" Width="50" Margin="4,0,0,0"
                            Background="Transparent" VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000"
                            ToolTipOpening="OnGainTipOpening" ToolTipClosing="OnGainTipClosing">
                      <Border.ToolTip>
                        <ToolTip Style="{StaticResource RichToolTip}">
                          <StackPanel MaxWidth="330" TextElement.Foreground="{DynamicResource TextBrush}"
                                      TextElement.FontFamily="{StaticResource UiFont}"
                                      TextElement.FontSize="{StaticResource FontBody}">
                            <TextBlock Text="{Binding ProfitTip}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                      <DockPanel x:Name="GainKamasValeur">
                        <Path DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,2,0" VerticalAlignment="Center"
                              Stretch="None" Stroke="{DynamicResource GainKamasBrush}"
                              StrokeThickness="1.2"
                              Data="M 0.9,5 A 4.1,4.1 0 1 0 9.1,5 A 4.1,4.1 0 1 0 0.9,5 Z
                                    M 3.2,5 A 1.8,1.8 0 1 0 6.8,5 A 1.8,1.8 0 1 0 3.2,5 Z" />
                        <TextBlock Text="{Binding GainKamas}" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   Foreground="{DynamicResource GainKamasBrush}"
                                   FontSize="{StaticResource FontSmall}" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Grid>

                <DataTemplate.Triggers>
                  <!-- First, what the row is: a subheading is set apart
                       from what it heads, otherwise a section would
                       read as just another quest. The offset applies
                       to the whole row, otherwise the icon would sit
                       eight pixels too high.

                       The icon comes next, and is set by the row's
                       nature rather than its kind: two branches unfold
                       the same way without denoting the same thing. -->
                  <!-- **The hierarchy was upside down.** A band header
                       was set to eleven pixels above the thirteen-pixel
                       rows it headed, so the thing that organised the
                       list was the smallest text in it. There is no size
                       setter here any more: the row keeps the implicit
                       thirteen, and weight, colour, air and a rule carry
                       the heading. Fifteen would have shouted.

                       The rule is the one already in the template. A new
                       band of fifty levels starting here is exactly what
                       it is for, and Header and Section never appear in
                       the same list, so borrowing it confuses nothing. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,16,0,4" />
                    <Setter TargetName="Filet" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- The same inversion, corrected the same way. No
                       rule here: an achievement title already carries a
                       star, a tally, and the quests indented beneath it
                       on a connecting line. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,16,0,4" />
                  </DataTrigger>

                  <!-- A results group's title dominates everything else:
                       bigger, in full text colour, preceded by a
                       divider. It heads achievements that already carry
                       the blue and the semi-bold weight of subheadings. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Section">
                    <Setter TargetName="Libelle" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Libelle" Property="FontSize" Value="{StaticResource FontMedium}" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0,18,0,5" />
                    <Setter TargetName="Filet" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- An achievement's quest is indented and gets its
                       line. -->
                  <DataTrigger Binding="{Binding InSuccess}" Value="True">
                    <Setter TargetName="Trait" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Ligne" Property="Margin" Value="0" />
                    <Setter TargetName="Libelle" Property="Margin" Value="9,3,0,3" />
                  </DataTrigger>

                  <!-- A dungeon's path, above its dungeon: its road takes
                       the place of the level, right-aligned in the level
                       column (22 wide) like the numbers, and its label
                       starts where the dungeon names do (32). Left in the
                       glyph column, the road read as a row of its own. -->
                  <DataTrigger Binding="{Binding Nested}" Value="True">
                    <Setter TargetName="Nature" Property="Grid.Column" Value="1" />
                    <Setter TargetName="Nature" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Nature" Property="Margin" Value="7,0,0,0" />
                    <Setter TargetName="Libelle" Property="Margin" Value="32,0,0,0" />
                    <Setter TargetName="CrochetHaut" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding AfterPath}" Value="True">
                    <Setter TargetName="CrochetBas" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- The break's blank space, placed on the row before
                       it. -->
                  <DataTrigger Binding="{Binding Spaced}" Value="True">
                    <Setter TargetName="Ligne" Property="Margin" Value="0,3,0,14" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Success">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphSuccessBrush}" />
                    <!-- A star: what you obtain. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,2 L 9.2,5.9 L 13.3,6.4 L 10.3,9.2 L 11.1,13.2
                                   L 7.5,11.2 L 3.9,13.2 L 4.7,9.2 L 1.7,6.4 L 5.8,5.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Place">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- A pin: a place you're going to. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 7.5,13.6 C 7.5,13.6 12.3,8.6 12.3,6.1
                                   A 4.8,4.8 0 1 0 2.7,6.1 C 2.7,8.6 7.5,13.6 7.5,13.6 Z
                                   M 7.5,6.1 m -1.7,0 a 1.7,1.7 0 1 0 3.4,0
                                   a 1.7,1.7 0 1 0 -3.4,0" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Route">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphPlaceBrush}" />
                    <!-- Flat caps, unlike the rounded ones on the rest of
                         the list: a round cap overflows by three
                         quarters of a unit on each side, and it was
                         closing up the gaps in the middle line, which
                         are only two units wide. -->
                    <Setter TargetName="Nature" Property="StrokeStartLineCap" Value="Flat" />
                    <Setter TargetName="Nature" Property="StrokeEndLineCap" Value="Flat" />
                    <!-- A road in perspective: two shoulders converging,
                         a dashed centre line. The place pin used to
                         hold this spot, and a route isn't a place: it
                         joins two of them.

                         Three other drawings were built and looked at
                         before this one, and none of them held up at
                         fifteen units: a curve with one bend gave a
                         bone, a curve with two bends a chevron, a
                         dashed arrow a solid arrow, its gaps eaten by
                         the rounded caps. A signpost read fine, but it
                         pointed to a direction, not a route. What
                         remains is the road itself, made of nothing
                         but straight lines. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.2,13.6 L 5.5,2.4
                                   M 11.8,13.6 L 9.5,2.4
                                   M 7.5,12.4 V 10.2
                                   M 7.5,8.4 V 6.4
                                   M 7.5,4.6 V 3.2" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Family">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke"
                            Value="{DynamicResource GlyphFamilyBrush}" />
                    <!-- A bookmark: a family of quests, which sorts
                         without placing. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4,2.4 L 11,2.4 L 11,12.9 L 7.5,10.1 L 4,12.9 Z" />
                  </DataTrigger>

                  <!-- The root's four entries are drawn solid rather
                       than outlined, unlike the rest of the list: they
                       are game objects, not sorting markers, and a
                       stroke a pixel and a half wide made them look
                       faded.

                       Three of them carry the same tint: a dungeon, a
                       raid and a lair are the same kind of place, and
                       the colour states the kind while the shape
                       states which of the three. Distinguishing them
                       by tint too would have pushed the list to eight
                       colours, where six is already barely enough.

                       The holes come from the even-odd fill rule, the
                       default rule of the drawing language: an inner
                       outline punches through the one that surrounds
                       it, without having to say so. -->
                  <DataTrigger Binding="{Binding Glyph}" Value="Quests">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <!-- The neutral tint of the home screen's three other
                         rows. The scroll used to be the only one in
                         colour there, and nothing justified singling
                         out one of the four kinds where they are all
                         equal. -->
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A scroll: two pill-shaped rolls, a body, and two
                         hollowed-out lines of writing. The drawing is
                         ours; the site's own will only be reused if
                         they grant it. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.7,2.7 H 11.3 A 1.05,1.05 0 0 1 11.3,4.8
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,2.7 Z
                                   M 4.1,4.8 H 10.9 V 10.2 H 4.1 Z
                                   M 3.7,10.2 H 11.3 A 1.05,1.05 0 0 1 11.3,12.3
                                   H 3.7 A 1.05,1.05 0 0 1 3.7,10.2 Z
                                   M 5.6,6.2 H 9.4 V 7.0 H 5.6 Z
                                   M 5.6,8.0 H 9.4 V 8.8 H 5.6 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Dungeons">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A dungeon in the literal sense: a crenellated
                         tower, its arched door and murder hole
                         hollowed out.

                         A key lying on its side had held this spot; it
                         was already saying something else. The
                         right-hand column marks with a key the
                         seventy-three dungeons that require one, and a
                         search would therefore show the same key twice
                         on a single row, on the left to say "dungeon"
                         and on the right to say "you need one".
                         Measured on "bworker". The key now means only
                         one thing. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,2.3 H 5.7 V 4.6 H 6.4 V 2.3 H 8.6 V 4.6
                                   H 9.3 V 2.3 H 11.5 V 13.1 H 3.5 Z
                                   M 6.3,13.1 V 9.9 A 1.2,1.2 0 0 1 8.7,9.9
                                   V 13.1 Z
                                   M 6.9,5.9 H 8.1 V 7.9 H 6.9 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Raids">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A skull: the raid is the fight that kills.

                         Two crossed swords had been drawn first, and
                         built into the application to be seen. At
                         their actual size, twenty-two pixels, the
                         guard and the pommel no longer read: all that's
                         left is a cross, a few centimetres from the one
                         that clears the search field. The skull holds
                         up because it's made of nothing but masses: a
                         skullcap, two eye sockets, a jaw. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 3.5,8 A 4,4.4 0 0 1 11.5,8 L 11.5,9.8 L 3.5,9.8 Z
                                   M 5.4,9.8 H 9.6 L 8.9,12.6 H 6.1 Z
                                   M 6,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 9,7.1 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0
                                   a 1.3,1.3 0 1 0 -2.6,0
                                   M 6.75,9.8 H 7.2 V 12.35 H 6.75 Z
                                   M 7.8,9.8 H 8.25 V 12.3 H 7.8 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Glyph}" Value="Lairs">
                    <Setter TargetName="Nature" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nature" Property="Stroke" Value="{x:Null}" />
                    <Setter TargetName="Nature" Property="Fill"
                            Value="{DynamicResource GlyphDungeonBrush}" />
                    <!-- A paw print: a lair is a beast's den, and that's
                         what sets it apart from a dungeon, built by
                         human hands. -->
                    <Setter TargetName="Nature" Property="Data"
                            Value="M 4.35,9.9 a 3.15,2.6 0 1 0 6.3,0
                                   a 3.15,2.6 0 1 0 -6.3,0 Z
                                   M 4.25,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 8.15,4.8 a 1.3,1.75 0 1 0 2.6,0
                                   a 1.3,1.75 0 1 0 -2.6,0 Z
                                   M 1.6,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z
                                   M 11.1,7 a 1.15,1.55 0 1 0 2.3,0
                                   a 1.15,1.55 0 1 0 -2.3,0 Z" />
                  </DataTrigger>

                  <!-- A line that only says something is coming, or that
                       nothing came: in the muted ink. -->
                  <DataTrigger Binding="{Binding Kind}" Value="Pending">
                    <Setter TargetName="Libelle" Property="Foreground"
                            Value="{DynamicResource TextMutedBrush}" />
                  </DataTrigger>

                  <!-- Before the quest trigger below, which must win on
                       rows that are not quests. -->
                  <DataTrigger Binding="{Binding GainKamas}" Value="{x:Null}">
                    <Setter TargetName="GainKamasValeur" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- No XP at all (bounties, Nowel stars): no "0", the column and its hover stay. -->
                  <DataTrigger Binding="{Binding GainXp}" Value="">
                    <Setter TargetName="GainXpValeur" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding GainXp}" Value="{x:Null}">
                    <Setter TargetName="GainXp" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="GainKamas" Property="Visibility" Value="Hidden" />
                  </DataTrigger>

                  <!-- Before the marks below, which must win on quest rows. -->
                  <DataTrigger Binding="{Binding Dungeon}" Value="{x:Null}">
                    <Setter TargetName="Priorite" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- The priority marks, on a twelve unit square: a flame
                       for the best tenth, the same flame hollow for the
                       next, a dot for the quarter after. -->
                  <DataTrigger Binding="{Binding Tier}" Value="3">
                    <Setter TargetName="Priorite" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PrioriteTrait" Property="Data"
                            Value="M 6,0.8 C 6.9,3 9.8,4.6 9.8,7.6 A 3.8,3.6 0 0 1 2.2,7.6
                                   C 2.2,5.9 3.2,4.9 4,3.8 C 4.3,5 4.9,5.6 5.5,5.8
                                   C 5.2,4.1 5.3,2.4 6,0.8 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Tier}" Value="2">
                    <Setter TargetName="Priorite" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PrioriteTrait" Property="Fill" Value="{x:Null}" />
                    <Setter TargetName="PrioriteTrait" Property="StrokeThickness" Value="1.3" />
                    <Setter TargetName="PrioriteTrait" Property="Data"
                            Value="M 6,1.4 C 6.8,3.4 9.4,4.8 9.4,7.6 A 3.4,3.2 0 0 1 2.6,7.6
                                   C 2.6,6 3.5,5.1 4.1,4.3 C 4.4,5.2 4.9,5.7 5.5,5.9
                                   C 5.3,4.4 5.4,2.9 6,1.4 Z" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Tier}" Value="1">
                    <Setter TargetName="Priorite" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PrioriteTrait" Property="Data"
                            Value="M 4,7 A 2,2 0 1 0 8,7 A 2,2 0 1 0 4,7 Z" />
                  </DataTrigger>

                  <!-- Keyed on the quest and not on the kind: dungeon, raid,
                       lair and path rows are of the quest kind too, and kept
                       the two empty columns on their right. -->
                  <DataTrigger Binding="{Binding Quest}" Value="{x:Null}">
                    <Setter TargetName="Marque" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Rythme" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Cadenas" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- A dungeon row keeps the gain columns: it is worth the
                       quests it advances, and its mark and gains say so. A
                       dungeon worth nothing keeps the gains and the mark's
                       square hidden, not collapsed, so the facts on its left
                       stay in their column. -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Quest}" Value="{x:Null}" />
                      <Condition Binding="{Binding Dungeon}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Priorite" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GainXp" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GainKamas" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>

                  <DataTrigger Binding="{Binding DataContext.ListHasQuestGains,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                               Value="False">
                    <Setter TargetName="GainXp" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GainKamas" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- A quest row keeps the level column only when a quest
                       of the list has a level; a dungeon row (Facts) always
                       does. -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Facts}" Value="{x:Null}" />
                      <Condition Binding="{Binding DataContext.ListHasQuestLevels,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Niveau" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>

                  <!-- The mark's four drawings, on a twelve unit square. -->
                  <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter TargetName="Marque" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Marque" Property="ToolTip" Value="{loc:T QuestStatusCompleted}" />
                    <Setter TargetName="MarqueTrait" Property="Data" Value="M 2,6.5 L 5,9.5 L 10.5,3" />
                  </DataTrigger>

                  <!-- An hourglass, as the game's journal marks a quest
                       under way: two caps and the glass pinched between. -->
                  <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter TargetName="Marque" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Marque" Property="ToolTip" Value="{loc:T QuestStatusInProgress}" />
                    <Setter TargetName="MarqueTrait" Property="Data"
                            Value="M 2.5,1.5 H 9.5 M 2.5,10.5 H 9.5
                                   M 3.5,1.5 L 6,6 L 3.5,10.5 M 8.5,1.5 L 6,6 L 8.5,10.5" />
                  </DataTrigger>

                  <!-- Blocked or ignored: still there, but out of the way,
                       and their marks in the muted ink. -->
                  <DataTrigger Binding="{Binding Status}" Value="Blocked">
                    <Setter TargetName="Ligne" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Marque" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Marque" Property="ToolTip" Value="{loc:T QuestStatusBlocked}" />
                    <Setter TargetName="MarqueTrait" Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="MarqueTrait" Property="Data"
                            Value="M 1.5,6 A 4.5,4.5 0 1 0 10.5,6 A 4.5,4.5 0 1 0 1.5,6
                                   M 2.8,2.8 L 9.2,9.2" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Status}" Value="Ignored">
                    <Setter TargetName="Ligne" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Marque" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Marque" Property="ToolTip" Value="{loc:T QuestStatusIgnored}" />
                    <Setter TargetName="MarqueTrait" Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                    <Setter TargetName="MarqueTrait" Property="Data" Value="M 3,6 H 9" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding HasNeeds}" Value="True">
                    <Setter TargetName="Cadenas" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <!-- Met prerequisites say nothing worth a glyph (the user's call):
                       after HasNeeds, so it wins. -->
                  <DataTrigger Binding="{Binding NeedsMet}" Value="True">
                    <Setter TargetName="Cadenas" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- The rhythms, on the list's fifteen unit square. A
                       calendar page with its day count for the daily and
                       weekly ones; two arrows chasing each other round for
                       the repeatable ones; a leaf for the seasonal ones. -->
                  <DataTrigger Binding="{Binding Recurrence}" Value="Daily">
                    <Setter TargetName="Rythme" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RythmeTrait" Property="Data"
                            Value="M 2.5,2.5 H 12.5 V 13.5 H 2.5 Z M 2.5,4.5 H 12.5
                                   M 6.6,7.8 L 7.8,7 V 11" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Recurrence}" Value="Weekly">
                    <Setter TargetName="Rythme" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RythmeTrait" Property="Data"
                            Value="M 2.5,2.5 H 12.5 V 13.5 H 2.5 Z M 2.5,4.5 H 12.5
                                   M 5.9,7 H 9.1 L 7.1,11" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Recurrence}" Value="Repeatable">
                    <Setter TargetName="Rythme" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RythmeTrait" Property="Data"
                            Value="M 3.27,6 A 4.5,4.5 0 0 1 11.73,6
                                   M 12.52,3.94 L 11.73,6 L 9.84,4.87
                                   M 11.73,9 A 4.5,4.5 0 0 1 3.27,9
                                   M 2.48,11.06 L 3.27,9 L 5.16,10.13" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Recurrence}" Value="Seasonal">
                    <Setter TargetName="Rythme" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RythmeTrait" Property="Data"
                            Value="M 3,12.5 C 3,6.5 6,3 12.5,2.5 C 12,9 8.5,12.5 3,12.5 Z
                                   M 3,12.5 L 8.5,7" />
                  </DataTrigger>

                  <!-- A zone with a tally: its level range becomes a fixed,
                       right-aligned column, kept even when empty. -->
                  <DataTrigger Binding="{Binding Tally,
                                                 Converter={StaticResource EmptyToVisibility},
                                                 ConverterParameter=inverse}"
                               Value="Visible">
                    <Setter TargetName="Detail" Property="Width" Value="52" />
                    <Setter TargetName="Detail" Property="TextAlignment" Value="Right" />
                    <Setter TargetName="Detail" Property="Visibility" Value="Visible" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Tally.Started}" Value="0">
                    <Setter TargetName="ZoneEnCours" Property="Visibility" Value="Hidden" />
                  </DataTrigger>

                  <!-- "quand Faisables est activé, enlève carrément le nombre ici, ça fait
                       doublon" (24/10/2026): a tally of doable quests has a tip. -->
                  <DataTrigger Binding="{Binding Tally.PassingTip,
                                                 Converter={StaticResource EmptyToVisibility},
                                                 ConverterParameter=inverse}"
                               Value="Visible">
                    <Setter TargetName="ZoneEnCoursCase" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>

                  <!-- A zone of repeatables only has nothing to count. -->
                  <DataTrigger Binding="{Binding Tally.Total}" Value="0">
                    <Setter TargetName="ZoneFait" Property="Visibility" Value="Hidden" />
                  </DataTrigger>

                  <DataTrigger Binding="{Binding Tally.IsComplete}" Value="True">
                    <Setter TargetName="ZoneFait" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ZoneFinie" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
