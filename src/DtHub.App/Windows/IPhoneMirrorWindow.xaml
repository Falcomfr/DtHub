<Window x:Class="DtHub.App.Windows.IPhoneMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Width="480" Height="860" Background="Black">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <wv:WebView2 x:Name="View" Visibility="Hidden" />
    <TextBlock x:Name="Status" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
               VerticalAlignment="Center" Margin="24" />
    <Button x:Name="RotateButton" Grid.Row="1" Content="{loc:T IPhoneRotate}" HorizontalAlignment="Center"
            Margin="6" MinWidth="110" Visibility="Collapsed" Click="OnRotate" />
  </Grid>
</Window>
