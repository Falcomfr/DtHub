<Window x:Class="DtHub.App.Windows.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="DT Hub"
        Width="400" Height="560"
        MinWidth="360" MinHeight="360"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display">

  <Border Background="{DynamicResource SurfaceAltBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
    <DockPanel>

      <!-- Bandeau : sert aussi de poignée de déplacement. -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
              CornerRadius="9,9,0,0" Padding="14,10" MouseLeftButtonDown="OnHeaderDrag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0" Source="/assets/app.png" Width="20" Height="20" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DT Hub" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11">
              <Run Text="{Binding ToggleShortcutText, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text=" pour afficher ou masquer" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                  FontSize="14" Padding="8,2" Click="OnHide"
                  ToolTip="Masquer le configurateur" />
        </Grid>
      </Border>

      <!-- Barre du bas : actions immédiates. -->
      <Border DockPanel.Dock="Bottom" Padding="12,10"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal">
          <Button Content="Lancer" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                  Command="{Binding LaunchEnabledCommand}" ToolTip="Ouvrir les instances cochées" />
          <Button Content="Replacer" Margin="0,0,6,0" Command="{Binding ArrangeCommand}"
                  ToolTip="Remettre toutes les fenêtres de jeu en place" />
          <Button Content="Tout fermer" Style="{StaticResource DangerButton}"
                  Command="{Binding CloseAllCommand}" />
          <Button Content="Quitter" Style="{StaticResource QuietButton}" Margin="6,0,0,0"
                  Click="OnQuit" ToolTip="Fermer DT Hub" />
        </StackPanel>
      </Border>

      <!-- Onglets -->
      <Grid Margin="12,12,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="TabHotkeys" Style="{StaticResource Tab}" Content="Raccourcis"
                       GroupName="Tabs" IsChecked="True" />
          <RadioButton x:Name="TabGeneral" Style="{StaticResource Tab}" Content="Général" GroupName="Tabs" />
          <RadioButton x:Name="TabDevices" Style="{StaticResource Tab}" Content="Appareils" GroupName="Tabs" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>

            <!-- Onglet Général -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabGeneral,
                                             Converter={StaticResource BoolToVisibility}}">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="POSITION DES FENÊTRES DE JEU" Style="{StaticResource SectionLabel}" />
                  <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                             Text="Toutes les fenêtres se superposent exactement à cet endroit." />

                  <ItemsControl ItemsSource="{Binding Anchors}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton Style="{StaticResource AnchorCell}" GroupName="Anchor"
                                     ToolTip="{Binding Converter={StaticResource AnchorLabel}}"
                                     Command="{Binding DataContext.SetAnchorCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}">
                          <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource SameValue}" Mode="OneWay">
                              <Binding Path="DataContext.GameAnchor"
                                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                              <Binding />
                            </MultiBinding>
                          </RadioButton.IsChecked>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Style="{StaticResource Muted}" Margin="2,8,0,0"
                             Text="{Binding GameAnchor, Converter={StaticResource AnchorLabel}}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="TAILLE DES FENÊTRES" Style="{StaticResource SectionLabel}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="30" Maximum="100" TickFrequency="5"
                            Value="{Binding GameSizePercent}" />
                    <TextBlock Grid.Column="1" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding GameSizePercent, StringFormat={}{0} %}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}"
                      Visibility="{Binding HasSeveralMonitors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="ÉCRAN" Style="{StaticResource SectionLabel}" />
                  <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding PreferredMonitor}"
                            DisplayMemberPath="DisplayName" />
                </StackPanel>
              </Border>

              <StackPanel Margin="2,4,0,10">
                <TextBlock Style="{StaticResource Muted}" FontSize="11">
                  <Run Text="{Binding ProductName, Mode=OneWay}" />
                  <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" FontSize="11" />
                <Button Content="Ouvrir le dossier des journaux" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" Margin="-8,4,0,0" Command="{Binding OpenLogsCommand}" />
              </StackPanel>

            </StackPanel>

            <!-- Onglet Appareils -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabDevices,
                                             Converter={StaticResource BoolToVisibility}}">

              <Button Content="+  Ajouter un appareil" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="Connecter un téléphone, ou voir la marche à suivre"
                      Click="OnAddDevice" />

              <w:InstanceListControl DataContext="{Binding Instances}" />

            </StackPanel>

            <!-- Onglet Raccourcis -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabHotkeys,
                                             Converter={StaticResource BoolToVisibility}}">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="VOS RACCOURCIS" Style="{StaticResource SectionLabel}" />
                  <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                             Text="Ils n'agissent que pendant qu'une fenêtre de DT Hub est active : Ctrl+Tab reste donc disponible dans vos autres logiciels." />

                  <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding ActionLabel}" Margin="0,0,0,4" />
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="6" Padding="9,6" Margin="0,0,6,0"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                              <TextBlock Text="{Binding ShortcutText}" />
                            </Border>

                            <Button Grid.Column="1" Content="Modifier"
                                    Command="{Binding DataContext.BeginCaptureCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                          </Grid>

                          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                                     FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"
                                     Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding HotkeyProblem}" Style="{StaticResource Muted}"
                             Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"
                             Visibility="{Binding HotkeyProblem, Converter={StaticResource EmptyToVisibility},
                                                  ConverterParameter=inverse}" />

                  <Button Content="Restaurer les raccourcis par défaut" Style="{StaticResource QuietButton}"
                          HorizontalAlignment="Left" Margin="-8,10,0,0"
                          Command="{Binding RestoreDefaultHotkeysCommand}" />
                </StackPanel>
              </Border>

            </StackPanel>

          </Grid>
        </ScrollViewer>
      </Grid>

    </DockPanel>
  </Border>
</Window>
