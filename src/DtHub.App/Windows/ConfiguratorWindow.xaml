<Window x:Class="DtHub.App.Windows.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="DT Hub"
        Width="400" Height="580"
        MinWidth="360" MinHeight="380"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display">

  <Border Background="{DynamicResource SurfaceAltBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
    <DockPanel>

      <!-- Bandeau : sert aussi de poignée de déplacement. -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
              CornerRadius="9,9,0,0" Padding="12,8" MouseLeftButtonDown="OnHeaderDrag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0" Source="/assets/app.png" Width="26" Height="26" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ProductName}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11">
              <Run Text="{Binding ToggleShortcutText, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text=" pour afficher ou masquer" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                  FontSize="14" Padding="8,2" Click="OnHide"
                  ToolTip="Masquer cette fenêtre" />
        </Grid>
      </Border>

      <!-- Barre du bas : outils à gauche, quitter à droite. -->
      <Border DockPanel.Dock="Bottom" Padding="10,8"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Les outils viendront s'ajouter ici, chacun avec son raccourci. -->
          <!-- Le raccourci passe sous son bouton : d'autres outils viendront se
               ranger à sa droite, sur la même ligne. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel>
            <Button Padding="8,5" Style="{StaticResource QuietButton}" HorizontalAlignment="Center"
                    ToolTip="Empiler toutes les fenêtres de jeu sur la dernière que vous avez utilisée, à sa position et à sa taille"
                    Command="{Binding RearrangeCommand}">
              <!-- Deux fenêtres superposées : c'est exactement ce que fait
                   l'action, et aucun glyphe ne le dit clairement. -->
              <Grid Width="20" Height="16">
                <Border Width="14" Height="11" CornerRadius="2"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        BorderThickness="1.4" BorderBrush="{DynamicResource TextMutedBrush}" />
                <Border Width="14" Height="11" CornerRadius="2"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderThickness="1.4" BorderBrush="{DynamicResource AccentBrush}" />
              </Grid>
            </Button>

            <TextBlock Text="{Binding RearrangeShortcutText}" Style="{StaticResource Muted}"
                       FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                       Visibility="{Binding RearrangeShortcutText,
                                            Converter={StaticResource EmptyToVisibility},
                                            ConverterParameter=inverse}" />
            </StackPanel>

            <StackPanel Margin="4,0,0,0">
              <Button Padding="8,5" Style="{StaticResource QuietButton}" HorizontalAlignment="Center"
                      ToolTip="Ranger deux fenêtres côte à côte, chacune sur une moitié de l'écran. La fenêtre active va à droite."
                      Command="{Binding TileCommand}">
                <!-- Deux fenêtres accolées, l'active en couleur à droite. -->
                <Grid Width="20" Height="16">
                  <Border Width="9" Height="13" CornerRadius="2"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          BorderThickness="1.4" BorderBrush="{DynamicResource TextMutedBrush}" />
                  <Border Width="9" Height="13" CornerRadius="2"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderThickness="1.4" BorderBrush="{DynamicResource AccentBrush}" />
                </Grid>
              </Button>

              <TextBlock Text="{Binding TileShortcutText}" Style="{StaticResource Muted}"
                         FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                         Visibility="{Binding TileShortcutText,
                                              Converter={StaticResource EmptyToVisibility},
                                              ConverterParameter=inverse}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <Button Content="Quitter" Click="OnQuit"
                    ToolTip="Fermer l'application et les fenêtres de jeu" />
            <TextBlock Text="{Binding QuitShortcutText}" Style="{StaticResource Muted}"
                       FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"
                       Visibility="{Binding QuitShortcutText,
                                            Converter={StaticResource EmptyToVisibility},
                                            ConverterParameter=inverse}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Onglets -->
      <Grid Margin="10,8,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="TabHotkeys" Style="{StaticResource Tab}" Content="Raccourcis"
                       GroupName="Tabs" IsChecked="True" />
          <RadioButton x:Name="TabGeneral" Style="{StaticResource Tab}" Content="Fenêtres" GroupName="Tabs" />
          <RadioButton x:Name="TabDevices" Style="{StaticResource Tab}" Content="Appareils" GroupName="Tabs" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
          <Grid>

            <!-- Onglet Raccourcis, en lecture seule -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabHotkeys,
                                             Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2" Background="Transparent"
                              ToolTip="{Binding ActionDetail}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                          <Border Grid.Column="1" CornerRadius="5" Padding="7,2"
                                  Background="{DynamicResource SurfaceAltBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="12" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="Modifier les raccourcis" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Click="OnEditHotkeys" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Onglet Fenêtres : replacement rapide et taille -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabGeneral,
                                             Converter={StaticResource BoolToVisibility}}">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="REPLACER LES FENÊTRES" Style="{StaticResource SectionLabel}" />

                  <ItemsControl ItemsSource="{Binding Anchors}" HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTip="Cliquez une case pour regrouper toutes les fenêtres à cet endroit de l'écran. C'est aussi le coin où s'ouvrent les fenêtres qui n'ont pas encore de place retenue.">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource AnchorCell}"
                                ToolTip="{Binding Converter={StaticResource AnchorLabel}}"
                                Command="{Binding DataContext.SetAnchorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="TAILLE DES FENÊTRES" Style="{StaticResource SectionLabel}"
                             ToolTip="Proportionnelle à la zone utilisable de l'écran, et non à ses pixels : la même valeur donne la même part d'écran partout. Les raccourcis Ctrl+1 à Ctrl+5 posent cinq repères sur ce curseur." />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Minimum="20" Maximum="100" TickFrequency="1"
                            SmallChange="1" LargeChange="5"
                            Value="{Binding SizePercent}" />

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                               MinWidth="42" TextAlignment="Right" FontWeight="SemiBold">
                      <Run Text="{Binding SizePercent, Mode=OneWay}" /><Run Text=" %" />
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="QUALITÉ" Style="{StaticResource SectionLabel}" />

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="Basse"
                                 Margin="0,0,5,0"
                                 ToolTip="Image en 720 au plus, 30 images par seconde, débit réduit, et le téléphone est interrogé deux fois moins souvent. Pour les machines et les téléphones modestes, ou beaucoup de comptes à la fois."
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Low}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="Moyenne"
                                 Margin="0,0,5,0"
                                 ToolTip="Image en 1080 au plus, 45 images par seconde. Le réglage d'origine, qui convient à la plupart des machines."
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Medium}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="Haute"
                                 Margin="0,0,5,0"
                                 ToolTip="Image en 1440 au plus, 60 images par seconde, débit doublé. Demande un téléphone récent et une bonne liaison."
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=High}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="Maximale"
                                 ToolTip="Image à la définition de la fenêtre, sans aucune borne, 120 images par seconde et débit doublé encore. Sans ménagement pour le téléphone : à réserver à un appareil récent, et en Wi-Fi à un réseau qui suit."
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Maximum}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="DISTANCE DANS LE JEU" Style="{StaticResource SectionLabel}"
                             ToolTip="Agit sur la densité de l'écran vu par Android, et non sur la finesse de l'image : à taille de fenêtre égale, le jeu montre plus ou moins de terrain." />

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="Très éloignée"
                                 Margin="0,0,5,0"
                                 ToolTip="Le plus de terrain qu'il soit possible d'afficher. L'interface du jeu devient petite : sur une fenêtre modeste, elle sera à la limite du lisible."
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Widest}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="Éloignée"
                                 Margin="0,0,5,0"
                                 ToolTip="Beaucoup de terrain visible, l'interface du jeu petite. Pratique pour suivre plusieurs comptes d'un coup d'oeil, moins confortable pour viser."
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Wide}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="Normale"
                                 Margin="0,0,5,0"
                                 ToolTip="Le réglage d'origine, celui d'un affichage de 1080 pixels à 240 ppp."
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Normal}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="Proche"
                                 ToolTip="Le moins de terrain visible, l'interface du jeu la plus grande. Confortable sur une petite fenêtre."
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Close}" />
                  </StackPanel>

                  <TextBlock Style="{StaticResource Muted}" FontSize="11"
                             Visibility="{Binding IsReopening, Converter={StaticResource BoolToVisibility}}"
                             Text="Les fenêtres ouvertes se rouvrent pour prendre le changement." />
                </StackPanel>
              </Border>

              <StackPanel Margin="2,4,0,10">
                <TextBlock Style="{StaticResource Muted}" FontSize="11">
                  <Run Text="{Binding ProductName, Mode=OneWay}" />
                  <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" FontSize="11" />
                <Button Content="Ouvrir le dossier des journaux" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" Margin="-9,4,0,0" Command="{Binding OpenLogsCommand}" />
              </StackPanel>

            </StackPanel>

            <!-- Onglet Appareils -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabDevices,
                                             Converter={StaticResource BoolToVisibility}}">

              <Button Content="+  Associer un nouvel appareil" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="À faire une seule fois par appareil. Les appareils déjà associés se connectent tout seuls."
                      Click="OnAddDevice" />

              <w:InstanceListControl DataContext="{Binding Instances}" />

            </StackPanel>

          </Grid>
        </ScrollViewer>

        <!-- Astuces de l'onglet Appareils, hors du contenu défilant : elles
             restent collées en bas de la page quelle que soit la longueur de
             la liste. La marge négative annule le remplissage et la bordure du
             bouton, neuf pixels, pour que le texte parte du même bord que la
             liste au-dessus. -->
        <StackPanel Grid.Row="2" Margin="0,6,0,0"
                    Visibility="{Binding IsChecked, ElementName=TabDevices,
                                         Converter={StaticResource BoolToVisibility}}">
          <Button Content="Plusieurs comptes sur un même appareil ?"
                  Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                  Margin="-9,0,0,0" Click="OnCloneHelp" />

          <Button Content="Une fenêtre se fige au bout d'un moment ?"
                  Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                  Margin="-9,0,0,0" Click="OnSleepHelp" />
        </StackPanel>
      </Grid>

    </DockPanel>
  </Border>
</Window>
