<Window x:Class="DtHub.App.Windows.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="DT Hub"
        Width="400" Height="580"
        MinWidth="360" MinHeight="380"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display">

  <Border Background="{DynamicResource SurfaceAltBrush}"
          BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
          CornerRadius="{StaticResource Radius}">
    <DockPanel>

      <!-- Bandeau : sert aussi de poignée de déplacement. -->
      <Border DockPanel.Dock="Top" Background="{StaticResource BrushedPanelBrush}"
              CornerRadius="{StaticResource RadiusTop}" Padding="12,8"
              BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnHeaderDrag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0" Source="/assets/app.png" Width="26" Height="26" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <!-- Le nom du jeu dit ici, une fois, sur la ligne du produit : il ne
                 coûte aucune hauteur et se voit sur les trois onglets. -->
            <TextBlock>
              <Run Text="{Binding ProductName, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
              <Run Text="{loc:T AppSubtitleForGame}" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" FontSize="11">
              <Run Text="{Binding ToggleShortcutText, Mode=OneWay}" FontWeight="SemiBold"
                   FontFamily="{StaticResource MonoFont}" />
              <Run Text="{loc:T ShortcutToggleSuffix}" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                  FontSize="14" Padding="8,2" Click="OnHide"
                  ToolTip="{loc:T HideThisWindow}" />
        </Grid>
      </Border>

      <!-- Ce que la prochaine version apporte. Le bandeau ne paraît que
           lorsqu'il y a quelque chose à dire, et il le dit en une ligne : la
           note complète tient dans sa propre fenêtre, qu'on ouvre si on veut. -->
      <Border DockPanel.Dock="Top" Padding="12,7"
              Background="{StaticResource BrushedPanelBrush}"
              BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding UpdateText, Converter={StaticResource EmptyToVisibility},
                                   ConverterParameter=inverse}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                     FontSize="12" Text="{Binding UpdateText}" />

          <Button Grid.Column="1" Content="{loc:T WhatsNew}" Style="{StaticResource QuietButton}"
                  Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                  Command="{Binding UpdateNotesCommand}"
                  ToolTip="{loc:T WhatsNewTip}" />
        </Grid>
      </Border>

      <!-- Barre du bas : outils à gauche, quitter à droite. -->
      <Border DockPanel.Dock="Bottom" Padding="10,8"
              Background="{StaticResource BrushedPanelBrush}"
              BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Les trois gestes de rangement, groupés comme les touches d'un
               même appareil : un seul cadre, deux filets, et le nom de chacune
               écrit à côté de son dessin.

               Elles étaient trois icônes flottantes surmontant chacune son
               raccourci en chasse fixe. « Ctrl + » y paraissait trois fois dans
               une barre de trois cent soixante unités, et c'était la chose la
               plus voyante d'un pied de fenêtre qui ne demande qu'à se faire
               oublier. Les raccourcis se lisent dans l'onglet qui leur est
               consacré, et l'infobulle dit ce que chaque touche fait. -->
          <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                  Margin="0,0,10,0"
                  Background="{StaticResource KeyFaceBrush}"
                  BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}">
            <StackPanel Orientation="Horizontal">

              <Button Style="{StaticResource GroupKey}"
                      ToolTip="{loc:T StackTip}"
                      Command="{Binding RearrangeCommand}">
                <StackPanel Orientation="Horizontal">
                  <!-- Deux fenêtres superposées : c'est exactement ce que fait
                       l'action, et aucun glyphe ne le dit clairement. -->
                  <Path Style="{StaticResource RowGlyph}" Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Data="M 1.8,2.2 H 10.2 V 8.4 H 1.8 Z M 4.8,6.6 H 13.2 V 12.8 H 4.8 Z" />
                  <TextBlock Text="{loc:T Stack}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Border Width="1" Margin="0,6" Background="{DynamicResource BorderBrush}" />

              <Button Style="{StaticResource GroupKey}"
                      ToolTip="{loc:T SideBySideTip}"
                      Command="{Binding TileCommand}">
                <StackPanel Orientation="Horizontal">
                  <!-- Une fenêtre partagée en deux : les deux panneaux
                       séparés se remplissaient de leur propre trait à cette
                       taille, et l'icône devenait deux pavés blancs. -->
                  <Path Style="{StaticResource RowGlyph}" Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Data="M 2,2.6 H 13 V 12.4 H 2 Z M 7.5,2.6 V 12.4" />
                  <TextBlock Text="{loc:T SideBySide}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Border Width="1" Margin="0,6" Background="{DynamicResource BorderBrush}" />

              <Button Style="{StaticResource GroupKey}"
                      ToolTip="{loc:T GuidesTip}"
                      Command="{Binding QuestsCommand}">
                <StackPanel Orientation="Horizontal">
                  <!-- Un parchemin déroulé : deux rouleaux et des lignes de
                       texte. Le dessin est à nous ; celui du site ne sera repris
                       que s'ils l'accordent. -->
                  <Path Style="{StaticResource RowGlyph}" Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Data="M 2.4,2.4 V 12.6 M 12.6,2.4 V 12.6
                              M 5,5.2 H 10 M 5,7.5 H 10 M 5,9.8 H 10" />
                  <TextBlock Text="{loc:T Guides}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

            </StackPanel>
          </Border>

          <Button Grid.Column="1" Content="{loc:T Quit}" Click="OnQuit"
                  VerticalAlignment="Center"
                  ToolTip="{loc:T QuitTip}" />
        </Grid>
      </Border>

      <!-- Onglets -->
      <Grid Margin="10,8,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="TabHotkeys" Style="{StaticResource Tab}" Content="{loc:T TabShortcuts}"
                       GroupName="Tabs" IsChecked="True" />
          <RadioButton x:Name="TabGeneral" Style="{StaticResource Tab}" Content="{loc:T TabWindows}" GroupName="Tabs" />
          <RadioButton x:Name="TabDevices" Style="{StaticResource Tab}" Content="{loc:T TabDevices}" GroupName="Tabs" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
          <Grid>

            <!-- Onglet Raccourcis, en lecture seule -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabHotkeys,
                                             Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2" Background="Transparent"
                              ToolTip="{Binding ActionDetail}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                          <Border Grid.Column="1" CornerRadius="{StaticResource Radius}" Padding="7,2"
                                  Background="{DynamicResource SurfaceAltBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="12"
                       FontFamily="{StaticResource MonoFont}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="{loc:T EditShortcuts}" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Click="OnEditHotkeys" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Onglet Fenêtres : replacement rapide et taille -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabGeneral,
                                             Converter={StaticResource BoolToVisibility}}">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T PlaceWindowsHeading}" Style="{StaticResource SectionLabel}" />

                  <ItemsControl ItemsSource="{Binding Anchors}" HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTip="{loc:T PlaceWindowsTip}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource AnchorCell}"
                                ToolTip="{Binding Converter={StaticResource AnchorLabel}}"
                                Command="{Binding DataContext.SetAnchorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T WindowSizeHeading}" Style="{StaticResource SectionLabel}"
                             ToolTip="{loc:T WindowSizeTip}" />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Minimum="20" Maximum="100" TickFrequency="1"
                            SmallChange="1" LargeChange="5"
                            Value="{Binding SizePercent}" />

                    <!-- En chasse fixe : le nombre ne danse plus d'un pixel à
                         l'autre quand il change de chiffre. -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                               MinWidth="46" TextAlignment="Right" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource AccentBrush}">
                      <Run Text="{Binding SizePercent, Mode=OneWay}" /><Run Text=" %" />
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <!-- Le rouage sur la ligne du titre, et non sous les
                       paliers : là il retombait à la ligne, seul, et faisait
                       gagner une rangée à la carte. Ici il tient dans la
                       hauteur que l'intertitre occupe déjà. -->
                  <Grid>
                    <TextBlock Text="{loc:T QualityHeading}" Style="{StaticResource SectionLabel}" />

                    <ToggleButton x:Name="CustomGear" Cursor="Hand"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-3,0,0" Background="Transparent"
                                  ToolTip="{loc:T CustomQualityTip}"
                                  Visibility="{Binding IsCustomQuality,
                                                       Converter={StaticResource BoolToVisibility}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Fond" Background="Transparent" Padding="3"
                                  CornerRadius="{StaticResource Radius}">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}" Data="F0 M 18.18,8.11 L 18.18,11.89 L 15.64,12.05 L 15.44,12.54 L 17.12,14.45 L 14.45,17.12 L 12.54,15.44 L 12.05,15.64 L 11.89,18.18 L 8.11,18.18 L 7.95,15.64 L 7.46,15.44 L 5.55,17.12 L 2.88,14.45 L 4.56,12.54 L 4.36,12.05 L 1.82,11.89 L 1.82,8.11 L 4.36,7.95 L 4.56,7.46 L 2.88,5.55 L 5.55,2.88 L 7.46,4.56 L 7.95,4.36 L 8.11,1.82 L 11.89,1.82 L 12.05,4.36 L 12.54,4.56 L 14.45,2.88 L 17.12,5.55 L 15.44,7.46 L 15.64,7.95 Z M 7.10,10.00 A 2.90,2.90 0 1 0 12.90,10.00 A 2.90,2.90 0 1 0 7.10,10.00 Z" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Fond" Property="Background"
                                      Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Fond" Property="Background"
                                      Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </Grid>

                  <!-- Repliés comme la distance juste en dessous : quatre
                       paliers ne tiennent plus sur la largeur de la fenêtre. -->
                  <WrapPanel Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityLow}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityLowTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Low}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityMedium}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityMediumTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Medium}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityHigh}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityHighTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Maximum}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityCustom}"
                                 ToolTip="{loc:T QualityCustomTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Custom}" />
                  </WrapPanel>

                  <Popup IsOpen="{Binding IsChecked, ElementName=CustomGear, Mode=TwoWay}" StaysOpen="False"
                         Placement="Bottom" PlacementTarget="{Binding ElementName=CustomGear}"
                         AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-296">
                    <Border Background="{DynamicResource SurfaceBrush}" Width="330"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="14,12,14,12">
                      <StackPanel>
                        <TextBlock Text="{loc:T FineSettingsHeading}" Style="{StaticResource SectionLabel}" />

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T MaxResolution}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T MaxResolutionTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding HeightChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomHeight}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T FrameRate}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FpsChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomFps}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T ImageDetail}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T ImageDetailTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FinesseChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomBitsPerPixel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T VideoCodec}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T VideoCodecTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding CodecChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomCodec}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

                        <TextBlock Text="{Binding BitrateSummary}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   ToolTip="{loc:T BitsPerPixelTip}" />

                        <!-- Plusieurs comptes ouverts, ce sont plusieurs flux
                             sur la même liaison et le même encodeur. Un miroir
                             simple n&apos;a pas ce souci ; celui-ci l&apos;a, et le dit. -->
                        <TextBlock Text="{Binding LinkSummary}" Style="{StaticResource Muted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   TextWrapping="Wrap"
                                   ToolTip="{loc:T BitrateTip}" />

                        <!-- Le palier retenu est le premier au-dessus de la
                             fenêtre : au-delà, monter le plafond ne demande
                             rien de plus et ne coûte rien de plus. Mesuré,
                             c'est le piège le moins visible du panneau. -->
                        <TextBlock Text="{Binding DisplayFitSummary}" Style="{StaticResource Muted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   TextWrapping="Wrap"
                                   ToolTip="{loc:T ResolutionAdviceTip}" />
                      </StackPanel>
                    </Border>
                  </Popup>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T GameDistanceHeading}" Style="{StaticResource SectionLabel}"
                             ToolTip="{loc:T GameDistanceTip}" />

                  <!-- Repliés plutôt qu'alignés : cinq paliers ne tiennent
                       plus sur la largeur de la fenêtre, et rogner un libellé
                       le rendrait indéchiffrable. -->
                  <WrapPanel Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomVeryFar}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomVeryFarTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Widest}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomFar}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomFarTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Wide}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomNormal}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomNormalTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Normal}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomClose}"
                                 ToolTip="{loc:T ZoomCloseTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Close}" />
                  </WrapPanel>

                  <TextBlock Style="{StaticResource Muted}" FontSize="11"
                             Visibility="{Binding IsReopening, Converter={StaticResource BoolToVisibility}}"
                             Text="{loc:T ReopenNotice}" />
                </StackPanel>
              </Border>

              <StackPanel Margin="2,4,0,10">
                <!-- La langue suit Windows sans qu'on ait rien à dire. Le choix
                     n'est là que pour la contredire : un Windows anglais chez
                     un francophone, ou l'inverse, est un cas courant. -->
                <TextBlock Text="{loc:T LanguageHeading}" Style="{StaticResource SectionLabel}"
                           ToolTip="{loc:T LanguageTip}" />

                <ComboBox ItemsSource="{Binding LanguageChoices}" Margin="0,0,0,4"
                          HorizontalAlignment="Left" MinWidth="150"
                          SelectedValuePath="Value" SelectedValue="{Binding Language}"
                          ToolTip="{loc:T LanguageTip}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"
                           Text="{loc:T LanguageRestart}"
                           Visibility="{Binding LanguageRestartNeeded,
                                                Converter={StaticResource BoolToVisibility}}" />

                <!-- Le téléchargement se fait en fond, l'échange à l'arrêt : une
                     application ne se remplace pas sous les doigts de celui qui
                     s'en sert. -->
                <!-- Le son du téléphone entier, non celui d'un compte : Android
                     ne sait pas l'isoler par application. Une seule fenêtre par
                     appareil le porte, sans quoi le même flux reviendrait en
                     plusieurs exemplaires. -->
                <CheckBox Content="{loc:T PhoneAudio}" Margin="0,0,0,8"
                          IsChecked="{Binding AudioEnabled}"
                          ToolTip="{loc:T PhoneAudioTip}" />

                <CheckBox Content="{loc:T AutomaticUpdates}" Margin="0,0,0,8"
                          IsChecked="{Binding UpdatesAutomatic}"
                          ToolTip="{loc:T AutomaticUpdatesTip}" />

                <TextBlock Style="{StaticResource Muted}" FontSize="11">
                  <Run Text="{Binding ProductName, Mode=OneWay}" />
                  <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" FontSize="11" />
                <Button Content="{loc:T OpenLogFolder}" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" Margin="-9,4,0,0" Command="{Binding OpenLogsCommand}" />
              </StackPanel>

            </StackPanel>

            <!-- Onglet Appareils -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabDevices,
                                             Converter={StaticResource BoolToVisibility}}">

              <!-- Les profils partagent la ligne du bouton d'association, qui
                   avait de la place à droite. Dépliés dans la page, ils
                   prenaient quarante-sept pixels à la liste des comptes, qui
                   en manque déjà dans une fenêtre courte. -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource OutlineButton}"
                        ToolTip="{loc:T PairDeviceTip}"
                        Click="OnAddDevice">
                  <StackPanel Orientation="Horizontal">
                    <!-- Un plus tracé, du même trait que le signet de la touche
                         voisine : la pastille qui l'entourait lui donnait un
                         poids que l'autre n'avait pas, et les deux touches de la
                         ligne ne se ressemblaient plus. -->
                    <Path Width="15" Height="15" Stretch="None" Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 7.5,2.2 V 12.8 M 2.2,7.5 H 12.8" />
                    <TextBlock Text="{loc:T PairDevice}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <ToggleButton x:Name="ProfilesToggle" Grid.Column="2"
                              Style="{StaticResource OutlineToggle}"
                              VerticalAlignment="Center"
                              ToolTip="{loc:T ProfilesTip}">
                  <StackPanel Orientation="Horizontal">
                    <!-- Un signet : ce qu'on met de côté pour y revenir. Le
                         chevron dit que la bulle s'ouvre en dessous ; il était
                         écrit en caractère de fonte à chasse fixe, et pendait
                         sous la ligne de texte. -->
                    <Path Width="11" Height="13" Margin="0,0,8,0" Stretch="None"
                          VerticalAlignment="Center" StrokeLineJoin="Round"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                          Data="M 1,1 H 10 V 12 L 5.5,8.6 L 1,12 Z" />
                    <TextBlock Text="{loc:T Profiles}" VerticalAlignment="Center" />
                    <Path Width="9" Height="5" Margin="9,2,0,0" Stretch="None"
                          VerticalAlignment="Center" StrokeLineJoin="Round"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 0.8,0.8 L 4.5,4.2 L 8.2,0.8" />
                  </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=ProfilesToggle, Mode=TwoWay}" StaysOpen="False"
                       Placement="Bottom" PlacementTarget="{Binding ElementName=ProfilesToggle}"
                       AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-250">
                  <Border Background="{DynamicResource SurfaceBrush}" Width="340"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="14,12,14,12">
                    <StackPanel>
                      <TextBlock Text="{loc:T LaunchProfilesHeading}" Style="{StaticResource SectionLabel}" />

                      <!-- Un panneau vide ne distingue pas « aucun profil » de
                           « la liste n'a pas chargé », et c'est justement la
                           question qu'on se pose en l'ouvrant. -->
                      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Text="{loc:T NoProfilesYet}"
                                 Visibility="{Binding Instances.HasProfiles,
                                                      Converter={StaticResource InverseBoolToVisibility}}" />

                      <!-- La liste est montrée, non repliée dans un champ : on
                           voit ce qu'on a sans rien ouvrir, et surtout désigner
                           une ligne ne l'ouvre plus. Avant, choisir dans la
                           liste déroulante fermait les fenêtres de jeu, ce qui
                           faisait d'un clic d'exploration une partie perdue. -->
                      <ItemsControl ItemsSource="{Binding Instances.Profiles}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                      ToolTip="{loc:T LaunchProfileTip}"
                                      Command="{Binding DataContext.Instances.OpenProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Style="{StaticResource RowGlyph}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M 5.5,3.5 L 12,7.5 L 5.5,11.5 Z" />
                              </Button>

                              <!-- Un bouton, non une bascule : « QuietButton »
                                   et ses pareils ciblent Button, et les poser
                                   sur un ToggleButton lève au chargement sans
                                   que la compilation le voie. L'état se dit par
                                   l'étoile pleine. -->
                              <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                      ToolTip="{loc:T DefaultProfileTip}"
                                      Command="{Binding DataContext.Instances.ToggleDefaultProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Width="14" Height="14"
                                      Data="M 10,1.5 L 12.4,7.1 L 18.5,7.7 L 13.9,11.8 L 15.2,17.8 L 10,14.6 L 4.8,17.8 L 6.1,11.8 L 1.5,7.7 L 7.6,7.1 Z">
                                  <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource RowGlyph}">
                                      <Setter Property="Stretch" Value="Uniform" />
                                      <Setter Property="Width" Value="14" />
                                      <Setter Property="Height" Value="14" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                          <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Path.Style>
                                </Path>
                              </Button>

                              <Button Grid.Column="3" Style="{StaticResource DangerIconButton}"
                                      ToolTip="{loc:T DeleteProfileTip}"
                                      Command="{Binding DataContext.Instances.DeleteProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Style="{StaticResource RowGlyph}"
                                      Data="M 3,4.6 H 12 M 6,4.6 V 3.2 H 9 V 4.6 M 4.2,4.6 V 12.3 H 10.8 V 4.6 M 6.4,6.6 V 10.3 M 8.6,6.6 V 10.3" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Button Content="{loc:T CreateProfile}" Style="{StaticResource QuietButton}"
                              Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                              ToolTip="{loc:T CreateProfileTip}"
                              Command="{Binding Instances.CreateProfileCommand}" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>

              <TextBlock Text="{loc:T AccountsHeading}" Style="{StaticResource SectionLabel}"
                         ToolTip="{loc:T AccountsTip}" />

              <w:InstanceListControl DataContext="{Binding Instances}"
                                     ShowDeviceStatus="True" />

            </StackPanel>

          </Grid>
        </ScrollViewer>

        <!-- Astuces de l'onglet Appareils, hors du contenu défilant : elles
             restent collées en bas de la page quelle que soit la longueur de
             la liste. La marge négative annule le remplissage et la bordure du
             bouton, neuf pixels, pour que le texte parte du même bord que la
             liste au-dessus. -->
        <StackPanel Grid.Row="2" Margin="0,6,0,0"
                    Visibility="{Binding IsChecked, ElementName=TabDevices,
                                         Converter={StaticResource BoolToVisibility}}">
          <Button Content="{loc:T FrozenWindowHelp}"
                  Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                  Margin="-9,0,0,0" Click="OnSleepHelp" />
        </StackPanel>
      </Grid>

    </DockPanel>
  </Border>
</Window>
