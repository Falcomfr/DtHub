<Window x:Class="DtHub.App.Windows.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        Title="DT Hub"
        Width="440" Height="580"
        MinWidth="360" MinHeight="380"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display">

  <Border Background="{DynamicResource SurfaceAltBrush}"
          BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
          CornerRadius="{StaticResource Radius}">
    <DockPanel>

      <!-- Header bar: also serves as a drag handle. -->
      <Border DockPanel.Dock="Top" Background="{StaticResource BrushedPanelBrush}"
              CornerRadius="{StaticResource RadiusTop}" Padding="12,8"
              BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnHeaderDrag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0" Source="/assets/app.png" Width="26" Height="26" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <!-- The game's name is stated here, once, on the product's line:
                 it costs no extra height and is visible on all three
                 tabs. -->
            <TextBlock>
              <!-- Out of scale, and that's deliberate: the product name is a
                   brand, not body text. -->
              <Run Text="{Binding ProductName, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
              <Run Text="{loc:T AppSubtitleForGame}" FontSize="{StaticResource FontSmall}"
                   Foreground="{DynamicResource TextMutedBrush}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}">
              <Run Text="{Binding ToggleShortcutText, Mode=OneWay}" FontWeight="SemiBold"
                   FontFamily="{StaticResource MonoFont}" />
              <Run Text="{loc:T ShortcutToggleSuffix}" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}"
                  FontSize="14" Padding="8,2" Click="OnHide"
                  ToolTip="{loc:T HideThisWindow}" />
        </Grid>
      </Border>

      <!-- What the next version brings. The banner only appears when
           there is something to say, and it says it in one line: the
           full note lives in its own window, which you open if you
           want. -->
      <Border DockPanel.Dock="Top" Padding="12,7"
              Background="{StaticResource BrushedPanelBrush}"
              BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding UpdateText, Converter={StaticResource EmptyToVisibility},
                                   ConverterParameter=inverse}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                     FontSize="{StaticResource FontBody}" Text="{Binding UpdateText}" />

          <Button Grid.Column="1" Content="{loc:T WhatsNew}" Style="{StaticResource QuietButton}"
                  Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                  Command="{Binding UpdateNotesCommand}"
                  ToolTip="{loc:T WhatsNewTip}" />
        </Grid>
      </Border>

      <!-- Bottom bar: tools on the left, quit on the right. -->
      <Border DockPanel.Dock="Bottom" Padding="10,8"
              Background="{StaticResource BrushedPanelBrush}"
              BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Two groups, not one. The guides don't arrange anything:
               putting them in the same frame as stacking and side by
               side made them look like three gestures of the same
               kind, when it's the only one of the three that opens
               something. They therefore keep their name, and the
               arranging frame is reduced to two icons.

               The buttons used to be three floating icons, each topped
               by its shortcut in monospace type. "Ctrl +" appeared
               three times in a bar three hundred and sixty units wide,
               and it was the most conspicuous thing on a window footer
               that only wants to go unnoticed. The shortcuts are
               listed in the tab dedicated to them, and the tooltip
               says what each button does. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      Margin="0,0,10,0">

            <Border Background="{StaticResource KeyFaceBrush}"
                    BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusKey}">
              <Button Style="{StaticResource GroupKey}"
                      ToolTip="{loc:T GuidesTip}"
                      Command="{Binding QuestsCommand}">
                <StackPanel Orientation="Horizontal">
                  <!-- The site's logo, used with papycha.fr's agreement. It
                       replaces the scroll we were drawing while waiting
                       for that agreement. The site's banner is ruled
                       out: it carries DOFUS Touch's registered logo,
                       which no agreement from papycha can grant us. See
                       THIRD-PARTY-NOTICES.md. -->
                  <Image Source="/assets/papycha.png" Width="16" Height="16"
                         Margin="0,0,6,0" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="{loc:T Guides}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>

            <!-- The Almanax next to the guides: these are the two buttons
                 that open something to read, as opposed to the window
                 arranging that follows. A drawn calendar rather than a
                 logo: the page comes from Ankama, none of whose
                 branding we display. -->
            <Border Margin="8,0,0,0"
                    Background="{StaticResource KeyFaceBrush}"
                    BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusKey}">
              <Button Style="{StaticResource GroupKey}"
                      ToolTip="{loc:T AlmanaxTip}"
                      Command="{Binding AlmanaxCommand}">
                <StackPanel Orientation="Horizontal">
                  <Path Width="16" Height="16" Stretch="None" Margin="0,0,6,0"
                        VerticalAlignment="Center" StrokeLineJoin="Round"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"
                        Data="M 3,4.5 H 13 V 13.5 H 3 Z M 3,7.5 H 13 M 6,3 V 6 M 10,3 V 6" />
                  <TextBlock Text="{loc:T Almanax}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>

            <!-- Arranging only appears when there's something to arrange:
                 at least two windows, and only when placements can
                 move. A single window, or two docked in the tabbed
                 frame, and pressing these buttons did nothing. No text:
                 their icon says what they do, and the window footer
                 gets some breathing room. -->
            <Border Margin="8,0,0,0"
                    Background="{StaticResource KeyFaceBrush}"
                    BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusKey}"
                    Visibility="{Binding CanArrange, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource GroupKey}"
                        ToolTip="{loc:T StackTip}"
                        Command="{Binding RearrangeCommand}">
                  <!-- Two overlapping windows: that's exactly what the
                       action does, and no glyph said it clearly. -->
                  <Path Style="{StaticResource RowGlyph}" VerticalAlignment="Center"
                        Data="M 1.8,2.2 H 10.2 V 8.4 H 1.8 Z M 4.8,6.6 H 13.2 V 12.8 H 4.8 Z" />
                </Button>

                <Border Width="1" Margin="0,6" Background="{DynamicResource BorderBrush}" />

                <Button Style="{StaticResource GroupKey}"
                        ToolTip="{loc:T SideBySideTip}"
                        Command="{Binding TileCommand}">
                  <!-- One window split in two: the two separate panels
                       filled in with their own stroke at this size, and
                       the icon turned into two blank blocks. -->
                  <Path Style="{StaticResource RowGlyph}" VerticalAlignment="Center"
                        Data="M 2,2.6 H 13 V 12.4 H 2 Z M 7.5,2.6 V 12.4" />
                </Button>

              </StackPanel>
            </Border>

          </StackPanel>

          <Button Grid.Column="1" Content="{loc:T Quit}" Click="OnQuit"
                  VerticalAlignment="Center"
                  ToolTip="{loc:T QuitTip}" />
        </Grid>
      </Border>

      <!-- Tabs -->
      <Grid Margin="10,8,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
          <!-- The order goes from the concrete to the setting: the device
               first, then its windows, then the shortcuts. The content
               panels follow the bindings by name, not this order:
               reordering them here doesn't move them. -->
          <!-- The first tab is also the one that opens: that's where you
               act, while shortcuts are read once. Which tab is open
               isn't remembered from one session to the next, so this
               choice applies at every launch. -->
          <RadioButton x:Name="TabDevices" Style="{StaticResource Tab}" Content="{loc:T TabDevices}"
                       GroupName="Tabs" IsChecked="True" />
          <RadioButton x:Name="TabGeneral" Style="{StaticResource Tab}" Content="{loc:T TabWindows}" GroupName="Tabs" />
          <RadioButton x:Name="TabHotkeys" Style="{StaticResource Tab}" Content="{loc:T TabShortcuts}"
                       GroupName="Tabs" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
          <Grid>

            <!-- Shortcuts tab, read-only -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabHotkeys,
                                             Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2" Background="Transparent"
                              ToolTip="{Binding ActionDetail}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                          <Border Grid.Column="1" CornerRadius="{StaticResource Radius}" Padding="7,2"
                                  Background="{DynamicResource SurfaceAltBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="{StaticResource FontBody}"
                       FontFamily="{StaticResource MonoFont}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="{loc:T EditShortcuts}" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Click="OnEditHotkeys" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Windows tab: quick placement and size -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabGeneral,
                                             Converter={StaticResource BoolToVisibility}}">

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T PlaceWindowsHeading}" Style="{StaticResource SectionLabel}" />

                  <ItemsControl ItemsSource="{Binding Anchors}" HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                ToolTip="{loc:T PlaceWindowsTip}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource AnchorCell}"
                                ToolTip="{Binding Converter={StaticResource AnchorLabel}}"
                                Command="{Binding DataContext.SetAnchorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T WindowSizeHeading}" Style="{StaticResource SectionLabel}"
                             ToolTip="{loc:T WindowSizeTip}" />

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Minimum="20" Maximum="100" TickFrequency="1"
                            SmallChange="1" LargeChange="5"
                            Value="{Binding SizePercent}" />

                    <!-- In monospace: the number no longer jitters by a
                         pixel from one digit to another when it
                         changes. -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                               MinWidth="46" TextAlignment="Right" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource AccentBrush}">
                      <Run Text="{Binding SizePercent, Mode=OneWay}" /><Run Text=" %" />
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <!-- The gear on the title's line, not under the tiers:
                       there it wrapped to its own line, alone, and cost
                       the card an extra row. Here it fits within the
                       height the subheading already takes up. -->
                  <Grid>
                    <TextBlock Text="{loc:T QualityHeading}" Style="{StaticResource SectionLabel}" />

                    <ToggleButton x:Name="CustomGear" Cursor="Hand"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-3,0,0" Background="Transparent"
                                  ToolTip="{loc:T CustomQualityTip}"
                                  Visibility="{Binding IsCustomQuality,
                                                       Converter={StaticResource BoolToVisibility}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Fond" Background="Transparent" Padding="3"
                                  CornerRadius="{StaticResource Radius}">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}" Data="F0 M 18.18,8.11 L 18.18,11.89 L 15.64,12.05 L 15.44,12.54 L 17.12,14.45 L 14.45,17.12 L 12.54,15.44 L 12.05,15.64 L 11.89,18.18 L 8.11,18.18 L 7.95,15.64 L 7.46,15.44 L 5.55,17.12 L 2.88,14.45 L 4.56,12.54 L 4.36,12.05 L 1.82,11.89 L 1.82,8.11 L 4.36,7.95 L 4.56,7.46 L 2.88,5.55 L 5.55,2.88 L 7.46,4.56 L 7.95,4.36 L 8.11,1.82 L 11.89,1.82 L 12.05,4.36 L 12.54,4.56 L 14.45,2.88 L 17.12,5.55 L 15.44,7.46 L 15.64,7.95 Z M 7.10,10.00 A 2.90,2.90 0 1 0 12.90,10.00 A 2.90,2.90 0 1 0 7.10,10.00 Z" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Fond" Property="Background"
                                      Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Fond" Property="Background"
                                      Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                  </Grid>

                  <!-- Wrapped like the zoom distance just below: four
                       tiers no longer fit across the window's width. -->
                  <WrapPanel Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityLow}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityLowTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Low}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityMedium}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityMediumTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Medium}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityHigh}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T QualityHighTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Maximum}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Quality" Content="{loc:T QualityCustom}"
                                 ToolTip="{loc:T QualityCustomTip}"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Custom}" />
                  </WrapPanel>

                  <Popup IsOpen="{Binding IsChecked, ElementName=CustomGear, Mode=TwoWay}" StaysOpen="False"
                         Placement="Bottom" PlacementTarget="{Binding ElementName=CustomGear}"
                         AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-296">
                    <Border Background="{DynamicResource SurfaceBrush}" Width="330"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="14,12,14,12">
                      <StackPanel>
                        <TextBlock Text="{loc:T FineSettingsHeading}" Style="{StaticResource SectionLabel}" />

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T MaxResolution}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T MaxResolutionTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding HeightChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomHeight}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T FrameRate}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FpsChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomFps}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T ImageDetail}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T ImageDetailTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FinesseChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomBitsPerPixel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{loc:T VideoCodec}" VerticalAlignment="Center"
                         Style="{StaticResource Muted}"
                            ToolTip="{loc:T VideoCodecTip}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding CodecChoices}"
                        SelectedValuePath="Value" SelectedValue="{Binding CustomCodec}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

                        <TextBlock Text="{Binding BitrateSummary}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   ToolTip="{loc:T BitsPerPixelTip}" />

                        <!-- Several open accounts mean several streams over
                             the same link and the same encoder. A simple
                             mirror doesn't have this concern; this one
                             does, and says so. -->
                        <TextBlock Text="{Binding LinkSummary}" Style="{StaticResource Muted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                   TextWrapping="Wrap"
                                   ToolTip="{loc:T BitrateTip}" />

                        <!-- The tier chosen is the first one above the
                             window: beyond that, raising the ceiling
                             asks for nothing more and costs nothing
                             more. Measured, it's the panel's least
                             visible trap. -->
                        <TextBlock Text="{Binding DisplayFitSummary}" Style="{StaticResource Muted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                   TextWrapping="Wrap"
                                   ToolTip="{loc:T ResolutionAdviceTip}" />
                      </StackPanel>
                    </Border>
                  </Popup>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T GameDistanceHeading}" Style="{StaticResource SectionLabel}"
                             ToolTip="{loc:T GameDistanceTip}" />

                  <!-- Wrapped rather than aligned: five tiers no longer fit
                       across the window's width, and trimming a label
                       would make it unreadable. -->
                  <WrapPanel Margin="0,0,0,5">
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomVeryFar}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomVeryFarTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Widest}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomFar}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomFarTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Wide}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomNormal}"
                                 Margin="0,0,5,0"
                                 ToolTip="{loc:T ZoomNormalTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Normal}" />
                    <RadioButton Style="{StaticResource Tab}" GroupName="Zoom" Content="{loc:T ZoomClose}"
                                 ToolTip="{loc:T ZoomCloseTip}"
                                 IsChecked="{Binding Zoom, Converter={StaticResource EnumMatch},
                                                     ConverterParameter=Close}" />
                  </WrapPanel>

                  <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                             Visibility="{Binding IsReopening, Converter={StaticResource BoolToVisibility}}"
                             Text="{loc:T ReopenNotice}" />
                </StackPanel>
              </Border>

              <StackPanel Margin="2,4,0,10">
                <!-- The language follows Windows without anyone having to
                     say anything. The choice is there only to override
                     that: an English Windows for a French speaker, or
                     the reverse, is a common case. -->
                <TextBlock Text="{loc:T LanguageHeading}" Style="{StaticResource SectionLabel}"
                           ToolTip="{loc:T LanguageTip}" />

                <ComboBox ItemsSource="{Binding LanguageChoices}" Margin="0,0,0,4"
                          HorizontalAlignment="Left" MinWidth="150"
                          SelectedValuePath="Value" SelectedValue="{Binding Language}"
                          ToolTip="{loc:T LanguageTip}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" Margin="0,0,0,10"
                           Text="{loc:T LanguageRestart}"
                           Visibility="{Binding LanguageRestartNeeded,
                                                Converter={StaticResource BoolToVisibility}}" />

                <!-- The download happens in the background, the swap on
                     shutdown: an application doesn't get replaced under
                     the fingers of the person using it. -->
                <!-- The whole phone's sound, not one account's: Android
                     doesn't know how to isolate it per application.
                     Only one window per device carries it, otherwise
                     the same stream would come back in several copies. -->
                <CheckBox Content="{loc:T PhoneAudio}" Margin="0,0,0,8"
                          IsChecked="{Binding AudioEnabled}"
                          ToolTip="{loc:T PhoneAudioTip}" />

                <!-- Placed with the sound rather than with updates: it
                     describes what happens to the phone, not to the
                     application. -->
                <CheckBox Content="{loc:T StopAppOnClose}" Margin="0,0,0,8"
                          IsChecked="{Binding StopAppOnClose}"
                          ToolTip="{loc:T StopAppOnCloseTip}" />

                <!-- Placed with the sound and stopping the game: it too
                     describes what happens to the phone. The layout's
                     trap is stated under the checkbox, not in a
                     tooltip: it decides the setting, it doesn't just
                     comment on it. -->
                <CheckBox Content="{loc:T SimulatedKeyboard}"
                          IsChecked="{Binding SimulatedPhysicalKeyboard}"
                          ToolTip="{loc:T SimulatedKeyboardTip}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                           TextWrapping="Wrap" Margin="24,2,0,8"
                           Text="{loc:T SimulatedKeyboardHelp}" />

                <!-- Last resort, and it only appears on a device where the
                     refusal has been observed: this mouse captures the
                     computer's cursor, offering it to someone without
                     the fault would be selling a remedy worse than the
                     disease. The key that gives the mouse back is
                     stated under the checkbox, not in a tooltip:
                     without it, you'd think your computer was locked
                     up. -->
                

                <StackPanel Visibility="{Binding ShowsSimulatedMouse,
                                                 Converter={StaticResource BoolToVisibility}}">
                  <CheckBox Content="{loc:T SimulatedMouse}"
                            IsChecked="{Binding SimulatedPhysicalMouse}"
                            ToolTip="{loc:T SimulatedMouseTip}" />
                  <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                             TextWrapping="Wrap" Margin="24,2,0,8"
                             Foreground="{DynamicResource WarningBrush}"
                             Text="{loc:T SimulatedMouseHelp}" />
                </StackPanel>

                <CheckBox Content="{loc:T AutomaticUpdates}" Margin="0,0,0,8"
                          IsChecked="{Binding UpdatesAutomatic}"
                          ToolTip="{loc:T AutomaticUpdatesTip}" />

                <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}">
                  <Run Text="{Binding ProductName, Mode=OneWay}" />
                  <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />
                <!-- A fault outside the UI thread doesn't get displayed: it
                     gets counted, and this line is the only place where
                     it shows. It can be ignored, which a dialog box
                     would not allow for a fault that repeats. -->
                <TextBlock Text="{loc:T IncidentNoticed}" Style="{StaticResource Muted}"
                           FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding HasIncident,
                                                Converter={StaticResource BoolToVisibility}}" />

                <!-- Two buttons on a line three hundred and sixty units
                     wide, and the second one was getting cut off: they
                     wrap onto a new line rather than lying about their
                     name. -->
                <WrapPanel Margin="-9,4,0,0">
                  <Button Content="{loc:T OpenLogFolder}" Style="{StaticResource QuietButton}"
                          Command="{Binding OpenLogsCommand}" />

                  <Button Content="{loc:T ReportProblem}" Style="{StaticResource QuietButton}"
                          Command="{Binding ReportProblemCommand}"
                          ToolTip="{loc:T ReportProblemTip}" />

                  <!-- Take your settings from one computer to another, and
                       get them back if the file gets corrupted. -->
                  <Button Content="{loc:T ExportSettings}" Style="{StaticResource QuietButton}"
                          Command="{Binding ExportSettingsCommand}"
                          ToolTip="{loc:T ExportSettingsTip}" />

                  <Button Content="{loc:T ImportSettings}" Style="{StaticResource QuietButton}"
                          Command="{Binding ImportSettingsCommand}"
                          ToolTip="{loc:T ImportSettingsTip}" />
                </WrapPanel>
              </StackPanel>

            </StackPanel>

            <!-- Devices tab -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=TabDevices,
                                             Converter={StaticResource BoolToVisibility}}">

              <!-- The connection's state, stated before anything has been
                   launched. Failure messages already existed, but they
                   only appeared in response to an action: as long as
                   nothing was launched, the application said neither
                   what it saw nor what was missing.

                   The block disappears once the phone responds: it
                   then has nothing left to tell anyone. It also stays
                   silent as long as the connection hasn't been checked
                   yet, otherwise it would announce "no phone" when the
                   panel opened, only to take it back at the first
                   poll. -->
              <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,12"
                      Visibility="{Binding ShowsConnection,
                                           Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="{loc:T ConnectionHeading}" Style="{StaticResource SectionLabel}" />

                  <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap"
                             Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />

                  <ToggleButton x:Name="CableHelpToggle" Style="{StaticResource OutlineToggle}"
                                Content="{loc:T CableHelp}" HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Visibility="{Binding ShowsCableHelp,
                                                     Converter={StaticResource BoolToVisibility}}" />

                  <StackPanel Margin="0,8,0,0"
                              Visibility="{Binding IsChecked, ElementName=CableHelpToggle,
                                                   Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T CableHelpTitle}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{loc:T CableHelpIntro}" TextWrapping="Wrap"
                               Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />
                    <TextBlock Text="{loc:T CableHelpSteps}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Profiles share the pairing button's line, which had room
                   to spare on the right. Unfolded in the page, they
                   took forty-seven pixels away from the account list,
                   which is already short of them in a short window. -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource OutlineButton}"
                        ToolTip="{loc:T PairDeviceTip}"
                        Click="OnAddDevice">
                  <StackPanel Orientation="Horizontal">
                    <!-- A plus sign drawn with the same stroke as the
                         neighbouring button's bookmark: the chip that
                         used to surround it gave it a weight the other
                         one didn't have, and the two buttons on the
                         line no longer looked alike. -->
                    <Path Width="15" Height="15" Stretch="None" Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 7.5,2.2 V 12.8 M 2.2,7.5 H 12.8" />
                    <TextBlock Text="{loc:T PairDevice}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <ToggleButton x:Name="ProfilesToggle" Grid.Column="2"
                              Style="{StaticResource OutlineToggle}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding Instances.ProfilesTooltip}">
                  <StackPanel Orientation="Horizontal">
                    <!-- A bookmark: what you set aside to come back to.
                         The chevron says the bubble opens below; it
                         used to be written in monospace type, and hung
                         below the line of text.

                         The bookmark fills in when a profile is set for
                         launch. It's the same signal as the filled star
                         on the row concerned, further down in the
                         bubble: a default profile decides the accounts,
                         the quality and the zoom, and that must be
                         visible without opening anything.

                         Two overlaid shapes rather than a brush
                         converter: visibility converters already exist,
                         a colour converter doesn't. -->
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Width="11" Height="13" Stretch="None"
                            StrokeLineJoin="Round"
                            Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                            Data="M 1,1 H 10 V 12 L 5.5,8.6 L 1,12 Z"
                            Visibility="{Binding Instances.HasActiveProfile,
                                                 Converter={StaticResource InverseBoolToVisibility}}" />

                      <Path Width="11" Height="13" Stretch="None"
                            StrokeLineJoin="Round"
                            Fill="{DynamicResource AccentBrush}"
                            Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                            Data="M 1,1 H 10 V 12 L 5.5,8.6 L 1,12 Z"
                            Visibility="{Binding Instances.HasActiveProfile,
                                                 Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- The chosen profile's name, truncated if it
                         overflows: a name can run up to forty
                         characters, and letting it grow would push the
                         chevron out of the button. -->
                    <TextBlock Text="{Binding Instances.ProfilesButtonText}"
                               VerticalAlignment="Center"
                               MaxWidth="150" TextTrimming="CharacterEllipsis" />
                    <Path Width="9" Height="5" Margin="9,2,0,0" Stretch="None"
                          VerticalAlignment="Center" StrokeLineJoin="Round"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 0.8,0.8 L 4.5,4.2 L 8.2,0.8" />
                  </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=ProfilesToggle, Mode=TwoWay}" StaysOpen="False"
                       Placement="Bottom" PlacementTarget="{Binding ElementName=ProfilesToggle}"
                       AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-250">
                  <Border Background="{DynamicResource SurfaceBrush}" Width="340"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="14,12,14,12">
                    <StackPanel>
                      <TextBlock Text="{loc:T LaunchProfilesHeading}" Style="{StaticResource SectionLabel}" />

                      <!-- An empty panel doesn't distinguish "no profile"
                           from "the list hasn't loaded", and that's
                           exactly the question you ask yourself when
                           opening it. -->
                      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Text="{loc:T NoProfilesYet}"
                                 Visibility="{Binding Instances.HasProfiles,
                                                      Converter={StaticResource InverseBoolToVisibility}}" />

                      <!-- The list is shown, not tucked away in a field:
                           you see what you have without opening
                           anything, and above all, pointing at a row no
                           longer opens it. Before, picking from the
                           drop-down closed the game windows, which
                           turned an exploratory click into a lost
                           game. -->
                      <ItemsControl ItemsSource="{Binding Instances.Profiles}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>

                              <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                      ToolTip="{loc:T LaunchProfileTip}"
                                      Command="{Binding DataContext.Instances.OpenProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Style="{StaticResource RowGlyph}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M 5.5,3.5 L 12,7.5 L 5.5,11.5 Z" />
                              </Button>

                              <!-- A button, not a toggle: "QuietButton" and
                                   its kin target Button, and applying
                                   them to a ToggleButton throws at load
                                   time without the compiler seeing it.
                                   The state is conveyed by the filled
                                   star. -->
                              <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                      ToolTip="{loc:T DefaultProfileTip}"
                                      Command="{Binding DataContext.Instances.ToggleDefaultProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Width="14" Height="14"
                                      Data="M 10,1.5 L 12.4,7.1 L 18.5,7.7 L 13.9,11.8 L 15.2,17.8 L 10,14.6 L 4.8,17.8 L 6.1,11.8 L 1.5,7.7 L 7.6,7.1 Z">
                                  <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource RowGlyph}">
                                      <Setter Property="Stretch" Value="Uniform" />
                                      <Setter Property="Width" Value="14" />
                                      <Setter Property="Height" Value="14" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                          <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                          <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Path.Style>
                                </Path>
                              </Button>

                              <Button Grid.Column="3" Style="{StaticResource DangerIconButton}"
                                      ToolTip="{loc:T DeleteProfileTip}"
                                      Command="{Binding DataContext.Instances.DeleteProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                                <Path Style="{StaticResource BinGlyph}" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Button Content="{loc:T CreateProfile}" Style="{StaticResource QuietButton}"
                              Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                              ToolTip="{loc:T CreateProfileTip}"
                              Command="{Binding Instances.CreateProfileCommand}" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>

              <TextBlock Text="{loc:T AccountsHeading}" Style="{StaticResource SectionLabel}"
                         ToolTip="{loc:T AccountsTip}" />

              <w:InstanceListControl DataContext="{Binding Instances}"
                                     ShowDeviceStatus="True" />

            </StackPanel>

          </Grid>
        </ScrollViewer>

        <!-- Tips for the Devices tab, outside the scrolling content: they
             stay pinned to the bottom of the page no matter how long
             the list is. The negative margin cancels the button's
             padding and border, nine pixels, so the text starts from
             the same edge as the list above. -->
        <StackPanel Grid.Row="2" Margin="0,6,0,0"
                    Visibility="{Binding IsChecked, ElementName=TabDevices,
                                         Converter={StaticResource BoolToVisibility}}">
          <!-- Two conditions, so two panels: the tab outside, the phone
               inside. They don't replace each other, they add up.
               Without a reachable phone there's no game window, and
               these two lines would have nothing to talk about. -->
          <StackPanel Visibility="{Binding Instances.ShowsWindowHelp,
                                           Converter={StaticResource BoolToVisibility}}">
            <Button Content="{loc:T FrozenWindowHelp}"
                    Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                    Margin="-9,0,0,0" Click="OnSleepHelp" />

            <!-- The most frequent symptom reported from the field, and the
                 most helpless one: nothing fails, nothing shows, and
                 the click does nothing. -->
            <Button Content="{loc:T DeadInputHelp}"
                    Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                    Margin="-9,0,0,0" Click="OnInputHelp" />
          </StackPanel>
        </StackPanel>
      </Grid>

    </DockPanel>
  </Border>
</Window>
