<Window x:Class="DtHub.App.Windows.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:vm="clr-namespace:DtHub.App.ViewModels"
        Title="{loc:T TabShortcuts}"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T TabShortcuts}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{loc:T ShortcutsScopeNotice}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="{loc:T ShortcutsMouseNotice}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="{loc:T Defaults}" Style="{StaticResource QuietButton}"
                Command="{Binding RestoreDefaultsCommand}" />
        <Button Grid.Column="2" Content="{loc:T Close}" MinWidth="110" Click="OnClose"
                IsCancel="True" />
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>

        <!-- Three sections, each series folded into one line: twenty-two
             lines one under the other were hard to read (2026-10-16). -->
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.Resources>
            <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
              <StackPanel Margin="0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center" />

                  <Border Grid.Column="1" CornerRadius="{StaticResource Radius}" Padding="9,6" Margin="8,0"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <TextBlock Text="{Binding ShortcutText}" FontFamily="{StaticResource MonoFont}" TextAlignment="Center" />
                  </Border>

                  <Button Grid.Column="2" Content="{loc:T Edit}"
                          Command="{Binding DataContext.BeginCaptureCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                </Grid>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="{StaticResource FontSmall}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding BareKeyNotice}" Foreground="{DynamicResource WarningBrush}"
                           FontSize="{StaticResource FontSmall}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding TakesKeyFromGame, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HotkeySeriesViewModel}">
              <!-- The summary laid over the header, in the keys' column: an
                   expander's header does not stretch. The hidden button keeps
                   the column of the rows' own Edit buttons. -->
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Expander Grid.ColumnSpan="3" IsExpanded="{Binding IsExpanded}" Header="{Binding Label}">
                  <ItemsControl ItemsSource="{Binding Rows}" Margin="22,2,0,0" />
                </Expander>

                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}"
                           TextAlignment="Center" VerticalAlignment="Top" Margin="8,4,8,0"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" />
                <Button Grid.Column="2" Content="{loc:T Edit}" Visibility="Hidden" VerticalAlignment="Top" />
              </Grid>
            </DataTemplate>
          </ItemsControl.Resources>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Entries}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Problem}" Style="{StaticResource Muted}"
                   Foreground="{DynamicResource WarningBrush}" Margin="2,12,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
