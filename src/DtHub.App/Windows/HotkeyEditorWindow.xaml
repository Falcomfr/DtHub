<Window x:Class="DtHub.App.Windows.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis"
        Width="560" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Raccourcis" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="Ils n'agissent que pendant qu'une fenêtre de l'application est active. Ctrl+Tab reste donc disponible dans vos autres logiciels." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="Valeurs par défaut" Style="{StaticResource QuietButton}"
                Command="{Binding RestoreDefaultsCommand}" />
        <Button Grid.Column="2" Content="Fermer" MinWidth="110" Click="OnClose" />
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center" />

                  <Border Grid.Column="1" CornerRadius="6" Padding="9,6" Margin="8,0"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <TextBlock Text="{Binding ShortcutText}" TextAlignment="Center" />
                  </Border>

                  <Button Grid.Column="2" Content="Modifier"
                          Command="{Binding DataContext.BeginCaptureCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                </Grid>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Problem}" Style="{StaticResource Muted}"
                   Foreground="{DynamicResource WarningBrush}" Margin="2,12,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                        ConverterParameter=inverse}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
