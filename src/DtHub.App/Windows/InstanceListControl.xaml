<UserControl x:Class="DtHub.App.Windows.InstanceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liste des téléphones et de leurs instances. Partagée par la fenêtre de
       mise en route et par l'onglet Appareils. -->
  <StackPanel>

    <ItemsControl ItemsSource="{Binding Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnDragSourcePressed"
                  MouseMove="OnDragSourceMoved"
                  DragOver="OnDragOver" Drop="OnDrop">
            <StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                              Visibility="{Binding ShowOrdering,
                                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                                   Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource MoveButton}" ToolTip="Placer cet appareil au-dessus"
                            IsEnabled="{Binding CanMoveUp}"
                            Command="{Binding DataContext.MoveDeviceUpCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Path Data="{StaticResource ChevronUp}" Stroke="{DynamicResource TextMutedBrush}"
                            StrokeThickness="1.4" />
                    </Button>
                    <Button Style="{StaticResource MoveButton}" ToolTip="Placer cet appareil en dessous"
                            IsEnabled="{Binding CanMoveDown}"
                            Command="{Binding DataContext.MoveDeviceDownCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Path Data="{StaticResource ChevronDown}" Stroke="{DynamicResource TextMutedBrush}"
                            StrokeThickness="1.4" />
                    </Button>
                  </StackPanel>

                  <Border Width="8" Height="8" CornerRadius="4" Margin="0,6,0,0"
                          Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />
                </StackPanel>
              </Grid>

              <!-- La consigne n'a de sens que là où les cases existent, donc
                   à la mise en route seulement. -->
              <StackPanel Visibility="{Binding ShowSelection,
                                               RelativeSource={RelativeSource AncestorType=UserControl},
                                               Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Cochez les instances à ouvrir au démarrage."
                           Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,2"
                           Visibility="{Binding Instances.Count, Converter={StaticResource EmptyToVisibility},
                                                ConverterParameter=inverse}" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Instances}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5" Background="Transparent" AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnDragSourcePressed"
                          MouseMove="OnDragSourceMoved"
                          DragOver="OnDragOver" Drop="OnDrop">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ToolTip="Ouvrir cette instance au démarrage de l'application"
                                Visibility="{Binding ShowSelection,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     Converter={StaticResource BoolToVisibility}}" />

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Ce texte devient le titre de la fenêtre du jeu"
                                 Padding="6,4" />
                        <TextBlock Text="{Binding UserLabel}" Style="{StaticResource Muted}"
                                   FontSize="11" Margin="2,3,0,0" />
                      </StackPanel>

                      <!-- Les boutons disent à eux seuls l'état de l'instance :
                           « Lancer » quand elle est fermée, « Relancer » et
                           « Fermer » quand elle est ouverte. Un badge en plus
                           n'apprendrait rien. -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  Visibility="{Binding ShowOrdering,
                                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource MoveButton}" ToolTip="Placer cette instance au-dessus"
                                IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding DataContext.MoveInstanceUpCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <Path Data="{StaticResource ChevronUp}" Stroke="{DynamicResource TextMutedBrush}"
                                StrokeThickness="1.4" />
                        </Button>
                        <Button Style="{StaticResource MoveButton}" ToolTip="Placer cette instance en dessous"
                                IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding DataContext.MoveInstanceDownCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <Path Data="{StaticResource ChevronDown}" Stroke="{DynamicResource TextMutedBrush}"
                                StrokeThickness="1.4" />
                        </Button>
                      </StackPanel>

                      <Grid Grid.Column="3"
                            Visibility="{Binding ShowActions,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource BoolToVisibility}}">

                        <!-- L'indicateur prend la place des boutons pendant l'action. -->
                        <Control Style="{StaticResource BusyIndicator}"
                                 Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding IsWorking,
                                                         Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Content="Lancer" Style="{StaticResource QuietButton}"
                                ToolTip="Ouvrir cette instance maintenant"
                                Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                                Command="{Binding DataContext.LaunchInstanceCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />

                        <Button Content="Relancer" Style="{StaticResource QuietButton}"
                                ToolTip="Fermer le jeu sur l'appareil, puis le rouvrir"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.RestartCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />

                        <Button Content="Fermer" Style="{StaticResource QuietButton}"
                                ToolTip="Fermer cette fenêtre de jeu"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.StopCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                         Text="Le jeu n'est installé sur aucun profil de cet appareil."
                         Visibility="{Binding Instances.Count, Converter={StaticResource EmptyToVisibility}}" />

            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Aucun appareil joignable : les appareils absents ne sont pas
         affichés, il faut donc dire pourquoi la liste est vide. -->
    <Border Style="{StaticResource Card}"
            Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVisibility}}">
      <StackPanel>
        <TextBlock Text="AUCUN APPAREIL DÉTECTÉ" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource Muted}"
                   Text="Branchez un câble USB avec le débogage activé : l'appareil apparaîtra tout seul. Un téléphone déjà associé en Wi-Fi se reconnecte de lui-même dès qu'il est de nouveau sur le réseau." />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Problem}" Style="{StaticResource Muted}"
               Foreground="{DynamicResource WarningBrush}" Margin="2,0,0,6"
               Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                    ConverterParameter=inverse}" />

    <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,4"
               Text="Le texte modifiable devient le titre de la fenêtre du jeu, dans la barre des tâches."
               Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVisibility},
                                    ConverterParameter=inverse}" />

  </StackPanel>
</UserControl>
