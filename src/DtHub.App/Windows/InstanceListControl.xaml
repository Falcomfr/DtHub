<UserControl x:Class="DtHub.App.Windows.InstanceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liste des téléphones et de leurs instances. Partagée par la fenêtre de
       mise en route et par l'onglet Appareils. -->
  <StackPanel>

    <ItemsControl ItemsSource="{Binding Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}">
            <StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                </StackPanel>

                <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top"
                        Margin="0,6,0,0"
                        Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Instances}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ToolTip="Lancer cette instance au démarrage" />

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Nom affiché dans le titre de la fenêtre"
                                 Padding="6,4" />
                        <TextBlock Text="{Binding UserLabel}" Style="{StaticResource Muted}"
                                   FontSize="11" Margin="2,3,0,0" />
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  Margin="10,0,0,0">
                        <Border Style="{StaticResource StatusPill}" Margin="0,0,6,0"
                                Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}">
                          <TextBlock Text="{Binding StatusText}" Foreground="White"
                                     FontSize="10" FontWeight="SemiBold" />
                        </Border>

                        <Button Content="Relancer" Style="{StaticResource QuietButton}"
                                ToolTip="Fermer puis rouvrir cette instance"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.RestartCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                         Text="Le jeu n'est installé sur aucun profil de ce téléphone."
                         Visibility="{Binding Instances, Converter={StaticResource EmptyToVisibility}}" />

            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{Binding Problem}" Style="{StaticResource Muted}"
               Foreground="{DynamicResource WarningBrush}" Margin="2,0,0,6"
               Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                    ConverterParameter=inverse}" />

  </StackPanel>
</UserControl>
