<UserControl x:Class="DtHub.App.Windows.InstanceListControl"
             GiveFeedback="OnGiveFeedback" MouseMove="OnDragSourceMoved"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DtHub.App.Localization"
             xmlns:s="clr-namespace:DtHub.Core.Settings;assembly=DtHub.Core">
  <!-- A single list of instances, across all devices. A phone's name
       only appears where it changes. Shared by the setup window and by
       the Devices tab. -->
  <StackPanel>

    <StackPanel Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>

              <!-- Device header. Outside the drop surface: including it
                   would push down the midpoint that decides between
                   "above" and "below", and only the first row of a
                   device would suffer from it. -->
              <Grid Margin="0,6,0,3"
                    Visibility="{Binding ShowDeviceHeader, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="1"
                        Background="{Binding Device.StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Device.Name}"
                             Style="{StaticResource DeviceHeader}" VerticalAlignment="Center"
                             ToolTip="{Binding Device.StatusText}" />

                  <!-- Spelled out only where you're choosing what to
                       launch: elsewhere the coloured dot is enough. -->
                  <TextBlock Text="{Binding Device.StatusText}" Style="{StaticResource Muted}"
                             FontSize="{StaticResource FontTiny}" Margin="8,1,0,0" VerticalAlignment="Center"
                             Visibility="{Binding ShowDeviceStatus,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Converter={StaticResource BoolToVisibility}}" />

                  <!-- The battery level. Drawn, not just given as a number:
                       a gauge reads without being read, and that's the
                       nature of information you want to catch out of
                       the corner of your eye. Nothing appears until
                       the device has responded. -->
                  <StackPanel Orientation="Horizontal" Margin="10,1,0,0" VerticalAlignment="Center"
                              ToolTip="{Binding Device.BatterySummary}"
                              Visibility="{Binding Device.HasBattery,
                                                   Converter={StaticResource BoolToVisibility}}">

                    <Border Width="18" Height="9" CornerRadius="2" Padding="1"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1">
                      <Rectangle HorizontalAlignment="Left" RadiusX="1" RadiusY="1"
                                 Width="{Binding Device.BatteryFill}"
                                 Fill="{Binding Device.BatteryBrushKey,
                                                Converter={StaticResource KeyToBrush}}" />
                    </Border>

                    <!-- The little nub at the tip, which makes it read as a
                         battery. -->
                    <Border Width="2" Height="4" CornerRadius="0,1,1,0" Margin="1,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TextMutedBrush}" />

                    <!-- The lightning bolt says why a phone at twelve
                         percent isn't warning about anything: it's
                         plugged in. -->
                    <Path Width="5" Height="8" Margin="5,0,0,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="M 3.2,0 L 0,4.6 L 2.2,4.6 L 1.8,8 L 5,3.4 L 2.8,3.4 Z"
                          Fill="{DynamicResource TextMutedBrush}"
                          Visibility="{Binding Device.IsCharging,
                                               Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Device.BatteryText}" Style="{StaticResource Muted}"
                               FontSize="{StaticResource FontTiny}" Margin="5,1,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding Device.BatteryBrushKey,
                                                    Converter={StaticResource KeyToBrush}}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Add an account: a fresh Android profile, with the game
                     inside. It's Android's own multiple-user mechanism,
                     the same one the phone's manufacturer overlay uses
                     itself. A solid plus sign, because adding has no
                     other icon. -->
                <Button Style="{StaticResource IconButton}" AllowDrop="False"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTip="{loc:T AddAccountTip}"
                        Command="{Binding DataContext.AddAccountCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Device}">
                  <Path Data="M 7.5,3 L 7.5,12 M 3,7.5 L 12,7.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                  <Button.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="ShowActions" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      <Binding Path="IsFirstOfDevice" />
                    </MultiBinding>
                  </Button.Visibility>
                </Button>

                <!-- Breaking the pairing only applies at the device level:
                     on its first row only, otherwise the button would
                     appear twice for the same phone. -->
                <!-- A broken link, drawn as two separated rings. -->
                <Button Style="{StaticResource DangerIconButton}"
                        AllowDrop="False"
                        ToolTip="{loc:T ForgetDeviceTip}"
                        Command="{Binding DataContext.ForgetDeviceCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Device}">
                  <Path Style="{StaticResource BinGlyph}" />

                  <Button.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="ShowActions" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      <Binding Path="IsFirstOfDevice" />
                    </MultiBinding>
                  </Button.Visibility>
                </Button>

                </StackPanel>
              </Grid>

              <!-- What's wrong with this device, under its name.

                   These findings used to live in a single banner at the
                   bottom of the list, where they seemed to talk about
                   the last device shown, which happened to be the one
                   with nothing wrong. The message's placement was half
                   the message.

                   One finding per row, each one truncated, full text on
                   hover: the number of rows follows that of the actual
                   problems, which is zero most of the time. -->
              <Grid Margin="16,0,0,4" ToolTip="{Binding Device.Problems}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.Visibility>
                  <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="ShowDeviceHeader" />
                    <Binding Path="Device.HasProblems" />
                  </MultiBinding>
                </Grid.Visibility>

                <Path Grid.Column="0" Width="13" Height="13" Stretch="None" Margin="0,1,5,0"
                      VerticalAlignment="Top" StrokeLineJoin="Round" StrokeThickness="1.3"
                      Stroke="{Binding Device.ProblemsBrushKey, Converter={StaticResource KeyToBrush}}"
                      Data="M 6.5,2 L 12.5,11.5 H 0.5 Z M 6.5,5.5 V 8 M 6.5,9.6 V 10.1" />

                <TextBlock Grid.Column="1" Text="{Binding Device.Problems}"
                           FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSmall}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Device.ProblemsBrushKey,
                                                Converter={StaticResource KeyToBrush}}" />
              </Grid>

              <!-- Drop surface: the row and its two markers, nothing else. -->
              <StackPanel AllowDrop="True"
                          Opacity="{Binding IsDragging, Converter={StaticResource DraggedOpacity}}"
                          DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">

                <Border Style="{StaticResource DropLine}"
                        Opacity="{Binding DropAbove, Converter={StaticResource BoolToOpacity}}" />

                <Grid Margin="0,1" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>


                  <Control Grid.Column="1" Style="{StaticResource DragHandle}" Margin="0,0,2,0"
                           VerticalAlignment="Center"
                           ToolTip="{loc:T DragToReorderTip}"
                           PreviewMouseLeftButtonDown="OnDragSourcePressed">
                    <Control.Visibility>
                      <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="ShowOrdering" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Path="DataContext.CanReorder"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </Control.Visibility>
                  </Control>

                  <!-- Locked, the window is left where it is: keyboard
                       navigation, stacking, side by side, and the
                       sizing presets all ignore it. -->
                  <ToggleButton Grid.Column="2" Style="{StaticResource LockToggle}"
                                IsChecked="{Binding IsLocked}" AllowDrop="False"
                                Margin="0,0,4,0" VerticalAlignment="Center"
                                ToolTip="{loc:T LockWindowTip}"
                                Visibility="{Binding ShowActions,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     Converter={StaticResource BoolToVisibility}}" />

                  <!-- The game's actual icon, pulled from a single entry in
                       its archive. The space is held even when there is
                       none: a fixed height and width mean the column
                       doesn't move, and an icon arriving after the scan
                       doesn't shift the name of every row. -->
                  <!-- Puts the account in the tabbed frame, or takes it
                       out. The window is neither closed nor reopened:
                       it is docked as is. -->
                  <ToggleButton Grid.Column="3" AllowDrop="False" Cursor="Hand"
                                Margin="0,0,5,0" VerticalAlignment="Center"
                                IsChecked="{Binding IsTabbed}"
                                ToolTip="{loc:T TabbedTip}"
                                Visibility="{Binding ShowActions,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Fond" Background="Transparent" Padding="2"
                                CornerRadius="{StaticResource Radius}">
                          <Path x:Name="Trait" StrokeThickness="1.4" Width="16" Height="16"
                                Stroke="{DynamicResource TextMutedBrush}"
                                Data="M 1.5,3 H 14.5 V 13.5 H 1.5 Z M 1.5,7 H 14.5 M 8,3 V 7" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}" />
                          </Trigger>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trait" Property="Stroke"
                                    Value="{DynamicResource AccentBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>

                  <!-- The week's playtime is read by hovering over the
                       icon: it's information you go looking for, not a
                       state you keep watch on, and the row is already
                       full. Nothing appears as long as there is nothing
                       to say, the value being null rather than empty. -->
                  <Image Grid.Column="4" Width="20" Height="20" Margin="0,0,7,0"
                         VerticalAlignment="Center" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         ToolTip="{Binding PlaytimeLabel}"
                         Source="{Binding IconPath, Converter={StaticResource IconPath}}" />

                  <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AllowDrop="False"
                             KeyDown="OnRenameKey"
                             Style="{StaticResource InlineEdit}"
                             ToolTip="{loc:T RenameTip}" />

                    <!-- The profile only shows after a rename: at that
                         point it's the only way to tell which is which.
                         Without a rename, it would just repeat the name
                         already shown. -->
                    <TextBlock Text="{Binding UserLabel}" Style="{StaticResource Muted}"
                               FontSize="{StaticResource FontTiny}" Margin="2,1,0,0"
                               Visibility="{Binding ShowUserLabel,
                                                    Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>

                  <!-- The buttons alone tell the instance's state:
                       "Launch" when it's closed, "Restart" and "Close"
                       when it's open. -->
                  <Grid Grid.Column="6" Margin="8,0,0,0"
                        Visibility="{Binding ShowActions,
                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                             Converter={StaticResource BoolToVisibility}}">

                    <Control Style="{StaticResource BusyIndicator}"
                             Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy,
                                                     Converter={StaticResource InverseBoolToVisibility}}">
                      <!-- This account's quality tier. Silent as long as it
                           follows the shared setting, which is the case
                           for everyone by default: five rows showing
                           "Medium" for five accounts set the same way
                           would teach nothing. -->
                      <Grid Margin="0,0,4,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="Palier" AllowDrop="False" Padding="6,3"
                                      FontSize="{StaticResource FontSmall}"
                                      ToolTip="{loc:T InstanceQualityTip}">
                          <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource OutlineToggle}">
                              <Style.Triggers>
                                <!-- An account that follows the common
                                     setting fades out, but its shape
                                     stays: a button no one can see is a
                                     button no one finds. -->
                                <DataTrigger Binding="{Binding HasOwnQuality}" Value="False">
                                  <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ToggleButton.Style>

                          <StackPanel Orientation="Horizontal">
                            <!-- Three rising bars: the universal icon for a
                                 level, one that needs no learning. -->
                            <Path Width="13" Height="13" Stretch="None" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 2.5,10.5 V 8 M 6.5,10.5 V 5.5 M 10.5,10.5 V 3" />

                            <TextBlock Text="{Binding QualityLabel}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                       Visibility="{Binding QualityLabel,
                                                    Converter={StaticResource EmptyToVisibility},
                                                    ConverterParameter=inverse}" />
                          </StackPanel>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsChecked, ElementName=Palier, Mode=TwoWay}" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=Palier}"
                               AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-110">
                          <Border Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                  CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="4">
                            <StackPanel MinWidth="170">
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T QualityFollowShared}"
                                      Command="{Binding FollowSharedQualityCommand}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T QualityLowShort}"
                                      Command="{Binding PickQualityCommand}"
                                      CommandParameter="{x:Static s:StreamQuality.Low}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T QualityMediumShort}"
                                      Command="{Binding PickQualityCommand}"
                                      CommandParameter="{x:Static s:StreamQuality.Medium}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T QualityMaximumShort}"
                                      Command="{Binding PickQualityCommand}"
                                      CommandParameter="{x:Static s:StreamQuality.Maximum}" />
                            </StackPanel>
                          </Border>
                        </Popup>
                      </Grid>

                      <!-- This account's zoom distance, next to its quality
                           tier and built the same way. Silent as long
                           as it follows the common one. Since the
                           setting only takes effect on opening, a dot
                           flags the window that is still running with
                           the old one. -->
                      <Grid Margin="0,0,4,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="Distance" AllowDrop="False" Padding="6,3"
                                      FontSize="{StaticResource FontSmall}"
                                      ToolTip="{loc:T InstanceZoomTip}">
                          <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource OutlineToggle}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOwnZoom}" Value="False">
                                  <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ToggleButton.Style>

                          <StackPanel Orientation="Horizontal">
                            <!-- A frame within a frame: the same window
                                 showing more or less of the field of
                                 view, which is exactly what the setting
                                 does. A thinner stroke than the quality
                                 tier's: two rectangles nested within
                                 thirteen pixels close in on themselves
                                 if you thicken them. -->
                            <Path Width="13" Height="13" Stretch="None" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  Data="M 1.2,2.6 H 11.8 V 10.4 H 1.2 Z M 4.6,5.1 H 8.4 V 7.9 H 4.6 Z" />

                            <TextBlock Text="{Binding ZoomLabel}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                       Visibility="{Binding ZoomLabel,
                                                    Converter={StaticResource EmptyToVisibility},
                                                    ConverterParameter=inverse}" />
                          </StackPanel>
                        </ToggleButton>

                        <!-- The dot that says the open window is still
                             running with the old zoom distance. Without
                             it, the setting looked dead. -->
                        <Ellipse Width="6" Height="6" Margin="0,-2,-2,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{DynamicResource WarningBrush}"
                                 ToolTip="{loc:T InstanceZoomWaitsForReopen}"
                                 Visibility="{Binding ZoomWaitsForReopen,
                                              Converter={StaticResource BoolToVisibility}}" />

                        <Popup IsOpen="{Binding IsChecked, ElementName=Distance, Mode=TwoWay}" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=Distance}"
                               AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-110">
                          <Border Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                  CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="4">
                            <StackPanel MinWidth="170">
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T QualityFollowShared}"
                                      Command="{Binding FollowSharedZoomCommand}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T ZoomVeryFar}"
                                      Command="{Binding PickZoomCommand}"
                                      CommandParameter="{x:Static s:GameZoom.Widest}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T ZoomFar}"
                                      Command="{Binding PickZoomCommand}"
                                      CommandParameter="{x:Static s:GameZoom.Wide}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T ZoomNormal}"
                                      Command="{Binding PickZoomCommand}"
                                      CommandParameter="{x:Static s:GameZoom.Normal}" />
                              <Button Style="{StaticResource QuietButton}" Padding="8,5"
                                      HorizontalContentAlignment="Left"
                                      Content="{loc:T ZoomClose}"
                                      Command="{Binding PickZoomCommand}"
                                      CommandParameter="{x:Static s:GameZoom.Close}" />
                            </StackPanel>
                          </Border>
                        </Popup>
                      </Grid>

                      <!-- A solid triangle: the one icon nobody needs to
                           learn. -->
                      <Button Style="{StaticResource IconButton}" AllowDrop="False"
                              ToolTip="{loc:T OpenInstanceTip}"
                              Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                              Command="{Binding DataContext.LaunchInstanceCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Path Data="M 4,2.5 L 12.5,7.5 L 4,12.5 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="15" Height="15" Stretch="None" />
                      </Button>

                      <!-- An arrow that loops back: the game restarts, the
                           window stays. -->
                      <Button Style="{StaticResource IconButton}" AllowDrop="False"
                              ToolTip="{loc:T RestartTip}"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.RestartCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Path Style="{StaticResource RowGlyph}"
                              Data="M 13,7.5 A 5.5,5.5 0 1 1 11.1,3.3 M 13,1.5 V 4.2 H 10.3" />
                      </Button>

                      <!-- A solid square, paired with the triangle: play
                           and stop. It used to be a cross, and in a list
                           a cross means "delete this row" to almost
                           everyone. Nothing is deleted here, and the
                           tooltip says so now too. -->
                      <Button Style="{StaticResource IconButton}" AllowDrop="False"
                              ToolTip="{loc:T CloseWindowTip}"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.StopCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{Binding Foreground,
                                                  RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Grid>

                <Border Style="{StaticResource DropLine}"
                        Opacity="{Binding DropBelow, Converter={StaticResource BoolToOpacity}}" />
              </StackPanel>

            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Devices with no instance at all: offline, or reachable but
         without the game. Without this reminder, plugging in a phone
         missing the game would produce nothing at all on screen. -->
    <StackPanel Margin="0,6,0,4"
                Visibility="{Binding HasInactiveDevices, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding InactiveDevices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- A second row, empty as long as there's nothing to say. -->
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource GrooveBrush}" BorderThickness="1"
                      Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DeviceHeader}" />

                <!-- Offline, the grey dot is enough in the ordinary list.
                     A missing game, though, can't be guessed. And where
                     you're choosing what to launch, both cases get
                     spelled out. -->
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"
                           FontSize="{StaticResource FontTiny}" Margin="8,1,0,0"
                           Foreground="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}"
                           ToolTip="{Binding StatusTip}">
                  <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AnyTrue}">
                      <Binding Path="HasNoGame" />
                      <Binding Path="ShowDeviceStatus"
                               RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                  </TextBlock.Visibility>
                </TextBlock>
              </StackPanel>

              <Button Grid.Column="2" Style="{StaticResource DangerIconButton}"
                      ToolTip="{loc:T ForgetDeviceShortTip}"
                      Visibility="{Binding ShowActions,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVisibility}}"
                      Command="{Binding DataContext.ForgetDeviceCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Path Style="{StaticResource BinGlyph}" />
              </Button>

              <!-- Where to fix it, on the only device where the refusal
                   was observed. A short line: "To pair again" says
                   what's missing, this one says how, and nothing shows
                   until that's established. -->
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Muted}"
                         FontSize="{StaticResource FontTiny}" Margin="0,1,0,2"
                         Text="{loc:T ToPairAgainHow}"
                         Foreground="{DynamicResource WarningBrush}"
                         Visibility="{Binding NeedsPairing,
                                              Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

    <!-- The first scan looks for remembered phones, and a phone that's
         turned off makes it wait. A word is better than emptiness. -->
    <Border Style="{StaticResource Card}" Padding="10,8"
            Visibility="{Binding ShowsSearching, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <Control Style="{StaticResource Spinner}" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Text="{loc:T SearchingDevices}" Style="{StaticResource Muted}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- No device at all: we need to say why the list is empty. -->
    <Border Style="{StaticResource Card}" Padding="10,8"
            Visibility="{Binding ShowsNoDeviceCard, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{loc:T NoDeviceFound}" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   Text="{loc:T NoDeviceHelp}" />
      </StackPanel>
    </Border>

    <!-- One finding per row, each one truncated, with the full text on
         hover. The full-width message took two or three lines by
         itself in the middle of the account list. Reducing it to a
         single icon would have been worse: these messages announce a
         battery that's failing, a phone that's throttling itself, or a
         window that will only show a padlock, and a warning you have
         to hover over to discover is a warning nobody reads.

         And for the same reason, the banner shows all of them:
         displaying only the most serious one hid the others just as
         surely as a hover would. One phone carried three at once, and
         the first one had to be fixed before learning the second one
         existed. Each row stays a row; their number follows that of
         the actual problems, which is zero most of the time. -->
    <Grid Margin="2,0,0,4"
          ToolTip="{Binding Problem}"
          Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                               ConverterParameter=inverse}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The triangle turns from yellow to red when the finding will
           cut the session short instead of just being a nuisance. -->
      <Path Grid.Column="0" Width="13" Height="13" Stretch="None" Margin="0,1,5,0"
            VerticalAlignment="Top" StrokeLineJoin="Round"
            StrokeThickness="1.3"
            Data="M 6.5,2 L 12.5,11.5 H 0.5 Z M 6.5,5.5 V 8 M 6.5,9.6 V 10.1">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ProblemIsSerious}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <TextBlock Grid.Column="1" Text="{Binding Problem}"
                 FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSmall}"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ProblemIsSerious}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

  </StackPanel>
</UserControl>
