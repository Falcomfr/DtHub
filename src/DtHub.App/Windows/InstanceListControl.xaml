<UserControl x:Class="DtHub.App.Windows.InstanceListControl"
             GiveFeedback="OnGiveFeedback" MouseMove="OnDragSourceMoved"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liste unique des instances, tous appareils confondus. Le nom d'un
       téléphone n'apparaît qu'aux endroits où il change. Partagée par la
       fenêtre de mise en route et par l'onglet Appareils. -->
  <StackPanel>

    <!-- La consigne n'a de sens que là où les cases existent, donc à la mise
         en route seulement. -->
    <TextBlock Text="Cochez les instances à ouvrir au démarrage."
               Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,6">
      <TextBlock.Visibility>
        <MultiBinding Converter="{StaticResource AllTrue}">
          <Binding Path="ShowSelection" RelativeSource="{RelativeSource AncestorType=UserControl}" />
          <Binding Path="HasRows" />
        </MultiBinding>
      </TextBlock.Visibility>
    </TextBlock>

    <StackPanel Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>

              <!-- En-tête d'appareil. Hors de la surface de dépôt : l'inclure
                   décalerait vers le bas le milieu qui départage « au-dessus »
                   et « en dessous », et seule la première ligne d'un appareil
                   en souffrirait. -->
              <Grid Margin="0,6,0,3"
                    Visibility="{Binding ShowDeviceHeader, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="{Binding Device.StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

                <TextBlock Grid.Column="1" Text="{Binding Device.Name}"
                           Style="{StaticResource DeviceHeader}" VerticalAlignment="Center"
                           ToolTip="{Binding Device.StatusText}" />

                <!-- Rompre l'association ne vaut que pour l'appareil : sur son
                     premier morceau seulement, sans quoi le bouton paraîtrait
                     deux fois pour le même téléphone. -->
                <!-- Un maillon rompu, dessiné comme deux anneaux écartés. -->
                <Button Grid.Column="2" Style="{StaticResource DangerIconButton}"
                        AllowDrop="False"
                        ToolTip="Rompre l'association avec cet appareil. Ses fenêtres se ferment, et ses instances comme leurs réglages sont effacés. Une confirmation est demandée."
                        Command="{Binding DataContext.ForgetDeviceCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Device}">
                  <Control Style="{StaticResource UnlinkGlyph}" />

                  <Button.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                      <Binding Path="ShowActions" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      <Binding Path="IsFirstOfDevice" />
                    </MultiBinding>
                  </Button.Visibility>
                </Button>
              </Grid>

              <!-- Surface de dépôt : la ligne et ses deux repères, rien d'autre. -->
              <StackPanel AllowDrop="True"
                          Opacity="{Binding IsDragging, Converter={StaticResource DraggedOpacity}}"
                          DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">

                <Border Style="{StaticResource DropLine}"
                        Opacity="{Binding DropAbove, Converter={StaticResource BoolToOpacity}}" />

                <Grid Margin="0,1" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" AllowDrop="False"
                            Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Ouvrir cette instance au démarrage de l'application"
                            Visibility="{Binding ShowSelection,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource BoolToVisibility}}" />

                  <Control Grid.Column="1" Style="{StaticResource DragHandle}" Margin="0,0,2,0"
                           VerticalAlignment="Center"
                           ToolTip="Glissez pour changer l'ordre. Une instance peut se placer entre celles d'un autre appareil, et cet ordre est aussi celui du parcours au clavier."
                           PreviewMouseLeftButtonDown="OnDragSourcePressed">
                    <Control.Visibility>
                      <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="ShowOrdering" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Path="DataContext.CanReorder"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </Control.Visibility>
                  </Control>

                  <!-- Verrouillée, la fenêtre est laissée où elle est : le
                       parcours au clavier, l'empilement, le côte à côte et les
                       tailles l'ignorent. -->
                  <ToggleButton Grid.Column="2" Style="{StaticResource LockToggle}"
                                IsChecked="{Binding IsLocked}" AllowDrop="False"
                                Margin="0,0,4,0" VerticalAlignment="Center"
                                ToolTip="Verrouiller cette fenêtre à sa place. Elle ne bougera plus lors d'un empilement, d'une mise côte à côte ou d'un changement de taille, et le parcours au clavier ne s'y arrêtera pas. Les autres fenêtres se placent sans elle." />

                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AllowDrop="False"
                             Style="{StaticResource InlineEdit}"
                             ToolTip="Cliquez pour renommer. Ce texte devient le titre de la fenêtre du jeu, visible dans la barre des tâches." />

                    <!-- Le profil ne s'affiche qu'après un renommage : c'est
                         alors le seul moyen de savoir lequel est lequel. Sans
                         renommage, il répète le nom déjà affiché. -->
                    <TextBlock Text="{Binding UserLabel}" Style="{StaticResource Muted}"
                               FontSize="10" Margin="2,1,0,0"
                               Visibility="{Binding ShowUserLabel,
                                                    Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>

                  <!-- Les boutons disent à eux seuls l'état de l'instance :
                       « Lancer » quand elle est fermée, « Relancer » et
                       « Fermer » quand elle est ouverte. -->
                  <Grid Grid.Column="4" Margin="8,0,0,0"
                        Visibility="{Binding ShowActions,
                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                             Converter={StaticResource BoolToVisibility}}">

                    <Control Style="{StaticResource BusyIndicator}"
                             Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy,
                                                     Converter={StaticResource InverseBoolToVisibility}}">
                      <Button Content="Lancer" Style="{StaticResource RowButton}" AllowDrop="False"
                              ToolTip="Ouvrir cette instance maintenant"
                              Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                              Command="{Binding DataContext.LaunchInstanceCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />

                      <!-- Une flèche qui reboucle : le jeu redémarre, la
                           fenêtre reste. -->
                      <Button Style="{StaticResource IconButton}" AllowDrop="False"
                              ToolTip="Relancer le jeu sans fermer la fenêtre. Utile quand une fenêtre s'est figée : elle repart à l'écran de connexion, à sa place et à sa taille."
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.RestartCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Path Style="{StaticResource RowGlyph}"
                              Data="M 13,7.5 A 5.5,5.5 0 1 1 11.1,3.3 M 13,1.5 V 4.2 H 10.3" />
                      </Button>

                      <Button Style="{StaticResource IconButton}" AllowDrop="False"
                              ToolTip="Fermer cette fenêtre. Sa position est retenue, mais elle ne rouvrira pas au prochain lancement tant que vous ne la recochez pas."
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.StopCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Path Style="{StaticResource RowGlyph}" Data="M 4,4 L 11,11 M 11,4 L 4,11" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Grid>

                <Border Style="{StaticResource DropLine}"
                        Opacity="{Binding DropBelow, Converter={StaticResource BoolToOpacity}}" />
              </StackPanel>

            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Appareils sans aucune instance : hors ligne, ou joignables mais sans
         le jeu. Sans ce rappel, brancher un téléphone où le jeu manque ne
         produirait rien du tout à l'écran. -->
    <StackPanel Margin="0,6,0,4"
                Visibility="{Binding HasInactiveDevices, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding InactiveDevices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}" />

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DeviceHeader}" />

                <!-- Hors ligne, le point gris suffit. Un jeu manquant, lui,
                     ne se devine pas. -->
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"
                           FontSize="10" Margin="8,1,0,0"
                           Visibility="{Binding HasNoGame, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <Button Grid.Column="2" Style="{StaticResource DangerIconButton}"
                      ToolTip="Rompre l'association avec cet appareil. Ses instances comme leurs réglages sont effacés. Une confirmation est demandée."
                      Visibility="{Binding ShowActions,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVisibility}}"
                      Command="{Binding DataContext.ForgetDeviceCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Control Style="{StaticResource UnlinkGlyph}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Aucun appareil du tout : il faut dire pourquoi la liste est vide. -->
    <Border Style="{StaticResource Card}" Padding="10,8"
            Visibility="{Binding HasNoConnectedDevice, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="AUCUN APPAREIL DÉTECTÉ" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                   Text="Branchez un câble USB avec le débogage activé : l'appareil apparaîtra tout seul. Un téléphone déjà associé en Wi-Fi se reconnecte de lui-même dès qu'il revient sur le réseau." />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Problem}" Style="{StaticResource Muted}" FontSize="11"
               Foreground="{DynamicResource WarningBrush}" Margin="2,0,0,4"
               Visibility="{Binding Problem, Converter={StaticResource EmptyToVisibility},
                                    ConverterParameter=inverse}" />

  </StackPanel>
</UserControl>
