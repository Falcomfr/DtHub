<Window x:Class="DtHub.App.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide"
        Width="560" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Préparer le téléphone" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="Les menus ne portent pas le même nom d'une marque à l'autre. Choisissez la vôtre." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="Fermer" HorizontalAlignment="Right" MinWidth="110" Click="OnClose" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,14">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="1. Débloquer les options pour les développeurs" />
            <TextBlock Text="{Binding Brand.BuildNumberPath}" Style="{StaticResource Muted}" Margin="0,0,0,3" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="Appuyez sept fois de suite sur «" />
              <Run Text="{Binding Brand.BuildNumberLabel, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="». Un message confirme que vous êtes développeur." />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="2. Ouvrir les options pour les développeurs" />
            <TextBlock Text="{Binding Brand.DeveloperOptionsPath}" Style="{StaticResource Muted}" Margin="0,0,0,3" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Activez « Débogage USB » et « Débogage sans fil »." />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding Brand.Warning}" Style="{StaticResource Muted}"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="3. Par câble, le plus simple" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Branchez le câble et acceptez la demande affichée sur le téléphone. Il apparaît tout seul dans la fenêtre principale, il n'y a rien d'autre à faire." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="4. Sans fil, la première fois" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                       Text="Débogage sans fil  ›  Associer l'appareil avec un code d'association" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                       Text="Le téléphone affiche un code à six chiffres et apparaît dans la fenêtre d'association." />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Le téléphone et le PC doivent être sur le même réseau Wi-Fi, et Android 11 au minimum. Ensuite, la connexion se refait toute seule à chaque lancement." />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,4"
                   Text="Seuls les téléphones Android conviennent. iOS ne permet ni d'ouvrir un écran supplémentaire, ni d'y installer deux fois la même application." />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
