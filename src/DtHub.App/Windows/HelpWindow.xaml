<Window x:Class="DtHub.App.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="{loc:T Help}"
        Width="560" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{loc:T PrepareDevice}" Style="{StaticResource Title}" />

      <!-- One version per way of being attached: the steps used to follow
           one another in a single list, cable and network mixed, and a
           cable owner read the Wi-Fi's troubles as if they were theirs. -->
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <RadioButton Style="{StaticResource Tab}" Content="{loc:T ByWifi}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable, Converter={StaticResource InverseBool}}" />
        <RadioButton Style="{StaticResource Tab}" Content="{loc:T ByCable}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable}" />
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel x:Name="Steps" Margin="0,0,12,0">

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" Margin="2,4,0,12"
                   Text="{loc:T FrenchLabelsShort}" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="{loc:T UnlockDeveloperOptions}" />
            <w:MenuPathControl Path="{Binding Brand.BuildNumberPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="{loc:T TapSevenTimesPrefix}" />
              <Run Text="{Binding Brand.BuildNumberLabel, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="{loc:T TapSevenTimesSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="{loc:T OpenDeveloperOptions}" />
            <w:MenuPathControl Path="{Binding Brand.DeveloperOptionsPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" Text="{loc:T EnableUsbDebugging}"
                       Visibility="{Binding OnCable, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Muted}" Text="{loc:T EnableDebugging}"
                       Visibility="{Binding OnCable, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{StaticResource Radius}" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding Brand.Warning}" Style="{StaticResource Muted}"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Visibility="{Binding OnCable, Converter={StaticResource BoolToVisibility}}">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T CableIsSimplest}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{loc:T CableSteps}" />
            </StackPanel>
            <StackPanel Visibility="{Binding OnCable, Converter={StaticResource InverseBoolToVisibility}}">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T WirelessFirstTime}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3" Text="{loc:T WirelessMenuPath}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{loc:T WirelessCodeShown}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Where "Nothing shows up?" and an offline phone's help link
             land: the window scrolls straight to it. -->
        <Border x:Name="Fixes" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T HelpFixes}" />
            <StackPanel Visibility="{Binding OnCable, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T HelpFixCableWire}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T HelpFixCableMode}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T HelpFixCableRevoke}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{loc:T HelpFixCableWindows}" />
            </StackPanel>
            <StackPanel Visibility="{Binding OnCable, Converter={StaticResource InverseBoolToVisibility}}">
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T HelpFixWifiRestart}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T StaysOfflineSameBand}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T StaysOfflinePrivate}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T StaysOfflineFirewall}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3" Text="{loc:T StaysOfflineVpn}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{loc:T StaysOfflineByHand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The battery help's other door: the alert can be hidden, and
             what it pointed to must stay findable. -->
        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="2,4,0,6"
                FontSize="{StaticResource FontSmall}"
                Content="{loc:T OpenSleepHelp}" Click="OnSleepHelp" />

        <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" Margin="2,0,0,4"
                   Text="{loc:T AndroidOnly}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
