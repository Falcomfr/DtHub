<Window x:Class="DtHub.App.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:w="clr-namespace:DtHub.App.Windows"
        Title="{loc:T Help}"
        Width="560" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBrush}"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="{loc:T PrepareDevice}" Style="{StaticResource Title}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="{loc:T BrandsDiffer}" />

      <!-- One version per way of being attached: the steps used to follow
           one another in a single list, cable and network mixed, and a
           cable owner read the Wi-Fi's troubles as if they were theirs. -->
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <RadioButton Style="{StaticResource Tab}" Content="{loc:T ByWifi}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable, Converter={StaticResource InverseBool}}" />
        <RadioButton Style="{StaticResource Tab}" Content="{loc:T ByCable}" GroupName="HelpMode"
                     IsChecked="{Binding OnCable}" />
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="{loc:T Close}" HorizontalAlignment="Right" MinWidth="110" Click="OnClose"
              IsCancel="True" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel Margin="0,0,12,0">

        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="{loc:T FrenchLabelsNotice}" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="{loc:T UnlockDeveloperOptions}" />
            <w:MenuPathControl Path="{Binding Brand.BuildNumberPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
              <Run Text="{loc:T TapSevenTimesPrefix}" />
              <Run Text="{Binding Brand.BuildNumberLabel, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="{loc:T TapSevenTimesSuffix}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="{loc:T OpenDeveloperOptions}" />
            <w:MenuPathControl Path="{Binding Brand.DeveloperOptionsPath}" Margin="0,2,0,4" />
            <TextBlock Style="{StaticResource Muted}" Text="{loc:T EnableUsbDebugging}"
                       Visibility="{Binding OnCable, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Muted}" Text="{loc:T EnableDebugging}"
                       Visibility="{Binding OnCable, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{StaticResource Radius}" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding Brand.Warning}" Style="{StaticResource Muted}"
                         Foreground="{DynamicResource WarningBrush}" />
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding OnCable, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T CableIsSimplest}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="{loc:T CableSteps}" />
            </StackPanel>
          </Border>

          <!-- The cable's own failures, gathered here from the places that
               only spoke of them after the fact: the dead input panel and
               the devices tab. -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T CableNoRequest}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T CableNoRequestCable}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T CableNoRequestMode}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T CableNoRequestRevoke}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="{loc:T CableNoRequestWindows}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding OnCable, Converter={StaticResource InverseBoolToVisibility}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T WirelessFirstTime}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                         Text="{loc:T WirelessMenuPath}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,3"
                         Text="{loc:T WirelessCodeShown}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T WirelessKeepOpen}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="{loc:T SameNetworkNotice}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T WirelessAfterRestart}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="{loc:T WirelessAfterRestartSteps}" />
            </StackPanel>
          </Border>

          <!-- Paired, yet offline: the pairing reached the phone, but its
               mDNS announcement never reached the PC. This is where the
               device row's help link lands. -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T StaysOffline}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflineCause}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflineSameBand}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflineGuest}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflinePrivate}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflineFirewall}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Text="{loc:T StaysOfflineVpn}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="{loc:T StaysOfflineByHand}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The battery help's other door: the alert can be hidden, and
             what it pointed to must stay findable. -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{loc:T WindowFreezes}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{loc:T WindowFreezesHelpEntry}" />
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Content="{loc:T OpenSleepHelp}" Click="OnSleepHelp" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}" Margin="2,0,0,4"
                   Text="{loc:T AndroidOnly}" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
