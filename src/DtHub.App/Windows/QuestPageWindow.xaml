<Window x:Class="DtHub.App.Windows.QuestPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DtHub.App.Localization"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:T LinkedPage}"
        Width="620" Height="820" MinWidth="380" MinHeight="360"
        Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">

  <!-- A page opened from a guide, outside quest tracking: no search, no
       steps, no success. It has no connection to anything the quest
       window shows, and borrowing its frame would suggest otherwise.

       No WindowStyle="None" or AllowsTransparency: a WebView2 is a
       native surface and does not render inside a transparent window. -->
  <DockPanel>

    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{StaticResource BrushedPanelBrush}"
            BorderBrush="{DynamicResource BevelBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                   TextTrimming="CharacterEllipsis"
                   Text="{loc:T PapychaGuides}" />

        <!-- Only on a site in another language than ours, where it takes the
             place of the untranslated page: see PageTranslation. -->
        <Button x:Name="Translate" Grid.Column="1"
                Style="{StaticResource QuietButton}"
                ToolTip="{loc:T TranslateTip}" Visibility="Collapsed"
                Click="OnTranslate">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:T Translate}" VerticalAlignment="Center" />
            <Path Style="{StaticResource RowGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                  Data="M 7,3.5 H 3.5 V 12.5 H 12.5 V 9 M 9.5,3.5 H 12.5 V 6.5 M 12.5,3.5 L 7.8,8.2" />
          </StackPanel>
        </Button>

        <Button x:Name="OpenPage" Grid.Column="2" Content="{loc:T OpenInBrowser}"
                Style="{StaticResource QuietButton}"
                ToolTip="{loc:T OpenThisPageTip}"
                Click="OnOpenInBrowser" />
      </Grid>
    </Border>

    <wv:WebView2 x:Name="View" />

  </DockPanel>
</Window>
