<UserControl x:Class="DtHub.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              Padding="28,26,28,26">
    <StackPanel MaxWidth="880">

      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

      <!-- Message d'état, erreurs comprises -->
      <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- Premier lancement -->
      <Border Style="{StaticResource Card}"
              Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Bienvenue dans DT Hub" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,14"
                     Text="Aucun téléphone n'est encore connecté. Branchez-en un en USB avec le débogage activé, ou associez-le en Wi-Fi depuis la page Appareils." />
          <Button Content="Connecter mon premier téléphone" HorizontalAlignment="Left"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding DataContext.Pages[3], RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
      </Border>

      <!-- Téléphones -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="TÉLÉPHONES" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
            <Button Content="Actualiser" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </DockPanel>

          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource StatusPill}"
                          Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Muted}" Text="Aucun téléphone détecté."
                     Visibility="{Binding Devices, Converter={StaticResource EmptyToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- Profil -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="PROFIL" Style="{StaticResource SectionTitle}" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="Name" MinWidth="260" />
            <TextBlock Text="{Binding ProfileSummary}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
          </StackPanel>

          <TextBlock Text="SESSIONS À OUVRIR" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
          <ItemsControl ItemsSource="{Binding PlannedTargets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource Muted}"
                     Text="Ce profil ne contient encore aucune session. Ajoutez-en depuis la page Applications."
                     TextWrapping="Wrap"
                     Visibility="{Binding PlannedTargets, Converter={StaticResource EmptyToVisibility}}" />

          <Button Content="▶  LANCER" Style="{StaticResource LaunchButton}"
                  HorizontalAlignment="Left" Margin="0,18,0,0"
                  Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
        </StackPanel>
      </Border>

      <!-- Sessions ouvertes -->
      <Border Style="{StaticResource Card}"
              Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="SESSIONS OUVERTES" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding OpenSessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource StatusPill}"
                          Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Recentrer les fenêtres" Command="{Binding RecenterCommand}" Margin="0,0,8,0" />
            <Button Content="Fermer toutes les sessions" Style="{StaticResource DangerButton}"
                    Command="{Binding CloseAllCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
