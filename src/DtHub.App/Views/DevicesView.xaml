<UserControl x:Class="DtHub.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              Padding="28,26,28,26">
    <StackPanel MaxWidth="880">

      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

      <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Button Content="+  Connecter un téléphone" Style="{StaticResource PrimaryButton}"
                Command="{Binding StartPairingCommand}" Margin="0,0,8,0" />
        <Button Content="Actualiser" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </StackPanel>

      <!-- Assistant d'appairage Wi-Fi -->
      <Border Style="{StaticResource Card}"
              Visibility="{Binding IsPairingVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Associer un téléphone en Wi-Fi" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Text="1.  Sur le téléphone : Paramètres &gt; À propos, puis appuyez sept fois sur « Numéro de build »." />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Text="2.  Dans Options pour les développeurs, activez « Débogage sans fil »." />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Text="3.  Appuyez sur « Associer l'appareil avec un code d'association »." />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                     Text="4.  Recopiez ci-dessous l'adresse IP, le port et le code affichés. Ils ne servent qu'une fois." />

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Adresse IP" Style="{StaticResource Muted}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port d'association" Style="{StaticResource Muted}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Code" Style="{StaticResource Muted}" Margin="0,0,0,4" />

            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PairingAddress, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PairingPort, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <TextBlock Text="{Binding PairingStatus}" TextWrapping="Wrap" Margin="0,4,0,10"
                     Visibility="{Binding PairingStatus, Converter={StaticResource EmptyToVisibility},
                                          ConverterParameter=inverse}" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Associer et connecter" Style="{StaticResource PrimaryButton}"
                    Command="{Binding PairCommand}" Margin="0,0,8,0" />
            <Button Content="Connexion directe" Command="{Binding ConnectDirectlyCommand}"
                    ToolTip="À utiliser si l'association est déjà faite : saisissez le port de connexion affiché sous « Débogage sans fil »."
                    Margin="0,0,8,0" />
            <Button Content="Annuler" Command="{Binding CancelPairingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Liste des appareils -->
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                    <Border Margin="10,0,0,0" Style="{StaticResource StatusPill}"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding Device.IsPrimary, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Principal" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusPill}"
                        Background="{Binding StatusBrushKey, Converter={StaticResource KeyToBrush}}">
                  <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="Renommer" Margin="0,0,6,0"
                          Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Reconnecter" Margin="0,0,6,0"
                          Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Définir comme principal" Margin="0,0,6,0"
                          Command="{Binding DataContext.SetPrimaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Oublier" Style="{StaticResource DangerButton}"
                          Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}"
              Visibility="{Binding Devices, Converter={StaticResource EmptyToVisibility}}">
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                   Text="Aucun téléphone connu pour l'instant. Branchez-en un en USB avec le débogage activé, ou utilisez le bouton ci-dessus pour une association Wi-Fi." />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
