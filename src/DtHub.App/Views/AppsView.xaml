<UserControl x:Class="DtHub.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="28,26,28,26">

    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

      <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="DisplayName" MinWidth="230" Margin="0,0,10,0" />

            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Rechercher par nom ou par nom de paquet" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
              <Button Content="Actualiser" Command="{Binding RefreshCommand}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton Content="Favoris" GroupName="AppFilter" Margin="0,0,14,0"
                         IsChecked="{Binding FilterMode, Converter={StaticResource Equality}, ConverterParameter=Favorites, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="Favorites" />
            <RadioButton Content="Applications" GroupName="AppFilter" Margin="0,0,14,0"
                         IsChecked="{Binding FilterMode, Converter={StaticResource Equality}, ConverterParameter=Applications, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="Applications" />
            <RadioButton Content="Système" GroupName="AppFilter"
                         IsChecked="{Binding FilterMode, Converter={StaticResource Equality}, ConverterParameter=System, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="System" />

            <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="24,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Barre d'action de la sélection -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0">
          <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text=" application(s) sélectionnée(s)" />
        </TextBlock>
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding TargetProfile}"
                  DisplayMemberPath="Name" MinWidth="200" Margin="0,0,10,0" />
        <Button Content="Ajouter au profil" Style="{StaticResource PrimaryButton}"
                Command="{Binding AddSelectionToProfileCommand}" Margin="0,0,8,0" />
        <Button Content="Tout décocher" Command="{Binding ClearSelectionCommand}" />
      </StackPanel>
    </Border>

    <!-- Liste des applications -->
    <Border Style="{StaticResource Card}" Margin="0">
      <ListBox ItemsSource="{Binding VisibleApps}" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               HorizontalContentAlignment="Stretch">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                        Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" Margin="0,0,10,0" />

              <!-- Pastille tenant lieu d'icône : les vraies icônes ne sont pas
                   accessibles par ADB (voir docs/DECISIONS.md, D6). -->
              <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0"
                      Background="{Binding MonogramColor, Converter={StaticResource HexToBrush}}">
                <TextBlock Text="{Binding Monogram}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <Border Margin="8,0,0,0" Style="{StaticResource StatusPill}"
                          Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding UserLabel}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding PackageName}" Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel>

              <Button Grid.Column="3" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                      Command="{Binding DataContext.ToggleFavoriteCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}">
                <TextBlock FontSize="16">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="☆" />
                      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                          <Setter Property="Text" Value="★" />
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </DockPanel>
</UserControl>
