<UserControl x:Class="DtHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              Padding="28,26,28,26">
    <StackPanel MaxWidth="820">

      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

      <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- Général -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="GÉNÉRAL" Style="{StaticResource SectionTitle}" />

          <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Thème" Width="220" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme_}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Sessions ouvertes à la fermeture" Width="220" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ExitPolicies}" SelectedItem="{Binding ExitPolicy}" />
          </StackPanel>

          <CheckBox Content="Reconnecter les téléphones mémorisés au démarrage"
                    IsChecked="{Binding ReconnectOnStartup}" />
          <CheckBox Content="Vérifier automatiquement les mises à jour"
                    IsChecked="{Binding CheckUpdatesAutomatically}" />
          <CheckBox Content="Afficher aussi les applications système dans le sélecteur"
                    IsChecked="{Binding ShowSystemApps}" />
        </StackPanel>
      </Border>

      <!-- Fenêtres -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="FENÊTRES" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Pourcentages de la zone utilisable de l'écran. La cinquième taille est le plein écran sans bordure." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Taille 1" Width="90" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                    Value="{Binding Size1}" Margin="0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Size1, StringFormat={}{0} %}"
                       Width="50" TextAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Taille 2" Width="90" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                    Value="{Binding Size2}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Size2, StringFormat={}{0} %}"
                       Width="50" TextAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Taille 3" Width="90" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                    Value="{Binding Size3}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Size3, StringFormat={}{0} %}"
                       Width="50" TextAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Taille 4" Width="90" VerticalAlignment="Center" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                    Value="{Binding Size4}" Margin="0,4" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Size4, StringFormat={}{0} %}"
                       Width="50" TextAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Écran préféré" Width="220" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding PreferredMonitor}"
                      DisplayMemberPath="DisplayName" MinWidth="260"
                      ToolTip="Laisser vide pour utiliser l'écran principal de Windows." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Raccourcis -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="RACCOURCIS" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
            <Button Content="Restaurer les raccourcis par défaut" HorizontalAlignment="Right"
                    Style="{StaticResource LinkButton}" Command="{Binding RestoreDefaultHotkeysCommand}" />
          </DockPanel>

          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Les raccourcis n'agissent que pendant qu'une fenêtre de DT Hub est active. Ctrl+Tab reste donc disponible dans vos autres logiciels." />

          <ItemsControl ItemsSource="{Binding Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" VerticalAlignment="Center" />

                    <Border Grid.Column="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <TextBlock Text="{Binding ShortcutText}" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Content="Modifier" Margin="0,0,6,0"
                              Command="{Binding DataContext.BeginCaptureCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Effacer" Style="{StaticResource LinkButton}"
                              Command="{Binding DataContext.ClearHotkeyCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                             FontSize="12" Margin="220,3,0,0" TextWrapping="Wrap"
                             Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- scrcpy -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="MIRRORING" Style="{StaticResource SectionTitle}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Images par seconde" Width="220" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="15" Maximum="120" TickFrequency="5"
                    Value="{Binding MaxFps}" Margin="0,6" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MaxFps}" Width="50"
                       TextAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Débit vidéo (kbit/s)" Width="220" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="1000" Maximum="20000" TickFrequency="500"
                    Value="{Binding VideoBitrateKbps}" Margin="0,6" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VideoBitrateKbps}" Width="50"
                       TextAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <CheckBox Content="Audio du téléphone"
                    ToolTip="Désactivé par défaut : plusieurs sessions simultanées produiraient un mélange inaudible."
                    IsChecked="{Binding AudioEnabled}" />
          <CheckBox Content="Synchroniser le presse-papiers dans les deux sens"
                    IsChecked="{Binding ClipboardSyncEnabled}" />

          <TextBlock Text="Écran virtuel" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Chaque session ouvre son propre écran virtuel sur le téléphone. La définition détermine la forme de la fenêtre." />

          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Largeur" Width="90" VerticalAlignment="Center" />
            <TextBox Text="{Binding VirtualDisplayWidth}" Width="90" Margin="0,0,16,0" />
            <TextBlock Text="Hauteur" Width="70" VerticalAlignment="Center" />
            <TextBox Text="{Binding VirtualDisplayHeight}" Width="90" Margin="0,0,16,0" />
            <TextBlock Text="Densité" Width="70" VerticalAlignment="Center" />
            <TextBox Text="{Binding VirtualDisplayDpi}" Width="90" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Diagnostic -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="DIAGNOSTIC" Style="{StaticResource SectionTitle}" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Établir le diagnostic" Command="{Binding BuildDiagnosticsCommand}" Margin="0,0,8,0" />
            <Button Content="Copier" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,0" />
            <Button Content="Ouvrir le dossier des journaux" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" />
            <Button Content="Ouvrir le dossier de données" Command="{Binding OpenDataFolderCommand}" />
          </StackPanel>

          <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="12"
                  Visibility="{Binding DiagnosticsReport, Converter={StaticResource EmptyToVisibility},
                                       ConverterParameter=inverse}">
            <TextBox Text="{Binding DiagnosticsReport, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="260"
                     VerticalScrollBarVisibility="Auto" />
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
