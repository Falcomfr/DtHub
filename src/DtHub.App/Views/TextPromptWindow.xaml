<Window x:Class="DtHub.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" FontWeight="SemiBold" Margin="0,0,0,10" />
    <TextBox x:Name="Input" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
      <Button Content="Valider" IsDefault="True" MinWidth="90" Click="OnValidate"
              Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>
