<?xml version="1.0" encoding="utf-8"?>
<!--
  The single source of the options that make up the shipped file.

  They used to live copied in three places: the delivery pipeline,
  AGENTS.md and build/lancer.cmd. Nothing checked that they matched, and
  a publish without "self-contained" produces a hundred and fifty
  kilobyte executable that requires .NET installed on the machine, while
  carrying exactly the same Windows metadata as the real one.

  Run via: dotnet publish src/DtHub.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The .NET runtime ships with the file: nothing to install on the machine. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- WPF's native libraries and the WebView2 bootstrapper need a real
         path on disk: without it, they are missing when called for at
         startup. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Deliberately absent: PublishTrimmed would break the COM
         marshalling of IShellLink and the P/Invokes; PublishReadyToRun
         and PublishAot have never been tried here. -->
  </PropertyGroup>
</Project>
