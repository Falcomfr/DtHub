<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Les couleurs viennent de la palette, par référence dynamique. -->

  <!-- L'échelle typographique. Les couleurs passaient toutes par la palette,
       et pas une n'était écrite en dur ; les tailles, elles, étaient des
       nombres anonymes semés dans les fenêtres, si bien qu'une fenêtre neuve en
       choisissait un à l'œil.

       Six crans, et rien entre. Les valeurs sont celles qui étaient déjà
       employées : nommer une échelle ne doit rien déplacer à l'écran.

       Trois tailles restent écrites en dur, et c'est voulu. Le nom du produit
       dans l'en-tête du configurateur est une marque et non du texte courant.
       La croix de fermeture et le chevron des fiches d'aide sont des signes,
       dont la taille suit le dessin et non la lecture. Et MenuPathControl
       dessine un écran d'Android : ses proportions sont celles de ce
       téléphone-là, pas celles de notre interface. -->
  <sys:Double x:Key="FontTiny">10</sys:Double>
  <sys:Double x:Key="FontSmall">11</sys:Double>
  <sys:Double x:Key="FontBody">12</sys:Double>
  <sys:Double x:Key="FontMedium">13</sys:Double>
  <sys:Double x:Key="FontLarge">15</sys:Double>
  <sys:Double x:Key="FontTitle">19</sys:Double>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Police de tout ce qui se lit comme une valeur : raccourcis, pourcentages.
       Un raccourci est une suite de touches, pas une phrase ; la chasse fixe le
       dit, et aligne les colonnes sans qu'on ait à s'en occuper. -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- Le rayon, en un seul endroit.

       Il était écrit en dur à vingt-et-un endroits, de 4 à 10 selon l'humeur :
       le prochain écran en aurait réintroduit un vingt-deuxième. Deux pixels
       adoucissent l'angle sans arrondir la forme. -->
  <CornerRadius x:Key="Radius">2</CornerRadius>
  <CornerRadius x:Key="RadiusTop">2,2,0,0</CornerRadius>

  <!-- Ce qui se presse est plus arrondi que ce qui porte : cinq pixels pour les
       touches, deux pour les cartes et les bulles. La distinction se voit sans
       qu'on ait à la nommer, et deux pixels sur une touche de trente de haut
       lisaient comme un rectangle qu'on aurait oublié de finir. -->
  <CornerRadius x:Key="RadiusKey">5</CornerRadius>

  <!-- La face d'une touche : un dégradé à peine perceptible, plus clair en
       haut. Avec le biseau, c'est ce qui la fait paraître posée plutôt que
       peinte. Deux valeurs prises de part et d'autre du fond des panneaux. -->
  <LinearGradientBrush x:Key="KeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF21252C" />
    <GradientStop Offset="1" Color="#FF15181C" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="KeyFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF272C34" />
    <GradientStop Offset="1" Color="#FF1A1E23" />
  </LinearGradientBrush>

  <!-- Le biseau : lumière en haut, ombre en bas, sur une bordure d'un pixel.
       C'est tout le relief de l'interface, et il ne coûte aucune ombre portée.
       Inversé, il enfonce au lieu de poser : c'est ce que fait un bouton
       pressé. -->
  <LinearGradientBrush x:Key="BevelBorderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF3A414D" />
    <GradientStop Offset="1" Color="#FF0A0C0F" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BevelPressedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF0A0C0F" />
    <GradientStop Offset="1" Color="#FF3A414D" />
  </LinearGradientBrush>

  <!-- Panneau brossé : deux surfaces seulement, le bandeau de titre et la barre
       du bas. Le fond général reste uni, sans quoi l'écran deviendrait bruyant. -->
  <LinearGradientBrush x:Key="BrushedPanelBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF16191F" />
    <GradientStop Offset="1" Color="#FF0E1014" />
  </LinearGradientBrush>

  <!-- Filet gravé : une rainure de deux pixels, l'ombre puis la lumière.
       Remplace l'ancien Separator, qui n'était employé nulle part. -->
  <Style x:Key="Groove" TargetType="Control">
    <Setter Property="Height" Value="2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <StackPanel>
            <Border Height="1" Background="{DynamicResource GrooveBrush}" />
            <Border Height="1" Background="{DynamicResource BevelBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Panneau encastré. Le fond est plus sombre que le châssis et la bordure
       porte le biseau : la carte se creuse au lieu de flotter. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelPressedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource KeyFaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- La face s'éclaircit sous le doigt, au lieu de s'effacer : une
                 baisse d'opacité rapprochait la touche du fond, ce qui est le
                 contraire de ce qu'un survol doit dire. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{StaticResource KeyFaceHoverBrush}" />
            </Trigger>

            <!-- Le biseau s'inverse : la lumière passe en bas, et la touche
                 paraît s'enfoncer sous le doigt. C'est une réponse au geste,
                 là où il n'y avait qu'un changement d'opacité. -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{StaticResource BevelPressedBrush}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

  <!-- Le bleu porte du texte clair : trop sombre pour l'inverse. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Foreground" Value="#FFF2F6FA" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Deux touches de la même famille, l'une simple et l'autre à bascule.
       Le geste d'association et l'ouverture des profils se tiennent sur la même
       ligne : deux dessins différents y faisaient désordre, l'un cadré et
       l'autre flottant sans bord.

       Au repos, le fond du panneau et le biseau, comme les autres touches. Sous
       le doigt, le bleu sourd et le bord d'accent, c'est-à-dire la couleur de
       ce qu'on choisit, là où il n'y avait qu'une baisse d'opacité qui ne
       disait rien. Le dessin de gauche, lui, reste toujours à l'accent : c'est
       la marque de la touche, pas un état. -->
  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{StaticResource BevelPressedBrush}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- La bascule du même dessin. Elle a son gabarit à elle et n'hérite de rien :
       les styles ci-dessus ciblent Button, et les poser sur un ToggleButton lève
       au chargement de la fenêtre, ce que la compilation ne voit pas. Ouverte,
       elle garde le fond d'accent, pour qu'on sache d'où sort la bulle. -->
  <Style x:Key="OutlineToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Une touche d'un groupe : les trois gestes de rangement de la barre du
       bas tiennent dans un seul cadre, séparés par un filet. Elles n'ont donc ni
       bord ni angle à elles, et c'est le cadre qui les arrondit aux extrémités.

       Elles portent leur nom : trois icônes seules obligeaient à survoler pour
       savoir laquelle faisait quoi, et le raccourci écrit sous chacune répétait
       « Ctrl + » trois fois dans une barre de trois cent soixante unités. -->
  <Style x:Key="GroupKey" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Padding" Value="7,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{StaticResource KeyFaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
  </Style>

  <!-- Un lien dans un texte : ni cadre ni fond, seulement la couleur et le
       soulignement au survol. Sert aux prérequis qui mènent à une quête. -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Libelle" Text="{TemplateBinding Content}"
                     TextWrapping="Wrap" Background="Transparent"
                     Foreground="{TemplateBinding Foreground}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Libelle" Property="TextDecorations" Value="Underline" />
              <Setter TargetName="Libelle" Property="Foreground"
                      Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}">
            <Grid>
              <!-- Le texte d'invite, quand le champ est vide et qu'on lui en a
                   posé un dans son Tag.

                   Dans le gabarit et non par-dessus le champ : superposé, il
                   fallait deviner sa marge. Il partage ainsi la bordure et la
                   fonte du champ.

                   Le retrait est appliqué deux fois, en marge et en retrait
                   propre, parce que le champ fait de même : la marge du gabarit
                   écarte le porte-texte, et le champ écarte encore le texte à
                   l'intérieur. Mesuré, l'invite tombait quatorze pixels à
                   gauche de la saisie, soit exactement deux fois les sept
                   pixels de retrait. -->
              <TextBlock x:Name="Invite" Margin="{TemplateBinding Padding}"
                         Padding="{TemplateBinding Padding}"
                         Text="{TemplateBinding Tag}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />

              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Invite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Case à cocher. Elle gardait le gabarit de Windows, avec son bleu et ses
       coins arrondis : le seul contrôle de la fenêtre de démarrage à ne pas
       suivre le thème. -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="15" Height="15" CornerRadius="{StaticResource Radius}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="1"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Path x:Name="Check" Stretch="None" Opacity="0"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 3,7 L 6,10 L 11,3" />
            </Border>

            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Liste déroulante : le gabarit par défaut de Windows ignore le thème
       sombre, on le remplace entièrement. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource Radius}">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                          Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.4" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius}" Margin="0,3,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="260">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Curseur de taille. Glissière en rainure gravée, poignée en petit bloc
       biseauté avec une encoche : c'est le geste le plus employé de l'onglet
       Fenêtres, et il rendait jusqu'ici le curseur bleu de Windows. -->
  <Style TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="{StaticResource Radius}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="1" />

            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4"
                              VerticalAlignment="Center">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Margin="1" CornerRadius="{StaticResource Radius}"
                              Background="{DynamicResource AccentBrush}" Opacity="0.7" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>

              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                              Background="Transparent" BorderThickness="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>

              <Track.Thumb>
                <Thumb Width="14" Height="18" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bloc" CornerRadius="{StaticResource Radius}"
                              Background="{DynamicResource SurfaceAltBrush}"
                              BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                              SnapsToDevicePixels="True">
                        <!-- L'encoche : elle dit où l'on tient la poignée. -->
                        <Border Width="2" Height="9" HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bloc" Property="BorderBrush"
                                  Value="{StaticResource BevelPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bloc" Property="Background"
                                  Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barre de défilement. Elle n'avait aucun style et rendait donc celle de
       Windows, flèches comprises : c'est ce qui trahissait le plus le thème.
       Huit pixels de large, sans flèche, glissière gravée et poignée de
       cuivre. Les six ScrollViewer réservent déjà dix pixels à droite. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- Quatre pixels, gris au repos. La poignée occupe souvent presque
               toute la piste : en cuivre plein, elle devenait une barre qui
               tirait l'oeil plus que le contenu. -->
          <Border x:Name="Poignee" CornerRadius="{StaticResource Radius}"
                  Width="4" HorizontalAlignment="Center"
                  Background="{DynamicResource BorderBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Poignee" Property="Width" Value="6" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Poignee" Property="Width" Value="6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Les boutons de piste sont neutralisés : un clic dans le vide fait défiler
       d'une page, sans qu'aucune flèche ne paraisse. -->
  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Border Width="1" HorizontalAlignment="Center"
                    Background="{DynamicResource GrooveBrush}" />

            <!-- Sans ces quatre liaisons, la piste ne sait pas quelle part du
                 contenu est visible : la poignée occupe alors toute la hauteur. -->
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand"
                              Style="{StaticResource ScrollTrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand"
                              Style="{StaticResource ScrollTrackButton}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="8" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Poignée de déplacement : une grille de points, dessinée comme le reste.
       Elle seule déclenche le glissé, pour que le champ de renommage garde la
       sélection de texte. -->
  <Style x:Key="DragHandle" TargetType="Control">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="ToolTip" Value="Faites glisser vers le haut ou vers le bas pour changer l'ordre" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border x:Name="Root" Background="Transparent" Padding="2">
            <UniformGrid Columns="2" Rows="3">
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
            </UniformGrid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Verrou de position, en icône plutôt qu'en case à cocher : la ligne
       d'une instance porte déjà une case, et deux cases côte à côte se
       confondent.

       Éteint par défaut, et fermé quand il est allumé : le geste que
       l'utilisateur fait est d'immobiliser une fenêtre, pas d'en libérer les
       autres. Le dessin change, pas seulement la couleur, une icône seulement
       pâlie se lisant « désactivée » et non « décochée ». -->
  <Style x:Key="LockToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius}" Padding="3">
            <Grid Width="14" Height="14" Opacity="0.5">
              <!-- Anse ouverte : la branche gauche est en l'air. -->
              <Path x:Name="Shackle" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 10,6.5 V 4.2 A 3,3 0 0 0 4,4.2" />
              <Path x:Name="Body" Fill="{DynamicResource TextMutedBrush}"
                    Data="M 3,6.5 H 11 A 1.2,1.2 0 0 1 12.2,7.7 V 12.3 A 1.2,1.2 0 0 1 11,13.5 H 3 A 1.2,1.2 0 0 1 1.8,12.3 V 7.7 A 1.2,1.2 0 0 1 3,6.5 Z" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <!-- Anse fermée : la branche gauche redescend sur le corps. -->
              <Setter TargetName="Shackle" Property="Data"
                      Value="M 10,6.5 V 4.2 A 3,3 0 0 0 4,4.2 V 6.5" />
              <Setter TargetName="Shackle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Body" Property="Fill" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Shackle" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Nom d'instance : du texte, qui se modifie au clic.
       Un champ encadré par ligne remplissait la liste de boîtes et coûtait une
       douzaine de pixels de hauteur chacune. Le cadre n'apparaît qu'au survol
       et à la saisie, là où il sert vraiment. -->
  <Style x:Key="InlineEdit" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius}"
                  BorderThickness="1" BorderBrush="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bouton d'action réduit à son dessin. Trois par ligne, ils tenaient en
       toutes lettres sur 400 de large mais mangeaient la place du nom, qui est
       la seule chose qu'on lise vraiment dans cette liste. L'infobulle porte
       ce que le libellé disait, en plus complet. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusKey}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rompre une association efface des réglages : le survol le dit en rouge. -->
  <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Un arc qui tourne, pour dire qu'on travaille.

       Il ne tourne que tant qu'il est à l'écran : une animation sans fin sur
       un élément replié continue de réclamer une image à chaque rafraîchissement
       pour rien, et cette carte disparaît au premier balayage rendu. -->
  <Style x:Key="Spinner" TargetType="Control">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!-- Un seul centre de rotation. Les deux, « RenderTransformOrigin »
               et « CenterX/CenterY », s'additionnent : posés ensemble, l'arc
               tournait autour du coin bas-droit au lieu de tourner sur
               lui-même. -->
          <Canvas Width="14" Height="14">
            <Canvas.RenderTransform>
              <RotateTransform x:Name="Turn" CenterX="7" CenterY="7" />
            </Canvas.RenderTransform>

            <!-- Trois quarts de cercle : l'ouverture est ce qui donne à voir
                 que ça tourne. -->
            <Path Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 7,1.2 A 5.8,5.8 0 1 1 1.9,4.3" />
          </Canvas>

          <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Spin">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Turn"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.9"
                                     RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Spin" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowGlyph" TargetType="Path">
    <Setter Property="Stroke" Value="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType=Button}}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- Une corbeille : ce qui retire une chose de l'application.

       Elle était dessinée à même la fenêtre des profils, et le bouton qui
       oublie un appareil portait une chaîne rompue, héritée du temps où il
       s'appelait « rompre l'association ». Il n'annule pourtant rien côté
       téléphone : il retire l'appareil d'ici, exactement comme la suppression
       d'un profil. Un seul geste, un seul dessin, écrit une seule fois. -->
  <Style x:Key="BinGlyph" TargetType="Path" BasedOn="{StaticResource RowGlyph}">
    <Setter Property="Data"
            Value="M 3,4.6 H 12 M 6,4.6 V 3.2 H 9 V 4.6 M 4.2,4.6 V 12.3 H 10.8 V 4.6 M 6.4,6.6 V 10.3 M 8.6,6.6 V 10.3" />
  </Style>

  <!-- Le même dessin, mais dans une liste. RowGlyph prend sa couleur d'un
       bouton ancêtre ; il n'y en a pas dans le gabarit d'une ligne, et le tracé
       y resterait invisible. La couleur est donc posée ici. -->
  <Style x:Key="ListGlyph" TargetType="Path" BasedOn="{StaticResource RowGlyph}">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Nom d'appareil au-dessus d'une suite d'instances. Volontairement
       discret : il situe, il ne se lit pas. -->
  <Style x:Key="DeviceHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DropLine" TargetType="Border">
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <!-- Indicateur d'activité : un arc qui tourne. C'est la seule animation
       du dépôt, volontairement discrète, pour les quelques secondes que dure
       l'ouverture ou la relance d'une instance. -->
  <Style x:Key="BusyIndicator" TargetType="Control">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!-- Le dessin est fait à seize unités et mis à l'échelle, au lieu
               d'être dessiné à la taille demandée.

               L'arc était un tracé de coordonnées fixes, l'anneau une ellipse
               qui remplissait la place : à seize pixels ils coïncidaient, et
               nulle part ailleurs. Le suivi demande vingt-deux pixels, où l'arc
               restait seize et se retrouvait décalé en haut à gauche d'un
               anneau plus grand que lui. Mesuré à l'écran.

               L'anneau garde une unité de marge pour que son rayon soit celui
               de l'arc, sept : sans elle il vaut huit, et le bleu passe à côté
               du gris d'un pixel entier. -->
          <Viewbox Stretch="Uniform">
            <!-- L'animation vise l'élément qui porte le déclencheur, sans nom :
                 un Storyboard déclenché depuis un gabarit ne voit pas l'étendue
                 de noms de ce gabarit, et échouait à chaque affichage d'une
                 ligne. -->
            <Grid Width="16" Height="16" Background="Transparent"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="0" />
              </Grid.RenderTransform>

              <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                          From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>

              <Ellipse Margin="1" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2" />
              <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 8 1 A 7 7 0 0 1 15 8" />
            </Grid>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Onglets, et paliers de réglage.

       La pilule pleine devient un simple trait sous l'onglet actif. Rien
       d'autre ne le distingue : ni fond, ni couleur de texte particulière. -->
  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Root" Background="Transparent" Padding="12,7,12,6"
                    CornerRadius="{StaticResource RadiusTop}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>

            <!-- Le liseré occupe toujours la place, même éteint : un trait qui
                 apparaît décalerait le texte au-dessus de lui. -->
            <Border x:Name="Mark" Height="2" VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentBrush}" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Case de la grille de positions. C'est une commande, pas un réglage
       affiché : cliquer regroupe les fenêtres à cet endroit, et rien ne reste
       allumé ensuite. -->
  <Style x:Key="AnchorCell" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" CornerRadius="{StaticResource Radius}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                  Cursor="Hand" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BevelPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Infobulle : le gabarit par défaut de Windows ignore le thème et donne
       du texte clair sur fond clair, illisible. -->
  <!-- Une infobulle qui porte autre chose qu'une phrase.
       Le gabarit ordinaire verse son contenu dans le Text d'un TextBlock : tout
       ce qui n'est pas une chaîne y afficherait son nom de type. Celui-ci
       présente le contenu tel qu'il est. -->
  <Style x:Key="RichToolTip" TargetType="ToolTip">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius}" Padding="11,8">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius}" Padding="10,7">
            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" MaxWidth="320"
                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                       Foreground="{DynamicResource TextBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
