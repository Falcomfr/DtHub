<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Colours come from the palette, by dynamic reference. -->

  <!-- The type scale. Colours all went through the palette, and not
       one was hardcoded; sizes, on the other hand, were anonymous
       numbers scattered across the windows, so much that a new window
       would pick one by eye.

       Six steps, and nothing in between. The values are the ones that
       were already in use: naming a scale must not move anything on
       screen.

       Three sizes remain hardcoded, and that's deliberate. The product
       name in the configurator's header is a brand, not body text.
       The close cross and the chevron on the help sheets are signs,
       whose size follows the artwork rather than reading. And
       MenuPathControl draws an Android screen: its proportions are
       those of that phone, not those of our interface. -->
  <sys:Double x:Key="FontTiny">10</sys:Double>
  <sys:Double x:Key="FontSmall">11</sys:Double>
  <sys:Double x:Key="FontBody">12</sys:Double>
  <sys:Double x:Key="FontMedium">13</sys:Double>
  <sys:Double x:Key="FontLarge">15</sys:Double>
  <sys:Double x:Key="FontTitle">19</sys:Double>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Font for everything that reads as a value: shortcuts,
       percentages. A shortcut is a sequence of keys, not a sentence;
       monospace says so, and lines up columns without anyone having
       to worry about it. -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- The corner radius, in a single place.

       It used to be hardcoded in twenty-one places, from 4 to 10
       depending on the mood: the next screen would have introduced a
       twenty-second one. Two pixels soften the corner without
       rounding the shape. -->
  <CornerRadius x:Key="Radius">2</CornerRadius>
  <CornerRadius x:Key="RadiusTop">2,2,0,0</CornerRadius>

  <!-- What gets pressed is more rounded than what carries: five
       pixels for buttons, two for cards and bubbles. The distinction
       shows without having to name it, and two pixels on a button
       thirty units tall read like a rectangle someone forgot to
       finish. -->
  <CornerRadius x:Key="RadiusKey">5</CornerRadius>

  <!-- A button's face: a barely perceptible gradient, lighter at the
       top. Along with the bevel, that's what makes it look placed
       rather than painted. Two values taken on either side of the
       panels' background. -->
  <LinearGradientBrush x:Key="KeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF21252C" />
    <GradientStop Offset="1" Color="#FF15181C" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="KeyFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF272C34" />
    <GradientStop Offset="1" Color="#FF1A1E23" />
  </LinearGradientBrush>

  <!-- The bevel: light on top, shadow at the bottom, on a one-pixel
       border. It's the interface's entire sense of relief, and it
       costs no drop shadow at all. Inverted, it recesses instead of
       raising: that's what a pressed button does. -->
  <LinearGradientBrush x:Key="BevelBorderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF3A414D" />
    <GradientStop Offset="1" Color="#FF0A0C0F" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BevelPressedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF0A0C0F" />
    <GradientStop Offset="1" Color="#FF3A414D" />
  </LinearGradientBrush>

  <!-- Brushed panel: only two surfaces, the title bar and the bottom
       bar. The general background stays flat, otherwise the screen
       would become noisy. -->
  <LinearGradientBrush x:Key="BrushedPanelBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF16191F" />
    <GradientStop Offset="1" Color="#FF0E1014" />
  </LinearGradientBrush>

  <!-- Engraved rule: a two-pixel groove, shadow then light. Replaces
       the old Separator, which wasn't used anywhere. -->
  <Style x:Key="Groove" TargetType="Control">
    <Setter Property="Height" Value="2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <StackPanel>
            <Border Height="1" Background="{DynamicResource GrooveBrush}" />
            <Border Height="1" Background="{DynamicResource BevelBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- Inset panel. The background is darker than the chassis and the
       border carries the bevel: the card recesses instead of
       floating. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelPressedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource KeyFaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- The face lightens under the finger, instead of fading:
                 a drop in opacity brought the button closer to the
                 background, which is the opposite of what a hover
                 should say. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{StaticResource KeyFaceHoverBrush}" />
            </Trigger>

            <!-- The bevel inverts: the light moves to the bottom, and
                 the button appears to sink under the finger. It's a
                 response to the action, where there used to be
                 nothing but a change in opacity. -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{StaticResource BevelPressedBrush}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

  <!-- The blue carries light text: too dark for the reverse. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Foreground" Value="#FFF2F6FA" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Two buttons of the same family, one plain and the other a
       toggle. The pairing action and opening the profiles sit on the
       same line: two different looks made it messy there, one framed
       and the other floating without a border.

       At rest, the panel's background and the bevel, like the other
       buttons. Under the finger, the muted blue and the accent
       border, that is, the colour of what you select, where there
       used to be nothing but a drop in opacity that said nothing. The
       icon on the left, though, always stays in the accent colour:
       it's the button's mark, not a state. -->
  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{StaticResource BevelPressedBrush}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The toggle version of the same look. It has its own template
       and inherits nothing: the styles above target Button, and
       applying them to a ToggleButton throws when the window loads,
       which the compiler doesn't see. Open, it keeps the accent
       background, so you know where the bubble comes from. -->
  <Style x:Key="OutlineToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BevelBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A button within a group: the bottom bar's three arranging
       actions sit within a single frame, separated by a divider. They
       therefore have no border or corner of their own, and it's the
       frame that rounds them at the ends.

       They carry their name: three icons alone forced you to hover to
       know which did what, and the shortcut written under each one
       repeated "Ctrl +" three times in a bar three hundred and sixty
       units wide. -->
  <Style x:Key="GroupKey" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Padding" Value="7,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{StaticResource KeyFaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
  </Style>

  <!-- A link within text: no frame, no background, just the colour
       and the underline on hover. Used for prerequisites that lead to
       a quest. -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Libelle" Text="{TemplateBinding Content}"
                     TextWrapping="Wrap" Background="Transparent"
                     Foreground="{TemplateBinding Foreground}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Libelle" Property="TextDecorations" Value="Underline" />
              <Setter TargetName="Libelle" Property="Foreground"
                      Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}">
            <Grid>
              <!-- The prompt text, when the field is empty and one has
                   been set on its Tag.

                   Inside the template rather than layered on top of
                   the field: overlaid, its margin had to be guessed
                   at. This way it shares the field's border and font.

                   The padding is applied twice, as margin and as its
                   own padding, because the field does the same: the
                   template's margin pushes the text holder away, and
                   the field pushes the text further inward again.
                   Measured, the prompt landed fourteen pixels to the
                   left of the entry, exactly twice the seven pixels of
                   padding. -->
              <TextBlock x:Name="Invite" Margin="{TemplateBinding Padding}"
                         Padding="{TemplateBinding Padding}"
                         Text="{TemplateBinding Tag}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />

              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Invite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox. It used to keep Windows' template, with its blue and
       its rounded corners: the only control on the startup window
       that didn't follow the theme. -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="15" Height="15" CornerRadius="{StaticResource Radius}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="1"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Path x:Name="Check" Stretch="None" Opacity="0"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 3,7 L 6,10 L 11,3" />
            </Border>

            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Drop-down list: Windows' default template ignores the dark
       theme, so it's replaced entirely. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource Radius}">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                          Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.4" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius}" Margin="0,3,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="260">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Size slider. Track in an engraved groove, thumb as a small
       bevelled block with a notch: it's the most used action in the
       Windows tab, and until now it rendered as Windows' blue slider. -->
  <Style TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="{StaticResource Radius}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{StaticResource BevelPressedBrush}" BorderThickness="1" />

            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4"
                              VerticalAlignment="Center">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Margin="1" CornerRadius="{StaticResource Radius}"
                              Background="{DynamicResource AccentBrush}" Opacity="0.7" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>

              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                              Background="Transparent" BorderThickness="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>

              <Track.Thumb>
                <Thumb Width="14" Height="18" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bloc" CornerRadius="{StaticResource Radius}"
                              Background="{DynamicResource SurfaceAltBrush}"
                              BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                              SnapsToDevicePixels="True">
                        <!-- The notch: it shows where you hold the thumb. -->
                        <Border Width="2" Height="9" HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bloc" Property="BorderBrush"
                                  Value="{StaticResource BevelPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bloc" Property="Background"
                                  Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbar. It had no style at all and therefore rendered as
       Windows' own, arrows included: this is what gave the theme away
       the most. Eight pixels wide, no arrows, an engraved track and a
       copper thumb. The six ScrollViewers already reserve ten pixels
       on the right. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- Four pixels, grey at rest. The thumb often takes up
               nearly the whole track: in solid copper, it turned into
               a bar that drew the eye more than the content did. -->
          <Border x:Name="Poignee" CornerRadius="{StaticResource Radius}"
                  Width="4" HorizontalAlignment="Center"
                  Background="{DynamicResource BorderBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Poignee" Property="Width" Value="6" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Poignee" Property="Width" Value="6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The track buttons are neutralised: clicking in the empty space
       scrolls by one page, with no arrow appearing at all. -->
  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Border Width="1" HorizontalAlignment="Center"
                    Background="{DynamicResource GrooveBrush}" />

            <!-- Without these four bindings, the track doesn't know
                 what portion of the content is visible: the thumb
                 then takes up the whole height. -->
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand"
                              Style="{StaticResource ScrollTrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand"
                              Style="{StaticResource ScrollTrackButton}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="8" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Drag handle: a grid of dots, drawn like everything else. It
       alone triggers the drag, so the rename field can keep its text
       selection. -->
  <Style x:Key="DragHandle" TargetType="Control">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border x:Name="Root" Background="Transparent" Padding="2">
            <UniformGrid Columns="2" Rows="3">
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
              <Ellipse Width="3" Height="3" Margin="1" Fill="{DynamicResource TextMutedBrush}" />
            </UniformGrid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Position lock, as an icon rather than a checkbox: an instance's
       row already carries a checkbox, and two checkboxes side by side
       would be confused with one another.

       Off by default, and closed when it's on: the gesture the user
       makes is to pin a window in place, not to free up the others.
       The icon itself changes, not just the colour, since an icon
       merely faded reads as "disabled" rather than "unchecked". -->
  <Style x:Key="LockToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius}" Padding="3">
            <Grid Width="14" Height="14" Opacity="0.5">
              <!-- Open shackle: the left arm is in the air. -->
              <Path x:Name="Shackle" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 10,6.5 V 4.2 A 3,3 0 0 0 4,4.2" />
              <Path x:Name="Body" Fill="{DynamicResource TextMutedBrush}"
                    Data="M 3,6.5 H 11 A 1.2,1.2 0 0 1 12.2,7.7 V 12.3 A 1.2,1.2 0 0 1 11,13.5 H 3 A 1.2,1.2 0 0 1 1.8,12.3 V 7.7 A 1.2,1.2 0 0 1 3,6.5 Z" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <!-- Closed shackle: the left arm comes back down onto the
                   body. -->
              <Setter TargetName="Shackle" Property="Data"
                      Value="M 10,6.5 V 4.2 A 3,3 0 0 0 4,4.2 V 6.5" />
              <Setter TargetName="Shackle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Body" Property="Fill" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Shackle" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Instance name: text that becomes editable on click. A field
       framed per row filled the list with boxes and cost a dozen
       pixels of height each. The frame only appears on hover and
       while typing, where it actually serves a purpose. -->
  <Style x:Key="InlineEdit" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource Radius}"
                  BorderThickness="1" BorderBrush="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Action button reduced to its icon. Three per row, they used to
       fit spelled out on a width of 400, but ate into the room for the
       name, which is the only thing you really read in this list.
       The tooltip carries what the label used to say, in fuller form. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusKey}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Breaking a pairing erases settings: the hover says so in red. -->
  <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A chip that opens a popup, with no box around it.

       IconButton would have done, and cannot: a Button style applied to
       a ToggleButton throws when the dictionary loads, which the
       compiler does not see. Hence a twin, targeting the right type.

       It exists because the row's settings used to be two bordered
       boxes standing at the same weight as the action itself. Fading
       them was not enough: a border is louder than a glyph at any
       opacity. This one is a glyph until you reach for it. -->
  <Style x:Key="RowChipToggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource RadiusKey}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <!-- Checked means its popup is open, which is a touch and
                 not a selection: the accent is exactly right for it,
                 and only for as long as it lasts. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The row's own action, raised where its neighbours are flat.

       **The accent was not available for this.** The palette reserves it
       for what you select and what you touch, and it is already at work
       inside this very row: the tabbed toggle when checked, the closed
       lock, the drop line, the default-profile star. A blue slab
       repeated on every row would spend "the only one of its kind" and
       make blue mean both "selected" and "the action".

       So it dominates by material instead: a key face and a bevel, the
       vocabulary the bottom bar already uses for the things you press,
       and a full-contrast glyph among muted ones. The one accent it
       does take is the press itself, which is literally what the
       palette keeps the colour for, and which GroupKey and OutlineButton
       already do.

       The glyphs need no change: RowGlyph inherits its stroke from the
       ancestor button's foreground, and the launch triangle binds its
       fill the same way, so overriding the foreground here carries. -->
  <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{StaticResource KeyFaceBrush}"
                  BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusKey}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <!-- Lightening and not fading, for the reason BaseButton
                 writes down: a key that dims under the pointer reads as
                 going away. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{StaticResource KeyFaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="Root" Property="BorderBrush"
                      Value="{StaticResource BevelPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A rotating arc, to say something is working.

       It only spins while it's on screen: an endless animation on a
       collapsed element keeps demanding a frame at every refresh for
       nothing, and this card disappears as soon as the first scan
       completes. -->
  <Style x:Key="Spinner" TargetType="Control">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!-- A single centre of rotation. The two,
               "RenderTransformOrigin" and "CenterX/CenterY", add up:
               set together, the arc rotated around its bottom-right
               corner instead of spinning on itself. -->
          <Canvas Width="14" Height="14">
            <Canvas.RenderTransform>
              <RotateTransform x:Name="Turn" CenterX="7" CenterY="7" />
            </Canvas.RenderTransform>

            <!-- Three quarters of a circle: the gap is what shows that
                 it's turning. -->
            <Path Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 7,1.2 A 5.8,5.8 0 1 1 1.9,4.3" />
          </Canvas>

          <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Spin">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Turn"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.9"
                                     RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Spin" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowGlyph" TargetType="Path">
    <Setter Property="Stroke" Value="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType=Button}}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- A bin: what removes something from the application.

       It used to be drawn straight into the profiles window, and the
       button that forgets a device carried a broken chain, inherited
       from when it was called "break the pairing". Yet it cancels
       nothing on the phone's side: it removes the device from here,
       exactly like deleting a profile. One single gesture, one single
       icon, written once. -->
  <Style x:Key="BinGlyph" TargetType="Path" BasedOn="{StaticResource RowGlyph}">
    <Setter Property="Data"
            Value="M 3,4.6 H 12 M 6,4.6 V 3.2 H 9 V 4.6 M 4.2,4.6 V 12.3 H 10.8 V 4.6 M 6.4,6.6 V 10.3 M 8.6,6.6 V 10.3" />
  </Style>

  <!-- The same icon, but within a list. RowGlyph takes its colour
       from an ancestor button; there is none in a row's template, and
       the stroke would stay invisible there. The colour is therefore
       set here. -->
  <Style x:Key="ListGlyph" TargetType="Path" BasedOn="{StaticResource RowGlyph}">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Device name above a run of instances. Deliberately understated:
       it locates, it isn't meant to be read. -->
  <Style x:Key="DeviceHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DropLine" TargetType="Border">
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <!-- Activity indicator: a rotating arc, for the few seconds an
       instance takes to open or restart.

       This used to claim to be the only animation in the repository. It
       was already wrong by one, the searching spinner above being the
       other, and the count is not the point: what motion there is here
       is there to say that something is happening, or that something
       has changed place, and never to decorate. -->
  <Style x:Key="BusyIndicator" TargetType="Control">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!-- The artwork is drawn at sixteen units and scaled, instead
               of being drawn at the requested size.

               The arc was a stroke with fixed coordinates, the ring an
               ellipse filling the space: at sixteen pixels they
               coincided, and nowhere else. Tracking asks for
               twenty-two pixels, where the arc stayed at sixteen and
               ended up offset toward the top left of a ring bigger
               than itself. Measured on screen.

               The ring keeps a one-unit margin so that its radius
               matches the arc's, seven: without it, it's eight, and
               the blue misses the grey by a full pixel. -->
          <Viewbox Stretch="Uniform">
            <!-- The animation targets the element that carries the
                 trigger, unnamed.

                 The rule is narrower than it looks, and worth stating
                 precisely: an EventTrigger written on an element inside
                 a template, as here, resolves against the outer scope
                 and cannot name anything in the template. A
                 ControlTemplate.Triggers entry does see it, which is how
                 the spinner and the tabs' underline both target a named
                 element. Getting the two confused cost a crash on every
                 row displayed. -->
            <Grid Width="16" Height="16" Background="Transparent"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="0" />
              </Grid.RenderTransform>

              <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                          From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>

              <Ellipse Margin="1" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2" />
              <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 8 1 A 7 7 0 0 1 15 8" />
            </Grid>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs, and setting tiers.

       The solid pill becomes a simple line under the active tab.
       Nothing else sets it apart: no background, no particular text
       colour. -->
  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Root" Background="Transparent" Padding="12,7,12,6"
                    CornerRadius="{StaticResource RadiusTop}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>

            <!-- The underline always takes up its space, even when
                 off: a line that appears would shift the text above
                 it. -->
            <Border x:Name="Mark" Height="2" VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentBrush}" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <!-- The underline crosses over instead of blinking on.

                 A bar that truly slid from one tab to the next would
                 need a single bar outliving all three, in the window
                 rather than in the template, plus code-behind measuring
                 offsets on load, on a language change, since the labels
                 are translated and change width, and on a DPI change.
                 And this style also dresses the four quality buttons and
                 the four zoom buttons, which would keep the per-template
                 mark: two different underline behaviours for controls
                 that look identical.

                 The setter stays as the resting value; the animation
                 only covers the crossing. Weight and colour stay
                 instant: fading those too would need a second copy of
                 the text underneath, and snapping them is what makes the
                 eye land on the panel rather than on the decoration.

                 The name resolves because this is a ControlTemplate
                 trigger, which does see the template's name scope. It is
                 an EventTrigger written on an element inside a template
                 that does not. -->
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Light">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Mark"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Light" />
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Mark"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Mark" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Cell of the position grid. It's a command, not a displayed
       setting: clicking gathers the windows at that spot, and nothing
       stays lit afterward. -->
  <Style x:Key="AnchorCell" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" CornerRadius="{StaticResource Radius}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                  Cursor="Hand" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BevelPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One of the six colours an account can be marked with.

       A square of colour and nothing else. The ring appears on the one
       the account already wears, which is why each swatch carries its
       own colour in Tag as well as in its command parameter: the
       template compares the two through the existing pair converter,
       and no new converter is needed for it. -->
  <Style x:Key="ColourSwatch" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Root" CornerRadius="{StaticResource Radius}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource BevelBorderBrush}" BorderThickness="1"
                    Cursor="Hand" SnapsToDevicePixels="True" />

            <!-- The mark of the colour in use. Drawn over the square
                 rather than around it, so the swatches keep the same
                 footprint whichever one is current. -->
            <Border x:Name="Ring" Margin="3" Opacity="0"
                    CornerRadius="1"
                    BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BevelPressedBrush}" />
            </Trigger>
            <DataTrigger Value="True">
              <DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource SameValue}">
                  <Binding Path="Colour" />
                  <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </DataTrigger.Binding>
              <Setter TargetName="Ring" Property="Opacity" Value="1" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltip: Windows' default template ignores the theme and gives
       light text on a light background, unreadable. -->
  <!-- A tooltip that carries something other than a sentence.
       The ordinary template pours its content into a TextBlock's
       Text: anything that isn't a string would show its type name
       there. This one presents the content as it is. -->
  <Style x:Key="RichToolTip" TargetType="ToolTip">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius}" Padding="11,8">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius}" Padding="10,7">
            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" MaxWidth="320"
                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontBody}"
                       Foreground="{DynamicResource TextBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
