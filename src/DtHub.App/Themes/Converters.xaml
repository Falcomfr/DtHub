<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DtHub.App.Converters">

  <!-- Declared at the application level: a view loaded via a data
       template has no parent at the moment its XAML is parsed, and
       would therefore not see the window's resources. -->

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:EnumMatchConverter x:Key="EnumMatch" />
  <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
  <conv:HexToBrushConverter x:Key="HexToBrush" />
  <conv:EqualityConverter x:Key="Equality" />
  <conv:IconPathToImageConverter x:Key="IconPath" />
  <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
  <conv:SameInstanceConverter x:Key="SameInstance" />
  <conv:SameValueConverter x:Key="SameValue" />
  <conv:AnchorLabelConverter x:Key="AnchorLabel" />

  <conv:DraggedOpacityConverter x:Key="DraggedOpacity" />

  <conv:AllTrueToVisibilityConverter x:Key="AllTrue" />
  <conv:AnyTrueToVisibilityConverter x:Key="AnyTrue" />

  <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

</ResourceDictionary>
