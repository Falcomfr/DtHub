<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DtHub.App.Converters">

  <!-- Déclarés au niveau de l'application : une vue chargée par modèle de
       données n'a pas de parent au moment où son XAML est analysé, et ne
       verrait donc pas les ressources de la fenêtre. -->

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
  <conv:HexToBrushConverter x:Key="HexToBrush" />
  <conv:EqualityConverter x:Key="Equality" />
  <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
  <conv:SameInstanceConverter x:Key="SameInstance" />
  <conv:SameValueConverter x:Key="SameValue" />
  <conv:AnchorLabelConverter x:Key="AnchorLabel" />

  <conv:DraggedOpacityConverter x:Key="DraggedOpacity" />

</ResourceDictionary>
