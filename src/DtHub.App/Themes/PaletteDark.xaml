<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- La palette de l'application. Il n'y en a qu'une : le thème clair a été
       retiré plutôt que maintenu à moitié, et l'application ne suit plus le
       réglage de Windows.

       Les couleurs sont écrites littéralement dans chaque pinceau, sans
       référence dynamique intermédiaire : un SolidColorBrush placé dans un
       dictionnaire de ressources est gelé, et un DynamicResource sur sa
       couleur ne se résout jamais, ce qui rendait toute l'interface noire.

       Le panneau est plus sombre que le châssis qui le porte : il s'enfonce
       plutôt qu'il ne se pose. C'est le parti pris de l'appareil, et le biseau
       le confirme, lumière en haut et ombre en bas. -->

  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF121419" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1A1D22" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF0E1014" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FF2E333C" />

  <!-- Les deux arêtes d'un biseau. Employées ensemble et dans cet ordre :
       la lumière vient d'en haut, comme sur tout appareil posé sur un bureau. -->
  <SolidColorBrush x:Key="BevelBrush" Color="#FF3A414D" />
  <SolidColorBrush x:Key="GrooveBrush" Color="#FF0A0C0F" />

  <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAEE" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#FF939BA8" />

  <!-- Cuivre mat : la couleur de ce qu'on choisit et de ce qu'on touche.
       Volontairement sombre et peu saturée, pour ne pas se confondre avec
       l'ambre vif des avertissements. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FFC8863C" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFDB9A4E" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF2A2118" />

  <!-- Les trois diodes d'état. L'ambre est plus clair et plus saturé que le
       cuivre : l'écart tient à la clarté autant qu'à la teinte. -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF46B478" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFE8C24A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFE06A6A" />

</ResourceDictionary>
