<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- La palette de l'application. Il n'y en a qu'une : le thème clair a été
       retiré plutôt que maintenu à moitié, et l'application ne suit plus le
       réglage de Windows.

       Les couleurs sont écrites littéralement dans chaque pinceau, sans
       référence dynamique intermédiaire : un SolidColorBrush placé dans un
       dictionnaire de ressources est gelé, et un DynamicResource sur sa
       couleur ne se résout jamais, ce qui rendait toute l'interface noire.

       Le panneau est plus sombre que le châssis qui le porte : il s'enfonce
       plutôt qu'il ne se pose. C'est le parti pris de l'appareil, et le biseau
       le confirme, lumière en haut et ombre en bas. -->

  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF121419" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1A1D22" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF0E1014" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FF2E333C" />

  <!-- Les deux arêtes d'un biseau. Employées ensemble et dans cet ordre :
       la lumière vient d'en haut, comme sur tout appareil posé sur un bureau. -->
  <SolidColorBrush x:Key="BevelBrush" Color="#FF3A414D" />
  <SolidColorBrush x:Key="GrooveBrush" Color="#FF0A0C0F" />

  <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAEE" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#FF939BA8" />

  <!-- Bleu d'acier : la couleur de ce qu'on choisit et de ce qu'on touche.
       Plus froid et plus profond que l'ancien, qui tirait sur le violet, et
       assez loin du bleu de Windows pour ne pas s'y confondre. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF3D82BE" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5098D6" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF16222E" />

  <!-- Les trois diodes d'état. -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF46B478" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFE8C24A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFE06A6A" />

  <!-- Les couleurs des icônes de la liste de quêtes.
       Nommées par ce qu'elles désignent et non par leur teinte : elles servent
       à distinguer des natures de ligne, pas à annoncer un état, et emprunter
       pour cela les diodes ci-dessus aurait brouillé les deux usages.

       Quatre teintes distinctes, pas une de plus : au-delà, une liste de
       soixante lignes se lit comme un vitrail. Toutes sont désaturées pour tenir
       sur le fond sombre sans vibrer.

       Le parchemin des quêtes en avait une cinquième, verte. Il était le seul
       en couleur sur l'accueil, où les quatre lignes se valent, et il prend
       donc la teinte neutre des lieux. -->
  <SolidColorBrush x:Key="GlyphDungeonBrush" Color="#FF8590A0" />
  <SolidColorBrush x:Key="GlyphPlaceBrush" Color="#FFD9A05E" />
  <SolidColorBrush x:Key="GlyphFamilyBrush" Color="#FF9D8ACF" />
  <SolidColorBrush x:Key="GlyphSuccessBrush" Color="#FFE0BE58" />
  <SolidColorBrush x:Key="GlyphNeedBrush" Color="#FF6F9CC4" />

</ResourceDictionary>
